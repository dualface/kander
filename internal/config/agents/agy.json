{
  "schema_version": 1,
  "path": "agy",
  "process_name": "agy",
  "args": {
    "start": ["--model", "{model}", "--effort", "{effort}", "--dangerously-skip-permissions", "--prompt-interactive"],
    "resume": ["--conversation", "{session}", "--model", "{model}", "--effort", "{effort}", "--dangerously-skip-permissions", "--prompt-interactive"],
    "review": [
      "--model", "{model}", "--effort", "{effort}",
      "--add-dir", "{runtime}", "--add-dir", "{rules_dir}",
      "--settings", "{{\"permissions\":{{\"allow\":[\"command(*)\"],\"deny\":[\"write_file(*)\",\"mcp(*)\",\"read_url(*)\",\"execute_url(*)\"]}}}}",
      "--output-format", "json", "--print", "{instruction} This is an isolated reviewer session. Use the supplied bootstrap and review contract as your instructions. Read the provided Git evidence and worktree, then return the complete report as your final answer. Skip executor setup, global workflow files, and planning artifacts."
    ]
  },
  "session": {"mode": "hook:agy-transcript"},
  "exit_command": "/exit",
  "program_status": {"reports": false},
  "display_name": "Antigravity CLI",
  "supports_effort": true,
  "prompt_delivery": {"mode": "argv"},
  "review": {
    "last_message_report": true,
    "cwd": "root",
    "home_policy": "optional",
    "output_name": "output.json",
    "inspection": "Use read and search tools and shell commands that do not write, including read-only Git in the review worktree; never create, modify, or delete any file.",
    "spawns_helpers": true,
    "snapshot_spec": true,
    "stdin": "none",
    "output": {
      "source": "stdout",
      "parse": "json_field:response",
      "success": [{"json_field": "status", "equals": "SUCCESS"}]
    }
  },
  "rules_target": {"global": ".gemini/AGENTS.md", "project": "AGENTS.md"},
  "config_home": {"default": ".gemini", "fixed": true},
  "rules_integration": "markdown-reference",
  "large_model": "",
  "small_model": "",
  "large_effort": "high",
  "small_effort": "medium",
  "model": "",
  "effort": "high"
}
