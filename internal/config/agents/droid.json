{
  "schema_version": 1,
  "path": "droid",
  "process_name": "droid",
  "args": {
    "start": [
      "--auto",
      "high"
    ],
    "resume": [
      "--auto",
      "high",
      "--resume",
      "{session}"
    ],
    "review": [
      "exec",
      "--output-format",
      "json",
      "--model",
      "{model}",
      "--append-system-prompt",
      "Output contract: your final message is the complete report. It must contain the complete analysis. Prefer one kander-findings JSON fence; a complete readable report is accepted for receiver interpretation. Write that one message and stop. Use read-only inspection only; never create, modify, or delete any file.",
      "{instruction}"
    ]
  },
  "session": {
    "mode": "hook:droid-sessions"
  },
  "exit_command": "/quit",
  "display_name": "Droid",
  "supports_effort": false,
  "prompt_delivery": {
    "mode": "pane",
    "ready": {
      "match": "? for help",
      "timeout_ms": 30000
    },
    "blocked": [
      {
        "match": "Trust this folder?",
        "reason": "Droid is asking whether to trust the launch directory"
      }
    ]
  },
  "review": {
    "cwd": "root",
    "home_policy": "optional",
    "output_name": "output.json",
    "inspection": "Use only read-only inspection: read, search, and shell commands that do not write. Never create, modify, or delete any file; the review gate fails if HEAD moves or the worktree is dirty.",
    "spawns_helpers": true,
    "snapshot_spec": true,
    "stdin": "none",
    "output": {
      "source": "stdout",
      "parse": "json_field:result",
      "success": [
        {"json_field": "type", "equals": "result"},
        {"json_field": "subtype", "equals": "success"},
        {"json_field": "is_error", "equals": false}
      ]
    }
  },
  "rules_target": {
    "global": ".factory/AGENTS.md",
    "project": "AGENTS.md"
  },
  "config_home": {
    "default": ".factory",
    "fixed": true
  },
  "rules_integration": "markdown-reference",
  "large_model": "",
  "small_model": "",
  "model": ""
}
