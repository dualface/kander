<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Kander server, managed by Kander: written by kander service install server; do not edit. kander-service: {"schema":1,"kind":"server","executable":"C:\\Users\\alice\\.local\\bin\\kander.exe","args":["server","start","\u002d\u002dforeground","\u002d\u002ddata","C:\\Users\\alice\\.local\\share\\kander\u002dserver","\u002d\u002dlisten","127.0.0.1:7878","\u002d\u002dttl","1m30s","\u002d\u002drenew","30s"],"work_dir":"C:\\Users\\alice\\.local\\share\\kander\u002dserver","log":"C:\\Users\\alice\\.local\\share\\kander\u002dserver\\server.log"}</Description>
    <URI>\kander-server</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>HOST\alice</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>HOST\alice</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>%SystemRoot%\System32\conhost.exe</Command>
      <Arguments>--headless cmd.exe /d /v:off /s /c "set "KANDER_MANAGED=1" &amp;&amp; "C:\Users\alice\.local\bin\kander.exe" "server" "start" "--foreground" "--data" "C:\Users\alice\.local\share\kander-server" "--listen" "127.0.0.1:7878" "--ttl" "1m30s" "--renew" "30s" &gt;&gt; "C:\Users\alice\.local\share\kander-server\server.log" 2&gt;&amp;1"</Arguments>
      <WorkingDirectory>C:\Users\alice\.local\share\kander-server</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
