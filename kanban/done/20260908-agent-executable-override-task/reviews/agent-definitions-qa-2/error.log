    64	// ResolveAgentProgram resolves built-in and configured executable names per platform.
    65	// name may be a PATH name (with or without extension) or an explicit path.
    66	func ResolveAgentProgram(name string) *AgentProgram {
    67		if !isWindows() {
    68			found, err := exec.LookPath(name)
    69			if err != nil {
    70				return nil
    71			}
    72			return &AgentProgram{Path: found}
    73		}
    74	
    75		if strings.ContainsAny(name, `/\`) {
    76			if explicit := explicitProgram(name); explicit != nil {
    77				return explicit
    78			}
    79			if filepath.Ext(name) == "" {
    80				for _, suffix := range []string{".exe", ".cmd", ".bat"} {
    81					if explicit := explicitProgram(name + suffix); explicit != nil {
    82						return explicit
    83					}
    84				}
    85			}
    86			return nil
    87		}
    88		if suffix := strings.ToLower(filepath.Ext(name)); suffix != "" {
    89			if suffix != ".exe" && suffix != ".cmd" && suffix != ".bat" {
    90				return nil
    91			}
    92			for _, candidate := range windowsPathCandidates(name, suffix) {
    93				if usableFile(candidate, suffix == ".exe") {
    94					return &AgentProgram{Path: candidate, Batch: suffix != ".exe"}
    95				}
    96			}
    97			return nil
    98		}
    99	
   100		for _, candidate := range windowsPathCandidates(name, ".exe") {
   101			if usableFile(candidate, true) {
   102				return &AgentProgram{Path: candidate}
   103			}
   104		}
   105		for _, suffix := range []string{".cmd", ".bat"} {
   106			for _, candidate := range windowsPathCandidates(name, suffix) {
   107				if usableFile(candidate, false) {
   108					return &AgentProgram{Path: candidate, Batch: true}
   109				}
   110			}
   111		}
   112		return nil
   113	}
   114	
   115	func explicitProgram(name string) *AgentProgram {
   116		suffix := strings.ToLower(filepath.Ext(name))
   117		if suffix != ".exe" {
   118			if _, ok := windowsBatchSuffixes[suffix]; !ok {
   119				return nil
   120			}
   121		}
   122		if !usableFile(name, suffix == ".exe") {
   123			return nil
   124		}
   125		_, batch := windowsBatchSuffixes[suffix]
   126		return &AgentProgram{Path: name, Batch: batch}
