   186	func windowsPathName(p string) string {
   187		normalized := strings.ReplaceAll(p, `/`, `\`)
   188		if i := strings.LastIndex(normalized, `\`); i >= 0 {
   189			return normalized[i+1:]
   190		}
   191		return normalized
   192	}
   193	
   194	func windowsPathAbsolute(p string) bool {
   195		if strings.HasPrefix(p, `\\`) || strings.HasPrefix(p, `//`) {
   196			return len(p) > 2
   197		}
   198		if len(p) >= 3 && p[1] == ':' && (p[2] == '\\' || p[2] == '/') && unicode.IsLetter(rune(p[0])) {
   199			return true
   200		}
   201		return false
   202	}
   203	
   204	func windowsJoin(base, elem1, elem2 string) string {
   205		base = strings.TrimRight(strings.ReplaceAll(base, `/`, `\`), `\`)
   206		return base + `\` + elem1 + `\` + elem2
   207	}
