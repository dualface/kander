   160	func quoteWindowsBatchArgument(argument string) (string, error) {
   161		if strings.ContainsRune(argument, 0) {
   162			return "", ErrNUL
   163		}
   164		runes := []rune(argument)
   165		reverse := []rune{'"'}
   166		quoteHit := true
   167		for i := len(runes) - 1; i >= 0; i-- {
   168			character := runes[i]
   169			reverse = append(reverse, character)
   170			if quoteHit && character == '\\' {
   171				reverse = append(reverse, '\\')
   172			} else if character == '"' {
   173				quoteHit = true
   174				reverse = append(reverse, '"')
   175			} else {
   176				quoteHit = false
   177			}
   178		}
   179		reverse = append(reverse, '"')
   180		for left, right := 0, len(reverse)-1; left < right; left, right = left+1, right-1 {
   181			reverse[left], reverse[right] = reverse[right], reverse[left]
   182		}
   183		return string(reverse), nil
   184	}
