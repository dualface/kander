   384			if modelID != "" {
   385				args = append(args, "--model", modelID)
   386			}
   387			args = append(args, "--trust", "--force")
   388			if definition.Session.Mode != "none" {
   389				args = append(args, "--resume", session.Reference)
   390			}
   391			return args, nil
   392		}
   393		effortKey := scale + "_effort"
   394		effort := model[effortKey]
   395		var modelArgs []string
   396		if modelID != "" {
   397			modelArgs = []string{"--model", modelID}
   398		}
   399		switch agent {
   400		case "codex":
   401			options := append(append([]string{}, modelArgs...), "--config", `model_reasoning_effort="`+effort+`"`, "--dangerously-bypass-approvals-and-sandbox")
   402			if resume {
   403				return append(append([]string{"resume"}, options...), session.Reference), nil
   404			}
   405			return options, nil
   406		case "claude":
   407			flag := "--session-id"
   408			if resume {
   409				flag = "--resume"
   410			}
   411			args := append(modelArgs, "--effort", effort, "--dangerously-skip-permissions")
   412			if definition.Session.Mode != "none" {
   413				args = append(args, flag, session.Reference)
   414			}
   415			return args, nil
   416		case "grok":
   417			flag := "--session-id"
   418			if resume {
   419				flag = "--resume"
   420			}
   421			args := append(modelArgs, "--effort", effort, "--permission-mode", "bypassPermissions")
   422			if definition.Session.Mode != "none" {
   423				args = append(args, flag, session.Reference)
   424			}
   425			return args, nil
   426		default:
   427			return nil, launchError("launch.unsupported_agent", agent)
   428		}
   429	}
