+			cfg := DefaultConfig()
+			exe, _ := os.Executable()
+			session := &AgentSessionDefinition{Mode: test.mode}
+			if test.mode == "allocated" {
+				session.Allocate = []string{exe}
+			}
+			cfg.Agents = map[string]AgentDefinition{"alias": {Dialect: test.dialect, Session: session}}
