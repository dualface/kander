   140	func windowsPathCandidates(name, suffix string) []string {
   141		filename := name
   142		if !strings.HasSuffix(strings.ToLower(name), suffix) {
   143			filename = name + suffix
   144		}
   145		separator := string(os.PathListSeparator)
   146		if isWindows() {
   147			separator = ";"
   148		}
   149		var out []string
   150		for _, raw := range strings.Split(os.Getenv("PATH"), separator) {
   151			directory := strings.Trim(strings.TrimSpace(raw), `"`)
   152			if directory == "" {
   153				continue
   154			}
   155			out = append(out, filepath.Join(directory, filename))
   156		}
   157		return out
   158	}
