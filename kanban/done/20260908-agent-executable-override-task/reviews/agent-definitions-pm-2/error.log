   137	}
   138	
   139	func resolveTaskIdentity(taskID, text string, requireResume bool, configs ...*config.Config) (AgentSession, error) {
   140		session, err := sessionFrom(text)
   141		if err != nil {
   142			return AgentSession{}, err
   143		}
   144		var cfg *config.Config
   145		if len(configs) > 0 {
   146			cfg = configs[0]
   147		} else {
   148			cfg, err = loadEffective()
   149			if err != nil {
   150				return AgentSession{}, err
   151			}
   152		}
   153		if !config.HasAgent(cfg, session.Agent) {
   154			return AgentSession{}, launchError("launch.unsupported_agent", session.Agent)
   155		}
   156		definition := config.AgentFor(cfg, session.Agent)
   157		if requireResume && definition.Session.Mode == "none" {
   158			return AgentSession{}, config.AgentResumeError(session.Agent)
   159		}
   160		if definition.Session.Mode == "discovered" && session.Reference == "" {
   161			id, err := findCodexSession(taskID)
   162			if err != nil {
   163				return AgentSession{}, err
   164			}
   165			return AgentSession{Agent: session.Agent, Reference: id}, nil
   166		}
   167		if session.Reference == "" {
   168			return AgentSession{}, launchError(
   169				"launch.task_session_for_has_no_id", session.Agent,
   170			)
   171		}
   172		return session, nil
   173	}
