   525			}
   526			index := len(bind.modelFields)
   527			bind.modelFields = append(bind.modelFields, field)
   528			value := field.Value()
   529			bind.modelValues = append(bind.modelValues, &value)
   530			// Inline puts the title and the value on one line, compressing the block of one role/scale from 7 lines to 4.
   531			out = append(out, huh.NewInput().
   532				Title(modelIndent+field.Short+"  ").
   533				Prompt("").
   534				Inline(true).
   535				Placeholder(placeholder).
   536				Value(bind.modelValues[index]))
   537		}
   538		return out
