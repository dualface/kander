    80	func newAgentSession(agent string, program *process.AgentProgram, configs ...*config.Config) (AgentSession, error) {
    81		var cfg *config.Config
    82		if len(configs) > 0 {
    83			cfg = configs[0]
    84		}
    85		definition := config.AgentFor(cfg, agent)
    86		switch definition.Session.Mode {
    87		case "generated", "none":
