   101	func parseTaskSession(text string) *AgentSession {
   102		value := metadataFrom(text, sessionField)
   103		if value == "" {
   104			return nil
   105		}
   106		parts := strings.Fields(value)
   107		if len(parts) == 0 {
   108			return nil
   109		}
   110		agent := parts[0]
   111		reference := ""
   112		if len(parts) > 1 {
   113			reference = parts[1]
   114		}
   115		if !config.ValidAgentName(agent) || len(parts) > 2 || (reference != "" && !sessionReferenceRe.MatchString(reference)) {
   116			return nil
   117		}
   118		return &AgentSession{Agent: agent, Reference: reference}
   119	}
