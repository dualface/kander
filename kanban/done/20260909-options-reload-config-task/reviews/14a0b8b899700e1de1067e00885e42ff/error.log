   214	func readOverlay(cwd string) (string, map[string]any, error) {
   215		path, err := OverlayPath(cwd)
   216		if err != nil || path == "" {
   217			return path, nil, err
   218		}
   219		data, err := readConfigBytes(path)
   220		if err != nil {
   221			return "", nil, configErrorfWrap(err, "config.failed_to_read_config", path, err.Error())
   222		}
   223		if data == nil {
   224			return "", nil, nil
   225		}
   226		raw, err := decodeJSON(data)
   227		if err != nil {
   228			return "", nil, configErrorfWrap(err, "config.overlay_invalid_json", path, err.Error())
   229		}
   230		obj, ok := raw.(map[string]any)
   231		if !ok {
   232			return "", nil, configErrorf("config.overlay_root_must_be_a_json_object", path)
   233		}
   234		if err := validateOverlayKeys(path, obj); err != nil {
   235			return "", nil, err
   236		}
   237		return path, obj, nil
   238	}
