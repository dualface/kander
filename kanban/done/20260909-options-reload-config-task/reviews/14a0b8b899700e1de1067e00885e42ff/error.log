    17	// ApplyLanguageArgument scans argv for --lang and sets KANDER_LANG / KANDER_LANG_CLI.
    18	func ApplyLanguageArgument(arguments []string) {
    19		langMu.Lock()
    20		defer langMu.Unlock()
    21		_ = os.Unsetenv(EnvLangCLI)
