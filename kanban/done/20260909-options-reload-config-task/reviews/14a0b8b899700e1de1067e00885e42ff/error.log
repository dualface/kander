   333	// openSection builds the form of one section.
   334	func (p *optionsPanel) openSection(section string) tea.Cmd {
   335		p.current = section
   336		tui := p.scopeTUI()
   337		bind := &formBinding{
   338			theme:     tui.Theme,
   339			columns:   tui.Columns,
   340			minWidth:  tui.MinColumnWidth,
   341			refresh:   tui.Refresh,
   342			single:    tui.Single,
   343			archived:  p.app.Model.ShowArchived,
   344			reviewers: map[string]*string{},
   345			stages:    map[string]*string{},
   346		}
   347		p.bind = bind
   704		minWidth := clampMinColumnWidth(b.minWidth)
   705		refresh := clampRefresh(b.refresh)
   706		single := b.single
   707		if containsString(themes, theme) {
   708			scopeTUI.Theme = theme
   709		}
   710		scopeTUI.Columns = columns
   711		scopeTUI.MinColumnWidth = minWidth
   712		scopeTUI.Refresh = refresh
   713		scopeTUI.Single = single
   714		if p.session != nil && p.session.Config != nil {
   715			p.session.Config.TUI = scopeTUI
   716		}
   717		if app.Model.ShowArchived != b.archived {
   718			app.Model.ToggleArchived()
   719		}
   720		current := config.TUI{
   721			Theme:          scopeTUI.Theme,
   722			Columns:        columns,
   723			MinColumnWidth: minWidth,
   724			Refresh:        refresh,
   725			Single:         single,
   726		}
   727		previous := p.loadedTUI
   728		if p.appliedTUI != nil {
   729			previous = *p.appliedTUI
   730			if current == previous {
   731				return
   732			}
   733		} else if current == p.loadedTUI {
   734			return
   735		}
   736		themeChanged := current.Theme != previous.Theme
   737		singleChanged := current.Single != previous.Single
   738		if containsString(themes, theme) && app.Theme != theme {
   739			app.Theme = theme
   740		}
   741		if themeChanged {
   742			// Huh caches the body during Update, and that cache still uses the old theme at this point.
   743			// Reuse the section rebuild path so the current frame takes effect and focus stays on the theme selector.
   744			p.rebuildAt(interfaceFocusKey("theme"))
   745		}
   746		if app.Columns != columns {
   747			app.Columns = columns
   748		}
   749		if app.MinColumnWidth != minWidth {
   750			app.MinColumnWidth = minWidth
   751		}
   752		if app.RefreshSecs != refresh {
   753			app.RefreshSecs = refresh
   754		}
   755		if app.Model.Single != single {
   756			app.Model.Single = single
   757		}
   758		if singleChanged {
   759			p.rebuildAt(interfaceFocusKey("single"))
   760		}
   761		copied := current
   762		p.appliedTUI = &copied
   763		// UI preferences reach config.json as soon as they change, so returning with Esc loses nothing.
   764		p.persistUI()
   765	}
