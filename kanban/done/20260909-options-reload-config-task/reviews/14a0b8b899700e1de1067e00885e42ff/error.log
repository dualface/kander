   223	func TestOpenOptionsIgnoresStaleReload(t *testing.T) {
   224		app := newPanelApp(t)
   225		initial := config.DefaultConfig()
   226		initial.WelcomeComplete = true
   227		initial.KanbanAgent = "codex"
   228		_ = newTestSession(t, initial)
   229		useTestOptionsSession(t)
   230		app.openOptions()
   231		staleLoad := app.pendingWork
   232		if staleLoad == nil {
   233			t.Fatal("first load")
   234		}
   235		app.pendingWork = nil
   236		staleResult := staleLoad()
   237		app.Options.close()
   238		loaded, err := config.LoadScope(true)
   239		if err != nil {
   240			t.Fatal(err)
   241		}
   242		loaded.KanbanAgent = "grok"
   243		if _, err := config.Save(loaded); err != nil {
   244			t.Fatal(err)
   245		}
   246		app.openOptions()
   247		freshLoad := app.pendingWork
   248		if freshLoad == nil {
   249			t.Fatal("second load")
   250		}
   251		app.pendingWork = nil
   252		cmd := app.applyWork(freshLoad())
   253		if cmd != nil {
   254			pumpPanel(app.Options, cmd)
   255		}
   256		freshSession := app.Session
   257		if freshSession == nil || freshSession.Config.KanbanAgent != "grok" {
   258			t.Fatalf("fresh agent=%v", app.Session)
   259		}
   260		app.applyWork(staleResult)
   261		if app.Session != freshSession || app.Session.Config.KanbanAgent != "grok" {
   262			t.Fatalf("stale result overwrote session agent=%s", app.Session.Config.KanbanAgent)
   263		}
   264	}
