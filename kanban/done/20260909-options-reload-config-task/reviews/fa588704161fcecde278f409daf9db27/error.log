    86	func validateOverlayKeys(path string, obj map[string]any) error {
    87		var forbidden, unknown []string
    88		for key := range obj {
    89			if _, ok := overlayForbiddenKeys[key]; ok {
    90				forbidden = append(forbidden, key)
    91				continue
    92			}
    93			if _, ok := overlayAllowedKeys[key]; !ok {
    94				unknown = append(unknown, key)
    95			}
    96		}
    97		if len(forbidden) > 0 {
    98			return configErrorf("config.overlay_has_forbidden_keys", path, strings.Join(sorted(forbidden), ", "))
    99		}
   100		if len(unknown) > 0 {
   101			return configErrorf("config.overlay_has_unknown_keys", path, strings.Join(sorted(unknown), ", "))
   102		}
   103		return nil
   104	}
