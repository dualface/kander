   106	func overlayPathSafe(path string) error {
   107		if runtime.GOOS == "windows" {
   108			_, err := ensureWindowsPathNofollowSafe(path)
   109			return err
   110		}
   111		return rejectLeafReparse(path)
   112	}
   113	
   114	func inspectOverlayCandidate(path string) (string, error) {
   115		abs, err := lexicalAbsolute(path)
   116		if err != nil {
   117			return "", err
   118		}
   119		if err := overlayPathSafe(abs); err != nil {
   120			return "", err
   121		}
   122		info, err := os.Lstat(abs)
   123		if err != nil {
   124			if os.IsNotExist(err) {
   125				return "", nil
   126			}
   127			return "", configErrorfWrap(err, "config.failed_to_inspect_path", abs)
   128		}
   129		if fs.IsReparsePoint(abs) {
   130			return "", unsafePathError(abs)
   131		}
   132		if !info.Mode().IsRegular() {
   133			return "", configErrorf("config.overlay_is_not_a_regular_file", abs)
   134		}
   135		return abs, nil
   136	}
   137	
   138	func walkOverlay(start string) (string, error) {
   139		current := start
   140		for {
   141			path, err := inspectOverlayCandidate(filepath.Join(current, OverlayFilename))
   142			if err != nil {
   143				return "", err
   144			}
   145			if path != "" {
   146				return path, nil
   147			}
   148			parent := filepath.Dir(current)
   149			if parent == current {
   150				return "", nil
   151			}
   152			current = parent
   153		}
   154	}
   155	
   156	// OverlayPath returns the absolute project overlay path for cwd, or "" when none exists.
   157	// A Git directory uses the main worktree root; otherwise the search walks up from cwd.
   158	func OverlayPath(cwd string) (string, error) {
   159		if cwd == "" {
   160			var err error
   161			cwd, err = os.Getwd()
   162			if err != nil {
   163				return "", configErrorfWrap(err, "config.failed_to_inspect_path", ".")
   164			}
   165		}
   166		start, err := lexicalAbsolute(cwd)
   167		if err != nil {
   168			return "", err
   169		}
   170		main, err := gitMainWorktree(start)
   171		if err != nil {
   172			return "", err
   173		}
   174		if main != "" {
   175			return inspectOverlayCandidate(filepath.Join(main, OverlayFilename))
   176		}
   177		return walkOverlay(start)
   178	}
