    13	func TestOpenOptionsReloadsScopeFromDisk(t *testing.T) {
    14		app := newPanelApp(t)
    15		initial := config.DefaultConfig()
    16		initial.WelcomeComplete = true
    17		initial.KanbanAgent = "codex"
    18		stale := newTestSession(t, initial)
    19		stale.Config.KanbanAgent = "claude"
    20		useTestOptionsSession(t)
    21		app.Session = stale
    22		app.openOptions()
    23		finishOptionsLoad(t, app)
    24		if app.Session == stale {
    25			t.Fatal("open reused the in-memory session")
    26		}
    27		if app.Session.Config.KanbanAgent != "codex" {
    28			t.Fatalf("session agent=%s", app.Session.Config.KanbanAgent)
    29		}
    30		app.Options.close()
    31		loaded, err := config.LoadScope(true)
    32		if err != nil {
    33			t.Fatal(err)
    34		}
    35		loaded.KanbanAgent = "grok"
    36		if _, err := config.Save(loaded); err != nil {
    37			t.Fatal(err)
    38		}
    39		app.openOptions()
    40		finishOptionsLoad(t, app)
    41		if app.Session.Config.KanbanAgent != "grok" {
    42			t.Fatalf("reopen agent=%s", app.Session.Config.KanbanAgent)
    43		}
    44	}
