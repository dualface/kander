   222	func TestOpenOptionsIgnoresStaleReload(t *testing.T) {
   223		app := newPanelApp(t)
   224		initial := config.DefaultConfig()
   225		initial.WelcomeComplete = true
   226		initial.KanbanAgent = "codex"
   227		_ = newTestSession(t, initial)
   228		useTestOptionsSession(t)
   229		app.openOptions()
   230		staleLoad := app.pendingWork
   231		if staleLoad == nil {
   232			t.Fatal("first load")
   233		}
   234		app.pendingWork = nil
   235		staleResult := staleLoad()
   236		app.Options.close()
   237		loaded, err := config.LoadScope(true)
   238		if err != nil {
   239			t.Fatal(err)
   240		}
   241		loaded.KanbanAgent = "grok"
   242		if _, err := config.Save(loaded); err != nil {
   243			t.Fatal(err)
   244		}
   245		app.openOptions()
   246		freshLoad := app.pendingWork
   247		if freshLoad == nil {
   248			t.Fatal("second load")
   249		}
   250		app.pendingWork = nil
   251		cmd := app.applyWork(freshLoad())
   252		if cmd != nil {
   253			pumpPanel(app.Options, cmd)
   254		}
   255		freshSession := app.Session
   256		if freshSession == nil || freshSession.Config.KanbanAgent != "grok" {
   257			t.Fatalf("fresh agent=%v", app.Session)
   258		}
   259		app.applyWork(staleResult)
   260		if app.Session != freshSession || app.Session.Config.KanbanAgent != "grok" {
   261			t.Fatalf("stale result overwrote session agent=%s", app.Session.Config.KanbanAgent)
   262		}
   263	}
