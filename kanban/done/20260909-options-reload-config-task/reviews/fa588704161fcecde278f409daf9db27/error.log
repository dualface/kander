    34	func cloneRawValue(v any) any {
    35		switch typed := v.(type) {
    36		case map[string]any:
    37			return cloneRawObjectDeep(typed)
    38		case []any:
    39			out := make([]any, len(typed))
    40			for i, item := range typed {
    41				out[i] = cloneRawValue(item)
    42			}
    43			return out
    44		default:
    45			return v
    46		}
    47	}
    48	
    49	func cloneRawObjectDeep(src map[string]any) map[string]any {
    50		out := make(map[string]any, len(src))
    51		for key, value := range src {
    52			out[key] = cloneRawValue(value)
    53		}
    54		return out
    55	}
    56	
    57	// deepMerge copies base and overlays src onto it: objects merge by key,
    58	// scalars and arrays replace wholesale.
    59	func deepMerge(base, overlay map[string]any) map[string]any {
    60		out := cloneRawObjectDeep(base)
    61		for key, value := range overlay {
    62			if overlayObj, ok := value.(map[string]any); ok {
    63				if baseObj, ok := out[key].(map[string]any); ok {
    64					out[key] = deepMerge(baseObj, overlayObj)
    65					continue
    66				}
    67			}
    68			out[key] = cloneRawValue(value)
    69		}
    70		return out
    71	}
