   423	func (p *optionsPanel) updateForm(msg tea.Msg) tea.Cmd {
   424		// Inside the panel Enter always means "submit the current form", no matter which field the cursor is on;
   425		// Huh treats Enter as "move to the next field" by default, so it is intercepted here first.
   426		if event, ok := msg.(tea.KeyMsg); ok && mapKey(event) == "enter" {
   427			if p.bind != nil {
   428				p.bind.apply(p)
   429			}
   430			if p.confirming {
   431				return p.finishCloseConfirm()
   432			}
   433			return p.finishSection()
   434		}
   435		model, cmd := p.form.Update(msg)
   436		if form, ok := model.(*huh.Form); ok {
   437			p.form = form
   438		}
   439		// Bound values are written back as the cursor moves, which is what lets UI preferences such as the theme preview while being selected.
   440		if p.bind != nil {
   441			p.bind.apply(p)
   442		}
   443		if p.rebuildFocus != "" {
   444			return tea.Batch(cmd, p.rebuildSection())
   445		}
   446		switch p.form.State {
   447		case huh.StateCompleted:
   448			if p.confirming {
   449				return p.finishCloseConfirm()
   450			}
   451			return tea.Batch(cmd, p.finishSection())
   452		case huh.StateAborted:
   453			if p.confirming {
   454				p.confirming = false
   455				return p.openRoot()
   456			}
   457			return p.abortSection()
   458		}
   459		return cmd
   460	}
