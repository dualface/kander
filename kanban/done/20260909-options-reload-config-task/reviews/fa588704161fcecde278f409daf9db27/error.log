   555	func (p *optionsPanel) save() {
   556		p.persistUI()
   557		if p.session == nil {
   558			p.status = t("tui.environment_not_ready_interface_preferences_saved")
   559			return
   560		}
   561		finishLines, err := p.session.Finish()
   562		finishLines = spaceSaveReport(finishLines)
   563		if err != nil {
   564			p.showReport(t("tui.save_failed"), finishLines, err.Error())
   565			return
   566		}
   567		path, err := p.session.Save()
   568		if err != nil {
   569			p.showReport(t("tui.save_failed"), finishLines, err.Error())
   570			return
   571		}
   572		p.dirty = false
   573		p.app.Context = tuiPageContext()
   574		p.showReport(
   575			t("tui.configuration_saved"),
   576			finishLines,
   577			t("tui.configuration_saved_2")+path,
   578		)
   579		p.form = nil
   580	}
   581	
   582	func (p *optionsPanel) persistUI() {
   583		if p.session == nil {
   584			return
   585		}
   586		// Write the session's scope TUI, not the merged App display values.
   587		written, err := savePrefs(prefsFromConfig(p.session.Config.TUI))
   588		// When the write fails, only the edited value in the session is updated and the baseline is not advanced.
   589		p.session.SyncTUI(written, err == nil)
   590		if err != nil {
   591			p.app.PrefsError = err.Error()
   592			return
   593		}
   594		p.app.PrefsError = ""
   595	}

