   769	// commitSideEffects runs the actions that may only fire once the user confirms the whole section:
   770	// installing tmux occupies the terminal and changes the local environment, so it must not run as the cursor moves.
   771	func (b *formBinding) commitSideEffects(p *optionsPanel) {
   772		switch p.current {
   773		case sectionExecution:
   774			b.commitLauncher(p)
   775		}
   776	}
   777	
   778	func (b *formBinding) commitLauncher(p *optionsPanel) {
   779		session := p.session
   780		if b.launcher != menu.LauncherInstallValue {
   781			return
   782		}
   783		// Installing tmux occupies the current terminal, so hand the terminal over first and return to the alt-screen afterwards.
   784		p.app.pendingShell = func() {
   785			lines, installed := session.InstallTmux()
   786			menu.FlushReport(lines)
   787			if installed {
   788				session.SetLauncher("tmux")
   789				p.markDirty()
   790			}
   791		}
   792	}
