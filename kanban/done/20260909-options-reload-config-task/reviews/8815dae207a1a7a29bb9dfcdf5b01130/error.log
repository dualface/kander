   224	func (p *optionsPanel) markDirty() {
   225		p.dirty = true
   285	// Update is the input entry point of the panel: the report first, then the current Huh form.
   286	func (p *optionsPanel) Update(msg tea.Msg) tea.Cmd {
   287		if tick, ok := msg.(spinner.TickMsg); ok {
   288			if p.form != nil || p.loadErr != "" {
   289				return nil
   290			}
   291			var cmd tea.Cmd
   292			p.spinner, cmd = p.spinner.Update(tick)
   293			return cmd
   294		}
   295		if p.report != nil {
   296			return p.updateReport(msg)
   297		}
   298		if event, ok := msg.(tea.KeyMsg); ok && p.form != nil && !p.acceptsText() {
   299			switch mapKey(event) {
   300			case "q", "Q", "o", "O":
   301				// Consistent with the rest of the board: q closes, and pressing o again closes too.
   302				return p.requestClose()
   303			}
   304		}
   305		if p.form == nil {
   306			if key, ok := msg.(tea.KeyMsg); ok {
   307				switch mapKey(key) {
   308				case "esc", "q", "Q":
   309					p.close()
   310				}
   311			}
   312			return nil
   313		}
   314		return p.updateForm(msg)
   315	}
   316	
   317	func (p *optionsPanel) updateReport(msg tea.Msg) tea.Cmd {
   318		if key, ok := msg.(tea.KeyMsg); ok {
   319			switch mapKey(key) {
   320			case "esc", "q", "Q", "enter", "backspace":
   321				p.report = nil
   322				if p.form == nil && p.session != nil {
   323					return p.openRoot()
   324				}
   325				return nil
   360		}
   361		return tea.Batch(cmd, repeatCmd(index, huh.NextField))
   362	}
   363	
   364	// resizeForm rebuilds the form so every page re-measures its natural height against the new terminal size.
   365	// Huh's WithHeight cannot be undone; a form once compressed by a short terminal can only leave the scrolling layout through a rebuild.
   366	func (p *optionsPanel) resizeForm() tea.Cmd {
   367		if p.form == nil || p.report != nil {
   368			return nil
   369		}
   370		if p.confirming {
   371			return p.openCloseConfirm()
   372		}
   373		if p.current == "" {
   374			return p.openRoot()
   375		}
   376		index := 0
   377		if p.bind != nil {
   378			focused := p.form.GetFocusedField()
   379			for _, field := range p.bind.formFields {
   380				if field.Skip() {
   381					continue
   382				}
   383				if field == focused {
   384					break
   385				}
   386				index++
   387			}
   388		}
   389		section := p.current
   390		cmd := p.openSection(section)
   391		return tea.Batch(cmd, repeatCmd(index, huh.NextField))
   392	}
   393	
   394	// requestClose closes the panel; unsaved changes make the user choose first.
   395	func (p *optionsPanel) requestClose() tea.Cmd {
   396		if !p.dirty {
   397			p.close()
   398			return nil
   399		}
   400		return p.openCloseConfirm()
   401	}
   402	
   403	func (p *optionsPanel) updateForm(msg tea.Msg) tea.Cmd {
   404		// Inside the panel Enter always means "submit the current form", no matter which field the cursor is on;
   405		// Huh treats Enter as "move to the next field" by default, so it is intercepted here first.
   406		if event, ok := msg.(tea.KeyMsg); ok && mapKey(event) == "enter" {
   407			if p.bind != nil {
   408				p.bind.apply(p)
   409			}
   410			if p.confirming {
   411				return p.finishCloseConfirm()
   412			}
   413			return p.finishSection()
   414		}
   415		model, cmd := p.form.Update(msg)
   416		if form, ok := model.(*huh.Form); ok {
   417			p.form = form
   418		}
   419		// Bound values are written back as the cursor moves, which is what lets UI preferences such as the theme preview while being selected.
   420		if p.bind != nil {
   421			p.bind.apply(p)
   422		}
   423		if p.rebuildFocus != "" {
   424			return tea.Batch(cmd, p.rebuildSection())
   425		}
   426		switch p.form.State {
   427		case huh.StateCompleted:
   428			if p.confirming {
   429				return p.finishCloseConfirm()
   430			}
   431			return tea.Batch(cmd, p.finishSection())
   432		case huh.StateAborted:
   433			if p.confirming {
   434				p.confirming = false
   435				return p.openRoot()
   436			}
   437			return p.abortSection()
   438		}
   439		return cmd
   440	}
   441	
   442	func (p *optionsPanel) finishCloseConfirm() tea.Cmd {
   443		p.confirming = false
   444		switch p.closeChoice {
   445		case closeSave:
   446			p.save()
   447			return nil
   448		case closeDiscard:
   449			p.close()
   450			return nil
   451		}
   452		return p.openRoot()
   453	}
   454	
   455	// finishSection runs the side effects and returns to the root menu once a section form is confirmed.
   456	// Ordinary values were already written back in apply; interface / task execution / review / rules reach disk on submit,
   457	// so there is no need to return to the root menu and pick "save and apply".
   458	func (p *optionsPanel) finishSection() tea.Cmd {
   459		if p.current == sectionDoctor {
   460			return p.finishHerdrInstall()
   461		}
   462		if p.current == "" {
   463			return p.dispatch(p.section)
   464		}
   465		if p.bind != nil {
   466			p.bind.commitSideEffects(p)
   467		}
   468		if p.savesOnSubmit() {
   469			if err := p.persistNow(); err != nil {
   470				p.showReport(t("tui.save_failed"), nil, err.Error())
   471				return nil
   472			}
   473		}
   474		p.current = ""
   475		return p.openRoot()
   476	}
   477	
   478	func (p *optionsPanel) savesOnSubmit() bool {
   479		return p.current == sectionInterface || p.current == sectionExecution || p.current == sectionReview || p.current == sectionRules
   480	}
   481	
   482	// persistNow writes the current session to the config file, UI preferences included.
   483	func (p *optionsPanel) persistNow() error {
   484		p.persistUI()
   485		if p.session == nil {
   486			return nil
   487		}
   488		p.session.Config.WelcomeComplete = true
   489		if _, err := p.session.Save(); err != nil {
   490			return err
   491		}
   492		p.dirty = false
   493		return nil
   494	}
   495	
   496	// abortSection handles Esc: a section returns to the root menu, the root menu closes the panel.
   497	// Changed values are kept (apply wrote them back long ago); only side effects that need confirmation are skipped.
   498	func (p *optionsPanel) abortSection() tea.Cmd {
   499		if p.current == sectionDoctor {
   500			p.installHerdr = false
   501			return p.finishHerdrInstall()
   502		}
   503		if p.current == "" {
   504			p.close()
   505			return nil
   506		}
   507		p.current = ""
   508		return p.openRoot()
   509	}
   510	
   511	func (p *optionsPanel) dispatch(section string) tea.Cmd {
   512		switch section {
   513		case sectionSave:
   514			p.save()
   515			return nil
   516		case sectionClose:
   517			p.close()
   518			return nil
   519		case sectionFlow:
   520			p.openFlow()
   521			return nil
   522		case sectionDoctor:
   523			p.status = t("tui.running_environment_check")
   524			p.app.pendingWork = func() any {
   525				return terminalToolsResult{tools: menu.CheckTerminalTools()}

