   696	func (b *formBinding) applyInterface(p *optionsPanel) {
   697		app := p.app
   698		var scopeTUI config.TUI
   699		if p.session != nil && p.session.Config != nil {
   700			scopeTUI = p.session.Config.TUI
   701		}
   702		theme := b.theme
   703		columns := clampColumns(b.columns)
   704		minWidth := clampMinColumnWidth(b.minWidth)
   705		refresh := clampRefresh(b.refresh)
   706		single := b.single
   707		if containsString(themes, theme) {
   708			scopeTUI.Theme = theme
   709		}
   710		scopeTUI.Columns = columns
   711		scopeTUI.MinColumnWidth = minWidth
   712		scopeTUI.Refresh = refresh
   713		scopeTUI.Single = single
   714		if p.session != nil && p.session.Config != nil {
   715			p.session.Config.TUI = scopeTUI
   716		}
   717		if app.Model.ShowArchived != b.archived {
   718			app.Model.ToggleArchived()
   719		}
   720		current := config.TUI{
   721			Theme:          scopeTUI.Theme,
   722			Columns:        columns,
   723			MinColumnWidth: minWidth,
   724			Refresh:        refresh,
   725			Single:         single,
   726		}
   727		previous := p.loadedTUI
   728		if p.appliedTUI != nil {
   729			previous = *p.appliedTUI
   730		} else if current == p.loadedTUI {
   731			return
   732		}
   733		changed := false
   734		if containsString(themes, theme) && app.Theme != theme {
   735			app.Theme = theme
   736			changed = true
   737			if theme != previous.Theme {
   738				// Huh caches the body during Update, and that cache still uses the old theme at this point.
   739				// Reuse the section rebuild path so the current frame takes effect and focus stays on the theme selector.
   740				p.rebuildAt(interfaceFocusKey("theme"))
   741			}
   742		}
   743		if app.Columns != columns {
   744			app.Columns = columns
   745			changed = true
   746		}
   747		if app.MinColumnWidth != minWidth {
   748			app.MinColumnWidth = minWidth
   749			changed = true
   750		}
   751		if app.RefreshSecs != refresh {
   752			app.RefreshSecs = refresh
   753			changed = true
   754		}
   755		if app.Model.Single != single {
   756			app.Model.Single = single
   757			changed = true
   758			if single != previous.Single {
   759				p.rebuildAt(interfaceFocusKey("single"))
   760			}
   761		}
   762		p.appliedTUI = &current
   763		// UI preferences reach config.json as soon as they change, so returning with Esc loses nothing.
   764		if changed {
   765			p.persistUI()
   766		}
   767	}
