   683	// applyModels writes changes made in the model inputs back to the config session immediately.
   684	func (b *formBinding) applyModels(p *optionsPanel) {
   685		for i, field := range b.modelFields {
   686			if i >= len(b.modelValues) || b.modelValues[i] == nil {
   687				continue
   688			}
   689			if field.Value() != *b.modelValues[i] {
   690				field.Set(*b.modelValues[i])
   691				p.markDirty()
   692			}
   693		}
   694	}
