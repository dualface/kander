   164		if result, ok := payload.(startResult); ok {
   165			a.applyStartResult(result)
   166			return nil
   167		}
   168		if result, ok := payload.(focusResult); ok {
   169			a.focusRunning = false
   170			a.showFocusNotice(result.message)
   171			return nil
   172		}
   173		panel := a.Options
   174		if panel == nil {
   175			return nil
   176		}
   177		switch result := payload.(type) {
   178		case sessionResult:
   179			if result.seq != panel.loadSeq {
   180				return nil
   181			}
   182			if result.err != nil {
   183				panel.loadErr = result.err.Error()
   184				a.Session = nil
   185				panel.session = nil
   186				panel.overlayNotice = ""
   187				return nil
   188			}
   189			a.Session = result.session
   190			panel.session = result.session
   191			panel.loadedTUI = result.session.Config.TUI
   192			panel.appliedTUI = nil
   193			config.BindEffectiveLanguage()
   194			if result.overlayPath != "" {
   195				panel.overlayNotice = t("tui.overlay_notice")
   196			} else {
   197				panel.overlayNotice = ""
   198			}
   199			if panel.initial != "" {
   200				section := panel.initial
   201				panel.initial = ""
   202				return panel.dispatch(section)
   203			}
   204			return panel.openRoot()
   205		case terminalToolsResult:
   206			return panel.beginDoctor(result.tools)
   207		case doctorResult:
   208			panel.status = ""
   209			if panel.session != nil && result.after != nil {
   210				if err := panel.session.ApplyDoctorConfig(result.before, result.after, panel.dirty); err != nil {
   211					result.lines = append(result.lines, menu.ReportLine{Level: menu.LevelWarning, Text: err.Error()})
   212				}
   213			}
   214			panel.showReport(t("tui.environment_check"), append(panel.doctorLines, result.lines...), "")
   215			panel.doctorLines = nil
   216		}
   217		return nil
   218	}
