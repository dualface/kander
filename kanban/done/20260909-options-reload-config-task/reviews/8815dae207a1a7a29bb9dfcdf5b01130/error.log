    15	)
    16	
    17	// ApplyLanguageArgument scans argv for --lang and sets KANDER_LANG / KANDER_LANG_CLI.
    18	func ApplyLanguageArgument(arguments []string) {
    19		langMu.Lock()
    20		defer langMu.Unlock()
    21		_ = os.Unsetenv(EnvLangCLI)
    22		cliLanguageOverride = ""
    23		var value string
    24		for i := 0; i < len(arguments); i++ {
    25			arg := arguments[i]
    26			if arg == "--lang" && i+1 < len(arguments) {
    27				value = arguments[i+1]
    28				break
    29			}
    30			if strings.HasPrefix(arg, "--lang=") {
    31				value = strings.TrimPrefix(arg, "--lang=")
    32				break
    33			}
    34		}
    35		if contains(Languages, value) {
    36			cliLanguageOverride = value
    37			_ = os.Setenv(EnvLang, value)
    38			_ = os.Setenv(EnvLangCLI, "1")
    39		}
    40	}
    41	
    42	// BindConfigLanguage binds the language of a validated config to the in-process accessor.
    43	func BindConfigLanguage(cfg *Config) {
    44		langMu.Lock()
    45		defer langMu.Unlock()
    46		if cfg == nil || !contains(Languages, cfg.Language) {
    47			configLanguage = ""
    48			return
    49		}
    50		configLanguage = cfg.Language
    51	}
    52	
    53	// CLILanguage returns the language selected by --lang / KANDER_LANG_CLI, or empty when none was set.
    54	func CLILanguage() string {
    55		langMu.Lock()
    56		cli := cliLanguageOverride
    57		langMu.Unlock()
    58		if contains(Languages, cli) {
    59			return cli
    60		}
    61		if os.Getenv(EnvLangCLI) != "" {
    62			if lang := os.Getenv(EnvLang); contains(Languages, lang) {
    63				return lang
    64			}
    65		}
    66		return ""
    67	}
    68	
    69	func explicitConfigLanguage(raw map[string]any) string {
    70		welcome, _ := raw["welcome_complete"].(bool)
    71		if !welcome {
    72			return ""
    73		}
    74		if _, exists := raw["language"]; !exists {
    75			return ""
    76		}
    77		language, _ := raw["language"].(string)
    78		if contains(Languages, language) {
    79			return language
    80		}
    81		return ""
    82	}
    83	
    84	func configuredScopeObject() map[string]any {
    85		path, err := ConfigPath()
    86		if err != nil {
    87			return nil
    88		}
    89		data, err := readConfigBytes(path)
    90		if err != nil || data == nil {
    91			return nil
    92		}
    93		raw, err := decodeJSON(data)
    94		if err != nil {
    95			return nil
    96		}
    97		obj, ok := asObject(raw)
    98		if !ok {
    99			return nil
   100		}
   101		if _, err := Validate(obj); err != nil {
   102			return nil
   103		}
   104		return obj
   105	}
   106	
   107	// ConfiguredScopeLanguage returns the language explicitly saved in the
   108	// unmerged scope config.json. An empty result means the key is missing or
   109	// the file is not a valid welcomed config; write paths must not fall back
   110	// to ResolveLanguage(), which can still see a bound overlay language.
   111	func ConfiguredScopeLanguage() string {
   112		obj := configuredScopeObject()
   113		if obj == nil {
   114			return ""
   115		}
   116		return explicitConfigLanguage(obj)
   117	}
   118	
   119	// ConfiguredLanguage returns the language explicitly saved in a valid
   120	// config.json after applying the project overlay, otherwise an empty string.
   121	func ConfiguredLanguage() string {
   122		obj := configuredScopeObject()
   123		if obj == nil {
   124			return ""
   125		}
   126		_, overlayRaw, err := readOverlay("")
   127		if err != nil {
   128			return ""
   129		}
   130		if overlayRaw != nil {
   131			merged, err := mergeOverlayRaw(cloneRawObjectDeep(obj), overlayRaw)
   132			if err != nil {
   133				return ""
   134			}
   135			if _, err := Validate(merged); err != nil {
   136				return ""
   137			}
   138			obj = merged
   139		}
   140		return explicitConfigLanguage(obj)
   141	}
   142	
   143	func effectiveLocale() string {
   144		for _, name := range []string{EnvLang, "LC_ALL", "LC_MESSAGES", "LANG"} {
   145			if value := os.Getenv(name); value != "" {
   146				return value
   147			}
   148		}
   149		return ""
   150	}
   151	
   152	func localeLanguage() string {
   153		locale := strings.ToLower(effectiveLocale())
   154		if strings.HasPrefix(locale, "cn") || strings.HasPrefix(locale, "zh") {
   155			return "cn"
   156		}
   157		if strings.HasPrefix(locale, "ja") {
   158			return "ja"
   159		}
   160		return "en"
   161	}
   162	
   163	// ResolveScopeLanguage resolves --lang / KANDER_LANG_CLI then the
   164	// environment locale. It ignores the in-process bound config language so
   165	// write paths cannot copy an overlay-only language into the scope file.
   166	func ResolveScopeLanguage() string {
   167		if lang := CLILanguage(); lang != "" {
   168			return lang
   169		}
   170		return localeLanguage()
   171	}
   172	
   173	// ResolveLanguage resolves in order: --lang (KANDER_LANG_CLI) > config > environment; the default is en.
   174	func ResolveLanguage() string {
   175		if lang := CLILanguage(); lang != "" {
   176			return lang
   177		}
   178		langMu.Lock()
   179		bound := configLanguage
   180		langMu.Unlock()
   181		if contains(Languages, bound) {
   182			return bound
   183		}
   184		return localeLanguage()
   185	}
   186	
   187	// BindEffectiveLanguage binds the language from the on-disk config, clearing it when invalid.
   188	func BindEffectiveLanguage() {
   189		language := ConfiguredLanguage()
   190		if language == "" {
   191			BindConfigLanguage(nil)
   192			return
   193		}
   194		BindConfigLanguage(&Config{Language: language})
   195	}
   196	
   197	func LanguageIsChinese() bool {
   198		return ResolveLanguage() == "cn"
   199	}
   200	
   201	// Text resolves a catalog message using the existing CLI/config/environment precedence.
   202	func Text(id string, args ...any) string {
   203		return i18n.Text(ResolveLanguage(), id, args...)
   204	}

