   279			t.Fatal("default language should be the first interface option")
   280		}
   281		// Change a neighboring field first, then switch themes repeatedly, verifying that the refresh loses no setting and does not move focus.
   282		// The interface section is ordered language, agent language, theme, refresh.
   283		drivePanel(panel, keyMsg("down"))
   284		drivePanel(panel, keyMsg("down"))
   285		drivePanel(panel, keyMsg("down"))
   286		drivePanel(panel, keyMsg("right"))
   287		refresh := app.RefreshSecs
   288		drivePanel(panel, keyMsg("up"))
   289		for _, step := range []struct{ key, theme string }{
   290			{"right", "dark"}, {"left", "light"}, {"left", "auto"}, {"right", "light"},
   291		} {
   292			drivePanel(panel, keyMsg(step.key))
   293			if app.Theme != step.theme || panel.bind.theme != step.theme {
   294				t.Fatalf("theme=%q binding=%q want %q", app.Theme, panel.bind.theme, step.theme)
   295			}
   296			if panel.current != sectionInterface || panel.form.GetFocusedField() != panel.bind.formFields[4] {
   297				t.Fatal("theme change should keep the interface section and theme focus")
   298			}
   299			if app.RefreshSecs != refresh || panel.bind.refresh != refresh {
   300				t.Fatal("theme change lost the refresh setting")
   301			}
   302			if prefs := loadPrefs(); prefs.Theme != step.theme || prefs.Refresh != refresh {
   303				t.Fatalf("preferences=%+v", prefs)
   304			}
   305		}
   306		drivePanel(panel, keyMsg("esc"))
   307		pumpPanel(panel, panel.dispatch(sectionInterface))
   308		if panel.bind.theme != "light" || panel.bind.refresh != refresh {
   309			t.Fatal("reopening the interface section lost the settings")
   310		}
   311	}
