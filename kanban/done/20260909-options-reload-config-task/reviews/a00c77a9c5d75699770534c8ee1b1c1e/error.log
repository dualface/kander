   696	func (b *formBinding) applyInterface(p *optionsPanel) {
   697		app := p.app
   698		var scopeTUI config.TUI
   699		if p.session != nil && p.session.Config != nil {
   700			scopeTUI = p.session.Config.TUI
   701		}
   702		theme := b.theme
   703		columns := clampColumns(b.columns)
   704		minWidth := clampMinColumnWidth(b.minWidth)
   705		refresh := clampRefresh(b.refresh)
   706		single := b.single
   707		if containsString(themes, theme) {
   708			scopeTUI.Theme = theme
   709		}
   710		scopeTUI.Columns = columns
   711		scopeTUI.MinColumnWidth = minWidth
   712		scopeTUI.Refresh = refresh
   713		scopeTUI.Single = single
   714		if p.session != nil && p.session.Config != nil {
   715			p.session.Config.TUI = scopeTUI
   716		}
   717		if app.Model.ShowArchived != b.archived {
   718			app.Model.ToggleArchived()
   719		}
   720		edited := theme != p.loadedTUI.Theme ||
   721			columns != p.loadedTUI.Columns ||
   722			minWidth != p.loadedTUI.MinColumnWidth ||
   723			refresh != p.loadedTUI.Refresh ||
   724			single != p.loadedTUI.Single
   725		if !edited {
   726			return
   727		}
   728		changed := false
   729		if containsString(themes, theme) && app.Theme != theme {
   730			app.Theme = theme
   731			changed = true
   732			if theme != p.loadedTUI.Theme {
   733				// Huh caches the body during Update, and that cache still uses the old theme at this point.
   734				// Reuse the section rebuild path so the current frame takes effect and focus stays on the theme selector.
   735				p.rebuildAt(interfaceFocusKey("theme"))
   736			}
   737		}
   738		if app.Columns != columns {
   739			app.Columns = columns
   740			changed = true
   741		}
   742		if app.MinColumnWidth != minWidth {
   743			app.MinColumnWidth = minWidth
   744			changed = true
   745		}
   746		if app.RefreshSecs != refresh {
   747			app.RefreshSecs = refresh
   748			changed = true
   749		}
   750		if app.Model.Single != single {
   751			app.Model.Single = single
   752			changed = true
   753			if single != p.loadedTUI.Single {
   754				p.rebuildAt(interfaceFocusKey("single"))
   755			}
   756		}
   757		// UI preferences reach config.json as soon as they change, so returning with Esc loses nothing.
   758		if changed {
   759			p.persistUI()
   760		}
   761	}
