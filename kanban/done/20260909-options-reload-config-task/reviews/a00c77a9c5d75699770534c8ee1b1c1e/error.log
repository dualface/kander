   399			if p.bind != nil {
   400				p.bind.apply(p)
   401			}
   402			if p.confirming {
   403				return p.finishCloseConfirm()
   404			}
   405			return p.finishSection()
   406		}
   407		model, cmd := p.form.Update(msg)
   408		if form, ok := model.(*huh.Form); ok {
   409			p.form = form
   410		}
   411		// Bound values are written back as the cursor moves, which is what lets UI preferences such as the theme preview while being selected.
   412		if p.bind != nil {
   413			p.bind.apply(p)
   414		}
   415		if p.rebuildFocus != "" {
   416			return tea.Batch(cmd, p.rebuildSection())
   417		}
   418		switch p.form.State {
   419		case huh.StateCompleted:
   420			if p.confirming {
   421				return p.finishCloseConfirm()
   422			}
   423			return tea.Batch(cmd, p.finishSection())
   424		case huh.StateAborted:
   425			if p.confirming {
   426				p.confirming = false
   427				return p.openRoot()
   428			}
   429			return p.abortSection()
   430		}
   431		return cmd
   432	}
   433	
   434	func (p *optionsPanel) finishCloseConfirm() tea.Cmd {
   435		p.confirming = false
   436		switch p.closeChoice {
   437		case closeSave:
   438			p.save()
   439			return nil
   440		case closeDiscard:
   441			p.close()
   442			return nil
   443		}
   444		return p.openRoot()
   445	}
   446	
   447	// finishSection runs the side effects and returns to the root menu once a section form is confirmed.
   448	// Ordinary values were already written back in apply; interface / task execution / review / rules reach disk on submit,
   449	// so there is no need to return to the root menu and pick "save and apply".
   450	func (p *optionsPanel) finishSection() tea.Cmd {
   451		if p.current == sectionDoctor {
   452			return p.finishHerdrInstall()
   453		}
   454		if p.current == "" {
   455			return p.dispatch(p.section)
   456		}
   457		if p.bind != nil {
   458			p.bind.commitSideEffects(p)
   459		}
   460		if p.savesOnSubmit() {
   461			if err := p.persistNow(); err != nil {
   462				p.showReport(t("tui.save_failed"), nil, err.Error())
   463				return nil
   464			}
   465		}
   466		p.current = ""
   467		return p.openRoot()
   468	}
   469	
   470	func (p *optionsPanel) savesOnSubmit() bool {
   471		return p.current == sectionInterface || p.current == sectionExecution || p.current == sectionReview || p.current == sectionRules
   472	}
   473	
   474	// persistNow writes the current session to the config file, UI preferences included.
   475	func (p *optionsPanel) persistNow() error {
   476		p.persistUI()
   477		if p.session == nil {
   478			return nil
   479		}
   480		p.session.Config.WelcomeComplete = true
   481		if _, err := p.session.Save(); err != nil {
   482			return err
   483		}
   484		p.dirty = false
   485		return nil
   486	}
   487	
   488	// abortSection handles Esc: a section returns to the root menu, the root menu closes the panel.
   489	// Changed values are kept (apply wrote them back long ago); only side effects that need confirmation are skipped.
   490	func (p *optionsPanel) abortSection() tea.Cmd {
   491		if p.current == sectionDoctor {
   492			p.installHerdr = false
   493			return p.finishHerdrInstall()
   494		}
   495		if p.current == "" {
   496			p.close()
   497			return nil
   498		}
   499		p.current = ""
   500		return p.openRoot()
   501	}
   502	
   503	func (p *optionsPanel) dispatch(section string) tea.Cmd {
   504		switch section {
   505		case sectionSave:
   506			p.save()
   507			return nil
   508		case sectionClose:
   509			p.close()
   510			return nil
   511		case sectionFlow:
   512			p.openFlow()
   513			return nil
   514		case sectionDoctor:
   515			p.status = t("tui.running_environment_check")
   516			p.app.pendingWork = func() any {
   517				return terminalToolsResult{tools: menu.CheckTerminalTools()}
   518			}
   519			p.form = nil
   520			return nil
   521		case "":
   522			return p.openRoot()
   523		}
   524		return p.openSection(section)
   525	}
   526	
   527	func (p *optionsPanel) save() {
   528		p.persistUI()
   529		if p.session == nil {
   530			p.status = t("tui.environment_not_ready_interface_preferences_saved")
   531			return
   532		}
   533		finishLines, err := p.session.Finish()
   534		finishLines = spaceSaveReport(finishLines)
   535		if err != nil {
   536			p.showReport(t("tui.save_failed"), finishLines, err.Error())
   537			return
   538		}
   539		path, err := p.session.Save()
   540		if err != nil {
   541			p.showReport(t("tui.save_failed"), finishLines, err.Error())
   542			return
   543		}
   544		p.dirty = false
   545		p.app.Context = tuiPageContext()
   546		p.showReport(
   547			t("tui.configuration_saved"),
   548			finishLines,
   549			t("tui.configuration_saved_2")+path,
   550		)
   551		p.form = nil
   552	}
   553	
   554	func (p *optionsPanel) persistUI() {
   555		if p.session == nil {
   556			return
   557		}
   558		// Write the session's scope TUI, not the merged App display values.
   559		written, err := savePrefs(prefsFromConfig(p.session.Config.TUI))
   560		// When the write fails, only the edited value in the session is updated and the baseline is not advanced.
   561		p.session.SyncTUI(written, err == nil)
   562		if err != nil {
   563			p.app.PrefsError = err.Error()
   564			return
   565		}
   566		p.app.PrefsError = ""
   567	}

