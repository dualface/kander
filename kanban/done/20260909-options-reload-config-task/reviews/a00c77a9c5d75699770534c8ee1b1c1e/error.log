   334	func (p *optionsPanel) openSection(section string) tea.Cmd {
   335		p.current = section
   336		tui := p.scopeTUI()
   337		bind := &formBinding{
   338			theme:     tui.Theme,
   339			columns:   tui.Columns,
   340			minWidth:  tui.MinColumnWidth,
   341			refresh:   tui.Refresh,
   342			single:    tui.Single,
   343			archived:  p.app.Model.ShowArchived,
   344			reviewers: map[string]*string{},
