   530	// modelInputs turns a set of model fields into indented text inputs.
   531	// When one agent is shared by two scales or two roles they point at the same config entry, which is shown only once.
   532	func (p *optionsPanel) modelInputs(bind *formBinding, fields []menu.ModelField) []huh.Field {
   533		out := make([]huh.Field, 0, len(fields))
   534		for _, field := range fields {
   535			if _, ok := bind.modelSeen[field.Key()]; ok {
   536				continue
   537			}
   538			bind.modelSeen[field.Key()] = struct{}{}
   539			placeholder := field.Placeholder
   540			if placeholder == "" {
   541				placeholder = t("tui.empty_means_cli_default")
   542			}
   543			index := len(bind.modelFields)
   544			bind.modelFields = append(bind.modelFields, field)
   545			value := field.Value()
   546			bind.modelValues = append(bind.modelValues, &value)
   547			// Inline puts the title and the value on one line, compressing the block of one role/scale from 7 lines to 4.
   548			out = append(out, huh.NewInput().
   549				Title(modelIndent+field.Short+"  ").
   550				Prompt("").
   551				Inline(true).
   552				Placeholder(placeholder).
   553				Value(bind.modelValues[index]))
   554		}
   555		return out
   556	}
