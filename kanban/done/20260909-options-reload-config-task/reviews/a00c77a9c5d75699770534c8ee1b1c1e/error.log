   238	// build wraps and colors the lines at the given width and returns the actual line count.
   239	func (r *reportView) build(palette palette, width int) int {
   240		var body []string
   241		if r.extra != "" {
   242			for _, text := range wrapText(r.extra, width) {
   243				body = append(body, styleFor("popup-ok", palette).Render(text))
   244			}
   245			if len(r.lines) > 0 {
   246				body = append(body, "")
   247			}
   248		}
   249		for _, line := range r.lines {
   250			style := styleFor(reportTag(line.Level), palette)
   251			for _, raw := range strings.Split(line.Text, "\n") {
   252				for _, text := range wrapText(raw, width) {
   253					body = append(body, style.Render(text))
   254				}
   255			}
   256		}
   257		if len(body) == 0 {
   258			body = append(body, styleFor("popup-dim", palette).Render(t("tui.no_output")))
   259		}
   260		r.view.SetContent(strings.Join(body, "\n"))
   261		r.width = width
   262		return len(body)
   263	}
