    98		want := `$env:KDR_0='"C:\tools\codex.cmd"'; & 'C:\tools\cmd.exe' '/c' '%KDR_0%'`
    99		if got != want {
   100			t.Fatalf("windows command\n got %q\nwant %q", got, want)
   101		}
