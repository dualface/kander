   252	func validateResumedAgent(plan LaunchPlan, outcome LaunchOutcome, session AgentSession, timeout float64) error {
   253		return validateResumedAgentReceipt(plan, outcome, session, timeout, nil)
   254	}
   255	
   256	func validateResumedAgentReceipt(plan LaunchPlan, outcome LaunchOutcome, session AgentSession, timeout float64, receipt func() (bool, error)) error {
   257		deadline := nowFn().Add(time.Duration(timeout * float64(time.Second)))
   258		for {
   259			if receipt != nil {
   260				consumed, err := receipt()
   261				if err != nil {
   262					return err
   263				}
   264				if consumed {
   265					return nil
   266				}
   267			}
   268			if plan.Launcher == "foreground" || plan.Launcher == "console" {
   269				if outcome.Poll != nil {
   270					if code := outcome.Poll(); code != nil {
   271						return launchError(
   272							"launch.resumed_agent_exited_during_the_liveness_observation_period_exit", itoa(*code),
   273						)
   274					}
   275				}
   276				if !nowFn().Before(deadline) {
   277					return nil
   278				}
   279				remaining := deadline.Sub(nowFn())
   280				d := notifyPollInterval
   281				if remaining < d {
   282					d = remaining
   283				}
   284				sleepFn(d)
   285				continue
   286			}
   287			remaining := deadline.Sub(nowFn())
   288			if remaining <= 0 {
   289				return launchError("launch.resumed_agent_liveness_check_timed_out")
   290			}
   291			ok := false
   292			if plan.Launcher == "herdr" {
   293				pane, err := probe.HerdrProbePane(plan.HerdrBin, outcome.Pane, remaining)
   294				if err == nil {
   295					ref := herdrSessionReference(pane)
   296					agent, _ := pane["agent"].(string)
   297					status, _ := pane["agent_status"].(string)
   298					if agent == session.Agent &&
   299						(session.Reference == "" || ref == "" || ref == session.Reference) &&
   300						(status == "idle" || status == "working" || status == "blocked") {
   301						ok = true
   302					}
   303				}
   304			} else if tmuxNotifyTarget(plan.Tmux, outcome.Pane, session, remaining) == nil {
   305				ok = true
   306			}
   307			if ok {
   308				return nil
   309			}
   310			if !nowFn().Before(deadline) {
   311				return launchError("launch.resumed_agent_liveness_check_timed_out")
   312			}
   313			remaining = deadline.Sub(nowFn())
   314			d := notifyPollInterval
   315			if remaining < d {
   316				d = remaining
   317			}
   318			sleepFn(d)
   319		}
   320	}
