   144	func rollbackLaunch(root string, moved board.Entry, originalState string, failure *LaunchFailure, originalText *string) error {
   145		var rollbackErrors []string
   146		if originalText != nil {
   147			if err := board.RollbackDocument(root, moved, *originalText, originalState); err != nil {
   148				rollbackErrors = append(rollbackErrors, t("launch.failed_to_restore_document", err.Error()))
   149			}
   150		}
   151		primary := failure.Err
   152		if len(rollbackErrors) > 0 {
   153			msg := t(
   154				"launch.start_and_rollback_both_failed_task_remains_in", moved.State, primary.Error(),
   155			)
   156			extras := []string{}
   157			if failure.CloseError != "" {
   158				extras = append(extras, failure.CloseError)
   159			}
   160			extras = append(extras, rollbackErrors...)
   161			return launchError(msg+joinSemi(extras), msg+joinSemi(extras))
   162		}
   163		if failure.CloseError != "" {
   164			return launchError("launch.value", primary.Error(), failure.CloseError)
   165		}
   166		return primary
   167	}
