    17	// fakeHerdrLaunchSource answers only the three subcommands launchAgent uses and
    18	// writes whatever `pane run` receives verbatim to FAKE_HERDR_RUN_LOG. It is
    19	// compiled to a binary rather than written as a /bin/sh script so this path runs
    20	// on Windows too.
    21	const fakeHerdrLaunchSource = `package main
    22	
    23	import (
    24		"encoding/json"
    25		"fmt"
    26		"os"
    27	)
    28	
    29	func main() {
    30		args := os.Args[1:]
    31		if len(args) >= 2 && args[0] == "tab" && args[1] == "create" {
    32			payload, _ := json.Marshal(map[string]any{
    33				"result": map[string]any{
    34					"tab":       map[string]any{"tab_id": "w1:t7"},
    35					"root_pane": map[string]any{"pane_id": "w1:p7"},
    36				},
    37			})
    38			fmt.Println(string(payload))
    39			return
    40		}
    41		if len(args) >= 2 && args[0] == "pane" && args[1] == "wait-output" {
    42			return
    43		}
    44		if len(args) >= 4 && args[0] == "pane" && args[1] == "run" {
    45			os.WriteFile(os.Getenv("FAKE_HERDR_RUN_LOG"), []byte(args[3]), 0o644)
    46			return
    47		}
    48		fmt.Fprintln(os.Stderr, "unexpected herdr args")
    49		os.Exit(1)
    50	}
    51	`
    52	
    53	func buildFakeHerdrLauncher(t *testing.T) string {
    54		t.Helper()
    55		dir := t.TempDir()
    56		source := filepath.Join(dir, "main.go")
    57		if err := os.WriteFile(source, []byte(fakeHerdrLaunchSource), 0o644); err != nil {
    58			t.Fatal(err)
    59		}
    60		name := "herdr"
    61		if runtime.GOOS == "windows" {
    62			name += ".exe"
    63		}
    64		binary := filepath.Join(dir, name)
    65		build := exec.Command("go", "build", "-o", binary, source)
    66		build.Dir = dir
    67		if out, err := build.CombinedOutput(); err != nil {
    68			t.Fatalf("build fake herdr: %v %s", err, out)
    69		}
    70		return binary
    71	}
