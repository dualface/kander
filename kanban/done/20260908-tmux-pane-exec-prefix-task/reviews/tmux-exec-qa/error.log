   243	func validateLivenessTimeout(timeout float64, command string) error {
   244		if math.IsNaN(timeout) || math.IsInf(timeout, 0) || timeout <= 60 {
   245			return launchError(
   246				"launch.timeout_must_be_a_finite_number_greater_than_60", command,
