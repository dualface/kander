   134	// start through herdr must build the invocation in shell form: on Windows only
   135	// cmd.exe's %VAR% form restores argv verbatim, and handing argv straight to
   136	// PowerShell loses embedded double quotes.
   137	// This case watches whether the real call sites use launchInvocation, not
   138	// launchInvocation itself.
   139	func TestCommandStartUsesShellInvocationForHerdr(t *testing.T) {
