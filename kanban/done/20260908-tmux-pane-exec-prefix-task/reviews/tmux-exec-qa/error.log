   154			shell++
   155			return process.NewShellInvocation(p, a, e)
   156		}
   157		newInvocation = func(p process.AgentProgram, a []string, e map[string]string) (process.ProcessInvocation, error) {
   158			direct++
   159			return process.NewProcessInvocation(p, a, e)
   160		}
   161	
