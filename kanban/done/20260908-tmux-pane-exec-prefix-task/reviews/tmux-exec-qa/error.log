    19	func resolveStartLauncher(launcher string) (string, error) {
    20		if launcher != "auto" {
    21			return launcher, nil
    22		}
    23		if os.Getenv("HERDR_ENV") == "1" {
    24			return "herdr", nil
    25		}
    26		if runtimeWindows() {
    27			// Native Windows has no tmux, so auto can only resolve to herdr.
    28			return "", launchError(
    29				"launch.auto_cannot_be_resolved_not_in_herdr_on_windows",
    30			)
    31		}
    32		if os.Getenv("TMUX") != "" {
    33			return "tmux", nil
    34		}
    35		return "", launchError(
    36			"launch.auto_cannot_be_resolved_not_currently_in_herdr_or",
    37		)
    38	}
    39	
    40	func prepareLaunch(launcher, project, command string) (LaunchPlan, error) {
    41		// herdr has a native Windows build; only tmux is still POSIX-only.
    42		if runtimeWindows() && (launcher == "tmux" || launcher == "tmux-session") {
    43			return LaunchPlan{}, launchError(
    44				"launch.windows_does_not_support_the_launcher_use_console_or", launcher,
    45			)
    46		}
    47		resolved, err := resolveStartLauncher(launcher)
    48		if err != nil {
    49			return LaunchPlan{}, err
    50		}
    51		plan := LaunchPlan{Launcher: resolved, Project: project}
    52		switch resolved {
    53		case "tmux", "tmux-session":
    54			tmux, err := lookPath("tmux")
    55			if err != nil {
    56				return LaunchPlan{}, launchError("launch.tmux_is_not_in_path_run_kander_welcome_to")
    57			}
    58			plan.Tmux = tmux
    59			if resolved == "tmux" {
    60				session, err := tmuxSessionID(tmux)
    61				if err != nil {
    62					return LaunchPlan{}, err
    63				}
    64				plan.Session = session
    65			} else {
    66				session, exists, err := resolveProjectSession(tmux, project)
    67				if err != nil {
    68					return LaunchPlan{}, err
    69				}
    70				plan.Session = session
    71				plan.SessionExists = exists
    72			}
    73		case "herdr":
    74			if os.Getenv("HERDR_ENV") != "1" {
    75				return LaunchPlan{}, launchError(
    76					"launch.not_currently_in_herdr_the_herdr_launcher_requires_herdr",
    77				)
    78			}
    79			herdr, err := lookPath("herdr")
    80			if err != nil {
    81				return LaunchPlan{}, launchError(
    82					"launch.herdr_is_not_in_path_run_kander_welcome_to",
    83				)
    84			}
    85			plan.HerdrBin = herdr
