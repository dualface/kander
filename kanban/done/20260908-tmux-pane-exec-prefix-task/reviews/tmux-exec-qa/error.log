   122	func trimNL(s string) string {
   123		for len(s) > 0 && (s[len(s)-1] == '\n' || s[len(s)-1] == '\r') {
   124			s = s[:len(s)-1]
   125		}
   126		return s
   127	}
   128	
   129	func splitTab(s string) []string {
   130		out := []string{}
   131		cur := ""
   132		for i := 0; i < len(s); i++ {
   133			if s[i] == '\t' {
   134				out = append(out, cur)
   135				cur = ""
   136				continue
   137			}
   138			cur += string(s[i])
   139		}
   140		out = append(out, cur)
   141		return out
   142	}
