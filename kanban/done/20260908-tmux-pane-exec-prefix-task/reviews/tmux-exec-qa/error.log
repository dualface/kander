   322	func resumedAgentFailureOutput(plan LaunchPlan, outcome LaunchOutcome) string {
   323		var res cmdResult
   324		var err error
   325		if plan.Launcher == "herdr" && outcome.Pane != "" {
   326			res, err = herdrCapture(plan.HerdrBin, []string{"pane", "read", outcome.Pane}, probe.DefaultCommandTimeout)
   327		} else if (plan.Launcher == "tmux" || plan.Launcher == "tmux-session") && outcome.Pane != "" {
   328			res, err = runCaptured(plan.Tmux, []string{"capture-pane", "-p", "-t", outcome.Pane}, probe.DefaultCommandTimeout)
   329		} else {
   330			return ""
   331		}
   332		if err != nil || res.Code != 0 {
   333			return ""
   334		}
   335		output := trimNL(res.Stdout)
   336		if len(output) > resumeOutputLimit {
   337			output = output[len(output)-resumeOutputLimit:]
   338		}
   339		return output
   340	}
