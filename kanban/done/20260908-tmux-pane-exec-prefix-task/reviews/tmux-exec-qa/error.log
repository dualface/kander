   342	func cleanupFailedResume(plan LaunchPlan, outcome LaunchOutcome) error {
   343		var cleanup string
   344		if plan.Launcher == "herdr" && outcome.Tab != "" {
   345			cleanup = herdrCloseTab(plan.HerdrBin, outcome.Tab)
   346		} else if (plan.Launcher == "tmux" || plan.Launcher == "tmux-session") && outcome.Window != "" {
   347			cleanup = tmuxCloseWindow(plan.Tmux, outcome.Window)
   348		} else if outcome.Process != nil && outcome.Poll != nil && outcome.Poll() == nil {
   349			_ = terminateProcess(outcome.Process)
   350			waited := make(chan struct{})
   351			go func() {
   352				if outcome.Wait != nil {
   353					_, _ = outcome.Wait()
   354				}
   355				close(waited)
   356			}()
   357			select {
   358			case <-waited:
   359			case <-time.After(5 * time.Second):
   360				_ = killProcess(outcome.Process)
   361			}
   362		}
   363		if cleanup != "" {
   364			return launchError(
   365				"launch.cleanup_after_failed_resume_failed_the_new_agent_may", cleanup,
   366			)
   367		}
   368		return nil
   369	}
