   347	// paneLauncher reports whether this launcher hands the agent to a terminal
   348	// container's shell, which parses the single-line command back into argv.
   349	func paneLauncher(launcher string) bool {
   350		return launcher == "herdr" || launcher == "tmux" || launcher == "tmux-session"
   351	}
   352	
   353	// launchInvocation picks the invocation form by launcher: a terminal container
   354	// only takes one line, so argv has to survive being parsed by a shell again;
   355	// foreground and console spawn directly and keep native argv.
   356	func launchInvocation(plan LaunchPlan, program process.AgentProgram, arguments []string) (process.ProcessInvocation, error) {
   357		if paneLauncher(plan.Launcher) {
   358			return newShellInvocation(program, arguments, nil)
   359		}
   360		return newInvocation(program, arguments, nil)
   361	}
   362	
   363	// paneCommand renders one process invocation as a single line the terminal
   364	// container's shell can run. POSIX containers are sh-like; a herdr pane on
   365	// Windows runs PowerShell, where a quoted executable path only runs behind the
   366	// call operator & — otherwise the shell just prints the line back and the agent
   367	// never starts. Argv carried in ShellEnv variables has to be assigned back in
   368	// the pane first.
   369	// This assumes the container shell is PowerShell on Windows (herdr's default)
   370	// and sh-like on POSIX. If a user points herdr's default_shell at cmd or
   371	// git-bash the line comes out wrong; the container only types the text in, it
   372	// never reports an error.
   373	func paneCommand(inv process.ProcessInvocation) (string, error) {
   374		for _, value := range inv.Argv {
   375			if err := rejectPaneControlChars(value); err != nil {
   376				return "", err
   377			}
   378		}
   379		for _, value := range inv.ShellEnv {
   380			if err := rejectPaneControlChars(value); err != nil {
   381				return "", err
   382			}
   383		}
   384		if !runtimeWindows() {
   385			return posixJoin(inv.Argv), nil
   386		}
   387		return powershellJoin(inv.Argv, inv.ShellEnv), nil
   388	}
   389	
   390	// rejectPaneControlChars: a terminal container treats the command as one typed
   391	// line plus Enter, so a bare newline submits early and turns the remainder into
   392	// a second command. Failing to start beats sending half a command.
   393	func rejectPaneControlChars(value string) error {
   394		if strings.ContainsAny(value, "\r\n\x00") {
   395			return launchError("launch.agent_command_contains_a_control_character")
   396		}
   397		return nil
   398	}
   399	
   400	func powershellJoin(argv []string, shellEnv map[string]string) string {
   401		if len(argv) == 0 {
   402			return ""
   403		}
   404		parts := make([]string, 0, len(shellEnv)+len(argv)+1)
   405		names := make([]string, 0, len(shellEnv))
   406		for name := range shellEnv {
   407			names = append(names, name)
   408		}
   409		sort.Strings(names)
   410		for _, name := range names {
   411			parts = append(parts, "$env:"+name+"="+powershellQuote(shellEnv[name])+";")
   412		}
   413		parts = append(parts, "&")
   414		for _, a := range argv {
   415			parts = append(parts, powershellQuote(a))
   416		}
   417		return strings.Join(parts, " ")
   418	}
   419	
   420	// powershellQuote always single-quotes: a PowerShell single-quoted string is
   421	// literal, and an inner single quote is escaped by doubling it.
   422	func powershellQuote(s string) string {
   423		return "'" + strings.ReplaceAll(s, "'", "''") + "'"
   424	}
   425	
   426	func posixJoin(argv []string) string {
   427		parts := make([]string, len(argv))
   428		for i, a := range argv {
   429			parts[i] = posixQuote(a)
   430		}
   431		return strings.Join(parts, " ")
   432	}
   433	
   434	func posixQuote(s string) string {
   435		if s == "" {
   436			return "''"
   437		}
   438		if regexp.MustCompile(`^[A-Za-z0-9_./:=+-]+$`).MatchString(s) {
   439			return s
   440		}
   441		return "'" + strings.ReplaceAll(s, "'", `'"'"'`) + "'"
   442	}

