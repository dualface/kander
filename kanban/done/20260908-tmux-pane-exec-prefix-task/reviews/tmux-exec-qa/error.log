    73	// launchAgent must hand the exact line paneCommand rendered to herdr pane run.
    74	// A Windows pane runs PowerShell, where POSIX-style quoting is printed back
    75	// verbatim and the agent never starts.
    76	func TestLaunchAgentSendsShellSpecificCommandToHerdr(t *testing.T) {
    77		resetLang(t)
    78		binary := buildFakeHerdrLauncher(t)
    79		log := filepath.Join(t.TempDir(), "run.txt")
    80		t.Setenv("FAKE_HERDR_RUN_LOG", log)
    81		t.Cleanup(func() { runtimeWindows = func() bool { return isWindowsGOOS() } })
    82	
    83		plan := LaunchPlan{Launcher: "herdr", HerdrBin: binary, HerdrWorkspace: "w1"}
    84		invocation := process.ProcessInvocation{
    85			Argv:     []string{`C:\tools\cmd.exe`, "/c", "%KDR_0%"},
    86			ShellEnv: map[string]string{"KDR_0": `"C:\tools\codex.cmd"`},
    87		}
    88	
    89		runtimeWindows = func() bool { return true }
