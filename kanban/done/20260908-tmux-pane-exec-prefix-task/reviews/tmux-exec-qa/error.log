func parentDir(p string) string {
	dir := p
	if i := lastSlash(dir); i >= 0 {
		return dir[:i]
	}
	return dir
}

func lastSlash(p string) int {
	i := strings.LastIndex(p, "/")
	j := strings.LastIndex(p, `\`)
	if j > i {
		return j
	}
	return i
}

