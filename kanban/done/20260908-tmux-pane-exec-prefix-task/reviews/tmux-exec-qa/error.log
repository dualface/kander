   171	// launchInvocation is the only place allowed to call newInvocation directly: the
   172	// three agent launch points (start / resume / notify recovery) must route through
   173	// it so the form follows the launcher, or a Windows herdr pane goes back to
   174	// receiving native argv that PowerShell cannot reassemble.
   175	// Watching that invariant with the AST is cheaper than writing one integration
   176	// case per call site.
   177	func TestOnlyLaunchInvocationCallsNewInvocation(t *testing.T) {
   178		files := token.NewFileSet()
   179		entries, err := os.ReadDir(".")
   180		if err != nil {
   181			t.Fatal(err)
   182		}
   183		found := 0
   184		for _, entry := range entries {
   185			name := entry.Name()
   186			if entry.IsDir() || !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
   187				continue
   188			}
   189			parsed, err := parser.ParseFile(files, name, nil, 0)
   190			if err != nil {
   191				t.Fatal(err)
   192			}
   193			for _, decl := range parsed.Decls {
   194				fn, ok := decl.(*ast.FuncDecl)
   195				if !ok {
   196					continue
   197				}
   198				ast.Inspect(fn, func(node ast.Node) bool {
   199					call, ok := node.(*ast.CallExpr)
   200					if !ok {
   201						return true
   202					}
   203					var name string
   204					switch fun := call.Fun.(type) {
   205					case *ast.Ident:
   206						name = fun.Name
   207					case *ast.SelectorExpr:
   208						// Bypassing the package variable and calling process.NewProcessInvocation directly breaks the invariant too.
   209						if qualifier, ok := fun.X.(*ast.Ident); ok && qualifier.Name == "process" {
   210							name = fun.Sel.Name
   211						}
   212					}
   213					if name != "newInvocation" && name != "NewProcessInvocation" {
   214						return true
   215					}
   216					found++
   217					// cursorCreateChat spawns create-chat in place and reads its output; it
   218					// never goes through a terminal container, so native argv is correct.
   219					if fn.Name.Name != "launchInvocation" && fn.Name.Name != "cursorCreateChat" {
   220						t.Errorf("%s: %s 直接调用了 newInvocation, 应改用 launchInvocation",
   221							files.Position(call.Pos()), fn.Name.Name)
   222					}
   223					return true
   224				})
   225			}
   226		}
   227		if found == 0 {
   228			t.Fatal("没有找到 newInvocation 的调用, 断言失效")
   229		}
   230	}
