   168	func projectSessionName(project string) string {
   169		base := filepathBase(project)
   170		var b strings.Builder
   171		for _, r := range base {
   172			if !unicode.IsPrint(r) {
   173				continue
   174			}
   175			if unicode.IsSpace(r) || r == '.' || r == ':' {
   176				b.WriteByte('-')
   177				continue
   178			}
   179			b.WriteRune(r)
   180		}
   181		label := strings.Trim(b.String(), "-")
   182		label = regexp.MustCompile(`-{2,}`).ReplaceAllString(label, "-")
   183		sum := sha256.Sum256([]byte(project))
   184		digest := hex.EncodeToString(sum[:])[:8]
   185		if label == "" {
   186			return "kb-" + digest
   187		}
   188		if len([]rune(label)) > 30 {
   189			label = string([]rune(label)[:30])
   190		}
   191		return "kb-" + label + "-" + digest
   192	}
