func (a *App) handleBoardClick(x, y, bstate int) {
	h, w := a.size()
	if h < minBoardHeight || w < 1 {
		return
	}
	if y == headerRow {
		a.Searching = true
		a.ShowCursor = true
		return
	}
	if y >= h-1 {
		return
	}
	hit := a.hitBoard(x, y)
	if hit == nil {
		return
	}
	switch hit.Kind {
	case "nav":
		a.Model.MoveColumn(hit.Delta)
	case "column":
		a.Model.FocusState(hit.State)
	case "task":
		a.Model.SelectTaskIndex(hit.State, hit.Index)
		if mouseLeftDoubleClicked(bstate) {
			a.openDetail()
		}
	}
}

