		a.Options.HandleMouse(x, y, bstate)
		return
	}
	if a.Detail != nil {
		a.handleDetailMouse(x, y, bstate)
		return
	}
	if a.Searching {
		a.handleSearchMouse(x, y, bstate)
		return
	}
	a.handleBoardMouse(x, y, bstate)
}

