    32				b := coordinatorTodo(t, root, "waiting")
    33				c := coordinatorClaim(t, root, a.Entry.TaskID, b.Entry.TaskID)
    34				if !c.Members[b.Entry.TaskID].AwaitingStart {
    35					t.Fatal("todo member has no explicit waiting state")
    36				}
    37				history := control(root, "groups", c.GroupID, "checkpoints", "1.json")
    38				original, err := os.ReadFile(history)
    39				if err != nil {
    40					t.Fatal(err)
    41				}
    42				if _, err = MoveWithOptions(b.Entry, root, "working", MoveOptions{Owner: "codex"}); err != nil {
    43					t.Fatal(err)
    44				}
    45				if fast {
    46					s := transactionSnapshot(t, root, b.Entry.TaskID)
    47					if _, err = MoveEntry(s.Entry, root, "review"); err != nil {
    48						t.Fatal(err)
    49					}
    50				}
