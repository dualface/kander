   186	// ClaimCoordinator creates a checkpoint or explicitly fences an earlier writer
   187	// under group CAS. Replaying an identical claim preserves its epoch and cursor.
   188	func ClaimCoordinator(ctx context.Context, root string, r CoordinatorClaim) (c CoordinatorCheckpoint, err error) {
   189		ids, err := orderedIDs(r.Members, false)
   190		if err != nil {
   191			return c, err
   192		}
   193		if len(ids) == 0 || len(ids) != len(r.Members) || strings.TrimSpace(r.Owner) == "" || !validDispatchID(r.Token) || strings.TrimSpace(r.Basis) == "" {
   194			return c, coordinatorError("claim identity, basis or members")
   195		}
   196		r.Members = ids
   197		err = WithTransactionContext(ctx, root, LockScope{Groups: []string{r.GroupID}, Tasks: ids, ExclusiveBoard: true}, func(tx *Transaction) error {
   198			if err := ctx.Err(); err != nil {
   199				return err
   200			}
   201			var exists bool
   202			c, exists, err = readCheckpoint(tx, r.GroupID)
   203			if err != nil {
   204				return err
   205			}
   206			if exists && c.ClaimHash == coordinatorHash(r) {
   207				return nil
   208			}
   209			if c.Revision != r.ExpectedRevision || c.Authority.Epoch != r.ExpectedEpoch || c.Revision == ^uint64(0) || c.Authority.Epoch == ^uint64(0) || exists && c.Authority.Token == r.Token {
   210				return coordinatorError("claim CAS or reused token")
   211			}
   212			if exists && !slices.Equal(checkpointIDs(c), ids) {
   213				return coordinatorError("claim cannot change membership")
   214			}
   215			if err := coordinatorMembership(tx, r.GroupID, ids); err != nil {
   216				return err
   217			}
   218			if !exists {
   219				c = CoordinatorCheckpoint{Schema: 1, GroupID: r.GroupID, MemberVersion: coordinatorHash(ids), Members: map[string]CoordinatorMember{}}
   220			}
   221			for _, id := range ids {
   222				if _, ok := c.Members[id]; ok {
   223					continue
   224				}
   225				s, e := tx.Snapshot(id)
   226				if e != nil {
   227					return e
   228				}
   229				c.Members[id] = CoordinatorMember{Revision: s.Revision, Cycle: planCycle(s), State: s.Entry.State, AwaitingStart: MetadataFrom(s.Text, FieldStartedAt) == "" && (s.Entry.State == "todo" || s.Entry.State == "backlog")}
   230			}
   231			c.Revision++
   232			c.Authority = CoordinatorAuthority{Owner: r.Owner, Token: r.Token, Epoch: c.Authority.Epoch + 1}
   233			c.ClaimHash, c.LastRequestHash, c.Basis = coordinatorHash(r), "", r.Basis
   234			return putCheckpoint(tx, &c)
   235		})
   236		return
   237	}
   238	
   239	// coordinatorMembership runs under the exclusive board lock. This freezes
   240	// topology while metadata is read and rejects partial or ambiguous membership.
   241	func coordinatorMembership(tx *Transaction, group string, ids []string) error {
   242		b, err := scan(tx.root)
   243		if err != nil {
   244			return err
   245		}
   246		if len(b.Problems) != 0 {
   247			return coordinatorError("board membership integrity")
   248		}
   249		actual := []string{}
   250		for id, entry := range b.Entries {
   251			text, e := readDocument(entry)
   252			if e != nil {
   253				return e
   254			}
   255			if TaskGroupFrom(text) == group {
   256				actual = append(actual, id)
   257			}
   258		}
   259		slices.Sort(actual)
   260		if !slices.Equal(actual, ids) {
   261			return coordinatorError("group membership changed; reconcile the explicit member set")
   262		}
   263		return nil
   264	}
   265	
   266	// ReconcileCoordinator uses the same path for snapshots and every later event.
   267	// The verifier is the Git-aware consumer; it must be read-only and must not
   268	// reenter board APIs while this transaction holds the declared locks.
   269	func ReconcileCoordinator(ctx context.Context, root string, r CoordinatorReconcile, verify func(context.Context, CoordinatorGitFacts) error) (c CoordinatorCheckpoint, err error) {
   270		ids := make([]string, 0, len(r.Members))
   271		for id := range r.Members {
   272			ids = append(ids, id)
   273		}
   274		slices.Sort(ids)
   275		if len(ids) == 0 {
   276			return c, coordinatorError("members required")
   277		}
   278		err = WithTransactionContext(ctx, root, LockScope{Groups: []string{r.GroupID, reviewControlGroup, dispatchRegistry}, Tasks: ids, ExclusiveBoard: true}, func(tx *Transaction) error {
   279			var exists bool
   280			c, exists, err = readCheckpoint(tx, r.GroupID)
   281			if err != nil {
   282				return err
   283			}
   284			if !exists || c.Authority != r.Authority {
   285				return coordinatorError("stale coordinator authority")
   286			}
   287			if c.Revision != r.ExpectedRevision {
   288				if c.LastRequestHash != coordinatorHash(r) {
   289					return coordinatorError("checkpoint CAS")
   290				}
   291				// A lost response may retry the same request, but evidence is still
   292				// revalidated before returning its existing result.
   293			}
   294			if !slices.Equal(ids, checkpointIDs(c)) {
   295				return coordinatorError("unknown or missing member")
   296			}
   297			if err := coordinatorMembership(tx, r.GroupID, ids); err != nil {
   298				return err
   299			}
   300			members := map[string]CoordinatorMember{}
   301			for _, id := range ids {
   302				if err := ctx.Err(); err != nil {
   303					return err
   304				}
   305				m, e := reconcileCoordinatorMember(ctx, tx, id, c.Members[id], r.Members[id], verify)
   306				if e != nil {
   307					return e
   308				}
   309				members[id] = m
   310			}
   311			if reflect.DeepEqual(c.Members, members) {
   312				return nil
   313			}
   314			if c.Revision == ^uint64(0) {
   315				return coordinatorError("checkpoint revision overflow")
   316			}
   317			c.Revision++
   318			c.Members, c.LastRequestHash = members, coordinatorHash(r)
   319			return putCheckpoint(tx, &c)
   320		})
   321		return
   322	}

