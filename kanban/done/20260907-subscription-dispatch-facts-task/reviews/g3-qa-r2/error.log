   151	func coordinatorDispatchAdvance(tx *Transaction, id string, old CoordinatorDispatch, d Dispatch) error {
   152		if old.ID != d.Input.ID {
   153			previous, err := readDispatch(tx, id, old.ID)
   154			if err != nil {
   155				return err
   156			}
   157			if previous.Authorization.Epoch < old.Epoch || !coordinatorDispatchTerminal(previous.State) {
   158				return coordinatorError("unfinished previous dispatch: " + id)
   159			}
   160			return nil
   161		}
   162		if old.Epoch == d.Authorization.Epoch {
   163			if d.Revision < old.Revision || coordinatorDispatchTerminal(old.State) && d.State != old.State {
   164				return coordinatorError("dispatch facts regressed: " + id)
   165			}
   166			return nil
   167		}
   168		if old.Epoch > d.Authorization.Epoch {
   169			return coordinatorError("old execution epoch: " + id)
   170		}
   171		// Only the dispatch producer can archive and fence an earlier grant. Merely
   172		// observing a newer epoch value is insufficient; consume that exact original.
   173		raw, err := tx.Read(id, dispatchPath(d.Input.ID, "execution-"+strconv.FormatUint(old.Epoch, 10)))
   174		if err != nil {
   175			return err
   176		}
   177		var previous Dispatch
   178		if json.Unmarshal([]byte(raw), &previous) != nil || previous.Authorization != (ExecutionAuthorization{DispatchID: old.ID, Epoch: old.Epoch}) || !reflect.DeepEqual(previous.Input, d.Input) {
   179			return coordinatorError("missing fenced execution original: " + id)
   180		}
   181		return nil
   182	}
   183	
   184	func coordinatorDispatchTerminal(state DispatchState) bool {
   185		return state == DispatchCompleted || state == DispatchFailed || state == DispatchCancelled
   186	}

