   172	
   173	// ReadCoordinatorCheckpointContext bounds contention during recovery reads.
   174	func ReadCoordinatorCheckpointContext(ctx context.Context, root, group string) (c CoordinatorCheckpoint, err error) {
   175		err = WithTransactionContext(ctx, root, LockScope{Groups: []string{group}, ReadOnly: true}, func(tx *Transaction) error {
   176			var exists bool
   177			c, exists, err = readCheckpoint(tx, group)
   178			if err == nil && !exists {
   179				return coordinatorError("checkpoint missing")
   180			}
   181			return err
   182		})
   183		return
   184	}
