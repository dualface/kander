    52				// waiting cursor until the same snapshot path proves the first start.
    53				c, err = ClaimCoordinator(context.Background(), root, CoordinatorClaim{GroupID: c.GroupID, ExpectedRevision: c.Revision, ExpectedEpoch: c.Authority.Epoch, Owner: "restarted", Token: "restart", Basis: "恢复编排", Members: checkpointIDs(c)})
    54				if err != nil {
