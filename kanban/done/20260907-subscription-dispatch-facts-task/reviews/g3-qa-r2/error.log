   167	// ReadCoordinatorCheckpoint reads only a committed cursor; pending transactions
   168	// fail explicitly and require the existing init maintenance protocol.
   169	func ReadCoordinatorCheckpoint(root, group string) (c CoordinatorCheckpoint, err error) {
