    15	func launchAgent(
    16		plan LaunchPlan,
    17		root string,
    18		name string,
    19		invocation process.ProcessInvocation,
    20		location func(LaunchOutcome) error,
    21		paneSession func() (AgentSession, error),
    22		agentSession *AgentSession,
    23		durable ...bool,
    24	) (LaunchOutcome, error) {
    25		var createdTab, createdWindow string
    26		sendAttempted := false
    27		fail := func(err error) error {
    28			if sendAttempted && len(durable) > 0 && durable[0] {
    29				return &LaunchFailure{Err: err, DeliveryUnknown: true}
    30			}
    31			var closeErr string
    32			if createdTab != "" {
    33				closeErr = herdrCloseTab(plan.HerdrBin, createdTab)
    34			} else if plan.Tmux != "" {
    35				closeErr = tmuxCloseWindow(plan.Tmux, createdWindow)
    36			}
    37			return &LaunchFailure{Err: err, CloseError: closeErr}
    38		}
    39		if plan.Launcher == "foreground" || plan.Launcher == "console" {
    40			handle, err := startProcessFn(invocation.Argv, invocation.Env, filepath.Dir(root), plan.Launcher == "console")
    41			if err != nil {
    42				return LaunchOutcome{}, fail(launchError("launch.failed_to_start_agent", err.Error()))
    43			}
    44			return LaunchOutcome{Process: handle.proc, Wait: handle.Wait, Poll: handle.Poll}, nil
    45		}
    46		command, err := paneCommand(invocation)
    47		if err != nil {
    48			return LaunchOutcome{}, fail(err)
    49		}
    50		if plan.Launcher == "herdr" {
    51			tab, pane, err := herdrCreateTab(plan.HerdrBin, plan.HerdrWorkspace, filepath.Dir(root), name)
    52			if err != nil {
    53				return LaunchOutcome{}, fail(err)
    54			}
    55			createdTab = tab
    56			if err := herdrWaitPaneReady(plan.HerdrBin, pane); err != nil {
    57				return LaunchOutcome{}, fail(err)
    58			}
    59			outcome := LaunchOutcome{Tab: tab, Pane: pane}
    60			if location != nil {
    61				if err := location(outcome); err != nil {
    62					return LaunchOutcome{}, fail(err)
    63				}
    64			}
    65			sendAttempted = true
    66			if err := herdrPaneRun(plan.HerdrBin, pane, command); err != nil {
    67				return LaunchOutcome{}, fail(err)
    68			}
    69			if agentSession != nil {
    70				reportHerdrAgentSession(plan.HerdrBin, pane, *agentSession)
    71			}
    72			return outcome, nil
    73		}
    74		create := plan.Launcher == "tmux-session" && !plan.SessionExists
    75		result := tmuxLaunch(plan.Tmux, plan.Session, create, filepath.Dir(root), name)
    76		if create && result.Code != 0 {
    77			owner, exists := sessionOwner(plan.Tmux, plan.Session)
    78			if exists && (owner == "" || owner == plan.Project) {
    79				create = false
    80				result = tmuxLaunch(plan.Tmux, plan.Session, false, filepath.Dir(root), name)
    81			}
    82		}
    83		if result.Code != 0 {
    84			sub := "new-window"
    85			if create {
    86				sub = "new-session"
    87			}
    88			detail := orExit(trimNL(result.Stderr), result.Code)
    89			return LaunchOutcome{}, fail(launchError("launch.tmux_failed", sub, detail))
    90		}
    91		locationParts := splitTab(trimNL(result.Stdout))
    92		if len(locationParts) != 2 || locationParts[0] == "" || locationParts[1] == "" {
    93			return LaunchOutcome{}, fail(launchError("launch.tmux_launch_failed_window_pane_id_was_not_returned"))
    94		}
    95		window, pane := locationParts[0], locationParts[1]
    10	)
