    12	func TestCoordinatorCompletedFixSurvivesClosedBatchRestart(t *testing.T) {
    13		for _, damage := range []string{"author", "report", "closure", "assignment"} {
    14			t.Run(damage, func(t *testing.T) {
    15				root, c, in, run, record := coordinatorAdvancedFix(t)
    16				roles := map[string]ReviewRoleConclusion{}
    17				for _, role := range []string{"PM", "QA"} {
    18					input := archiveInput([]string{in.TaskID}, "passing-"+strings.ToLower(role), role)
    19					input.Commit = record.FixCommit
    20					if role == "PM" {
    21						input.PreviousRunID, input.ReviewedCommit = run.RunID, run.Commit
    22					}
    23					passing := gateRun(t, root, input, emptyFindings())
    24					assignGate(t, root, passing, map[string][]string{})
    25					roles[role] = passRole(passing)
    26				}
    27				if _, err := gateClose(t, root, roles); err != nil {
    28					t.Fatal(err)
    29				}
    30				// There is deliberately no wrap-up intent. Restart from the persisted
    31				// pre-closure checkpoint and the still-current completed fix receipt.
    32				c, err := ReadCoordinatorCheckpoint(root, c.GroupID)
    33				if err != nil {
    34					t.Fatal(err)
    35				}
    36				r := coordinatorRequest(t, root, c)
    37				next, err := ReconcileCoordinator(context.Background(), root, r, nil)
    38				if err != nil {
    39					t.Fatal("closed batch blocked historical completion", err)
    40				}
    41				m := next.Members[in.TaskID]
    42				if m.Review.Status != "closed" || m.DeliveryCommit != record.FixCommit || m.Dispatch.PendingDelivery || m.Dispatch.ID != in.ID {
    43					t.Fatal("closed history lost completed round", m)
    44				}
    45				before, err := operationRecords(root)
    46				if err != nil {
    47					t.Fatal(err)
    48				}
    49				for range 2 {
    50					replay, err := ReconcileCoordinator(context.Background(), root, r, nil)
    51					if err != nil || !reflect.DeepEqual(replay, next) {
    52						t.Fatal("duplicate changed closed cursor", err)
    53					}
    54				}
    55				after, err := operationRecords(root)
    56				if err != nil || len(before) != len(after) {
    57					t.Fatal("duplicate created transaction", err)
    58				}
    59				// Test the closed gate directly as well: old targets alone must not be
    60				// the reason creation and transport remain forbidden.
    61				if err = WithTransaction(root, reviewScope([]string{in.TaskID}, true), func(tx *Transaction) error {
    62					_, e := reviewRunForMutation(tx, run.RunID)
    63					return e
    64				}); err == nil {
    65					t.Fatal("closed run still mutable")
    66				}
    67				if err = ValidateDispatchEvidence(root, in.TaskID, in.ID); err == nil {
    68					t.Fatal("closed fix still sendable")
    69				}
    70				copy := in
    71				copy.ID = "another-fix"
    72				if _, err = PrepareDispatch(root, copy); err == nil {
    73					t.Fatal("closed fix recreated")
    74				}
    75				s := transactionSnapshot(t, root, in.TaskID)
    76				path := map[string]string{
    77					"author":     filepath.Join(s.Entry.Path, dispositionPath(record)),
    78					"report":     filepath.Join(s.Entry.Path, "reviews", run.RunID, "report.md"),
    79					"closure":    filepath.Join(s.Entry.Path, "reviews", "batches", run.BatchID, "closed.json"),
    80					"assignment": filepath.Join(s.Entry.Path, "reviews", run.RunID, "assignment.json"),
    81				}[damage]
    82				if err = os.Remove(path); err != nil {
    83					t.Fatal(err)
    84				}
    85				if _, err = ReconcileCoordinator(context.Background(), root, r, nil); err == nil {
    86					t.Fatal("damaged historical original accepted")
    87				}
    88				actual, err := ReadCoordinatorCheckpoint(root, c.GroupID)
    89				if err != nil || !reflect.DeepEqual(actual, next) {
    90					t.Fatal("damage changed cursor", err)
    91				}
    92			})
    93		}
    94	}
