    12	func TestCoordinatorRecoversStartRollbackAndRetry(t *testing.T) {
    13		if runtime.GOOS == "windows" {
    14			t.Skip("tmux fakes are POSIX")
    15		}
    16		for _, missRollback := range []bool{false, true} {
    17			t.Run(map[bool]string{false: "rollback-snapshot", true: "missed-rollback"}[missRollback], func(t *testing.T) {
    18				root, _, _ := setupBoard(t)
    19				const group = "20260908-start-rollback-group"
    20				ids := []string{}
    21				for _, slug := range []string{"running", "retry"} {
    22					id, _ := makeTodo(t, root, slug)
    23					ids = append(ids, id)
    24					s, err := board.ReadSnapshot(root, id)
    25					if err != nil {
    26						t.Fatal(err)
    27					}
    28					text := strings.Replace(s.Text, "- TASK_GROUP:", "- TASK_GROUP: "+group, 1)
    29					if err = board.WithTransaction(root, board.LockScope{Tasks: []string{id}}, func(tx *board.Transaction) error { return tx.Put(id, "spec.md", text) }); err != nil {
    30						t.Fatal(err)
    31					}
    32				}
    33				if _, _, err := capture(t, func() error { return commandStart(root, "claude", "tmux", ids[0]) }); err != nil {
    34					t.Fatal(err)
    35				}
    36				c, err := board.ClaimCoordinator(context.Background(), root, board.CoordinatorClaim{GroupID: group, Owner: "coordinator", Token: "first", Basis: "测试启动失败恢复", Members: ids})
    37				if err != nil {
    38					t.Fatal(err)
    39				}
    40				reconcile := func() {
    41					t.Helper()
    42					r := board.CoordinatorReconcile{GroupID: group, ExpectedRevision: c.Revision, Authority: c.Authority, Members: map[string]board.CoordinatorObservation{}}
    43					for _, id := range ids {
    44						s, e := board.ReadSnapshot(root, id)
    45						if e != nil {
    46							t.Fatal(e)
    47						}
    48						r.Members[id] = board.CoordinatorObservation{Revision: s.Revision}
    49					}
    50					c, err = ReconcileCoordinator(context.Background(), root, r)
    51					if err != nil {
    52						t.Fatal("recovery blocked", err)
    53					}
    54				}
    55				oldWrite := writeDocumentFn
    56				oldStamp := nowStamp
    57				nowStamp = func() string { return "2026-09-08 10:00" }
    58				t.Cleanup(func() { nowStamp = oldStamp })
    59				t.Cleanup(func() { writeDocumentFn = oldWrite })
    60				writeDocumentFn = func(root string, e board.Entry, text string) error {
    61					if err := oldWrite(root, e, text); err != nil {
    62						return err
    63					}
    64					// Deterministically observe committed metadata before the real
    65					// launcher executes and fails. No task mutation comes from polling.
    66					reconcile()
    67					if !c.Members[ids[1]].AwaitingStart {
    68						t.Fatal("unconfirmed launch bound the execution cycle")
    69					}
    70					return nil
    71				}
    72				t.Setenv("KANBAN_TMUX_FAIL", "1")
    73				if _, _, err = capture(t, func() error { return commandStart(root, "claude", "tmux", ids[1]) }); err == nil {
    74					t.Fatal("launcher failure not injected")
    75				}
    76				writeDocumentFn = oldWrite
    77				s, err := board.ReadSnapshot(root, ids[1])
    78				if err != nil || s.Entry.State != "todo" || board.MetadataFrom(s.Text, board.FieldStartedAt) != "" {
    79					t.Fatal("real rollback did not restore todo", err)
    80				}
    81				c, err = board.ReadCoordinatorCheckpoint(root, group)
    82				if err != nil {
    83					t.Fatal(err)
    84				}
    85				c, err = board.ClaimCoordinator(context.Background(), root, board.CoordinatorClaim{GroupID: group, ExpectedRevision: c.Revision, ExpectedEpoch: c.Authority.Epoch, Owner: "restarted", Token: "second", Basis: "测试重启", Members: ids})
    86				if err != nil {
    87					t.Fatal(err)
    88				}
    89				if !missRollback {
    90					reconcile()
    91				}
    92				t.Setenv("KANBAN_TMUX_FAIL", "")
    93				nowStamp = func() string { return "2026-09-08 10:01" }
    94				if _, _, err = capture(t, func() error { return commandStart(root, "claude", "tmux", ids[1]) }); err != nil {
    95					t.Fatal(err)
    96				}
    97				reconcile()
    98				if c.Members[ids[1]].AwaitingStart {
    99					t.Fatal("successful retry never confirmed")
   100				}
   101				revision := c.Revision
   102				reconcile()
   103				if c.Revision != revision {
   104					t.Fatal("repeat recovery changed cursor")
   105				}
   106			})
   107		}
   108	}

