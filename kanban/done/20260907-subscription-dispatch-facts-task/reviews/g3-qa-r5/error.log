   119			return putTaskStart(tx, a, "result")
   120		}
   121		return nil
   122	}
   123	
   124	// ConfirmTaskStart records launcher success without overwriting or revising task
   125	// work produced by a fast executor. The original operation cursor fences retries.
   126	func ConfirmTaskStart(root string, entry Entry) error {
   127		if entry.Version == nil {
   128			return coordinatorError("start cursor missing")
   129		}
   130		entry.Version.mu.Lock()
   131		defer entry.Version.mu.Unlock()
   132		return WithTransaction(root, LockScope{Groups: []string{taskStartGroup}, Tasks: []string{entry.TaskID}}, func(tx *Transaction) error {
   133			a, exists, err := readTaskStart(tx, entry.TaskID, "")
   134			if err != nil {
   135				return err
   136			}
   137			s, err := tx.Snapshot(entry.TaskID)
   138			if err != nil {
   139				return err
   140			}
   141			if !exists || a.Status == "rolled-back" || a.Revision > entry.Version.revision || a.Cycle != planCycle(s) || a.Owner != MetadataFrom(s.Text, FieldOwner) || a.Session != MetadataFrom(s.Text, FieldSession) {
   142				return coordinatorError("start success binding")
   143			}
   144			if a.Status == "succeeded" {
   145				return nil
   146			}
   147			a.Status, a.FinishedRevision = "succeeded", s.Revision
   148			return putTaskStart(tx, a, "result")
   149		})
   150	}
