    75	func TestReviewRolesAndStageOrder(t *testing.T) {
    76		for shift := 0; shift < 3; shift++ {
    77			cfg := config.DefaultConfig()
    78			for i, role := range config.ReviewRoles {
    79				cfg.ReviewStages[role] = []string{"required", "auto", "skip"}[(i+shift)%3]
    80				cfg.Reviewers[role] = "reviewer-" + role
    81			}
    82			seen := map[string]int{}
    83			stage := ""
    84			for _, line := range Build(cfg) {
    85				if line.Key == "flow.stage_one" || line.Key == "flow.stage_two" {
    86					stage = line.Key
    87				}
    88				if line.Key != "flow.role_auto" && line.Key != "flow.role_required" {
    89					continue
    90				}
    91				role := line.Args[0].(string)
    92				seen[role]++
    93				if line.Key != "flow.role_"+cfg.ReviewStages[role] || line.Args[1] != cfg.Reviewers[role] {
    94					t.Fatalf("wrong policy/reviewer: %+v", line)
    95				}
    96				want := "flow.stage_one"
    97				if role == "CSA" || role == "Hacker" {
    98					want = "flow.stage_two"
    99				}
   100				if stage != want {
   101					t.Fatalf("%s in %s", role, stage)
   102				}
   103			}
   104			for _, role := range config.ReviewRoles {
   105				want := 2
   106				if cfg.ReviewStages[role] == "skip" {
   107					want = 0
   108				}
   109				if seen[role] != want {
   110					t.Errorf("%s/%s count %d, want %d", role, cfg.ReviewStages[role], seen[role], want)
   111				}
   112			}
   113		}
   114	}
