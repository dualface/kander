   116	func TestWorkflowOrderAndTranslations(t *testing.T) {
   117		cfg := config.DefaultConfig()
   118		cfg.ReviewStages["PM"] = "required"
   119		lines := Build(cfg)
   120		positions := map[string]int{}
   121		steps := 0
   122		for index, line := range lines {
   123			positions[line.Key] = index
   124			if line.Kind == Heading {
   125				if steps > 40 {
   126					t.Fatalf("workflow has %d steps", steps)
   127				}
   128				steps = 0
   129			}
   130			if line.Kind == Step {
   131				steps++
   132			}
   133		}
   134		for _, pair := range [][2]string{{"member_delivery", "batch"}, {"batch", "receive"}, {"receive", "dispatch_fix"}, {"dispatch_fix", "member_fix"}, {"member_fix", "close_plan"}, {"close_plan", "group_ready"}, {"group_ready", "integrate"}, {"integrate", "wrap_dispatch"}, {"wrap_dispatch", "task_cleanup"}, {"task_cleanup", "member_done"}, {"member_done", "group_cleanup"}} {
   135			if positions["flow."+pair[0]] >= positions["flow."+pair[1]] {
   136				t.Errorf("wrong order: %v", pair)
   137			}
   138		}
   139		if steps > 40 {
   140			t.Fatalf("group has %d steps", steps)
   141		}
   142		for _, launcher := range []string{"auto", "tmux", "tmux-session", "herdr", "foreground", "console"} {
   143			cfg.Launcher = launcher
   144			for _, line := range Build(cfg) {
   145				for _, lang := range []string{"en", "cn", "ja"} {
   146					text := i18n.Text(lang, line.Key, line.Args...)
   147					if text == line.Key || strings.Contains(text, "{{") {
   148						t.Errorf("untranslated %s/%s", lang, line.Key)
   149					}
   150				}
   151			}
   152		}
   153	}
