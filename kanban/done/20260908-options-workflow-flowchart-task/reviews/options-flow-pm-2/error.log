     1	// Package flow describes configured workflows without performing workflow actions.
     2	package flow
     3	
     4	import "github.com/dualface/kander/internal/config"
     5	
     6	// Kind distinguishes headings, summary facts, steps and conditional step details.
     7	type Kind uint8
     8	
     9	const (
    10		Heading Kind = iota
    11		Summary
    12		Step
    13		Detail
    14	)
    15	
    16	// Line carries a catalog key and template arguments, independent of terminal layout.
    17	type Line struct {
    18		Kind Kind
    19		Key  string
    20		Args []any
    21	}
    22	
    23	// Build reads a normalized options-session configuration without modifying it.
    24	// Project overrides and task-specific triggers are resolved by agents at execution time.
    25	func Build(cfg *config.Config) []Line {
    26		var lines []Line
    27		add := func(kind Kind, key string, args ...any) {
    28			lines = append(lines, Line{Kind: kind, Key: "flow." + key, Args: args})
    29		}
    30		add(Heading, "configuration")
    31		add(Summary, "scope")
    32		for _, scale := range config.TaskScales {
    33			add(Summary, "agent", scale, cfg.KanbanAgents[scale])
    34		}
    35		add(Summary, "launcher", cfg.Launcher)
    36		for _, role := range config.ReviewRoles {
    37			add(Summary, "reviewer", role, cfg.Reviewers[role], cfg.ReviewStages[role])
    38		}
    39		for _, module := range config.RuleModules {
    40			key := "module_off"
    41			if cfg.Rules[module] {
    42				key = "module_on"
    43			}
    44			add(Summary, key, module)
    45		}
    46		start := func() {
    47			add(Step, "start")
    48			add(Detail, "launch_"+cfg.Launcher)
    49			add(Detail, "launch_failure")
    50			add(Step, "read")
    51			if cfg.Rules[config.RuleCollaboration] {
    52				add(Step, "collaboration")
    53			}
    54		}
    55		implement := func() {
    56			add(Step, "implement")
    57			if cfg.Rules[config.RuleCode] {
    58				add(Step, "self_check")
    59			}
    60		}
    61		hasReviewRole := false
    62		for _, role := range config.ReviewRoles {
    63			hasReviewRole = hasReviewRole || cfg.ReviewStages[role] != "skip"
    64		}
    65		review := func(group bool) {
    66			add(Step, "plan")
    67			if !cfg.Rules[config.RuleReview] {
    68				return
    69			}
    70			add(Step, "review_trigger")
    71			if !hasReviewRole {
    72				return
    73			}
    74			for _, stage := range [][]string{{"PM", "QA"}, {"CSA", "Hacker"}} {
    75				var roles []string
    76				for _, role := range stage {
    77					if cfg.ReviewStages[role] != "skip" {
    78						roles = append(roles, role)
    79					}
    80				}
    81				if len(roles) == 0 {
    82					continue
    83				}
    84				key := "stage_one"
    85				if stage[0] == "CSA" {
    86					key = "stage_two"
    87				}
    88				add(Step, key)
    89				for _, role := range roles {
    90					add(Detail, "role_"+cfg.ReviewStages[role], role, cfg.Reviewers[role])
    91				}
    92			}
    93			if group {
    94				add(Step, "dispatch_fix")
    95				add(Step, "member_fix")
    96			} else {
    97				add(Step, "single_fix")
    98			}
    99			add(Step, "review_finish")
   100		}
   101		report := func() {
   102			if cfg.Rules[config.RuleReporting] {
   103				add(Step, "report")
   104			}
   105		}
   106		add(Heading, "single")
   107		if cfg.Rules[config.RuleTaskIntake] {
   108			add(Step, "intake")
   109		}
   110		add(Step, "card")
   111		add(Step, "todo")
   112		start()
   113		if cfg.Rules[config.RuleGit] {
   114			add(Step, "task_branch")
   115		}
   116		implement()
   117		if cfg.Rules[config.RuleGit] {
   118			add(Step, "commit")
   119		}
   120		review(false)
