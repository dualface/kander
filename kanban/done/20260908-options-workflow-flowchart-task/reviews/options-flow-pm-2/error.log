    20	func TestModulePruning(t *testing.T) {
    21		for _, disabled := range append([]string{"", "all"}, config.RuleModules...) {
    22			t.Run(disabled, func(t *testing.T) {
    23				cfg := config.DefaultConfig()
    24				cfg.Rules = config.DefaultRules(disabled != "all")
    25				if disabled != "" && disabled != "all" {
    26					cfg.Rules[disabled] = false
    27				}
    28				before := config.Clone(cfg)
    29				lines := Build(cfg)
    30				got := keys(lines)
    31				if !reflect.DeepEqual(cfg, before) {
    32					t.Fatal("workflow mutated its input")
    33				}
    34				for module, key := range map[string]string{
    35					config.RuleCode: "self_check", config.RuleCollaboration: "collaboration",
    36					config.RuleTaskIntake: "intake", config.RuleReview: "review_trigger",
    37					config.RuleGit: "integrate", config.RuleReporting: "report",
    38				} {
    39					if got["flow."+key] != cfg.Rules[module] {
    40						t.Errorf("%s presence does not match %s", key, module)
    41					}
    42				}
    43				group := cfg.Rules[config.RuleTaskGroups] && cfg.Rules[config.RuleGit]
    44				if got["flow.group_branch"] != group || got["flow.group_unavailable"] == group {
    45					t.Fatal("group dependency pruning failed")
    46				}
    47				for _, key := range []string{"card", "todo", "start", "read", "implement", "plan", "close_plan", "records", "single_done"} {
    48					if !got["flow."+key] {
    49						t.Errorf("missing mandatory command protocol: %s", key)
    50					}
    51				}
    52				if !cfg.Rules[config.RuleReview] {
    53					for _, key := range []string{"stage_one", "stage_two", "role_auto", "role_required", "dispatch_fix", "single_fix", "review_finish", "batch"} {
    54						if got["flow."+key] {
    55							t.Errorf("disabled review node: %s", key)
    56						}
    57					}
    58				}
    59				if !cfg.Rules[config.RuleGit] && (got["flow.task_branch"] || got["flow.task_cleanup"] || got["flow.commit"]) {
    60					t.Fatal("disabled Git nodes remain")
    61				}
    62				modules := 0
    63				for _, line := range lines {
    64					if line.Key == "flow.module_on" || line.Key == "flow.module_off" {
    65						modules++
    66					}
    67				}
    68				if modules != 7 {
    69					t.Fatalf("summary has %d modules", modules)
    70				}
    71			})
    72		}
    73	}
