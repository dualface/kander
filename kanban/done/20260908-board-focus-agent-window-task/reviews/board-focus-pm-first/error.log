	}
	if text != "" {
		a.copyText(text)
	}
	a.resetDetailSelection()
}

func (a *App) detailMoveCursor(deltaLine, deltaCol int) {
	lines := a.detailLines()
	if len(lines) == 0 {
		return
	}
	line, col := a.DetailCursor[0], a.DetailCursor[1]
	line += deltaLine
	if line < 0 {
		line = 0
	}
	if line > len(lines)-1 {
		line = len(lines) - 1
	}
	lineText := lines[line]
	if deltaCol != 0 {
		col += deltaCol
		n := runeCount(lineText)
		if col < 0 {
			col = 0
		}
		if col > n {
			col = n
		}
	} else if deltaLine != 0 {
		n := runeCount(lineText)
		if col > n {
			col = n
		}
	}
	a.DetailCursor = [2]int{line, col}
	a.ensureDetailCursorVisible(lines)
}

