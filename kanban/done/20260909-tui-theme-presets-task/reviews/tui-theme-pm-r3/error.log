   178	func themeDefByName(name string) (themeDef, bool) {
   179		for _, def := range themeTable {
   180			if def.name == name {
   181				return def, true
   182			}
   183		}
   184		return themeDef{}, false
   185	}
   186	
   187	func namedThemeNames() []string {
   188		out := make([]string, len(themeTable))
   189		for i, def := range themeTable {
   190			out[i] = def.name
   191		}
   192		return out
   193	}
   194	
   195	func themePalette(name string) palette {
   196		if def, ok := themeDefByName(resolveTheme(name)); ok {
   197			return def.palette
   198		}
   199		def, _ := themeDefByName("dark")
   200		return def.palette
   201	}
   202	
   203	// themeIsDark reports the light/dark family of a theme from the table.
   204	// auto and unknown names go through resolveTheme first.
   205	func themeIsDark(name string) bool {
   206		if def, ok := themeDefByName(resolveTheme(name)); ok {
   207			return def.dark
   208		}
   209		return resolveTheme(name) == "dark"
   210	}
