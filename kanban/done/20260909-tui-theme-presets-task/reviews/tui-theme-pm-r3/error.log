   135	func TestThemePaletteContrast(t *testing.T) {
   136		for _, name := range namedThemeNames() {
   137			p := themePalette(name)
   138			bg := string(p.Bg)
   139			minRatio := themeBodyContrastMin(name)
   140			baseRatio := contrastRatio(string(p.Base), bg)
   141			body := []struct {
   142				label string
   143				color lipgloss.Color
   144			}{
   145				{"Base", p.Base},
   146				{"Accent", p.Accent},
   147				{"Bar", p.Bar},
   148				{"Warn", p.Warn},
   149				{"OK", p.OK},
   150				{"PopupFg", p.PopupFg},
   151				{"PopupEdge", p.PopupEdge},
   152			}
   153			for _, item := range body {
   154				ratio := contrastRatio(string(item.color), bg)
   155				if ratio < minRatio {
   156					t.Fatalf("%s %s on Bg = %.3f, want >= %.1f", name, item.label, ratio, minRatio)
   157				}
   158			}
   159			for _, state := range allStates {
   160				ratio := contrastRatio(string(p.Headings[state]), bg)
   161				if ratio < minRatio {
   162					t.Fatalf("%s heading %s on Bg = %.3f, want >= %.1f", name, state, ratio, minRatio)
   163				}
   164			}
   165			dimRatio := contrastRatio(string(p.Dim), bg)
   166			sepRatio := contrastRatio(string(p.Separator), bg)
   167			if dimRatio < 3 {
   168				t.Fatalf("%s Dim on Bg = %.3f, want >= 3", name, dimRatio)
   169			}
   170			if sepRatio < 3 {
   171				t.Fatalf("%s Separator on Bg = %.3f, want >= 3", name, sepRatio)
   172			}
   173			if dimRatio >= baseRatio {
   174				t.Fatalf("%s Dim contrast %.3f should be below Base %.3f", name, dimRatio, baseRatio)
   175			}
   176			if sepRatio >= baseRatio {
   177				t.Fatalf("%s Separator contrast %.3f should be below Base %.3f", name, sepRatio, baseRatio)
   178			}
   179			chromeRatio := contrastRatio(string(p.ChromeFg), string(p.ChromeBg))
   180			if chromeRatio < minRatio {
   181				t.Fatalf("%s ChromeFg on ChromeBg = %.3f, want >= %.1f", name, chromeRatio, minRatio)
   182			}
   183		}
   184	}
