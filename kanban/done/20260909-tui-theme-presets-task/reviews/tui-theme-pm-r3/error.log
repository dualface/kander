   247	func assertHexColor(t *testing.T, label string, color lipgloss.Color) {
   248		t.Helper()
   249		value := string(color)
   250		if !hexColorPattern.MatchString(value) {
   251			t.Fatalf("%s = %q, want #rrggbb", label, value)
   252		}
   253	}
   254	
   255	func contrastRatio(a, b string) float64 {
   256		l1, l2 := relativeLuminance(a), relativeLuminance(b)
   257		if l1 < l2 {
   258			l1, l2 = l2, l1
   259		}
   260		return (l1 + 0.05) / (l2 + 0.05)
   261	}
   262	
   263	func relativeLuminance(hex string) float64 {
   264		if len(hex) != 7 || hex[0] != '#' {
   265			return 0
   266		}
   267		r := linearizeChannel(hexByte(hex[1], hex[2]))
   268		g := linearizeChannel(hexByte(hex[3], hex[4]))
   269		b := linearizeChannel(hexByte(hex[5], hex[6]))
   270		return 0.2126*r + 0.7152*g + 0.0722*b
   271	}
   272	
   273	func linearizeChannel(value float64) float64 {
   274		c := value / 255
   275		if c <= 0.04045 {
   276			return c / 12.92
   277		}
   278		return math.Pow((c+0.055)/1.055, 2.4)
   279	}
   280	
   281	func hexByte(hi, lo byte) float64 {
   282		return float64(hexNibble(hi)<<4 | hexNibble(lo))
   283	}
   284	
   285	func hexNibble(b byte) int {
   286		switch {
   287		case b >= '0' && b <= '9':
   288			return int(b - '0')
   289		case b >= 'a' && b <= 'f':
   290			return int(b-'a') + 10
   291		case b >= 'A' && b <= 'F':
   292			return int(b-'A') + 10
   293		}
   294		return 0
   295	}
   296	
   297	func trueColorSeq(hex string, foreground bool) string {
   298		prefix := "48;2"
   299		if foreground {
   300			prefix = "38;2"
   301		}
   302		return fmt.Sprintf("%s;%.0f;%.0f;%.0f", prefix, hexByte(hex[1], hex[2]), hexByte(hex[3], hex[4]), hexByte(hex[5], hex[6]))
   303	}
