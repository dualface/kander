+func themeDefByName(name string) (themeDef, bool) {
+	for _, def := range themeTable {
+		if def.name == name {
+			return def, true
+		}
+	}
+	return themeDef{}, false
+}
+
+func namedThemeNames() []string {
+	out := make([]string, len(themeTable))
+	for i, def := range themeTable {
+		out[i] = def.name
+	}
+	return out
 }
 
