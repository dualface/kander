   212	func (p palette) ink(color lipgloss.Color) lipgloss.Style {
   213		return lipgloss.NewStyle().Foreground(color).Background(p.Bg)
   214	}
   215	
   216	func (p palette) fillLine(width int) string {
   217		if width < 1 {
   218			return ""
   219		}
   220		return p.ink(p.Base).Render(strings.Repeat(" ", width))
   221	}
   222	
   223	func (p palette) fillColumn(width, height int) string {
   224		if height < 1 {
   225			return ""
   226		}
   227		line := p.fillLine(width)
   228		lines := make([]string, height)
   229		for i := range lines {
   230			lines[i] = line
   231		}
   232		return strings.Join(lines, "\n")
   233	}
   234	
   235	func (p palette) paint(style lipgloss.Style) lipgloss.Style {
   236		return style.Background(p.Bg)
   237	}
   238	
   239	// paintScreen lays the content on a canvas of fixed width and height, with line ends and blank lines carrying the theme background too.
   240	func paintScreen(content string, width, height int, p palette) string {
   241		if width < 1 {
   242			width = 1
   243		}
   244		if height < 1 {
   245			height = 1
   246		}
   247		lines := strings.Split(content, "\n")
   248		out := make([]string, height)
   249		for i := 0; i < height; i++ {
   250			line := ""
   251			if i < len(lines) {
   252				line = lines[i]
   253			}
   254			out[i] = padLineFill(line, width, p)
   255		}
   256		return strings.Join(out, "\n")
   257	}
   258	
   259	// styleFor maps a screenBuffer cell tag to a lipgloss style.
   260	func styleFor(tag string, p palette) lipgloss.Style {
   261		style := p.ink(p.Base)
   262		switch {
   263		case tag == "title" || tag == "footer":
   264			return lipgloss.NewStyle().Foreground(p.ChromeFg).Background(p.ChromeBg).Bold(true)
   265		case tag == "search":
   266			return p.ink(p.Accent).Bold(true)
   267		case tag == "selected" || tag == "select":
   268			return p.ink(p.Base).Reverse(true).Bold(true)
   269		case tag == "bar":
   270			return p.ink(p.Bar).Bold(true)
   271		case tag == "match" || tag == "caret":
   272			return p.ink(p.Base).Reverse(true)
   273		case tag == "dim":
   274			return p.ink(p.Dim)
   275		case tag == "separator":
   276			return p.ink(p.Separator)
   277		case tag == "bold":
   278			return style.Bold(true)
   279		case tag == "popup-title":
   280			return p.ink(p.PopupEdge).Bold(true)
   281		case tag == "popup-edge":
   282			return p.ink(p.PopupEdge)
   283		case tag == "popup-sel":
   284			return p.ink(p.PopupFg).Reverse(true).Bold(true)
   285		case tag == "popup-dim":
   286			return p.ink(p.Dim)
   287		case tag == "popup-group":
   288			return p.ink(p.Accent).Bold(true)
   289		case tag == "popup-warn":
   290			return p.ink(p.Warn).Bold(true)
   291		case tag == "popup-ok":
   292			return p.ink(p.OK)
   293		case tag == "popup":
   294			return p.ink(p.PopupFg)
   295		case strings.HasPrefix(tag, "heading-"):
   296			state := strings.TrimPrefix(tag, "heading-")
   297			if color, ok := p.Headings[state]; ok {
   298				return p.ink(color).Bold(true)
   299			}
   300			return style.Bold(true)
   301		}
   302		return style
   303	}
   304	
   305	// headingStyle is the style of a column title. The selected column is inverted,
   306	// so which column has focus is obvious at a glance even when no card is selected.
   307	func headingStyle(p palette, state string, focused bool) lipgloss.Style {
   308		style := styleFor("heading-"+state, p)
   309		if focused {
   310			return style.Reverse(true)
   311		}
   312		return style
   313	}
   314	
   315	// headingRuleStyle is the rule below the title. The selected column uses its column color as a focus hint,
   316	// while the others take the same low-contrast separator as the vertical dividers and do not compete with the content.
   317	func headingRuleStyle(p palette, state string, focused bool) lipgloss.Style {
   318		if focused {
   319			return styleFor("heading-"+state, p)
   320		}
   321		return styleFor("separator", p)
   322	}
   323	
   324	// stateColor is the theme color of one column, falling back to the base foreground for an unknown column.
   325	func stateColor(p palette, state string) lipgloss.Color {
   326		if color, ok := p.Headings[state]; ok {
   327			return color
   328		}
   329		return p.Base
   330	}
   331	
   332	// cardStyle is the style of one line of a task card. Line 0 is the title and takes the color of its column,
   333	// staying in the same family as the column title; the remaining lines are the task ID and metadata and keep the base color.
   334	// A selected card is inverted in its column color as one block, so the selection and its column match up at a glance.
   335	func cardStyle(p palette, state string, line int, selected bool) lipgloss.Style {
   336		color := stateColor(p, state)
   337		if selected {
   338			style := p.ink(color).Reverse(true)
   339			if line == 0 {
   340				return style.Bold(true)
   341			}
   342			return style
   343		}
   344		if line == 0 {
   345			return p.ink(color)
   346		}
   347		return p.ink(p.Base)
   348	}
   349	
   350	// panelBorderStyle is the border of a column panel: the selected column outlines focus in its column color,
   351	// while the others take the low-contrast separator and do not compete with the card content.
   352	func panelBorderStyle(p palette, state string, focused bool) lipgloss.Style {
   353		if focused {
   354			return p.ink(stateColor(p, state))
   355		}
   356		return styleFor("separator", p)
   357	}
   358	
   359	// badgeStyle is the task count badge after a column title. It is an inverted little block rather than a bare number:
   360	// the selected column uses its column color and joins the equally inverted title, while the others go dim and only hint.
   361	func badgeStyle(p palette, state string, focused bool) lipgloss.Style {
   362		if focused {
   363			return p.ink(stateColor(p, state)).Reverse(true).Bold(true)
   364		}
   365		return p.ink(p.Dim).Reverse(true)
   366	}
   367	
   368	// resolveTheme only normalizes auto: a named theme is returned as itself,
   369	// and auto (or any name not in the table) uses the cached terminal probe.
   370	func resolveTheme(name string) string {
   371		if _, ok := themeDefByName(name); ok {
   372			return name
   373		}
