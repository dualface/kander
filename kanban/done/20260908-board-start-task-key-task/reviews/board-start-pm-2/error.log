func (p program) Init() tea.Cmd {
	return tea.Batch(tickCmd(), p.app.takePending())
}

func (p program) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch event := msg.(type) {
	case tea.WindowSizeMsg:
