   131	func (a *App) renderStartConfirmation() (popupBox, string) {
   132		request := a.StartConfirmation
   133		lines := []string{
   134			t("tui.start_confirm"),
   135			request.TaskID,
   136			t("tui.start_settings", request.Agent, request.Launcher),
   137		}
   138		if request.State == "backlog" {
   139			lines = append(lines, t("tui.start_backlog"))
   140		}
   141		lines = append(lines, t("tui.start_confirm_keys"))
   142		return a.renderStartPopup(lines)
   143	}
   144	
   145	func (a *App) renderStartPopup(lines []string) (popupBox, string) {
   146		h, w := a.size()
   147		p := themePalette(a.Theme)
   148		for i, line := range lines {
   149			lines[i] = printableText(ansi.Strip(line))
   150		}
   151		inner := max(1, min(w-8, max(40, blockWidth(strings.Join(lines, "\n")))))
   152		body := ansi.Wrap(strings.Join(lines, "\n"), inner, "")
   153		box := centerPopupMax(w, h, inner+4, blockHeight(body)+2, max(1, w-4))
   154		return box, popupFrame(p, box.Width-2).Render(padBlock(body, box.Width-4, box.Height-2, p))
   155	}
