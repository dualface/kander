    23	
    24	func prepareTaskStart(id string) (startRequest, error) {
    25		root, err := board.BoardRoot()
    26		if err != nil {
    27			return startRequest{}, err
    28		}
    29		preview, err := launch.PreviewStart(root, id)
    30		return startRequest{StartPreview: preview, root: root}, err
    31	}
    32	
    33	func runTaskStart(request startRequest) (launch.StartResult, error) {
    34		if !backgroundStartLauncher(request.Launcher) {
    35			return launch.StartResult{}, fmt.Errorf("%s", t("tui.start_use_cli", request.Launcher))
    36		}
    37		if request.State == "backlog" {
    38			snapshot, err := board.ReadSnapshot(request.root, request.TaskID)
    39			if err != nil {
    40				return launch.StartResult{}, err
    41			}
    42			if snapshot.Entry.State != "backlog" {
    43				return launch.StartResult{}, fmt.Errorf("%s", t("tui.start_state_changed", request.TaskID))
    44			}
    45			if _, err := board.MoveEntry(snapshot.Entry, request.root, "todo"); err != nil {
    46				return launch.StartResult{}, err
    47			}
    48		}
    49		return launch.Start(request.root, request.Agent, request.Launcher, request.TaskID)
    50	}
    51	
    52	func backgroundStartLauncher(launcher string) bool {
    53		return launcher == "herdr" || launcher == "tmux" || launcher == "tmux-session"
    54	}
    55	
    56	func (a *App) confirmSelectedStart() {
    57		selected := a.Model.SelectedTask()
    58		if selected == nil {
    59			a.showFocusNotice(t("tui.start_no_selection"))
    60			return
    61		}
    62		if selected.State != "backlog" && selected.State != "todo" {
    63			a.showFocusNotice(t("tui.start_invalid_state", selected.State))
    64			return
    65		}
    66		request, err := a.PrepareStart(selected.TaskID)
    67		if err != nil {
    68			a.showFocusNotice(t("tui.start_failed", err.Error()))
    69			return
    70		}
    71		if request.State != "backlog" && request.State != "todo" {
    72			a.showFocusNotice(t("tui.start_invalid_state", request.State))
    73			return
    74		}
    75		if !backgroundStartLauncher(request.Launcher) {
    76			a.showFocusNotice(t("tui.start_use_cli", request.Launcher))
    77			return
    78		}
    79		a.StartConfirmation = &request
    80		a.resetMouseSelection()
    81	}
    82	
    83	func (a *App) handleStartConfirmation(key string) {
    84		request := *a.StartConfirmation
    85		a.StartConfirmation = nil
    86		if key != "y" {
    87			return
    88		}
    89		run := a.StartTask
    90		a.startsRunning++
    91		a.pendingWork = func() any {
    92			result, err := run(request)
    93			return startResult{result, err}
    94		}
    95		a.showFocusNotice(t("tui.start_starting", request.TaskID))
    96	}
    97	
    98	func (a *App) applyStartResult(result startResult) {
    99		if a.startsRunning > 0 {
   100			a.startsRunning--
   101		}
   102		defer func() {
   103			if a.quitAfterStarts && a.startsRunning == 0 {
   104				a.Running = false
   105			}
   106		}()
   107		a.refreshBoard()
   108		message := ""
   109		compact := ""
   110		if result.err != nil {
   111			message = t("tui.start_failed", result.err.Error())
   112		} else {
   113			r := result.result
   114			address := r.Outcome.Tab + ":" + r.Outcome.Pane
   115			if r.Plan.Launcher != "herdr" {
   116				address = r.Plan.Session + ":" + r.Outcome.Window + ":" + r.Outcome.Pane
   117			}
   118			message = t("tui.start_success", r.TaskID, r.Agent, r.Plan.Launcher, address)
   119			compact = t("tui.start_success_compact", r.Agent, r.Plan.Launcher, address)
   120		}
   121		for _, warning := range result.result.Warnings {
   122			message += " " + warning
   123			compact += " " + warning
   124		}
   125		a.showFocusNotice(message)
   126		if result.err == nil {
   127			a.startNotice = &startNotice{a.CopyNotice, strings.ReplaceAll(printableText(ansi.Strip(compact)), "\n", " ")}
   128		}
   129	}
