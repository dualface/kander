   170		switch event.Button {
   171		case tea.MouseButtonNone:
   172			return buttonNone
   173		case tea.MouseButtonLeft:
   174			return buttonLeft
   175		case tea.MouseButtonWheelUp:
   176			return buttonWheelUp
   177		case tea.MouseButtonWheelDown:
   178			return buttonWheelDown
   179		}
   180		return buttonOther
   181	}
