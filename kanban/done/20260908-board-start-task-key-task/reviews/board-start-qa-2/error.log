   157	// requestQuit keeps the event loop alive until every queued start has settled,
   158	// so the launch layer can finish its existing confirmation or rollback protocol.
   159	func (a *App) requestQuit() {
   160		if a.startsRunning == 0 {
   161			a.Running = false
   162			return
   163		}
   164		a.quitAfterStarts = true
   165		a.showFocusNotice(t("tui.start_wait_exit", a.startsRunning))
   166	}
