   168	func (a *App) activeStartNotice() bool {
   169		return a.startNotice != nil && a.CopyNotice == a.startNotice.full && a.Now().Before(a.CopyNoticeUntil)
   170	}
   171	
   172	func (a *App) displayNotice() string {
   173		if a.activeStartNotice() {
   174			_, w := a.size()
   175			if displayWidth(a.CopyNotice) > w-1 {
   176				return a.startNotice.compact
   177			}
   178		}
   179		return a.CopyNotice
   180	}
   181	
   182	func (a *App) startNoticeOverflows(width int) bool {
   183		return a.activeStartNotice() && displayWidth(a.startNotice.compact) > width-1
   184	}
