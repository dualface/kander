   298		unavailable := config.Text("menu.not_currently_installed")
   299		for _, item := range tmuxLauncherChoices() {
   300			if s.Config.Launcher == item.Value {
   301				choices = append(choices, Choice{Value: item.Value, Label: item.Label + unavailable})
