   331	
   332	func (s *Session) saveScope() (string, error) {
   333		cfg := s.scopeBuffer()
   334		if cfg == nil {
   335			return "", nil
   336		}
   337		cfg.WelcomeComplete = true
   338		baseline := s.scopeExisting
   339		if baseline == nil {
   340			baseline = s.existing
   341		}
   342		path, err := config.SaveIfUnchanged(cfg, baseline)
   343		if err == nil {
   344			s.existing = config.Clone(cfg)
   345			s.scopeExisting = config.Clone(cfg)
   346			s.scopeConfig = cfg
   347			if raw, rawErr := config.DocumentFromConfig(cfg); rawErr == nil {
   348				s.scopeRaw = raw
   349			}
   350			if s.EditingOverlay() {
   351				_ = s.rebuildOverlayConfig()
   352			} else {
   353				s.Config = cfg
   354			}
   355			s.ScopeDirty = false
   356		}
   357		return path, err
   358	}
   359	
   360	// SaveAllDirty writes every unpublished tab. Save still writes only the active tab
   361	// so a section submit on Project cannot copy merged values into the scope file.
   362	func (s *Session) SaveAllDirty() (string, error) {
   363		if s == nil {
   364			return "", nil
   365		}
   366		var last string
   367		if s.ScopeDirty {
   368			path, err := s.saveScope()
   369			if err != nil {
   370				return last, err
   371			}
   372			last = path
   373		}
   374		if s.OverlayDirty {
   375			path, err := s.saveOverlay()
   376			if err != nil {
   377				return last, err
   378			}
   379			last = path
   380		}
   381		if last != "" {
   382			return last, nil
   383		}
   384		return s.Save()
   385	}
   386	
   387	func (s *Session) saveOverlay() (string, error) {
   388		if s.OverlayLocation.Path == "" {
   389			return "", config.ErrMissingOverlayPath()
   390		}
   391		path, err := config.SaveOverlayIfUnchanged(s.OverlayLocation.Path, s.overlayRaw, s.overlayExisting)
   392		if err == nil {
   393			s.overlayExisting = config.CloneOverlay(s.overlayRaw)
   394			s.OverlayLocation.Exists = len(s.overlayRaw) > 0
   395			s.OverlayDirty = false
   396		}
   397		return path, err
   398	}
