   547	// Summary returns the "current configuration" overview shown in the menu title and at the top of the panel.
   548	func (s *Session) Summary() []string {
   549		cfg := s.Config
   550		lines := []string{config.Text("menu.current_configuration")}
   551		lines = append(lines, config.Text("rules.modules")+": "+config.FormatRulesSummary(cfg.Rules))
   552		for _, agent := range config.ExecutionAgentsInUse(cfg) {
   553			entry := cfg.Models.Kanban[agent]
   554			lines = append(lines, "  kanban "+agent+": "+config.FormatKanbanModelSummary(agent, entry))
   555		}
   556		seen := map[string]struct{}{}
   557		for _, role := range config.ReviewRoles {
   558			reviewer := cfg.Reviewers[role]
   559			if _, ok := seen[reviewer]; ok {
   560				continue
   561			}
   562			seen[reviewer] = struct{}{}
   563			entry := cfg.Models.Review[reviewer]
   564			lines = append(lines, "  review "+reviewer+": "+config.FormatReviewModelSummary(entry))
   565		}
   566		return lines
   567	}
