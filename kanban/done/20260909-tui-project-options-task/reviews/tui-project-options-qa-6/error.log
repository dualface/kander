   246	// MergeOverlayOnRaw validates overlay keys against a raw scope JSON document,
   247	// matching Load. Do not pass a filled Config: missing optional sections would
   248	// be filled and then accept overlays that Load rejects.
   249	func MergeOverlayOnRaw(scopeRaw, overlay map[string]any) (*Config, error) {
   250		if scopeRaw == nil {
   251			scopeRaw = map[string]any{}
   252		}
   253		base := cloneRawObjectDeep(scopeRaw)
   254		if len(overlay) == 0 {
   255			return Validate(base)
   256		}
   257		merged, err := mergeOverlayRaw(base, overlay)
   258		if err != nil {
   259			return nil, err
   260		}
   261		return Validate(merged)
   262	}
   263	
   264	// MergeScopeAndOverlay validates a filled Config plus sparse overlay keys.
   265	// Overlay save and Project-tab preview use MergeOverlayOnRaw instead.
   266	func MergeScopeAndOverlay(scope *Config, overlay map[string]any) (*Config, error) {
   267		raw, err := DocumentFromConfig(scope)
   268		if err != nil {
   269			return nil, err
   270		}
   271		return MergeOverlayOnRaw(raw, overlay)
   272	}
   273	
   274	func encodeOverlay(obj map[string]any) ([]byte, error) {
   275		if obj == nil {
   276			obj = map[string]any{}
   277		}
   278		payload, err := json.MarshalIndent(obj, "", "  ")
   279		if err != nil {
   280			return nil, err
   281		}
   282		return append(payload, '\n'), nil
   283	}
   284	
   285	func overlayMapsEqual(a, b map[string]any) bool {
   286		if len(a) == 0 && len(b) == 0 {
   287			return true
   288		}
   289		left, err := encodeOverlay(a)
   290		if err != nil {
   291			return false
   292		}
   293		right, err := encodeOverlay(b)
   294		if err != nil {
   295			return false
   296		}
   297		return bytes.Equal(left, right)
   298	}
   299	
   300	func readOverlayMapAt(path string) (map[string]any, bool, error) {
   301		data, err := readConfigBytes(path)
   302		if err != nil {
   303			return nil, false, configErrorfWrap(err, "config.failed_to_read_config", path, err.Error())
   304		}
   305		if data == nil {
   306			return map[string]any{}, false, nil
   307		}
   308		raw, err := decodeJSON(data)
   309		if err != nil {
   310			return nil, true, configErrorfWrap(err, "config.overlay_invalid_json", path, err.Error())
   311		}
   312		obj, ok := raw.(map[string]any)
   313		if !ok {
   314			return nil, true, configErrorf("config.overlay_root_must_be_a_json_object", path)
   315		}
   316		if err := validateOverlayKeys(path, obj); err != nil {
   317			return nil, true, err
   318		}
   319		return cloneRawObjectDeep(obj), true, nil
   320	}
   321	
   322	func removeOverlayFile(path string) error {
   323		abs, err := lexicalAbsolute(path)
   324		if err != nil {
   325			return err
   326		}
   327		anchor, err := volumeAnchor(abs)
   328		if err != nil {
   329			return err
   330		}
   331		if _, err := fs.RemoveRegularFileIfExists(anchor, abs); err != nil {
   332			return wrapSaveError(path, err)
   333		}
   334		return nil
   335	}
   336	
   337	func writeOverlayAt(path string, overlay map[string]any) error {
   338		if err := validateOverlayKeys(path, overlay); err != nil {
   339			return err
   340		}
   341		payload, err := encodeOverlay(overlay)
   342		if err != nil {
   343			return wrapSaveError(path, err)
   344		}
   345		abs, err := lexicalAbsolute(path)
   346		if err != nil {
   347			return err
   348		}
   349		anchor, err := volumeAnchor(abs)
   350		if err != nil {
   351			return err
   352		}
   353		if err := fs.EnsureInheritedDirectoryPath(filepath.Dir(abs)); err != nil {
   354			return wrapSaveError(path, err)
   355		}
   356		if err := fs.WriteTextAtomicInherited(anchor, abs, string(payload), true); err != nil {
   357			return wrapSaveError(path, err)
   358		}
   359		return nil
   360	}
   361	
   362	// ErrMissingOverlayPath is returned when Options has no resolved write target.
   363	func ErrMissingOverlayPath() error {
   364		return configErrorf("config.failed_to_inspect_path", ".")
   365	}
   366	
   367	// SaveOverlayIfUnchanged writes only explicit overlay keys after validating the
   368	// merged effective config. An empty overlay deletes the file and never creates one.
   369	func SaveOverlayIfUnchanged(path string, overlay, baseline map[string]any) (string, error) {
   370		if path == "" {
   371			return "", configErrorf("config.failed_to_inspect_path", ".")
   372		}
   373		if overlay == nil {
   374			overlay = map[string]any{}
   375		}
   376		if err := validateOverlayKeys(path, overlay); err != nil {
   377			return "", err
   378		}
   379		raw, err := LoadScopeDocument(true)
   380		if err != nil {
   381			return "", err
   382		}
   383		if _, err := MergeOverlayOnRaw(raw, overlay); err != nil {
   384			return "", err
   385		}
   386		abs, err := lexicalAbsolute(path)
   387		if err != nil {
   388			return "", err
   389		}
   390		lockPath, err := overlayAdvisoryLock(abs)
   391		if err != nil {
   392			return "", err
   393		}
   394		err = withConfigLockFile(abs, lockPath, func() error {
   395			current, _, readErr := readOverlayMapAt(abs)
   396			if readErr != nil {
   397				return readErr
   398			}
   399			if !overlayMapsEqual(current, baseline) {
   400				return configErrorf("config.configuration_changed_while_editing")
   401			}
   402			if len(overlay) == 0 {
   403				return removeOverlayFile(abs)
   404			}
   405			return writeOverlayAt(abs, overlay)
   406		})
   407		if err != nil {
   408			return "", err
   409		}
   410		return abs, nil
   411	}
   412	
   413	// overlayAdvisoryLock keeps the exclusive lock out of the project tree so a
   414	// save cannot leave .kander-config.json.lock next to user sources.
   415	func overlayAdvisoryLock(overlay string) (string, error) {
    35		for _, module := range []string{RuleCollaboration, RuleCode, RuleGit, RuleReview, RuleTaskIntake, RuleTaskGroups, RuleReporting} {
    36			rules[module] = true
    37		}
    38		return rules
    39	}
