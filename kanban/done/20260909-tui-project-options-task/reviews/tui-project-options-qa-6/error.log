   302	func expandReviewStagesOverlay(overlay map[string]any) {
   303		if overlay == nil {
   304			return
   305		}
   306		stages, ok := overlay["review_stages"]
   307		if !ok {
   308			return
   309		}
   310		if obj, ok := stages.(map[string]any); ok {
   311			if _, hasLarge := obj["large"]; hasLarge {
   312				return
   313			}
   314			if _, hasSmall := obj["small"]; hasSmall {
   315				return
   316			}
   317		}
   318		normalized, err := config.NormalizeReviewStages(stages)
   319		if err != nil {
   320			return
   321		}
   322		overlay["review_stages"] = normalized
   323	}
