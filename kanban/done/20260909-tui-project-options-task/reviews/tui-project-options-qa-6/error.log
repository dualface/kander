   357	
   358	// ExecutionModelFieldsFor returns the model fields of the agent currently selected for one task scale (large/small).
   359	// Model and reasoning effort are stored per scale, so large and small tasks each keep their own
   360	// independently editable values even when they select the same agent.
   361	func (s *Session) ExecutionModelFieldsFor(scale string) []ModelField {
   362		agent := s.Config.KanbanAgents[scale]
   363		if agent == "" {
   364			return nil
   365		}
   366		// When a legacy config only has the shared model key, the scale models are filled in with the same concrete value,
   367		// so the UI never shows a field that looks empty but actually has a value.
   368		if entry := s.Config.Models.Kanban[agent]; entry != nil {
   369			if entry[scale+"_model"] == "" && entry["model"] != "" {
   370				entry[scale+"_model"] = entry["model"]
   371			}
   372		}
   373		label := agentLabels()[agent]
   374		if label == "" {
   375			label = agent
   376		}
   377		if s.Config.Models.Kanban[agent] == nil {
   378			s.Config.Models.Kanban[agent] = map[string]string{}
   379		}
   380		scaleLabel := config.Text("menu.large_task")
   381		if scale == "small" {
   382			scaleLabel = config.Text("menu.small_task")
   383		}
   384		fields := []ModelField{s.kanbanModelField(agent, scale+"_model",
   385			config.Text("menu.kanban_model", label, scaleLabel),
   386			config.Text("menu.model", label, scaleLabel),
   387			config.Text("menu.full_model_id_for_s", scaleLabel))}
   388		if config.AgentFor(s.Config, agent).Dialect == "cursor" && config.AgentFor(s.Config, agent).Args == nil {
   389			return fields
   390		}
   391		return append(fields, s.kanbanModelField(agent, scale+"_effort",
   392			config.Text("menu.kanban_reasoning_effort", label, scaleLabel),
   393			config.Text("menu.effort", label, scaleLabel),
   394			config.Text("menu.reasoning_effort_for_s", scaleLabel)))
   395	}
