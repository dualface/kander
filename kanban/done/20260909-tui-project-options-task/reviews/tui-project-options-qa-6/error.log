   287	func (s *Session) LauncherChoices() []Choice {
   288		if isWindowsOS() {
   289			return windowsLauncherChoices(s.Config)
   290		}
   291		foreground := Choice{Value: "foreground", Label: config.Text("menu.foreground_in_this_terminal")}
   292		choices := []Choice{autoLauncherChoice()}
   293		if lookPath("tmux") != "" {
