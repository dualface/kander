   346	// kanbanModelField builds one model field on the execution side.
   347	func (s *Session) kanbanModelField(agent, field, label, short, prompt string) ModelField {
   348		return ModelField{
   349			Label:  label,
   350			Short:  short,
   351			Agent:  agent,
   352			Prompt: prompt,
   353			entry:  s.Config.Models.Kanban[agent],
   354			field:  field,
