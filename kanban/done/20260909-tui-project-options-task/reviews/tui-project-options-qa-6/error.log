   460	// ResetReviewRoleModel resets the model and reasoning effort of one role to the defaults of its new reviewer.
   461	// Call it when a role changes reviewer: the old values were configured for the old reviewer and would otherwise be misattributed.
   462	func (s *Session) ResetReviewRoleModel(role string) {
   463		if s.EditingOverlay() {
   464			_ = s.applyOverlayEdit(func(candidate map[string]any) {
   465				config.OverlayDelete(candidate, "models", "review_roles", role)
   466			})
   467			return
   468		}
   469		s.Config.Models.ReviewRoles[role] = map[string]string{}
   470		s.seedReviewRole(role, s.Config.Reviewers[role])
   471	}
