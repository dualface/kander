   443	// seedReviewRole makes sure the role owns its values: whichever item is missing is filled in from that reviewer's default.
   444	func (s *Session) seedReviewRole(role, reviewer string) map[string]string {
   445		entry := s.Config.Models.ReviewRoles[role]
   446		if entry == nil {
   447			entry = map[string]string{}
   448			s.Config.Models.ReviewRoles[role] = entry
   449		}
   450		agentEntry := s.Config.Models.Review[reviewer]
   451		if entry["model"] == "" {
   452			entry["model"] = agentEntry["model"]
   453		}
   454		if _, ok := agentEntry["effort"]; ok && entry["effort"] == "" {
   455			entry["effort"] = agentEntry["effort"]
   456		}
   457		return entry
   458	}
