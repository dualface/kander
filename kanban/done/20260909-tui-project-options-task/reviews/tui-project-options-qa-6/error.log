   589	// NewSessionForTest builds a session that skips environment probing; it is for tests only.
   590	// The candidate agents are simply every value the schema allows, and no agent executable is invoked.
   591	func NewSessionForTest(existing *config.Config) (*Session, error) {
   592		session := &Session{existing: existing}
   593		labels := agentLabels()
   594		for _, name := range config.AgentNames(existing) {
   595			session.exec = append(session.exec, Choice{Value: name, Label: labels[name]})
   596		}
   597		for _, name := range config.ReviewAgents {
   598			session.review = append(session.review, Choice{Value: name, Label: labels[name]})
   599		}
   600		cfg := config.DefaultConfig()
   601		cfg.Agents = config.CloneAgents(existing.Agents)
   602		cfg.Models = copyModels(existing.Models)
   603		cfg.KanbanAgent = existing.KanbanAgent
   604		cfg.KanbanAgents = cloneStrings(existing.KanbanAgents)
   605		cfg.Reviewers = cloneStrings(existing.Reviewers)
   606		cfg.ReviewStages = cloneReviewStages(existing.ReviewStages)
   607		cfg.Rules = existing.Rules.Clone()
   608		cfg.Launcher = existing.Launcher
   609		cfg.TUI = existing.TUI
   610		cfg.Language = existing.Language
   611		cfg.AgentLanguage = existing.AgentLanguage
   612		session.Config = cfg
   613		session.initOverlayState()
   614		if path, err := config.ConfigPath(); err == nil {
   615			session.BasePath = path
   616		}
   617		return session, nil
   618	}
