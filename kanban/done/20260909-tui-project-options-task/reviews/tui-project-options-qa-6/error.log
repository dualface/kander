   412	
   413	// ReviewModelFieldsFor returns the model fields of one review role.
   414	// Every role stores its own concrete values, so what the UI shows is what is used, with no hidden inheritance layer;
   415	// while a role has no value yet, it is filled in from the default of its selected reviewer.
   416	func (s *Session) ReviewModelFieldsFor(role string) []ModelField {
   417		reviewer := s.Config.Reviewers[role]
   418		if reviewer == "" {
   419			return nil
   420		}
   421		entry := s.seedReviewRole(role, reviewer)
   422		fields := []ModelField{{
   423			Label:  config.Text("menu.review_model", role),
   424			Short:  config.Text("menu.model_2", role),
   425			Agent:  role,
   426			Prompt: config.Text("menu.which_model_should_use", role),
   427			entry:  entry,
   428			field:  "model",
   429		}}
   430		if reviewer == "cursor" {
   431			return fields
   432		}
   433		return append(fields, ModelField{
   434			Label:  config.Text("menu.review_reasoning_effort", role),
   435			Short:  config.Text("menu.effort_2", role),
   436			Agent:  role,
   437			Prompt: config.Text("menu.reasoning_effort_for", role),
   438			entry:  entry,
   439			field:  "effort",
   440		})
   441	}
