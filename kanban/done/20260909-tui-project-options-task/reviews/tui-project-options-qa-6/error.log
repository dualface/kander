   498	func (s *Session) finish() error {
   499		if err := config.ValidateRules(s.Config.Rules); err != nil {
   500			return err
   501		}
   502		labels := agentLabels()
   503		paths, err := currentPaths()
   504		if err != nil {
   505			return err
   506		}
   507		entry := rulesEntry(paths)
   508		seen := map[string]struct{}{}
   509		for _, selected := range config.ExecutionAgentsInUse(s.Config) {
   510			target := install.AgentRulesTarget(selected, paths)
   511			if _, ok := seen[target]; ok && target != "" {
   512				continue
   513			}
   514			seen[target] = struct{}{}
   515			outcome, ensureErr := install.EnsureRulesIntegration(selected, paths)
   516			if ensureErr != nil {
   517				warning(config.Text("menu.is_not_connected_to_kander_rules", labels[selected], ensureErr.Error()))
   518				hint(config.Text(
   519					"menu.follow_the_readme_integration_section_and_point_the_rules", entry,
   520				))
   521				continue
   522			}
   523			if outcome.Status == install.IntegrationPresent {
   524				success(config.Text("menu.is_connected_to_kander_rules", labels[selected], outcome.Target))
   525			} else {
   526				success(config.Text("menu.added_kander_rules_reference", labels[selected], outcome.Target))
   527			}
   528		}
   529		note(config.Text(
   530			"menu.note_kanban_start_uses_the_agent_s_no_confirmation",
   531		))
   532		note(RulesSessionNotice())
   533		if !s.EditingOverlay() {
   534			s.Config.WelcomeComplete = true
   535		}
   536		return nil
   537	}
