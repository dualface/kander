   620	func cloneStrings(src map[string]string) map[string]string {
   621		out := make(map[string]string, len(src))
   622		for k, v := range src {
   623			out[k] = v
   624		}
   625		return out
   626	}
   627	
   628	func cloneReviewStages(src map[string]map[string]string) map[string]map[string]string {
   629		out := make(map[string]map[string]string, len(src))
   630		for scale, roles := range src {
   631			out[scale] = cloneStrings(roles)
   632		}
   633		return out
   634	}

