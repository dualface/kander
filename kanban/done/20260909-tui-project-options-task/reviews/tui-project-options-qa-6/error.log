   566	func modelOverlayPath(field menu.ModelField) []string {
   567		if field.Agent == "" || field.FieldName() == "" {
   568			return nil
   569		}
   570		switch field.FieldName() {
   571		case "path", "process_name":
   572			return []string{"agents", field.Agent, field.FieldName()}
   573		case "model", "effort":
   574			return []string{"models", "review_roles", field.Agent, field.FieldName()}
   575		default:
   576			return []string{"models", "kanban", field.Agent, field.FieldName()}
   577		}
   578	}
