   397	// ExecutionModelFields is the flattened, order-preserving deduplication of the per-scale fields, for the line-based menu.
   398	func (s *Session) ExecutionModelFields() []ModelField {
   399		var out []ModelField
   400		seen := map[string]struct{}{}
   401		for _, scale := range config.TaskScales {
   402			for _, field := range s.ExecutionModelFieldsFor(scale) {
   403				if _, ok := seen[field.Key()]; ok {
   404					continue
   405				}
   406				seen[field.Key()] = struct{}{}
   407				out = append(out, field)
   408			}
   409		}
   410		return out
