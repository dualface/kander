    41	func (r Rules) Clone() Rules {
    42		copy := make(Rules, len(r))
    43		for key, enabled := range r {
    44			copy[key] = enabled
    45		}
    46		return copy
    47	}
    48	
    49	func ValidateRules(rules Rules) error {
    50		for _, key := range sortedRulesKeys(rules) {
    51			if !contains(RuleModules, key) {
    52				return configErrorf("rules.unknown_module", key)
    53			}
    54		}
    55		if rules[RuleTaskGroups] && !rules[RuleGit] {
    56			return configErrorf("rules.group_requires_git")
    57		}
    58		return nil
    59	}
    60	
    61	func sortedRulesKeys(rules Rules) []string {
    62		keys := make([]string, 0, len(rules))
    63		for key := range rules {
    64			keys = append(keys, key)
    65		}
    66		return sorted(keys)
    67	}
    68	
    69	func validateRules(raw any) (Rules, error) {
    70		obj, ok := asObject(raw)
    71		if !ok {
    72			return nil, configErrorf("rules.object_required")
    73		}
    74		rules := DefaultRules(false)
    75		for key, value := range obj {
    76			enabled, ok := value.(bool)
    77			if !ok {
    78				return nil, configErrorf("rules.boolean_required", key)
    79			}
    80			rules[key] = enabled
    81		}
    82		return rules, ValidateRules(rules)
    83	}
    84	
    85	// CheckTaskGroup is shared by start, resume, takeover and notify before side effects.
    86	func (r Rules) CheckTaskGroup(group string) error {
    87		if group == "" {
    88			return nil
    89		}
    90		if !r[RuleTaskGroups] || !r[RuleGit] {
    91			return configErrorf("rules.group_disabled", group)
    92		}
    93		return nil
    94	}
