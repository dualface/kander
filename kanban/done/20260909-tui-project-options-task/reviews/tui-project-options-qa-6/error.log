     5	// SetRules keeps both configuration UIs on the same validation and copy boundary.
     6	func (s *Session) SetRules(rules config.Rules) error {
     7		if err := config.ValidateRules(rules); err != nil {
     8			return err
     9		}
    10		previous := s.Config.Rules.Clone()
    11		if s.EditingOverlay() {
    12			return s.applyOverlayEdit(func(candidate map[string]any) {
    13				for _, module := range config.RuleModules {
    14					if previous[module] != rules[module] {
    15						config.OverlaySet(candidate, rules[module], "rules", module)
    16					}
    17				}
    18			})
    19		}
    20		s.Config.Rules = rules.Clone()
    21		s.ScopeDirty = true
    22		for _, module := range config.RuleModules {
    23			if previous[module] != rules[module] {
    24				s.syncScopeRaw([]string{"rules", module}, rules[module])
    25			}
    26		}
    27		return nil
    28	}
    29	
    30	func RulesSessionNotice() string {
    31		return config.Text("rules.session_notice")
    32	}
    33	
    34	func editRules(session *Session) error {
    35		for {
    36			var choices []Choice
    37			for _, module := range config.RuleModules {
    38				state := config.Text("rules.off")
    39				if session.Config.Rules[module] {
    40					state = config.Text("rules.on")
    41				}
    42				choices = append(choices, Choice{Value: module, Label: config.RuleLabel(module) + ": " + state})
    43			}
    44			choices = append(choices,
    45				Choice{Value: "all", Label: config.Text("rules.all")},
    46				Choice{Value: "none", Label: config.Text("rules.none")},
    47				Choice{Value: "back", Label: config.Text("rules.back")},
    48			)
    49			selected, err := askChoice(config.Text("rules.toggle"), choices, "back")
    50			if err != nil {
    51				return err
    52			}
    53			if selected == "back" {
    54				return nil
    55			}
    56			rules := session.Config.Rules.Clone()
    57			if selected == "all" || selected == "none" {
    58				rules = config.DefaultRules(selected == "all")
    59			} else {
    60				rules[selected] = !rules[selected]
    61			}
    62			if err := session.SetRules(rules); err != nil {
    63				warning(err.Error())
    64			}
    65		}
    66	}

