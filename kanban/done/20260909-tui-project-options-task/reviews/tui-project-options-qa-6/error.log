   531	// modelInputs turns a set of model fields into indented text inputs.
   532	// When one agent is shared by two scales or two roles they point at the same config entry, which is shown only once.
   533	func (p *optionsPanel) addModelInputs(bind *formBinding, fields []menu.ModelField) {
   534		for _, field := range fields {
   535			if _, ok := bind.modelSeen[field.Key()]; ok {
   536				continue
   537			}
   538			bind.modelSeen[field.Key()] = struct{}{}
   539			placeholder := field.Placeholder
   540			if placeholder == "" {
   541				placeholder = t("tui.empty_means_cli_default")
   542			}
   543			index := len(bind.modelFields)
   544			bind.modelFields = append(bind.modelFields, field)
   545			value := field.Value()
   546			bind.modelValues = append(bind.modelValues, &value)
   547			// Inline puts the title and the value on one line, compressing the block of one role/scale from 7 lines to 4.
   548			path := modelOverlayPath(field)
   549			title := modelIndent + field.Short + "  "
   550			if len(path) > 0 {
   551				title = p.inheritTitle(title, value, path...)
   552			}
   553			bind.fieldIndex[modelFocusKey(field)] = bind.focusable
   554			bind.addField(huh.NewInput().
   555				Title(title).
   556				Prompt("").
   557				Inline(true).
   558				Placeholder(placeholder).
   559				Value(bind.modelValues[index]))
   560			if len(path) > 0 {
   561				bind.addRestore(p, value, path...)
   562			}
   563		}
   564	}
