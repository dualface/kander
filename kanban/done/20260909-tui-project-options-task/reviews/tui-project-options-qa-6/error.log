   635	// apply writes the values changed in the form back to App and the config session immediately.
   636	// Huh updates its bound pointers as the cursor moves, which is what makes changes take effect while selecting;
   637	// returning with Esc loses nothing, because the changes already landed in the session.
   638	// Items with side effects (installing tmux) are not run here, see commitSideEffects.
   639	func (b *formBinding) apply(p *optionsPanel) {
   640		if b.applyRestores(p) {
   641			return
   642		}
   643		switch p.current {
   644		case sectionRules:
   645			b.applyRules(p)
   646		case sectionInterface:
   647			b.applyInterface(p)
   648			if p.session != nil && b.language != "" && p.session.Config.Language != b.language {
   649				before := p.overridePresence("language")
   650				p.session.SetLanguage(b.language)
   651				p.app.Context = tuiPageContext()
   652				p.markDirty()
   653				p.rebuildIfOverrideChanged(before, interfaceFocusKey("language"), "language")
   654			}
   655			if p.session != nil && b.agentLanguage != "" && p.session.Config.AgentLanguage != b.agentLanguage {
   656				before := p.overridePresence("agent_language")
   657				p.session.SetAgentLanguage(b.agentLanguage)
   658				p.markDirty()
   659				p.rebuildIfOverrideChanged(before, interfaceFocusKey("agent_language"), "agent_language")
   660			}
   661		case sectionExecution:
   662			session := p.session
   663			// The agent changed, so the model fields below it belong to a different object and this screen must be rebuilt;
   664			// focus returns to the line just edited so the interaction is not interrupted.
   665			if session.Config.KanbanAgents["large"] != b.large {
   666				session.SetExecutionAgent("large", b.large)
   667				p.markDirty()
   668				p.rebuildAt(scaleFocusKey("large"))
   669			}
   670			if session.Config.KanbanAgents["small"] != b.small {
   671				session.SetExecutionAgent("small", b.small)
   672				p.markDirty()
   673				p.rebuildAt(scaleFocusKey("small"))
   674			}
   675			if b.launcher != menu.LauncherInstallValue && session.Config.Launcher != b.launcher {
   676				before := p.overridePresence("launcher")
   677				session.SetLauncher(b.launcher)
   678				p.markDirty()
   679				p.rebuildIfOverrideChanged(before, launcherFocusKey(), "launcher")
   680			}
   681			b.applyModels(p)
   682		case sectionReview:
   683			session := p.session
   684			for _, role := range config.ReviewRoles {
   685				value := b.reviewers[role]
   686				if value != nil && session.Config.Reviewers[role] != *value {
   687					session.SetReviewer(role, *value)
   688					// The old values were configured for the old reviewer, so after the switch they are reset to the new reviewer's defaults.
   689					session.ResetReviewRoleModel(role)
   690					p.markDirty()
   691					p.rebuildAt(roleFocusKey(role))
   692				}
   693			}
   694			for _, role := range config.ReviewRoles {
   695				for _, scale := range config.TaskScales {
   696					value := b.stages[stageFocusKey(role, scale)]
   697					if value == nil {
   698						continue
   699					}
   700					current, err := config.ReviewStageFor(session.Config, scale, role)
   701					if err != nil {
   702						current = ""
   703					}
   704					if current != *value {
   705						path := []string{"review_stages", scale, role}
   706						before := p.overridePresence(path...)
   707						session.SetReviewStage(scale, role, *value)
   708						p.markDirty()
   709						p.rebuildIfOverrideChanged(before, stageFocusKey(role, scale), path...)
   710					}
   711				}
   712			}
   713			b.applyModels(p)
   714		}
   715	}
