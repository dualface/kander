   588	// NewSessionForTest builds a session that skips environment probing; it is for tests only.
   589	// The candidate agents are simply every value the schema allows, and no agent executable is invoked.
   590	func NewSessionForTest(existing *config.Config) (*Session, error) {
   591		session := &Session{existing: existing}
   592		labels := agentLabels()
   593		for _, name := range config.AgentNames(existing) {
   594			session.exec = append(session.exec, Choice{Value: name, Label: labels[name]})
   595		}
   596		for _, name := range config.ReviewAgents {
   597			session.review = append(session.review, Choice{Value: name, Label: labels[name]})
   598		}
   599		cfg := config.DefaultConfig()
   600		cfg.Agents = config.CloneAgents(existing.Agents)
   601		cfg.Models = copyModels(existing.Models)
   602		cfg.KanbanAgent = existing.KanbanAgent
   603		cfg.KanbanAgents = cloneStrings(existing.KanbanAgents)
   604		cfg.Reviewers = cloneStrings(existing.Reviewers)
   605		cfg.ReviewStages = cloneReviewStages(existing.ReviewStages)
   606		cfg.Rules = existing.Rules.Clone()
   607		cfg.Launcher = existing.Launcher
   608		cfg.TUI = existing.TUI
   609		cfg.Language = existing.Language
   610		cfg.AgentLanguage = existing.AgentLanguage
   611		session.Config = cfg
   612		session.initOverlayState()
   613		if path, err := config.ConfigPath(); err == nil {
   614			session.BasePath = path
   615		}
   616		return session, nil
   617	}
   618	
   619	func cloneStrings(src map[string]string) map[string]string {
   620		out := make(map[string]string, len(src))
   621		for k, v := range src {
   622			out[k] = v
   623		}
   624		return out
   625	}
   626	
   627	func cloneReviewStages(src map[string]map[string]string) map[string]map[string]string {
   628		out := make(map[string]map[string]string, len(src))
   629		for scale, roles := range src {
   630			out[scale] = cloneStrings(roles)
   631		}
   632		return out
