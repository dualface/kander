   234	// Focus markers: the prefix of a selected item is set by this package in huhTheme, while the left border of a focused field is drawn by Huh.
   235	const (
   236		focusMarker = "▸"
   237		focusBorder = "┃"
   238	)
   239	
   240	// focusRange finds the line range currently holding focus in the rendered output.
   241	// With a selected-item marker it is exact to that line, otherwise it falls back to the whole left border segment of the focused field.
   242	func focusRange(lines []string) (lo, hi int, ok bool) {
   243		lo, hi = -1, -1
   244		for i, line := range lines {
   245			text := ansi.Strip(line)
   246			if strings.Contains(text, focusMarker) {
   247				return i, i, true
   248			}
