   611	// reviewStageOptions is the UI wording of the three review stage policies; the config values remain auto/skip/required.
   612	func reviewStageOptions() []huh.Option[string] {
   613		labels := map[string]string{
   614			"auto":     "tui.labels.auto",
   615			"skip":     "tui.labels.skip",
   616			"required": "tui.labels.required",
   617		}
   618		out := make([]huh.Option[string], 0, len(config.ReviewStageModes))
   619		for _, mode := range config.ReviewStageModes {
