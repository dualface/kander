   523	// modelInputs turns a set of model fields into indented text inputs.
   524	// When one agent is shared by two scales or two roles they point at the same config entry, which is shown only once.
   525	func (p *optionsPanel) addModelInputs(bind *formBinding, fields []menu.ModelField) {
   526		for _, field := range fields {
   527			if _, ok := bind.modelSeen[field.Key()]; ok {
   528				continue
   529			}
   530			bind.modelSeen[field.Key()] = struct{}{}
   531			placeholder := field.Placeholder
   532			if placeholder == "" {
   533				placeholder = t("tui.empty_means_cli_default")
   534			}
   535			index := len(bind.modelFields)
   536			bind.modelFields = append(bind.modelFields, field)
   537			value := field.Value()
   538			bind.modelValues = append(bind.modelValues, &value)
   539			// Inline puts the title and the value on one line, compressing the block of one role/scale from 7 lines to 4.
   540			path := modelOverlayPath(field)
   541			title := modelIndent + field.Short + "  "
   542			if len(path) > 0 {
   543				title = p.inheritTitle(title, value, path...)
   544			}
   545			bind.addField(huh.NewInput().
   546				Title(title).
   547				Prompt("").
   548				Inline(true).
   549				Placeholder(placeholder).
   550				Value(bind.modelValues[index]))
   551			if len(path) > 0 {
   552				bind.addRestore(p, value, path...)
   553			}
   554		}
   555	}
   556	
   557	func modelOverlayPath(field menu.ModelField) []string {
   558		if field.Agent == "" || field.FieldName() == "" {
   559			return nil
   560		}
   561		switch field.FieldName() {
   562		case "path", "process_name":
   563			return []string{"agents", field.Agent, field.FieldName()}
   564		case "model", "effort":
   565			return []string{"models", "review_roles", field.Agent, field.FieldName()}
   566		default:
   567			return []string{"models", "kanban", field.Agent, field.FieldName()}
   568		}
   569	}
