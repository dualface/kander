   104	func cloneAgent(d AgentDefinition) AgentDefinition {
   105		if d.Args != nil {
   106			a := *d.Args
   107			a.Start = append([]string{}, a.Start...)
   108			a.Resume = append([]string{}, a.Resume...)
   109			d.Args = &a
   110		}
   111		if d.Session != nil {
   112			s := *d.Session
   113			s.Allocate = append([]string(nil), s.Allocate...)
   114			d.Session = &s
   115		}
   116		return d
   117	}
   118	
   119	func CloneAgents(src map[string]AgentDefinition) map[string]AgentDefinition {
   120		if src == nil {
   121			return nil
   122		}
   123		out := make(map[string]AgentDefinition, len(src))
   124		for name, d := range src {
   125			out[name] = cloneAgent(d)
   126		}
   127		return out
   128	}
