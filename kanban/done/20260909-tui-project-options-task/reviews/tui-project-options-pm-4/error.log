    49	func classifyReviewStages(obj map[string]any) (scales, roles, unknown []string) {
    50		scaleSet := reviewScaleSet()
    51		roleSet := reviewRoleSet()
    52		for key := range obj {
    53			switch {
    54			case containsKey(scaleSet, key):
    55				scales = append(scales, key)
    56			case containsKey(roleSet, key):
    57				roles = append(roles, key)
    58			default:
    59				unknown = append(unknown, key)
    60			}
    61		}
    62		return sorted(scales), sorted(roles), sorted(unknown)
    63	}
