   331	// SaveOverlayIfUnchanged writes only explicit overlay keys after validating the
   332	// merged effective config. An empty overlay deletes the file and never creates one.
   333	func SaveOverlayIfUnchanged(path string, overlay, baseline map[string]any) (string, error) {
   334		if path == "" {
   335			return "", configErrorf("config.failed_to_inspect_path", ".")
   336		}
   337		if overlay == nil {
   338			overlay = map[string]any{}
   339		}
   340		if err := validateOverlayKeys(path, overlay); err != nil {
   341			return "", err
   342		}
   343		scope, err := LoadScope(true)
   344		if err != nil {
   345			return "", err
   346		}
   347		if _, err := MergeScopeAndOverlay(scope, overlay); err != nil {
   348			return "", err
   349		}
   350		abs, err := lexicalAbsolute(path)
   351		if err != nil {
   352			return "", err
   353		}
   354		lockPath, err := overlayAdvisoryLock(abs)
   355		if err != nil {
   356			return "", err
   357		}
   358		err = withConfigLockFile(abs, lockPath, func() error {
   359			current, _, readErr := readOverlayMapAt(abs)
   360			if readErr != nil {
   361				return readErr
   362			}
   363			if !overlayMapsEqual(current, baseline) {
   364				return configErrorf("config.configuration_changed_while_editing")
   365			}
   366			if len(overlay) == 0 {
   367				return removeOverlayFile(abs)
   368			}
   369			return writeOverlayAt(abs, overlay)
   370		})
   371		if err != nil {
   372			return "", err
   373		}
   374		return abs, nil
   375	}
