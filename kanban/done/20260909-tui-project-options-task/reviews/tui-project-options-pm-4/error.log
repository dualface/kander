   155	// OverlayPath returns the absolute project overlay path for cwd, or "" when none exists.
   156	// A Git directory uses the main worktree root; otherwise the search walks up from cwd.
   157	func OverlayPath(cwd string) (string, error) {
   158		if cwd == "" {
   159			var err error
   160			cwd, err = os.Getwd()
   161			if err != nil {
   162				return "", configErrorfWrap(err, "config.failed_to_inspect_path", ".")
   163			}
   164		}
   165		start, err := lexicalAbsolute(cwd)
   166		if err != nil {
   167			return "", err
   168		}
   169		main, err := gitMainWorktree(start)
   170		if err != nil {
   171			return "", err
   172		}
   173		if main != "" {
   174			return inspectOverlayCandidate(filepath.Join(main, OverlayFilename))
   175		}
   176		return walkOverlay(start)
   177	}
