     1	package tui
     2	
     3	import (
     4		"github.com/dualface/kander/internal/config"
     5	)
     6	
     7	// uiPrefs is the UI preference view used inside the TUI; persistence goes through config.json alone.
     8	type uiPrefs struct {
     9		Columns        int
    10		MinColumnWidth int
    11		Theme          string
    12		Refresh        int
    13		Single         bool
    14	}
    15	
    16	func defaultPrefs() uiPrefs {
    17		return prefsFromConfig(config.DefaultTUI())
    18	}
    19	
    20	func loadPrefs() uiPrefs {
    21		cfg, err := config.Load(true)
    22		if err != nil {
    23			return defaultPrefs()
    24		}
    25		return prefsFromConfig(cfg.TUI)
    26	}
    27	
    28	// savePrefs writes the caller-provided UI preferences into the scope
    29	// config.json as a whole TUI section. Callers must pass unmerged scope
    30	// values; this function does not filter overlay-only fields.
    31	func savePrefs(prefs uiPrefs) (config.TUI, error) {
    32		value := prefsConfig(prefs)
    33		_, err := config.Update(func(cfg *config.Config) error {
    34			cfg.TUI = value
    35			return nil
    36		})
    37		return value, err
    38	}
    39	
    40	func prefsFromConfig(value config.TUI) uiPrefs {
    41		return uiPrefs{
    42			Columns:        value.Columns,
    43			MinColumnWidth: value.MinColumnWidth,
    44			Theme:          value.Theme,
    45			Refresh:        value.Refresh,
    46			Single:         value.Single,
    47		}
    48	}
    49	
    50	func prefsConfig(prefs uiPrefs) config.TUI {
    51		theme := prefs.Theme
    52		if !containsString(themes, theme) {
    53			theme = "auto"
    54		}
    55		return config.TUI{
    56			Columns:        clampColumns(prefs.Columns),
    57			MinColumnWidth: clampMinColumnWidth(prefs.MinColumnWidth),
    58			Refresh:        clampRefresh(prefs.Refresh),
    59			Single:         prefs.Single,
    60			Theme:          theme,
    61		}
    62	}
    63	
    64	// saveColumns remembers how many columns the user wants on screen.
    65	// Only Columns is written so overlay-only TUI keys stay out of the scope file.
    66	func saveColumns(count int) (config.TUI, error) {
    67		var written config.TUI
    68		_, err := config.Update(func(cfg *config.Config) error {
    69			cfg.TUI.Columns = clampColumns(count)
    70			written = cfg.TUI
    71			return nil
    72		})
    73		return written, err
    74	}

