    14	// innerWidth is the number of writable columns inside the popup border; rendering and measuring must use the same value.
    15	// The panel asks for a four-column margin on each side and lets the popup clamp from there.
    16	func (p *optionsPanel) innerWidth() int {
    17		screenHeight, screenWidth := p.app.size()
    18		return p.frame("").inner(screenWidth, screenHeight, screenWidth-12)
    19	}
    20	
    21	// frame is the popup shape of the settings panel. The title is filled in only when it is being rendered.
    22	func (p *optionsPanel) frame(title string) popup {
    23		return popup{Title: title, TightFit: true}
    24	}
    25	
    26	// startForm installs a new form: Init first draws the fields into the viewport, then the natural height is measured.
    27	// Measuring too early finds an empty viewport, dropping the trailing blanks yields 1, and the following WithHeight(1) cuts the whole page away.
    28	func (p *optionsPanel) startForm(form *huh.Form) tea.Cmd {
    29		p.form = form
    30		cmd := form.Init()
    31		p.measureForm()
    32		return cmd
    33	}
    34	
    35	// measureForm records the natural height of the form. Huh's WithHeight pads the form up to the given height,
    36	// so it has to be measured once before the height is set, for the popup to hug its content afterwards.
    37	// NewGroup inflates the viewport with Charm's default style before the theme is applied, so View() carries trailing blanks;
    38	// they are dropped while measuring, otherwise a field-heavy page such as review would keep a large empty tail.
    39	func (p *optionsPanel) measureForm() {
    40		if p.form == nil {
    41			return
    42		}
    43		p.formWidth = p.innerWidth()
    44		p.syncFormTheme(themePalette(p.app.Theme))
    45		p.form.WithWidth(p.formWidth)
    46		p.formNatural = contentHeight(p.form.View())
    47	}
    48	
    49	func contentHeight(view string) int {
    50		n := len(trimTrailingBlank(strings.Split(view, "\n")))
    51		if n < 1 {
    52			return 1
    53		}
    54		return n
    55	}
    56	
    57	func optionsHeader(left string, width int) string {
    58		right := clipText(version.String(), width)
    59		rightWidth := displayWidth(right)
    60		if rightWidth >= width {
    61			return padLine(right, width)
    62		}
    63		left = clipText(left, width-rightWidth-1)
    64		gap := width - displayWidth(left) - rightWidth
    65		return left + strings.Repeat(" ", gap) + right
    66	}
    67	
    68	// view renders the popup and records its geometry for mouse hit testing.
    69	// The body is rendered against the available space first, then the border is tightened to the body's actual height to avoid large blank areas.
    70	func (p *optionsPanel) view() (popupBox, string) {
    71		palette := themePalette(p.app.Theme)
    72		screenHeight, screenWidth := p.app.size()
    73	
    74		inner := p.innerWidth()
    75		// The title text only comes out of content() below, but it is always a single line, so the frame
    76		// can be measured with a stand-in already.
    77		frame := p.frame("title")
    78		// When the content does not fit, the options popup may reach the top and bottom edges of the terminal, so the rule modules do not
    79		// start scrolling merely because of the popup's outer margin.
    80		maxBody := screenHeight - frame.chrome()
    81		if maxBody < 3 {
    82			maxBody = 3
    83		}
    84	
    85		title, body := p.content(palette, inner, maxBody)
    86		lines := trimTrailingBlank(strings.Split(body, "\n"))
    87		if len(lines) > maxBody {
    88			lines = lines[:maxBody]
    89		}
    90		frame.Title = optionsHeader(title, inner)
    91	
    92		box, bodyBox, out := frame.render(palette, screenWidth, screenHeight, inner, strings.Join(lines, "\n"))
    93		p.box = box
    94		p.bodyX, p.bodyY = bodyBox.X, bodyBox.Y
    95		p.bodyWidth, p.bodyHeight = bodyBox.Width, bodyBox.Height
    96		p.bodyLines = lines
    97		return box, out
    98	}
