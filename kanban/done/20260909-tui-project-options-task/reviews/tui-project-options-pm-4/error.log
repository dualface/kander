   109	func (a *App) finishMouseSelection() {
   110		if !a.MouseSelecting {
   111			return
   112		}
   113		if a.MouseAnchor == nil || a.MouseCursor == nil {
   114			a.resetMouseSelection()
   115			return
   116		}
   117		var text string
   118		if a.MouseAnchor.Kind == "board" {
   119			text = a.extractBoardMouseSelection()
   120		} else {
   121			text = a.extractDetailMouseSelection()
   122		}
   123		a.resetMouseSelection()
   124		if text != "" {
   125			a.copyText(text)
   126		}
   127	}
