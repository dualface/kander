   167					a.resetMouseSelection()
   168				}
   169			}
   170			return
   171		}
   172		if a.MouseSelecting && (mouseButton1Dragging(bstate) || mouseLeftPressed(bstate)) {
   173			if hit := a.detailHit(x, y); hit != nil {
   174				a.MouseCursor = hit
   175			}
