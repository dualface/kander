   377	// overlayAdvisoryLock keeps the exclusive lock out of the project tree so a
   378	// save cannot leave .kander-config.json.lock next to user sources.
   379	func overlayAdvisoryLock(overlay string) (string, error) {
   380		cfgPath, err := ConfigPath()
   381		if err != nil {
   382			return "", err
   383		}
   384		sum := sha256.Sum256([]byte(overlay))
   385		return filepath.Join(filepath.Dir(cfgPath), "overlay-"+hex.EncodeToString(sum[:8])+".lock"), nil
   386	}

