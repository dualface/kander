   279	// Save validates and then atomically writes config.json.
   280	func Save(cfg *Config) (string, error) {
   281		path, err := ConfigPath()
   282		if err != nil {
   283			return "", err
   284		}
   285		var saved string
   286		err = withConfigLock(path, func() error {
   287			var saveErr error
   288			saved, saveErr = saveConfigAt(path, cfg)
   289			return saveErr
   290		})
   291		return saved, err
   292	}
   293	
   294	// Update re-reads, mutates and saves the config inside a single cross-process lock.
   295	func Update(mutate func(*Config) error) (string, error) {
   296		path, err := ConfigPath()
   297		if err != nil {
   298			return "", err
   299		}
   300		var saved string
   301		err = withConfigLock(path, func() error {
   302			cfg, loadErr := loadValidated(path, true)
   303			if loadErr != nil {
   304				return loadErr
   305			}
   306			if mutate != nil {
   307				if mutateErr := mutate(cfg); mutateErr != nil {
   308					return mutateErr
   309				}
   310			}
   311			var saveErr error
   312			saved, saveErr = saveConfigAt(path, cfg)
   313			return saveErr
   314		})
   315		return saved, err
   316	}
   317	
   318	// SetLanguageIfPresent updates language in an existing config.json and does nothing when the file is missing.
   319	func SetLanguageIfPresent(path, lang string) error {
   320		if !contains(Languages, lang) {
   321			return choiceError("language", strings.Join(Languages, ", "))
   322		}
   323		if path == "" {
   324			return nil
   325		}
   326		data, err := readConfigBytes(path)
   327		if err != nil {
   328			return configErrorfWrap(err, "config.failed_to_read_config", path, err.Error())
   329		}
   330		if data == nil {
   331			return nil
   332		}
   333		return withConfigLock(path, func() error {
   334			cfg, loadErr := loadValidated(path, false)
   335			if loadErr != nil {
   336				return loadErr
   337			}
   338			if cfg.Language == lang {
   339				return nil
   340			}
   341			cfg.Language = lang
   342			_, saveErr := saveConfigAt(path, cfg)
   343			return saveErr
   344		})
   345	}
   346	
   347	func configEditConflicts(current, baseline, target *Config) bool {
   348		if current == nil || baseline == nil || target == nil {
   349			return true
   350		}
   351		currentValue := reflect.ValueOf(*current)
   352		baselineValue := reflect.ValueOf(*baseline)
   353		targetValue := reflect.ValueOf(*target)
   354		for i := 0; i < currentValue.NumField(); i++ {
   355			currentField := currentValue.Field(i).Interface()
   356			baselineField := baselineValue.Field(i).Interface()
   357			targetField := targetValue.Field(i).Interface()
   358			if !reflect.DeepEqual(currentField, baselineField) && !reflect.DeepEqual(currentField, targetField) {
   359				return true
   360			}
   361		}
   362		return false
   363	}
   364	
   365	// SaveIfUnchanged saves only while the on-disk config still equals the editing baseline; a missing file may be created directly.
   366	func SaveIfUnchanged(cfg, baseline *Config) (string, error) {
   367		path, err := ConfigPath()
   368		if err != nil {
   369			return "", err
   370		}
   371		var saved string
   372		err = withConfigLock(path, func() error {
   373			data, readErr := readConfigBytes(path)
   374			if readErr != nil {
   375				return configErrorfWrap(readErr, "config.failed_to_read_config", path, readErr.Error())
   376			}
   377			if data != nil {
   378				current, loadErr := loadValidated(path, false)
   379				if loadErr != nil {
   380					return loadErr
   381				}
   382				if configEditConflicts(current, baseline, cfg) {
   383					return configErrorf("config.configuration_changed_while_editing")
   384				}
   385			}
   386			var saveErr error
   387			saved, saveErr = saveConfigAt(path, cfg)
   388			return saveErr
   389		})
   390		return saved, err
