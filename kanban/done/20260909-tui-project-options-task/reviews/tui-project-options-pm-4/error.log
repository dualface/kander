   127	func (p *optionsPanel) hitTab(x, y int) string {
   128		if y != 0 || len(p.tabHits) == 0 {
   129			return ""
   130		}
   131		for _, hit := range p.tabHits {
   132			if x >= hit.x0 && x < hit.x1 {
   133				return hit.target
   134			}
   135		}
   136		return ""
   137	}
   138	
   139	func (p *optionsPanel) handleTabMouse(x, y, bstate int) tea.Cmd {
   140		if !optionsMouseActivate(bstate) || p.session == nil {
   141			return nil
   142		}
   143		localX := x - p.bodyX
   144		localY := y - p.bodyY
   145		target := p.hitTab(localX, localY)
   146		if target == "" {
   147			return nil
   148		}
   149		return p.switchTab(target)
   150	}
