   141	// isolatedHome gives the child process its own HOME and config path and drops in a fake codex,
   142	// so the test neither reads nor writes the user's real Kander config.
   143	func isolatedHome(t *testing.T) (home string, env []string) {
   144		t.Helper()
   145		root := t.TempDir()
   146		home = filepath.Join(root, "home")
   147		fakeBin := filepath.Join(root, "bin")
   148		for _, dir := range []string{home, fakeBin} {
   149			if err := os.MkdirAll(dir, 0o755); err != nil {
   150				t.Fatal(err)
   151			}
   152		}
   153		script := "#!/bin/sh\nprintf '%s\\n' 'codex test-version'\n"
   154		if err := os.WriteFile(filepath.Join(fakeBin, "codex"), []byte(script), 0o755); err != nil {
   155			t.Fatal(err)
   156		}
   157		env = []string{
