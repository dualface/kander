    37	var agentNamePattern = regexp.MustCompile(`^[a-z][a-z0-9_-]{0,63}$`)
    38	
    39	func ValidAgentName(name string) bool { return agentNamePattern.MatchString(name) }
    40	
    41	func AgentNames(cfg *Config) []string {
    42		names := append([]string{}, ExecutionAgents...)
    43		var custom []string
    44		if cfg != nil {
    45			for name := range cfg.Agents {
    46				if !contains(names, name) {
    47					custom = append(custom, name)
    48				}
    49			}
    50		}
    51		sort.Strings(custom)
    52		return append(names, custom...)
    53	}
    54	
    55	func HasAgent(cfg *Config, name string) bool { return contains(AgentNames(cfg), name) }
    56	
    57	// AgentFor returns a detached definition with defaults resolved. The discovered
    58	// mode is internal to the Codex dialect and cannot be declared in JSON.
    59	func AgentFor(cfg *Config, name string) AgentDefinition {
    60		var d AgentDefinition
    61		if cfg != nil {
    62			d = cloneAgent(cfg.Agents[name])
    63		}
    64		if d.Path == "" {
    65			d.Path = AgentExecutableName(name)
    66		}
    67		if d.ProcessName == "" {
    68			d.ProcessName = filepath.Base(d.Path)
    69		}
    70		if d.Dialect == "" && contains(ExecutionAgents, name) {
    71			d.Dialect = name
    72		}
    73		if d.Session == nil {
    74			mode := "generated"
    75			switch d.Dialect {
    76			case "codex":
    77				mode = "discovered"
    78			case "cursor":
    79				mode = "allocated"
    80			}
    81			d.Session = &AgentSessionDefinition{Mode: mode}
    82			if d.Dialect == "cursor" {
    83				d.Session.Allocate = []string{d.Path, "create-chat"}
    84			}
    85		}
    86		return d
    87	}
    88	
    89	func AgentPath(cfg *Config, name string) string        { return AgentFor(cfg, name).Path }
    90	func AgentProcessName(cfg *Config, name string) string { return AgentFor(cfg, name).ProcessName }
    91	
    92	// LoadAgent resolves current runtime settings without caching machine-local state.
    93	func LoadAgent(name string) (AgentDefinition, error) {
    94		cfg, err := Effective(nil)
    95		if err != nil {
    96			return AgentDefinition{}, err
    97		}
    98		if !HasAgent(cfg, name) {
    99			return AgentDefinition{}, choiceError("agent", strings.Join(AgentNames(cfg), ", "))
   100		}
   101		return AgentFor(cfg, name), nil
   102	}
