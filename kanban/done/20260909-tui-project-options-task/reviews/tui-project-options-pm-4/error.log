    99			RuleCode:          "rules.code",
   100			RuleGit:           "rules.git",
   101			RuleReview:        "rules.review",
   102			RuleTaskIntake:    "rules.task_intake",
   103			RuleTaskGroups:    "rules.task_groups",
   104			RuleReporting:     "rules.reporting",
   105		}
   106		if label, ok := labels[module]; ok {
