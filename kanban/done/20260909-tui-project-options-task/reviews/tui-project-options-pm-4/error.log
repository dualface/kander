    99	
   100	func (s *ptySession) text() string {
   101		s.mu.Lock()
   102		defer s.mu.Unlock()
   103		return string(s.out)
   104	}
   105	
   106	// waitFor waits for some text to appear in the pseudo-terminal output.
   107	func (s *ptySession) waitFor(needle string, timeout time.Duration) bool {
   108		s.t.Helper()
   109		deadline := time.Now().Add(timeout)
   110		for time.Now().Before(deadline) {
   111			if bytes.Contains([]byte(s.text()), []byte(needle)) {
   112				return true
   113			}
   114			time.Sleep(50 * time.Millisecond)
   115		}
   116		return false
   117	}
   118	
   119	func (s *ptySession) waitExit(timeout time.Duration) error {
   120		s.t.Helper()
   121		select {
   122		case err := <-s.done:
   123			return err
   124		case <-time.After(timeout):
   125			s.t.Fatalf("process did not exit\npty:\n%s", s.text())
   126			return nil
   127		}
   128	}
