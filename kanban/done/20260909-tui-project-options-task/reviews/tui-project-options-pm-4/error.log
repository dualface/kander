   597	func validateTUI(raw any) (TUI, error) {
   598		obj, ok := asObject(raw)
   599		if !ok {
   600			return TUI{}, configErrorf("config.tui_must_be_a_json_object")
   601		}
   602		allowed := map[string]struct{}{
   603			"columns": {}, "min_column_width": {}, "refresh": {}, "single": {}, "theme": {},
   604		}
   605		var unknown []string
   606		for key := range obj {
   607			if _, ok := allowed[key]; !ok {
   608				unknown = append(unknown, key)
   609			}
   610		}
   611		if len(unknown) > 0 {
   612			return TUI{}, configErrorf(
   613				"config.tui_has_unknown_fields", strings.Join(sorted(unknown), ", "),
   614			)
   615		}
   616		columns, err := validateInteger(obj["columns"], "tui.columns", MinTUIColumns, MaxTUIColumns)
   617		if err != nil {
   618			return TUI{}, err
   619		}
   620		width, err := validateInteger(obj["min_column_width"], "tui.min_column_width", MinTUIMinColumnWidth, MaxTUIMinColumnWidth)
   621		if err != nil {
   622			return TUI{}, err
   623		}
   624		refresh, err := validateInteger(obj["refresh"], "tui.refresh", MinTUIRefresh, MaxTUIRefresh)
   625		if err != nil {
   626			return TUI{}, err
   627		}
   628		single, ok := obj["single"].(bool)
   629		if !ok {
   630			return TUI{}, configErrorf("config.tui_single_must_be_a_boolean")
   631		}
   632		theme, err := validateChoice(obj["theme"], TUIThemes, "tui.theme")
   633		if err != nil {
   634			return TUI{}, err
   635		}
   636		return TUI{Columns: columns, MinColumnWidth: width, Refresh: refresh, Single: single, Theme: theme}, nil
   637	}
