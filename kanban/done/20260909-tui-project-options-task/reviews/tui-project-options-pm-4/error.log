   130		if mouseButton1Released(bstate) && bstate&mouseBtn1Clicked == 0 {
   131			if y != headerRow {
   132				a.Searching = false
   133				a.ShowCursor = false
   134			}
   135			return
   136		}
   137		if !mouseLeftClicked(bstate) {
