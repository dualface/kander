    23			huh.NewConfirm().
    24				Title(menu.HerdrInstallPrompt()).
    25				Description(menu.HerdrInstallCommand()).
    26				Affirmative(t("menu.install_herdr")).
    27				Negative(t("tui.skip_and_continue")).
    28				Value(&p.installHerdr),
    29		)))
    30	}
    31	
    32	func (p *optionsPanel) finishHerdrInstall() tea.Cmd {
    33		if !p.installHerdr {
    34			return p.continueDoctor()
    35		}
    36		p.form = nil
    37		p.current = ""
    38		p.status = t("tui.installing_herdr")
    39		p.app.pendingShell = func() {
    40			lines, _ := p.session.InstallHerdr()
    41			p.doctorLines = lines
    42			p.status = t("tui.running_environment_check")
    43			// Re-probe and continue even when the install fails; no concurrent check runs while the installer does.
    44			p.app.pendingWork = func() any {
    45				return runDoctorReport(menu.CheckTerminalTools())
    46			}
    47		}
    48		return nil
    49	}
    50	
    51	func (p *optionsPanel) continueDoctor() tea.Cmd {
    52		p.form = nil
    53		p.current = ""
    54		p.status = t("tui.running_environment_check")
    55		tools := p.doctorTools
    56		p.app.pendingWork = func() any {
    57			return runDoctorReport(tools)
    58		}
    59		return nil
    60	}
    61	
    62	func runDoctorReport(tools menu.TerminalTools) doctorResult {
    63		before, _ := config.LoadScope(true)
    64		lines, healthy := menu.DoctorReport(tools)
    65		after, _ := config.LoadScope(false)
    66		return doctorResult{lines: lines, healthy: healthy, before: before, after: after}
