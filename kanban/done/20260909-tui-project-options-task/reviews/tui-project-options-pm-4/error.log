   118	// Init returns the command to run when the panel starts (the loading spinner or the form initialization).
   119	func (p *optionsPanel) Init() tea.Cmd {
   120		if p.form != nil {
   121			return p.form.Init()
   122		}
   123		return p.spinner.Tick
   124	}
   125	
   126	func (p *optionsPanel) requestSession() {
   127		p.app.pendingWork = func() any {
   128			existing, err := config.LoadScope(true)
   129			valid := err == nil
   130			if err != nil {
   131				existing = config.DefaultConfig()
   132			}
   133			session, sessionErr := menu.NewSession(existing, valid)
   134			return sessionResult{session: session, err: sessionErr}
   135		}
   136	}
   137	
   138	type sessionResult struct {
   139		session *menu.Session
   140		err     error
   141	}
   142	
   143	type doctorResult struct {
   144		lines   []menu.ReportLine
   145		healthy bool
   146		before  *config.Config
   147		after   *config.Config
   148	}
   149	
   150	// applyWork consumes the result of a background task; the Bubble Tea shell calls it on a workMsg.
   151	func (a *App) applyWork(payload any) tea.Cmd {
   152		if result, ok := payload.(startPreviewResult); ok {
   153			a.applyStartPreview(result)
   154			return nil
   155		}
   156		if result, ok := payload.(startResult); ok {
   157			a.applyStartResult(result)
   158			return nil
   159		}
   160		if result, ok := payload.(focusResult); ok {
   161			a.focusRunning = false
   162			a.showFocusNotice(result.message)
   163			return nil
   164		}
   165		panel := a.Options
   166		if panel == nil {
   167			return nil
   168		}
   169		switch result := payload.(type) {
   170		case sessionResult:
   171			if result.err != nil {
   172				panel.loadErr = result.err.Error()
   173				return nil
   174			}
   175			a.Session = result.session
   176			panel.session = result.session
   177			if panel.initial != "" {
   178				section := panel.initial
   179				panel.initial = ""
   180				return panel.dispatch(section)
   181			}
   182			return panel.openRoot()
   183		case terminalToolsResult:
   184			return panel.beginDoctor(result.tools)
   185		case doctorResult:
   186			panel.status = ""
   187			if panel.session != nil && result.after != nil {
   188				if err := panel.session.ApplyDoctorConfig(result.before, result.after, panel.dirty); err != nil {
   189					result.lines = append(result.lines, menu.ReportLine{Level: menu.LevelWarning, Text: err.Error()})
   190				}
   191			}
   192			panel.showReport(t("tui.environment_check"), append(panel.doctorLines, result.lines...), "")
   193			panel.doctorLines = nil
   194		}
   195		return nil
   196	}
