   129	// ResolveOverlayLocation returns the overlay path that Options will read and write.
   130	// Git uses the main worktree; a missing file still names that path. Non-Git reuses
   131	// walk-up when a file exists, otherwise the start directory is the create target.
   132	func ResolveOverlayLocation(cwd string) (OverlayLocation, error) {
   133		if cwd == "" {
   134			var err error
   135			cwd, err = os.Getwd()
   136			if err != nil {
   137				return OverlayLocation{}, configErrorfWrap(err, "config.failed_to_inspect_path", ".")
   138			}
   139		}
   140		start, err := lexicalAbsolute(cwd)
   141		if err != nil {
   142			return OverlayLocation{}, err
   143		}
   144		main, err := gitMainWorktree(start)
   145		if err != nil {
   146			return OverlayLocation{}, err
   147		}
   148		if main != "" {
   149			return overlayLocationAt(main)
   150		}
   151		existing, err := walkOverlay(start)
   152		if err != nil {
   153			return OverlayLocation{}, err
   154		}
   155		if existing != "" {
   156			return OverlayLocation{
   157				ProjectRoot: filepath.Dir(existing),
   158				Path:        existing,
   159				Exists:      true,
   160			}, nil
   161		}
   162		return overlayLocationAt(start)
   163	}
