   346	// resizeForm rebuilds the form so every page re-measures its natural height against the new terminal size.
   347	// Huh's WithHeight cannot be undone; a form once compressed by a short terminal can only leave the scrolling layout through a rebuild.
   348	func (p *optionsPanel) resizeForm() tea.Cmd {
   349		if p.form == nil || p.report != nil {
   350			return nil
   351		}
   352		if p.confirming {
   353			return p.openCloseConfirm()
   354		}
   355		if p.current == "" {
   356			return p.openRoot()
   357		}
   358		index := 0
   359		if p.bind != nil {
   360			focused := p.form.GetFocusedField()
   361			for _, field := range p.bind.formFields {
   362				if field.Skip() {
   363					continue
   364				}
   365				if field == focused {
   366					break
   367				}
   368				index++
   369			}
   370		}
   371		section := p.current
