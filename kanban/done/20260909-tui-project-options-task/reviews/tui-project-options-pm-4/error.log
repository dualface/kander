   282	// LauncherInstallValue is the value of the "install tmux" item in the launcher list.
   283	const LauncherInstallValue = "install-tmux"
   284	
   285	// LauncherChoices returns the launchers available on the current platform, plus the install item when tmux is missing.
   286	func (s *Session) LauncherChoices() []Choice {
   287		if isWindowsOS() {
   288			return windowsLauncherChoices(s.Config)
   289		}
   290		foreground := Choice{Value: "foreground", Label: config.Text("menu.foreground_in_this_terminal")}
   291		choices := []Choice{autoLauncherChoice()}
   292		if lookPath("tmux") != "" {
   293			choices = append(choices, tmuxLauncherChoices()...)
   294			choices = append(choices, herdrLauncherChoices(s.Config)...)
   295			return append(choices, foreground)
   296		}
   297		unavailable := config.Text("menu.not_currently_installed")
   298		for _, item := range tmuxLauncherChoices() {
   299			if s.Config.Launcher == item.Value {
   300				choices = append(choices, Choice{Value: item.Value, Label: item.Label + unavailable})
   301			}
   302		}
   303		choices = append(choices, herdrLauncherChoices(s.Config)...)
   304		return append(choices, foreground, Choice{
   305			Value: LauncherInstallValue,
   306			Label: config.Text("menu.install_tmux_and_use_a_new_window"),
   307		})
   308	}
