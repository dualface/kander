   248	func (s *Session) saveScope() (string, error) {
   249		cfg := s.scopeBuffer()
   250		if cfg == nil {
   251			return "", nil
   252		}
   253		cfg.WelcomeComplete = true
   254		baseline := s.scopeExisting
