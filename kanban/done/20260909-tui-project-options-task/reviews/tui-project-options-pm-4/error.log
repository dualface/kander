    53	// OverlayGet walks path and returns the value when the leaf key is present.
    54	func OverlayGet(overlay map[string]any, path ...string) (any, bool) {
    55		if overlay == nil || len(path) == 0 {
    56			return nil, false
    57		}
    58		current := overlay
    59		for i, key := range path {
    60			value, ok := current[key]
    61			if !ok {
    62				return nil, false
    63			}
    64			if i == len(path)-1 {
    65				return value, true
    66			}
    67			next, ok := value.(map[string]any)
    68			if !ok {
    69				return nil, false
    70			}
    71			current = next
    72		}
    73		return nil, false
    74	}
