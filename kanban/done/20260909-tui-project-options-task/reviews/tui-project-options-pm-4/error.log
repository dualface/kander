    33	func cloneRawValue(v any) any {
    34		switch typed := v.(type) {
    35		case map[string]any:
    36			return cloneRawObjectDeep(typed)
    37		case []any:
    38			out := make([]any, len(typed))
    39			for i, item := range typed {
