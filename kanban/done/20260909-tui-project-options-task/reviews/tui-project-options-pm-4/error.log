   184		next := key.NewBinding(key.WithKeys("down", "tab"), key.WithHelp("↑↓", t("tui.move")))
   185		prev := key.NewBinding(key.WithKeys("up", "shift+tab"))
   186		submit := key.NewBinding(key.WithKeys("enter"), key.WithHelp("enter", t("tui.submit")))
   187		change := key.NewBinding(key.WithKeys("right", "l"), key.WithHelp("←→", t("tui.change")))
   188		changeBack := key.NewBinding(key.WithKeys("left", "h"))
   189	
   190		keys.Select.Next = next
   191		keys.Select.Prev = prev
   192		keys.Select.Submit = submit
   193		// ↑↓ is given to field navigation and values change with ←→; only an Inline Select enables Left/Right.
   194		keys.Select.Up = key.NewBinding(key.WithDisabled())
   195		keys.Select.Down = key.NewBinding(key.WithDisabled())
   196		keys.Select.Left = changeBack
   197		keys.Select.Right = change
   198	
   199		keys.Confirm.Next = next
   200		keys.Confirm.Prev = prev
   201		keys.Confirm.Submit = submit
   202		keys.Confirm.Toggle = key.NewBinding(key.WithKeys("left", "right", "h", "l"), key.WithHelp("←→", t("tui.toggle")))
