   626	// apply writes the values changed in the form back to App and the config session immediately.
   627	// Huh updates its bound pointers as the cursor moves, which is what makes changes take effect while selecting;
   628	// returning with Esc loses nothing, because the changes already landed in the session.
   629	// Items with side effects (installing tmux) are not run here, see commitSideEffects.
   630	func (b *formBinding) apply(p *optionsPanel) {
   631		if b.applyRestores(p) {
   632			return
   633		}
   634		switch p.current {
   635		case sectionRules:
   636			b.applyRules(p)
   637		case sectionInterface:
   638			b.applyInterface(p)
   639			if p.session != nil && b.language != "" && p.session.Config.Language != b.language {
   640				p.session.SetLanguage(b.language)
   641				p.app.Context = tuiPageContext()
   642				p.markDirty()
   643			}
   644			if p.session != nil && b.agentLanguage != "" && p.session.Config.AgentLanguage != b.agentLanguage {
   645				p.session.SetAgentLanguage(b.agentLanguage)
   646				p.markDirty()
   647			}
   648		case sectionExecution:
   649			session := p.session
   650			// The agent changed, so the model fields below it belong to a different object and this screen must be rebuilt;
   651			// focus returns to the line just edited so the interaction is not interrupted.
   652			if session.Config.KanbanAgents["large"] != b.large {
   653				session.SetExecutionAgent("large", b.large)
   654				p.markDirty()
   655				p.rebuildAt(scaleFocusKey("large"))
   656			}
   657			if session.Config.KanbanAgents["small"] != b.small {
   658				session.SetExecutionAgent("small", b.small)
   659				p.markDirty()
   660				p.rebuildAt(scaleFocusKey("small"))
   661			}
   662			if b.launcher != menu.LauncherInstallValue && session.Config.Launcher != b.launcher {
   663				session.SetLauncher(b.launcher)
   664				p.markDirty()
   665			}
   666			b.applyModels(p)
   667		case sectionReview:
   668			session := p.session
   669			for _, role := range config.ReviewRoles {
   670				value := b.reviewers[role]
   671				if value != nil && session.Config.Reviewers[role] != *value {
   672					session.SetReviewer(role, *value)
   673					// The old values were configured for the old reviewer, so after the switch they are reset to the new reviewer's defaults.
   674					session.ResetReviewRoleModel(role)
   675					p.markDirty()
   676					p.rebuildAt(roleFocusKey(role))
   677				}
   678			}
   679			for _, role := range config.ReviewRoles {
   680				for _, scale := range config.TaskScales {
   681					value := b.stages[stageFocusKey(role, scale)]
   682					if value == nil {
   683						continue
   684					}
   685					current, err := config.ReviewStageFor(session.Config, scale, role)
   686					if err != nil {
   687						current = ""
   688					}
   689					if current != *value {
   690						session.SetReviewStage(scale, role, *value)
   691						p.markDirty()
   692					}
   693				}
   694			}
   695			b.applyModels(p)
   696		}
   697	}
