     5	// Rules controls optional workflow advice, not the contracts of the commands themselves.
     6	type Rules map[string]bool
     7	
     8	const (
     9		RuleCollaboration = "collaboration"
    10		RuleCode          = "code"
    11		RuleGit           = "git"
    12		RuleReview        = "review"
    13		RuleTaskIntake    = "task_intake"
    14		RuleTaskGroups    = "task_groups"
    15		RuleReporting     = "reporting"
    16	)
    17	
    18	var RuleModules = []string{
    19		RuleCollaboration, RuleCode, RuleGit, RuleReview, RuleTaskIntake, RuleTaskGroups, RuleReporting,
    20	}
    21	
    22	// DefaultRules returns an independent selection for the current modules.
    23	func DefaultRules(enabled bool) Rules {
    24		rules := make(Rules, len(RuleModules))
    25		for _, module := range RuleModules {
    26			rules[module] = enabled
    27		}
    28		return rules
    29	}
    30	
    31	// legacyRules preserves only the modules shipped before rules became configurable.
    32	// Future modules must not be implicitly enabled for old configurations.
    33	func legacyRules() Rules {
    34		rules := DefaultRules(false)
    35		for _, module := range []string{RuleCollaboration, RuleCode, RuleGit, RuleReview, RuleTaskIntake, RuleTaskGroups, RuleReporting} {
    36			rules[module] = true
    37		}
    38		return rules
    39	}
    40	
    41	func (r Rules) Clone() Rules {
    42		copy := make(Rules, len(r))
    43		for key, enabled := range r {
    44			copy[key] = enabled
    45		}
    46		return copy
    47	}
    48	
    49	func ValidateRules(rules Rules) error {
    50		for _, key := range sortedRulesKeys(rules) {
    51			if !contains(RuleModules, key) {
    52				return configErrorf("rules.unknown_module", key)
    53			}
    54		}
    55		if rules[RuleTaskGroups] && !rules[RuleGit] {
    56			return configErrorf("rules.group_requires_git")
    57		}
    58		return nil
    59	}
    60	
    61	func sortedRulesKeys(rules Rules) []string {
    62		keys := make([]string, 0, len(rules))
    63		for key := range rules {
    64			keys = append(keys, key)
    65		}
    66		return sorted(keys)
    67	}
    68	
    69	func validateRules(raw any) (Rules, error) {
    70		obj, ok := asObject(raw)
    71		if !ok {
    72			return nil, configErrorf("rules.object_required")
    73		}
    74		rules := DefaultRules(false)
    75		for key, value := range obj {
    76			enabled, ok := value.(bool)
    77			if !ok {
    78				return nil, configErrorf("rules.boolean_required", key)
    79			}
    80			rules[key] = enabled
    81		}
    82		return rules, ValidateRules(rules)
    83	}
    84	
    85	// CheckTaskGroup is shared by start, resume, takeover and notify before side effects.
    86	func (r Rules) CheckTaskGroup(group string) error {
    87		if group == "" {
    88			return nil
    89		}
    90		if !r[RuleTaskGroups] || !r[RuleGit] {
    91			return configErrorf("rules.group_disabled", group)
    92		}
    93		return nil
    94	}
    95	
    96	func RuleLabel(module string) string {
