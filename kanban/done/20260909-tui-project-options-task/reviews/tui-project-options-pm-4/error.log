   206	// showReport displays one report through a viewport, on top of the form.
   207	func (p *optionsPanel) showReport(title string, lines []menu.ReportLine, extra string) {
   208		p.report = &reportView{title: title, extra: extra, lines: lines, view: viewport.New(1, 1)}
   209	}
   210	
   211	// spaceSaveReport splits the agent wiring results and the closing notes into readable paragraphs.
   212	func spaceSaveReport(lines []menu.ReportLine) []menu.ReportLine {
   213		out := make([]menu.ReportLine, 0, len(lines)+2)
   214		for index, line := range lines {
   215			if index > 0 && (line.Level == menu.LevelOK || line.Level == menu.LevelWarning ||
   216				(line.Level == menu.LevelNote && lines[index-1].Level != menu.LevelNote)) {
   217				out = append(out, menu.ReportLine{})
   218			}
   219			out = append(out, line)
   220		}
   221		return out
   222	}
   223	
   224	// build wraps and colors the lines at the given width and returns the actual line count.
   225	func (r *reportView) build(palette palette, width int) int {
   226		var body []string
   227		if r.extra != "" {
   228			for _, text := range wrapText(r.extra, width) {
   229				body = append(body, styleFor("popup-ok", palette).Render(text))
   230			}
   231			if len(r.lines) > 0 {
   232				body = append(body, "")
   233			}
   234		}
   235		for _, line := range r.lines {
   236			style := styleFor(reportTag(line.Level), palette)
   237			for _, raw := range strings.Split(line.Text, "\n") {
   238				for _, text := range wrapText(raw, width) {
   239					body = append(body, style.Render(text))
   240				}
   241			}
   242		}
   243		if len(body) == 0 {
   244			body = append(body, styleFor("popup-dim", palette).Render(t("tui.no_output")))
   245		}
   246		r.view.SetContent(strings.Join(body, "\n"))
   247		r.width = width
   248		return len(body)
   249	}
   250	
   251	func reportTag(level string) string {
   252		switch level {
   253		case menu.LevelWarning:
   254			return "popup-warn"
   255		case menu.LevelOK:
   256			return "popup-ok"
   257		case menu.LevelNote:
   258			return "popup-title"
   259		}
   260		return "popup"
   261	}
   262	
   263	// Update is the input entry point of the panel: the report first, then the current Huh form.
   264	func (p *optionsPanel) Update(msg tea.Msg) tea.Cmd {
   265		if tick, ok := msg.(spinner.TickMsg); ok {
   266			if p.form != nil || p.loadErr != "" {
   267				return nil
   268			}
   269			var cmd tea.Cmd
   270			p.spinner, cmd = p.spinner.Update(tick)
   271			return cmd
   272		}
   273		if p.report != nil {
   274			return p.updateReport(msg)
   275		}
   276		if event, ok := msg.(tea.KeyMsg); ok && p.form != nil && !p.acceptsText() {
   277			switch mapKey(event) {
   278			case "q", "Q", "o", "O":
   279				// Consistent with the rest of the board: q closes, and pressing o again closes too.
   280				return p.requestClose()
   281			case "[":
   282				return p.cycleTab(-1)
   283			case "]":
   284				return p.cycleTab(1)
   285			}
   286		}
   287		if p.form == nil {
   288			if key, ok := msg.(tea.KeyMsg); ok {
   289				switch mapKey(key) {
   290				case "esc", "q", "Q":
   291					p.close()
   292				}
   293			}
   294			return nil
   295		}
   296		return p.updateForm(msg)
   297	}
   298	
   299	func (p *optionsPanel) updateReport(msg tea.Msg) tea.Cmd {
   300		if key, ok := msg.(tea.KeyMsg); ok {
   301			switch mapKey(key) {
   302			case "esc", "q", "Q", "enter", "backspace":
   303				p.report = nil
   304				if p.form == nil && p.session != nil {
   305					return p.openRoot()
   306				}
   307				return nil
   308			}
   309		}
   310		var cmd tea.Cmd
   311		p.report.view, cmd = p.report.view.Update(msg)
   312		return cmd
   313	}
   314	
   315	// acceptsText reports whether the current section contains a text input;
   316	// while it does, q and o must reach the input verbatim and the panel is closed with Esc instead.
   317	func (p *optionsPanel) acceptsText() bool {
   318		return p.current == sectionExecution || p.current == sectionReview
   319	}
   320	
   321	// rebuildAt requests a rebuild of the current section after this update, with focus landing back on the selector named by key.
   322	// When the execution agent or the reviewer changes, the model fields on the same screen belong to a different object and must be rebuilt.
   323	func (p *optionsPanel) rebuildAt(key string) {
   324		p.rebuildFocus = key
   325	}
   326	
   327	// rebuildSection rebuilds the current section and moves focus back to the original field.
   328	// The focus move is left to Bubble Tea to run asynchronously; the form commands must not run synchronously here,
   329	// because the blink chain of a text input contains a tea.Tick that would block for over half a second.
   330	func (p *optionsPanel) rebuildSection() tea.Cmd {
   331		key := p.rebuildFocus
   332		p.rebuildFocus = ""
   333		section := p.current
   334		if section == "" {
   335			return nil
   336		}
   337		cmd := p.openSection(section)
   338		// openSection rebuilt bind, so only now is it known which position that selector holds in the new form.
   339		index := 0
   340		if p.bind != nil {
   341			index = p.bind.fieldIndex[key]
   342		}
   343		return tea.Batch(cmd, repeatCmd(index, huh.NextField))
   344	}
   345	
   346	// resizeForm rebuilds the form so every page re-measures its natural height against the new terminal size.
   347	// Huh's WithHeight cannot be undone; a form once compressed by a short terminal can only leave the scrolling layout through a rebuild.
   348	func (p *optionsPanel) resizeForm() tea.Cmd {
   349		if p.form == nil || p.report != nil {
   350			return nil
   351		}
   352		if p.confirming {
   353			return p.openCloseConfirm()
   354		}
   355		if p.current == "" {
   356			return p.openRoot()
   357		}
   358		index := 0
   359		if p.bind != nil {
   360			focused := p.form.GetFocusedField()
   361			for _, field := range p.bind.formFields {
   362				if field.Skip() {
   363					continue
   364				}
   365				if field == focused {
   366					break
   367				}
   368				index++
   369			}
   370		}
   371		section := p.current
   372		cmd := p.openSection(section)
   373		return tea.Batch(cmd, repeatCmd(index, huh.NextField))
   374	}
   375	
   376	// requestClose closes the panel; unsaved changes make the user choose first.
   377	func (p *optionsPanel) requestClose() tea.Cmd {
   378		if !p.dirty {
   379			p.close()
   380			return nil
   381		}
   382		return p.openCloseConfirm()
   383	}
   384	
   385	func (p *optionsPanel) updateForm(msg tea.Msg) tea.Cmd {
   386		// Inside the panel Enter always means "submit the current form", no matter which field the cursor is on;
   387		// Huh treats Enter as "move to the next field" by default, so it is intercepted here first.
   388		if event, ok := msg.(tea.KeyMsg); ok && mapKey(event) == "enter" {
   389			if p.bind != nil {
   390				p.bind.apply(p)
   391			}
   392			if p.confirming {
   393				return p.finishCloseConfirm()
   394			}
   395			return p.finishSection()
   396		}
   397		model, cmd := p.form.Update(msg)
   398		if form, ok := model.(*huh.Form); ok {
   399			p.form = form
   400		}
   401		// Bound values are written back as the cursor moves, which is what lets UI preferences such as the theme preview while being selected.
   402		if p.bind != nil {
   403			p.bind.apply(p)
   404		}
   405		if p.rebuildFocus != "" {
   406			return tea.Batch(cmd, p.rebuildSection())
   407		}
   408		switch p.form.State {
   409		case huh.StateCompleted:
   410			if p.confirming {
   411				return p.finishCloseConfirm()
   412			}
   413			return tea.Batch(cmd, p.finishSection())
   414		case huh.StateAborted:
   415			if p.confirming {
   416				p.confirming = false
   417				return p.openRoot()
   418			}
   419			return p.abortSection()
   420		}
   421		return cmd
   422	}
   423	
   424	func (p *optionsPanel) finishCloseConfirm() tea.Cmd {
   425		p.confirming = false
   426		switch p.closeChoice {
   427		case closeSave:
   428			p.save()
   429			return nil
   430		case closeDiscard:
   431			p.close()
   432			return nil
   433		}
   434		return p.openRoot()
   435	}
   436	
   437	// finishSection runs the side effects and returns to the root menu once a section form is confirmed.
   438	// Ordinary values were already written back in apply; interface / task execution / review / rules reach disk on submit,
   439	// so there is no need to return to the root menu and pick "save and apply".
   440	func (p *optionsPanel) finishSection() tea.Cmd {
   441		if p.current == sectionDoctor {
   442			return p.finishHerdrInstall()
   443		}
   444		if p.current == "" {
   445			return p.dispatch(p.section)
   446		}
   447		if p.bind != nil {
   448			p.bind.commitSideEffects(p)
   449		}
   450		if p.savesOnSubmit() {
   451			if err := p.persistNow(); err != nil {
   452				p.showReport(t("tui.save_failed"), nil, err.Error())
   453				return nil
   454			}
   455		}
   456		p.current = ""
   457		return p.openRoot()
   458	}
   459	
   460	func (p *optionsPanel) savesOnSubmit() bool {
   461		return p.current == sectionInterface || p.current == sectionExecution || p.current == sectionReview || p.current == sectionRules
   462	}
   463	
   464	// persistNow writes the current session to the config file, UI preferences included.
   465	func (p *optionsPanel) persistNow() error {
   466		if p.session != nil && p.session.EditingOverlay() {
   467			if _, err := p.session.Save(); err != nil {
   468				return err
   469			}
   470			p.dirty = p.session.HasUnsaved()
   471			return nil
   472		}
   473		p.persistUI()
   474		if p.session == nil {
   475			return nil
   476		}
   477		p.session.Config.WelcomeComplete = true
   478		if _, err := p.session.Save(); err != nil {
   479			return err
   480		}
   481		p.dirty = p.session.HasUnsaved()
   482		return nil
   483	}
   484	
   485	// abortSection handles Esc: a section returns to the root menu, the root menu closes the panel.
   486	// Changed values are kept (apply wrote them back long ago); only side effects that need confirmation are skipped.
   487	func (p *optionsPanel) abortSection() tea.Cmd {
   488		if p.current == sectionDoctor {
   489			p.installHerdr = false
   490			return p.finishHerdrInstall()
   491		}
   492		if p.current == "" {
   493			p.close()
   494			return nil
   495		}
   496		p.current = ""
   497		return p.openRoot()
   498	}
   499	
   500	func (p *optionsPanel) dispatch(section string) tea.Cmd {
   501		switch section {
   502		case sectionSave:
   503			p.save()
   504			return nil
   505		case sectionClose:
   506			p.close()
   507			return nil
   508		case sectionFlow:
   509			p.openFlow()
   510			return nil
   511		case sectionDoctor:
   512			p.status = t("tui.running_environment_check")
   513			p.app.pendingWork = func() any {
   514				return terminalToolsResult{tools: menu.CheckTerminalTools()}
   515			}
   516			p.form = nil
   517			return nil
   518		case "":
   519			return p.openRoot()
   520		}
   521		return p.openSection(section)
   522	}
   523	
   524	func (p *optionsPanel) save() {
   525		p.persistUI()
   526		if p.session == nil {
   527			p.status = t("tui.environment_not_ready_interface_preferences_saved")
   528			return
   529		}
   530		finishLines, err := p.session.Finish()
   531		finishLines = spaceSaveReport(finishLines)
   532		if err != nil {
   533			p.showReport(t("tui.save_failed"), finishLines, err.Error())
   534			return
   535		}
   536		path, err := p.session.SaveAllDirty()
   537		if err != nil {
   538			p.showReport(t("tui.save_failed"), finishLines, err.Error())
   539			return
   540		}
   541		p.dirty = p.session.HasUnsaved()
   542		p.app.Context = tuiPageContext()
   543		p.showReport(
   544			t("tui.configuration_saved"),
   545			finishLines,
   546			t("tui.configuration_saved_2")+path,
   547		)
   548		p.form = nil
   549	}
   550	
   551	func (p *optionsPanel) persistUI() {
   552		if p.session == nil || p.session.EditingOverlay() {
   553			return
   554		}
   555		// Write the session's scope TUI, not the merged App display values.
   556		written, err := savePrefs(prefsFromConfig(p.session.Config.TUI))
   557		// When the write fails, only the edited value in the session is updated and the baseline is not advanced.
   558		p.session.SyncTUI(written, err == nil)
   559		if err != nil {
   560			p.app.PrefsError = err.Error()
   561			return
   562		}
   563		p.app.PrefsError = ""
   564	}

