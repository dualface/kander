   269	}
   270	
   271	// SaveAllDirty writes every unpublished tab. Save still writes only the active tab
   272	// so a section submit on Project cannot copy merged values into the scope file.
   273	func (s *Session) SaveAllDirty() (string, error) {
   274		if s == nil {
   275			return "", nil
   276		}
   277		var last string
   278		if s.ScopeDirty {
   279			path, err := s.saveScope()
   280			if err != nil {
   281				return last, err
   282			}
   283			last = path
   284		}
   285		if s.OverlayDirty {
   286			path, err := s.saveOverlay()
   287			if err != nil {
   288				return last, err
   289			}
   290			last = path
   291		}
   292		if last != "" {
   293			return last, nil
   294		}
   295		return s.Save()
   296	}
   297	
   298	func (s *Session) saveOverlay() (string, error) {
   299		if s.OverlayLocation.Path == "" {
   300			return "", config.ErrMissingOverlayPath()
   301		}
   302		path, err := config.SaveOverlayIfUnchanged(s.OverlayLocation.Path, s.overlayRaw, s.overlayExisting)
   303		if err == nil {
   304			s.overlayExisting = config.CloneOverlay(s.overlayRaw)
   305			s.OverlayLocation.Exists = len(s.overlayRaw) > 0
   306			s.OverlayDirty = false
   307		}
   308		return path, err
   309	}
