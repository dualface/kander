   340	// ModelFields builds the editable model fields for the execution agents and reviewers actually in use.
   341	func (s *Session) ModelFields() []ModelField {
   342		return append(s.ExecutionModelFields(), s.ReviewModelFields()...)
   343	}
   344	
   345	// kanbanModelField builds one model field on the execution side.
   346	func (s *Session) kanbanModelField(agent, field, label, short, prompt string) ModelField {
   347		return ModelField{
   348			Label:  label,
   349			Short:  short,
   350			Agent:  agent,
   351			Prompt: prompt,
   352			entry:  s.Config.Models.Kanban[agent],
   353			field:  field,
   354		}
   355	}
   356	
   357	// ExecutionModelFieldsFor returns the model fields of the agent currently selected for one task scale (large/small).
   358	// Model and reasoning effort are stored per scale, so large and small tasks each keep their own
   359	// independently editable values even when they select the same agent.
   360	func (s *Session) ExecutionModelFieldsFor(scale string) []ModelField {
   361		agent := s.Config.KanbanAgents[scale]
   362		if agent == "" {
   363			return nil
   364		}
   365		// When a legacy config only has the shared model key, the scale models are filled in with the same concrete value,
   366		// so the UI never shows a field that looks empty but actually has a value.
   367		if entry := s.Config.Models.Kanban[agent]; entry != nil {
   368			if entry[scale+"_model"] == "" && entry["model"] != "" {
   369				entry[scale+"_model"] = entry["model"]
   370			}
   371		}
   372		label := agentLabels()[agent]
   373		if label == "" {
   374			label = agent
   375		}
   376		if s.Config.Models.Kanban[agent] == nil {
   377			s.Config.Models.Kanban[agent] = map[string]string{}
   378		}
   379		scaleLabel := config.Text("menu.large_task")
   380		if scale == "small" {
   381			scaleLabel = config.Text("menu.small_task")
   382		}
   383		fields := []ModelField{s.kanbanModelField(agent, scale+"_model",
   384			config.Text("menu.kanban_model", label, scaleLabel),
   385			config.Text("menu.model", label, scaleLabel),
   386			config.Text("menu.full_model_id_for_s", scaleLabel))}
   387		if config.AgentFor(s.Config, agent).Dialect == "cursor" && config.AgentFor(s.Config, agent).Args == nil {
   388			return fields
   389		}
   390		return append(fields, s.kanbanModelField(agent, scale+"_effort",
   391			config.Text("menu.kanban_reasoning_effort", label, scaleLabel),
   392			config.Text("menu.effort", label, scaleLabel),
   393			config.Text("menu.reasoning_effort_for_s", scaleLabel)))
   394	}
   395	
   396	// ExecutionModelFields is the flattened, order-preserving deduplication of the per-scale fields, for the line-based menu.
   397	func (s *Session) ExecutionModelFields() []ModelField {
   398		var out []ModelField
   399		seen := map[string]struct{}{}
   400		for _, scale := range config.TaskScales {
   401			for _, field := range s.ExecutionModelFieldsFor(scale) {
   402				if _, ok := seen[field.Key()]; ok {
   403					continue
   404				}
   405				seen[field.Key()] = struct{}{}
   406				out = append(out, field)
   407			}
   408		}
   409		return out
   410	}
   411	
   412	// ReviewModelFieldsFor returns the model fields of one review role.
   413	// Every role stores its own concrete values, so what the UI shows is what is used, with no hidden inheritance layer;
   414	// while a role has no value yet, it is filled in from the default of its selected reviewer.
   415	func (s *Session) ReviewModelFieldsFor(role string) []ModelField {
   416		reviewer := s.Config.Reviewers[role]
   417		if reviewer == "" {
   418			return nil
   419		}
   420		entry := s.seedReviewRole(role, reviewer)
   421		fields := []ModelField{{
   422			Label:  config.Text("menu.review_model", role),
   423			Short:  config.Text("menu.model_2", role),
   424			Agent:  role,
   425			Prompt: config.Text("menu.which_model_should_use", role),
   426			entry:  entry,
   427			field:  "model",
   428		}}
   429		if reviewer == "cursor" {
   430			return fields
   431		}
   432		return append(fields, ModelField{
   433			Label:  config.Text("menu.review_reasoning_effort", role),
   434			Short:  config.Text("menu.effort_2", role),
   435			Agent:  role,
   436			Prompt: config.Text("menu.reasoning_effort_for", role),
   437			entry:  entry,
   438			field:  "effort",
   439		})
   440	}
   441	
   442	// seedReviewRole makes sure the role owns its values: whichever item is missing is filled in from that reviewer's default.
   443	func (s *Session) seedReviewRole(role, reviewer string) map[string]string {
   444		entry := s.Config.Models.ReviewRoles[role]
   445		if entry == nil {
   446			entry = map[string]string{}
   447			s.Config.Models.ReviewRoles[role] = entry
   448		}
   449		agentEntry := s.Config.Models.Review[reviewer]
   450		if entry["model"] == "" {
   451			entry["model"] = agentEntry["model"]
   452		}
   453		if _, ok := agentEntry["effort"]; ok && entry["effort"] == "" {
   454			entry["effort"] = agentEntry["effort"]
   455		}
   456		return entry
   457	}
   458	
   459	// ResetReviewRoleModel resets the model and reasoning effort of one role to the defaults of its new reviewer.
   460	// Call it when a role changes reviewer: the old values were configured for the old reviewer and would otherwise be misattributed.
   461	func (s *Session) ResetReviewRoleModel(role string) {
   462		if s.EditingOverlay() {
   463			config.OverlayDelete(s.overlayRaw, "models", "review_roles", role)
   464			s.OverlayDirty = true
   465			_ = s.rebuildOverlayConfig()
   466			return
   467		}
   468		s.Config.Models.ReviewRoles[role] = map[string]string{}
   469		s.seedReviewRole(role, s.Config.Reviewers[role])
   470	}
   471	
   472	// ReviewModelFields is the flattened, order-preserving deduplication of the per-role fields, for the line-based menu.
   473	func (s *Session) ReviewModelFields() []ModelField {
   474		var out []ModelField
   475		seen := map[string]struct{}{}
   476		for _, role := range config.ReviewRoles {
   477			for _, field := range s.ReviewModelFieldsFor(role) {
   478				if _, ok := seen[field.Key()]; ok {
   479					continue
   480				}
   481				seen[field.Key()] = struct{}{}
   482				out = append(out, field)
   483			}
   484		}
   485		return out
   486	}
   487	
   488	// Finish wraps up before saving: it reports how the rules were installed and marks initialization complete.
   489	func (s *Session) Finish() ([]ReportLine, error) {
   490		var err error
   491		lines := CaptureReport(func() {
   492			err = s.finish()
   493		})
   494		return lines, err
   495	}
   496	
   497	func (s *Session) finish() error {
   498		if err := config.ValidateRules(s.Config.Rules); err != nil {
   499			return err
   500		}
   501		labels := agentLabels()
   502		paths, err := currentPaths()
   503		if err != nil {
   504			return err
   505		}
   506		entry := rulesEntry(paths)
   507		seen := map[string]struct{}{}
   508		for _, selected := range config.ExecutionAgentsInUse(s.Config) {
   509			target := install.AgentRulesTarget(selected, paths)
   510			if _, ok := seen[target]; ok && target != "" {
   511				continue
   512			}
   513			seen[target] = struct{}{}
   514			outcome, ensureErr := install.EnsureRulesIntegration(selected, paths)
   515			if ensureErr != nil {
   516				warning(config.Text("menu.is_not_connected_to_kander_rules", labels[selected], ensureErr.Error()))
   517				hint(config.Text(
   518					"menu.follow_the_readme_integration_section_and_point_the_rules", entry,
   519				))
   520				continue
   521			}
   522			if outcome.Status == install.IntegrationPresent {
   523				success(config.Text("menu.is_connected_to_kander_rules", labels[selected], outcome.Target))
   524			} else {
   525				success(config.Text("menu.added_kander_rules_reference", labels[selected], outcome.Target))
   526			}
   527		}
   528		note(config.Text(
   529			"menu.note_kanban_start_uses_the_agent_s_no_confirmation",
   530		))
   531		note(RulesSessionNotice())
   532		if !s.EditingOverlay() {
   533			s.Config.WelcomeComplete = true
   534		}
   535		return nil
   536	}
   537	
   538	// Save writes the active tab: scope config.json or the project overlay.
   539	func (s *Session) Save() (string, error) {
   540		if s.EditingOverlay() {
   541			return s.saveOverlay()
   542		}
   543		return s.saveScope()
   544	}
   545	
   546	// Summary returns the "current configuration" overview shown in the menu title and at the top of the panel.
   547	func (s *Session) Summary() []string {
   548		cfg := s.Config
   549		lines := []string{config.Text("menu.current_configuration")}
   550		lines = append(lines, config.Text("rules.modules")+": "+config.FormatRulesSummary(cfg.Rules))
   551		for _, agent := range config.ExecutionAgentsInUse(cfg) {
   552			entry := cfg.Models.Kanban[agent]
   553			lines = append(lines, "  kanban "+agent+": "+config.FormatKanbanModelSummary(agent, entry))
   554		}
   555		seen := map[string]struct{}{}
   556		for _, role := range config.ReviewRoles {
   557			reviewer := cfg.Reviewers[role]
   558			if _, ok := seen[reviewer]; ok {
   559				continue
   560			}
   561			seen[reviewer] = struct{}{}
   562			entry := cfg.Models.Review[reviewer]
   563			lines = append(lines, "  review "+reviewer+": "+config.FormatReviewModelSummary(entry))
   564		}
   565		return lines
   566	}
