   571	func (p *optionsPanel) reviewGroup(bind *formBinding) *huh.Group {
   572		session := p.session
   573		cfg := session.Config
   574		bind.reset()
   575		for _, role := range config.ReviewRoles {
   576			if len(bind.formFields) > 0 {
   577				bind.addSpacer()
   578			}
   579			value := cfg.Reviewers[role]
   580			bind.reviewers[role] = &value
   581			bind.fieldIndex[roleFocusKey(role)] = bind.focusable
   582			bind.addField(huh.NewSelect[string]().
   583				Title(p.inheritTitle(role+" Reviewer", value, "reviewers", role)).
   584				Description(t("tui.which_agent_reviews_this_role")).
   585				Options(toOptions(session.ReviewerChoicesFor(value))...).
   586				Value(bind.reviewers[role]).
   587				Inline(true))
   588			bind.addRestore(p, value, "reviewers", role)
   589			// Each role keeps a large and a small stage selector, matching kanban_agents.
   590			for _, scale := range config.TaskScales {
   591				stage, err := config.ReviewStageFor(cfg, scale, role)
   592				if err != nil {
   593					stage = "auto"
   594				}
   595				key := stageFocusKey(role, scale)
   596				bind.stages[key] = &stage
   597				bind.fieldIndex[key] = bind.focusable
   598				bind.addField(huh.NewSelect[string]().
   599					Title(p.inheritTitle(modelIndent+t("tui.review_stage", t("config."+scale)), stage, "review_stages", scale, role)).
   600					// The value line is indented along with the title: a Select puts its value on its own line, so indenting the title alone would look ragged.
   601					Options(reviewStageOptions()...).
   602					Value(bind.stages[key]).
   603					Inline(true))
   604				bind.addRestore(p, stage, "review_stages", scale, role)
   605			}
   606			p.addModelInputs(bind, session.ReviewModelFieldsFor(role))
   607		}
   608		return huh.NewGroup(bind.formFields...)
   609	}
