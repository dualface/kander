   192		case p.current == "":
   193			if p.session != nil && len(p.session.AvailableTargets()) > 1 {
   194				return t("tui.move_enter_open_esc_close") + " · " + t("tui.switch_scope_tabs")
   195			}
   196			return t("tui.move_enter_open_esc_close")
   197		case p.current == sectionExecution || p.current == sectionReview:
   198			return t("tui.field_change_type_model_ids_enter_save_esc_back")
   199		}
   200		return t("tui.field_change_enter_save_esc_back")
