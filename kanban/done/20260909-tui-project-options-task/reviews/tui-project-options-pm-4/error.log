    10	type terminalToolsResult struct{ tools menu.TerminalTools }
    11	
    12	func (p *optionsPanel) beginDoctor(tools menu.TerminalTools) tea.Cmd {
    13		p.doctorTools = tools
    14		p.doctorLines = nil
    15		if !tools.NeedsHerdrInstall() {
    16			return p.continueDoctor()
    17		}
    18		p.status = ""
    19		p.current = sectionDoctor
    20		p.bind = nil
    21		p.installHerdr = false
