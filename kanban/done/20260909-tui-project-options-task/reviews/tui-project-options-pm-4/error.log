     3	func (a *App) boardCardHit(x, y int) *mouseSel {
     4		hit := a.hitBoard(x, y)
     5		if hit == nil || hit.Kind != "task" {
     6			return nil
     7		}
     8		h, _ := a.size()
     9		bodyHeight := h - bodyTop - 2
    10		tasks, scroll, _ := columnTaskWindow(a.Model, hit.State, bodyHeight)
    11		if hit.Index < scroll || hit.Index >= len(tasks) {
    12			return nil
    13		}
    14		task := tasks[hit.Index]
    15		layout := a.visibleColumnLayout()
    16		colX, colWidth := 0, 1
    17		for _, col := range layout {
    18			if col.State == hit.State {
    19				colX, colWidth = col.X, col.Width
    20				break
    21			}
    22		}
    23		if x < colX || x >= colX+colWidth {
    24			return nil
    25		}
    26		row := (y - bodyTop) / cardHeight
    27		lineInCard := y - bodyTop - row*cardHeight
    28		if lineInCard < 0 {
    29			lineInCard = 0
    30		}
    31		if lineInCard > 2 {
    32			lineInCard = 2
    33		}
    34		contentWidth := colWidth - panelChrome
    35		if contentWidth < 1 {
    36			contentWidth = 1
    37		}
    38		displayCol := x - colX - 2
    39		if displayCol < 0 {
    40			displayCol = 0
    41		}
    42		lines := a.boardCardLines(task, contentWidth)
    43		lineText := lines[lineInCard]
    44		charCol := displayColumnToCharIndex(lineText, displayCol)
    45		return &mouseSel{Kind: "board", TaskID: task.TaskID, Line: lineInCard, Col: charCol, ContentWidth: contentWidth}
    46	}
    47	
    48	func (a *App) detailHit(x, y int) *mouseSel {
    49		if y < detailBodyTop {
    50			return nil
    51		}
    52		_, w := a.size()
    53		bodyHeight := a.detailBodyHeight()
    54		if y >= detailBodyTop+bodyHeight {
    55			return nil
    56		}
    57		lineIndex := a.DetailScroll + (y - detailBodyTop)
    58		lines := a.detailLines()
    59		if lineIndex < 0 || lineIndex >= len(lines) {
    60			return nil
    61		}
    62		// The body sits inside the panel: 1 column for the left border, 1 for the padding.
    63		displayCol := x - 2
    64		if displayCol < 0 {
    65			displayCol = 0
    66		}
    67		if displayCol > w-1 {
    68			displayCol = w - 1
    69		}
    70		lineText := lines[lineIndex]
    71		charCol := displayColumnToCharIndex(lineText, displayCol)
    72		return &mouseSel{Kind: "detail", Line: lineIndex, Col: charCol}
    73	}
