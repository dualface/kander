   160			"HOME=" + home,
   161			"USERPROFILE=" + home,
   162			"KANDER_CONFIG=" + filepath.Join(home, ".config", "kander", "config.json"),
   163			"KANDER_LANG=en",
   164			"KANDER_SKIP_INSTALL=1",
   165		}
