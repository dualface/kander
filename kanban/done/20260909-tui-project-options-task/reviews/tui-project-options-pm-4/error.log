   332	func moduleRoot(t *testing.T) string {
   333		t.Helper()
   334		wd, err := os.Getwd()
   335		if err != nil {
   336			t.Fatal(err)
   337		}
   338		for {
   339			if _, err := os.Stat(filepath.Join(wd, "go.mod")); err == nil {
   340				return wd
   341			}
   342			parent := filepath.Dir(wd)
