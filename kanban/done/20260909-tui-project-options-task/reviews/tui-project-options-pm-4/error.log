   454	func minColumnWidthChoices(current int) []int {
   455		out := make([]int, 0, (maxMinColumnWidth-minMinColumnWidth)/minColumnWidthStep+2)
   456		seen := map[int]bool{}
   457		current = clampMinColumnWidth(current)
   458		for width := minMinColumnWidth; width <= maxMinColumnWidth; width += minColumnWidthStep {
   459			out = append(out, width)
   460			seen[width] = true
   461		}
   462		if !seen[current] {
   463			out = append([]int{current}, out...)
   464		}
   465		return out
   466	}
