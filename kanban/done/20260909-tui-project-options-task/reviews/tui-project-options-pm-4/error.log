   583	func validateInteger(value any, name string, min, max int) (int, error) {
   584		number, ok := value.(json.Number)
   585		if !ok {
   586			return 0, configErrorf("config.must_be_an_integer", name)
   587		}
   588		parsed, err := number.Int64()
   589		if err != nil || parsed < int64(min) || parsed > int64(max) {
   590			return 0, configErrorf(
   591				"config.must_be_an_integer_from_to", name, min, max,
   592			)
   593		}
   594		return int(parsed), nil
   595	}
