    86	// NewSession probes agents and launchers, and prepares the editable config from existing.
    87	// configValid means a schema-validated config already exists on disk.
    88	func NewSession(existing *config.Config, configValid bool) (*Session, error) {
    89		session := &Session{existing: existing}
    90		var err error
    91		session.Warnings = CaptureReport(func() {
    92			err = session.prepare(configValid)
    93		})
    94		// A session is returned even on error, so the caller can still display the environment warnings collected so far.
    95		return session, err
    96	}
    97	
    98	func (s *Session) prepare(configValid bool) error {
    99		s.agents = findAgents(s.existing)
   100		labels := agentLabels()
   101		for name, state := range s.agents {
   102			if state.Path != "" && !agentUsable(state) {
   103				warning(config.Text(
   104					"menu.version_failed_unavailable_as_a_new_choice", labels[name], state.Path,
   105				))
   106			}
   107		}
   108		firstExecution := ""
   109		for _, name := range config.AgentNames(s.existing) {
   110			state := s.agents[name]
   111			if labels[name] == "" {
   112				labels[name] = name
   113			}
   114			label := labels[name] + config.Text("menu.not_currently_installed")
   115			if agentUsable(state) {
   116				if firstExecution == "" {
   117					firstExecution = name
   118				}
   119				label = labels[name] + " (" + state.Version + ")"
   120			}
   121			// Unavailable agents remain selectable so their executable can be configured.
   122			s.exec = append(s.exec, Choice{Value: name, Label: label})
   123		}
   124		if firstExecution == "" && !s.existing.WelcomeComplete {
   125			return errors.New(config.Text("menu.no_usable_agent_found_version_must_succeed_install_codex"))
   126		}
   127		for _, name := range config.ReviewAgents {
   128			if reviewerUsable(s.agents[name]) {
   129				s.review = append(s.review, Choice{Value: name, Label: labels[name] + " (" + reviewerState(s.agents[name]).Version + ")"})
   130			}
   131		}
   132		if len(s.review) == 0 && !s.existing.WelcomeComplete {
   133			return errors.New(config.Text(
   134				"menu.no_usable_reviewer_found_install_codex_claude_grok_or",
   135			))
   136		}
   137	
   138		cfg := config.DefaultConfig()
   139		cfg.Agents = config.CloneAgents(s.existing.Agents)
   140		cfg.Models = copyModels(s.existing.Models)
   141		cfg.KanbanAgent = s.existing.KanbanAgent
   142		cfg.AgentLanguage = s.existing.AgentLanguage
   143		cfg.KanbanAgents = map[string]string{}
   144		for k, v := range s.existing.KanbanAgents {
   145			cfg.KanbanAgents[k] = v
   146		}
   147		if !s.existing.WelcomeComplete {
   148			if !agentUsable(s.agents[cfg.KanbanAgent]) {
   149				cfg.KanbanAgent = firstExecution
   150			}
   151			for _, scale := range config.TaskScales {
   152				if !agentUsable(s.agents[cfg.KanbanAgents[scale]]) {
   153					cfg.KanbanAgents[scale] = cfg.KanbanAgent
   154				}
   155			}
   156		}
   157		cfg.Reviewers = map[string]string{}
   158		for _, role := range config.ReviewRoles {
   159			previous := s.existing.Reviewers[role]
   160			cfg.Reviewers[role] = previous
   161			if !s.existing.WelcomeComplete && !reviewerUsable(s.agents[previous]) {
   162				cfg.Reviewers[role] = s.review[0].Value
   163			}
   164		}
   165		cfg.Launcher = s.existing.Launcher
   166		s.normalizeLauncher(cfg)
   167		cfg.TUI = s.existing.TUI
   168		cfg.Rules = s.existing.Rules.Clone()
   169		cfg.ReviewStages = cloneReviewStages(s.existing.ReviewStages)
   170		if configValid {
   171			if stored := config.ConfiguredScopeLanguage(); stored != "" {
   172				cfg.Language = stored
   173			} else {
   174				cfg.Language = config.ResolveScopeLanguage()
   175			}
   176		} else {
   177			cfg.Language = config.ResolveScopeLanguage()
   178		}
   179		// Session.Language is the unmerged explicit scope value, or a CLI/env
   180		// fallback that does not see the bound overlay language. Panel copy
   181		// follows BindEffectiveLanguage() (merged).
   182		config.BindEffectiveLanguage()
   183		s.Config = cfg
   184		s.initOverlayState()
   185		return s.loadOverlayContext()
   186	}
   187	
   188	func (s *Session) normalizeLauncher(cfg *config.Config) {
   189		if s.existing.WelcomeComplete {
   190			return
   191		}
   192		switch {
   193		case isWindowsOS() && (cfg.Launcher == "tmux" || cfg.Launcher == "tmux-session"):
   194			cfg.Launcher = "console"
   195			warning(config.Text(
   196				"menu.windows_does_not_support_tmux_using_console",
   197			))
   198		case (cfg.Launcher == "tmux" || cfg.Launcher == "tmux-session") && lookPath("tmux") == "":
   199			cfg.Launcher = "foreground"
   200			warning(config.Text(
   201				"menu.tmux_is_not_installed_using_foreground_the_launcher_menu",
   202			))
   203		// On POSIX auto holds as long as tmux exists, so a missing herdr must not
   204		// rewrite it; on Windows auto can only land on herdr, so a missing herdr does.
   205		case (cfg.Launcher == "herdr" || (cfg.Launcher == "auto" && isWindowsOS())) && lookPath("herdr") == "":
   206			switch {
   207			case isWindowsOS():
   208				cfg.Launcher = "console"
   209			case lookPath("tmux") != "":
   210				cfg.Launcher = "tmux"
   211			default:
   212				cfg.Launcher = "foreground"
   213			}
   214			warning(config.Text(
   215				"menu.herdr_is_not_installed_using", cfg.Launcher,
   216			))
   217		}
   218	}
