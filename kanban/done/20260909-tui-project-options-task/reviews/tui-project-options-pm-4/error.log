    75	func (a *App) extractBoardMouseSelection() string {
    76		if a.MouseAnchor == nil || a.MouseCursor == nil {
    77			return ""
    78		}
    79		if a.MouseAnchor.Kind != "board" || a.MouseCursor.Kind != "board" {
    80			return ""
    81		}
    82		if a.MouseAnchor.TaskID != a.MouseCursor.TaskID {
    83			return ""
    84		}
    85		var task *Task
    86		for i := range a.Model.Tasks {
    87			if a.Model.Tasks[i].TaskID == a.MouseAnchor.TaskID {
    88				task = &a.Model.Tasks[i]
    89				break
    90			}
    91		}
    92		if task == nil {
    93			return ""
    94		}
    95		lines := a.boardCardLines(*task, a.MouseAnchor.ContentWidth)
    96		return extractMouseCharSelection(lines, [2]int{a.MouseAnchor.Line, a.MouseAnchor.Col}, [2]int{a.MouseCursor.Line, a.MouseCursor.Col})
    97	}
    98	
    99	func (a *App) extractDetailMouseSelection() string {
   100		if a.MouseAnchor == nil || a.MouseCursor == nil {
   101			return ""
   102		}
   103		if a.MouseAnchor.Kind != "detail" || a.MouseCursor.Kind != "detail" {
   104			return ""
   105		}
   106		return extractMouseCharSelection(a.detailLines(), [2]int{a.MouseAnchor.Line, a.MouseAnchor.Col}, [2]int{a.MouseCursor.Line, a.MouseCursor.Col})
   107	}
