   172		exe, err := os.Executable()
   173		if err != nil {
   174			return "", configErrorfWrap(err, "config.cannot_resolve_current_entry")
   175		}
   176		return lexicalAbsolute(exe)
   177	}
   178	
   179	// InstallPathsFromEntry resolves global or project install paths from the entry point.
   180	// Project mode is entered only when the entry lives in a directory named .kander/bin/, so a source tree's cmd/ is never mistaken for one.
   181	func InstallPathsFromEntry(entry string) (InstallPaths, error) {
   182		source, err := lexicalAbsolute(entry)
   183		if err != nil {
   184			return InstallPaths{}, err
   185		}
   186		binDir := filepath.Dir(source)
   187		installRoot := filepath.Dir(binDir)
   188		if !sameDirName(filepath.Base(binDir), "bin") || !sameDirName(filepath.Base(installRoot), ProjectInstallDirname) {
   189			return globalInstallPaths()
   190		}
   191		if runtime.GOOS == "windows" {
   192			if _, err := ensureWindowsPathNofollowSafe(binDir); err != nil {
   193				return InstallPaths{}, err
   194			}
   195		} else {
   196			if err := rejectLeafReparse(installRoot); err != nil {
   197				return InstallPaths{}, err
   198			}
   199			if err := rejectLeafReparse(binDir); err != nil {
   200				return InstallPaths{}, err
   201			}
   202		}
   203		parent := filepath.Dir(installRoot)
   204		main, err := gitMainWorktree(parent)
   205		if err != nil {
   206			return InstallPaths{}, err
   207		}
   208		if main == "" {
   209			return InstallPaths{}, configErrorf(
   210				"config.project_is_not_a_git_repository", parent,
   211			)
   212		}
   213		paths := projectInstallLayout(main)
   214		if runtime.GOOS == "windows" {
   215			if _, err := ensureWindowsPathNofollowSafe(paths.BinDir); err != nil {
   216				return InstallPaths{}, err
   217			}
   218		} else {
   219			if paths.InstallRoot != "" {
   220				if err := rejectLeafReparse(paths.InstallRoot); err != nil {
   221					return InstallPaths{}, err
   222				}
   223			}
   224			if err := rejectLeafReparse(paths.BinDir); err != nil {
   225				return InstallPaths{}, err
   226			}
   227		}
   228		return paths, nil
   229	}
   230	
   231	// CurrentInstallPaths resolves the scope from the current executable entry point.
   232	func CurrentInstallPaths() (InstallPaths, error) {
   233		entry, err := currentEntry()
   234		if err != nil {
   235			return InstallPaths{}, err
   236		}
   237		return InstallPathsFromEntry(entry)
   238	}
   239	
   240	// ProjectInstallPaths normalizes a user-supplied project directory to the project install paths under the Git main worktree.
   241	func ProjectInstallPaths(project string) (InstallPaths, error) {
   242		candidate, err := lexicalAbsolute(project)
   243		if err != nil {
   244			return InstallPaths{}, err
   245		}
