    39	func rejectLeafReparse(path string) error {
    40		if _, err := os.Lstat(path); err != nil {
    41			if os.IsNotExist(err) {
    42				return nil
    43			}
    44			return configErrorfWrap(err, "config.failed_to_inspect_path", path)
    45		}
