   644	func schemaVersionOf(raw any) any {
   645		switch v := raw.(type) {
   646		case json.Number:
   647			if i, err := v.Int64(); err == nil {
   648				return int(i)
   649			}
   650			return v.String()
   651		default:
   652			return v
   653		}
