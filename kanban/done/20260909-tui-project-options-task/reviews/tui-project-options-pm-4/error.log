     8	)
     9	
    10	// The workflow presets only manage this list; standalone modules are rendered separately and take part in neither preset application nor matching.
    11	var workflowRuleModules = []string{
    12		config.RuleCollaboration, config.RuleGit, config.RuleReview,
    13		config.RuleTaskIntake, config.RuleTaskGroups, config.RuleReporting,
    14	}
    15	
    16	var independentRuleModules = []string{config.RuleCode}
    17	
    18	const customRulePreset = "custom"
    19	
    20	var workflowRulePresets = []struct {
    21		id      string
    22		label   string
    23		enabled config.Rules
    24	}{
    25		{"basic", "rules.basic_workflow", config.Rules{
    26			config.RuleCollaboration: true, config.RuleGit: true,
    27			config.RuleTaskIntake: true, config.RuleReporting: true,
    28		}},
    29		{"full", "rules.full_workflow", config.Rules{
    30			config.RuleCollaboration: true, config.RuleGit: true, config.RuleReview: true,
    31			config.RuleTaskIntake: true, config.RuleTaskGroups: true, config.RuleReporting: true,
    32		}},
    33	}
    34	
    35	func matchWorkflowPreset(rules config.Rules) string {
    36		for _, preset := range workflowRulePresets {
    37			matches := true
    38			for _, module := range workflowRuleModules {
    39				if rules[module] != preset.enabled[module] {
    40					matches = false
    41					break
    42				}
    43			}
    44			if matches {
    45				return preset.id
    46			}
    47		}
    48		return customRulePreset
    49	}
    50	
    51	func (p *optionsPanel) rulesGroup(bind *formBinding) *huh.Group {
    52		bind.reset()
    53		bind.rules = map[string]*bool{}
    54		bind.rulePreset = matchWorkflowPreset(p.session.Config.Rules)
    55		bind.prevRulePreset = bind.rulePreset
    56		bind.fieldIndex["rules:preset"] = bind.focusable
    57		options := make([]huh.Option[string], 0, len(workflowRulePresets)+1)
    58		for _, preset := range workflowRulePresets {
    59			options = append(options, huh.NewOption(t(preset.label), preset.id))
    60		}
    61		options = append(options, huh.NewOption(t("rules.custom"), customRulePreset))
    62		bind.addField(huh.NewSelect[string]().Title(t("rules.selection")).
    63			Options(options...).
    64			Inline(true).Value(&bind.rulePreset))
    65		bind.addRuleFields(p, p.session.Config.Rules, workflowRuleModules)
    66		bind.addSpacer()
    67		bind.formFields = append(bind.formFields, huh.NewNote().Title(t("rules.independent")))
    68		bind.addRuleFields(p, p.session.Config.Rules, independentRuleModules)
    69		bind.formFields = append(bind.formFields, huh.NewNote().Description(t("rules.contract_notice")))
    70		return huh.NewGroup(bind.formFields...)
    71	}
    72	
    73	func (bind *formBinding) addRuleFields(p *optionsPanel, rules config.Rules, modules []string) {
    74		for _, module := range modules {
    75			enabled := rules[module]
    76			bind.rules[module] = &enabled
    77			bind.fieldIndex["rules:"+module] = bind.focusable
    78			bind.addField(huh.NewConfirm().Title(p.inheritTitle(config.RuleLabel(module), formatBool(enabled), "rules", module)).
    79				Affirmative(t("rules.on")).Negative(t("rules.off")).
    80				Inline(true).Value(&enabled))
    81			bind.addRestore(p, formatBool(enabled), "rules", module)
    82		}
    83	}
    84	
    85	func (b *formBinding) applyRules(p *optionsPanel) {
    86		rules := p.session.Config.Rules.Clone()
    87		focus := "rules:preset"
    88		for _, module := range config.RuleModules {
    89			if value := b.rules[module]; value != nil {
    90				if rules[module] != *value {
    91					focus = "rules:" + module
    92				}
    93				rules[module] = *value
    94			}
    95		}
    96		// Apply a preset only when the user switches the selector, so later per-item edits are not overwritten by the old preset.
    97		presetChanged := b.rulePreset != b.prevRulePreset
    98		if presetChanged {
    99			for _, preset := range workflowRulePresets {
   100				if preset.id == b.rulePreset {
   101					for _, module := range workflowRuleModules {
   102						rules[module] = preset.enabled[module]
   103					}
   104					break
   105				}
   106			}
   107			focus = "rules:preset"
   108		}
   109		if !reflect.DeepEqual(rules, p.session.Config.Rules) {
   110			if err := p.session.SetRules(rules); err != nil {
   111				for module, value := range b.rules {
   112					*value = p.session.Config.Rules[module]
   113				}
   114				p.showReport(t("rules.dependency"), nil, err.Error())
   115				p.rebuildAt(focus)
   116				return
   117			}
   118			p.markDirty()
   119		}
   120		if presetChanged || matchWorkflowPreset(rules) != b.rulePreset {
   121			p.rebuildAt(focus)
   122		}
   123	}

