    91	func gitSubprocessEnv() []string {
    92		env := os.Environ()
    93		out := make([]string, 0, len(env))
    94		blocked := map[string]struct{}{}
    95		for _, name := range gitOverrideVars {
    96			blocked[name] = struct{}{}
    97			if runtime.GOOS == "windows" {
    98				blocked[strings.ToUpper(name)] = struct{}{}
    99			}
   100		}
   101		for _, item := range env {
   102			name, _, _ := strings.Cut(item, "=")
   103			if _, ok := blocked[name]; ok {
   104				continue
   105			}
   106			if runtime.GOOS == "windows" {
   107				if _, ok := blocked[strings.ToUpper(name)]; ok {
   108					continue
   109				}
   110			}
   111			out = append(out, item)
   112		}
   113		return out
   114	}
