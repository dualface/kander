   116	func gitMainWorktree(directory string) (string, error) {
   117		target, err := lexicalAbsolute(directory)
   118		if err != nil {
   119			return "", err
   120		}
   121		info, err := os.Stat(target)
   122		if err != nil || !info.IsDir() {
   123			return "", nil
   124		}
   125		cmd := exec.Command("git", "-C", target, "worktree", "list", "--porcelain")
   126		cmd.Env = gitSubprocessEnv()
   127		output, err := cmd.Output()
   128		if err != nil {
   129			return "", nil
   130		}
   131		for _, line := range strings.Split(string(output), "\n") {
   132			if strings.HasPrefix(line, "worktree ") {
   133				return lexicalAbsolute(strings.TrimPrefix(line, "worktree "))
   134			}
   135		}
   136		return "", nil
   137	}
