    22	
    23	// ptySession runs kander inside a pseudo-terminal and answers capability queries like a real terminal would,
    24	// otherwise Bubble Tea keeps waiting for the background color and cursor position responses.
    25	type ptySession struct {
    26		t      *testing.T
    27		cmd    *exec.Cmd
    28		master *os.File
    29		mu     sync.Mutex
    30		out    []byte
    31		done   chan error
    32	}
    33	
    34	func startPTY(t *testing.T, bin string, env []string, args ...string) *ptySession {
    35		t.Helper()
    36		return startPTYAt(t, "", bin, env, args...)
    37	}
    38	
    39	func startPTYAt(t *testing.T, dir, bin string, env []string, args ...string) *ptySession {
    40		t.Helper()
    41		master, slave, err := openPTY()
    42		if err != nil {
    43			t.Fatal(err)
    44		}
    45		ws := unix.Winsize{Row: 32, Col: 120}
    46		_ = unix.IoctlSetWinsize(int(slave.Fd()), unix.TIOCSWINSZ, &ws)
    47		cmd := exec.Command(bin, args...)
    48		cmd.Env = env
    49		cmd.Dir = dir
    50		cmd.Stdin, cmd.Stdout, cmd.Stderr = slave, slave, slave
    51		if err := cmd.Start(); err != nil {
    52			t.Fatal(err)
    53		}
    54		_ = slave.Close()
    55		session := &ptySession{t: t, cmd: cmd, master: master, done: make(chan error, 1)}
    56		go func() {
    57			buf := make([]byte, 4096)
    58			for {
    59				n, err := master.Read(buf)
    60				if n > 0 {
    61					chunk := buf[:n]
    62					session.mu.Lock()
    63					session.out = append(session.out, chunk...)
    64					session.mu.Unlock()
    65					if bytes.Contains(chunk, []byte("\x1b]11;?")) {
    66						_, _ = master.Write([]byte("\x1b]11;rgb:0000/0000/0000\x1b\\"))
    67					}
    68					if bytes.Contains(chunk, []byte("\x1b[6n")) {
    69						_, _ = master.Write([]byte("\x1b[1;1R"))
    70					}
    71				}
    72				if err != nil {
    73					return
    74				}
    75			}
    76		}()
    77		go func() { session.done <- cmd.Wait() }()
    78		t.Cleanup(func() {
    79			_ = cmd.Process.Kill()
    80			_ = master.Close()
    81		})
    82		return session
    83	}
    84	
    85	func (s *ptySession) send(keys string) {
    86		s.t.Helper()
    87		if _, err := s.master.Write([]byte(keys)); err != nil {
    88			s.t.Fatal(err)
    89		}
    90	}
    91	
    92	func (s *ptySession) resize(rows, cols uint16) {
    93		s.t.Helper()
    94		ws := unix.Winsize{Row: rows, Col: cols}
    95		if err := unix.IoctlSetWinsize(int(s.master.Fd()), unix.TIOCSWINSZ, &ws); err != nil {
   260		// A gap is required between Esc and the following key, otherwise the terminal parses them as alt+<key>.
   261		session.send("\x1b")
   262		time.Sleep(300 * time.Millisecond)
   263		session.send("q")
   264		if err := session.waitExit(8 * time.Second); err != nil {
   265			t.Fatalf("exit: %v\npty:\n%s", err, session.text())
   266		}
   267	}
