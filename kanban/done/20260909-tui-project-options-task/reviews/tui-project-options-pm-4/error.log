   286			t.Fatalf("global install should show both tabs\npty:\n%s", plain)
   287		}
   288		if !strings.Contains(plain, project) {
   289			t.Fatalf("missing project path\npty:\n%s", plain)
   290		}
   291		if !strings.Contains(plain, overlay) && !strings.Contains(plain, config.OverlayFilename) {
   292			t.Fatalf("missing overlay path\npty:\n%s", plain)
   293		}
   294		if !strings.Contains(plain, configPath) && !strings.Contains(plain, filepath.Base(configPath)) {
   295			t.Fatalf("missing base config path\npty:\n%s", plain)
   296		}
   297		session.send("]")
   298		if !session.waitFor("Overlay file does not exist yet", 6*time.Second) {
   299			t.Fatalf("project tab did not show create hint\npty:\n%s", session.text())
   300		}
   301		session.send("\r")
   302		if !session.waitFor("Global:", 6*time.Second) {
   303			t.Fatalf("project tab did not show inherit prefix\npty:\n%s", session.text())
   304		}
   305		session.resize(24, 48)
   306		deadline := time.Now().Add(4 * time.Second)
   307		for time.Now().Before(deadline) {
   308			if strings.Contains(session.text(), config.OverlayFilename) {
   309				break
   310			}
   311			time.Sleep(50 * time.Millisecond)
   312		}
   313		if !strings.Contains(session.text(), config.OverlayFilename) {
   314			t.Fatalf("narrow resize dropped overlay leaf\npty:\n%s", session.text())
   315		}
   316		session.send("\x1b")
   317		time.Sleep(300 * time.Millisecond)
   318		session.send("\x1b")
   319		time.Sleep(300 * time.Millisecond)
   320		session.send("q")
   321		if err := session.waitExit(8 * time.Second); err != nil {
   322			t.Fatalf("exit: %v\npty:\n%s", err, session.text())
   323		}
   324		if _, err := os.Stat(overlay); !os.IsNotExist(err) {
   325			t.Fatal("browsing and switching tabs created an overlay")
   326		}
   327		if _, err := os.Stat(configPath); err != nil {
   328			t.Fatalf("isolated scope config missing: %v", err)
   329		}
   330	}
