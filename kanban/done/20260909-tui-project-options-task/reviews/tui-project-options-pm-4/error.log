    93	// Update is the message entry point of App: the options panel takes over while open, otherwise the board and detail view handle it.
    94	func (a *App) Update(msg tea.Msg) tea.Cmd {
    95		if event, ok := msg.(tea.KeyMsg); ok && mapKey(event) == "ctrl-c" && a.StartConfirmation == nil {
    96			a.requestQuit()
    97			return nil
    98		}
    99		if a.Options != nil {
   100			if event, ok := msg.(tea.MouseMsg); ok {
   101				return a.Options.HandleMouse(event.X, event.Y, a.mouse.mapButtons(event.X, event.Y, neutralButtons(event), time.Now()))
   102			}
   103			return a.Options.Update(msg)
   104		}
   105		switch event := msg.(type) {
   106		case tea.KeyMsg:
   107			a.HandleKey(mapKey(event))
   108			if a.Options != nil {
   109				return a.Options.Init()
   110			}
   111		case tea.MouseMsg:
   112			a.HandleMouse(event.X, event.Y, a.mouse.mapButtons(event.X, event.Y, neutralButtons(event), time.Now()))
   113		}
   114		return nil
   115	}
