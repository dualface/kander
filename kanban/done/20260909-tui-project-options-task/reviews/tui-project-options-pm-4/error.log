    51	
    52	func ensureWindowsPathNofollowSafe(path string) (string, error) {
    53		abs, err := lexicalAbsolute(path)
    54		if err != nil {
    55			return "", err
    56		}
    57		vol := filepath.VolumeName(abs)
    58		if vol == "" {
    59			return "", configErrorf("config.invalid_install_path", path)
    60		}
    61		current := vol
    62		if !strings.HasSuffix(current, string(os.PathSeparator)) {
    63			current += string(os.PathSeparator)
    64		}
    65		rest := strings.TrimPrefix(abs, current)
    66		if rest == abs {
    67			rest = strings.TrimPrefix(abs, vol)
    68			rest = strings.TrimPrefix(rest, string(os.PathSeparator))
    69		}
    70		if rest == "" {
    71			return abs, nil
    72		}
    73		for _, part := range strings.Split(rest, string(os.PathSeparator)) {
    74			if part == "" {
    75				continue
    76			}
    77			current = filepath.Join(current, part)
    78			if _, err := os.Lstat(current); err != nil {
    79				if os.IsNotExist(err) {
    80					break
    81				}
    82				return "", configErrorfWrap(err, "config.failed_to_inspect_path", current)
    83			}
    84			if fs.IsReparsePoint(current) {
    85				return "", unsafePathError(current)
    86			}
    87		}
    88		return abs, nil
    89	}
