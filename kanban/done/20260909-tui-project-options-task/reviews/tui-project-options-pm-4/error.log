   350	func openPTY() (master, slave *os.File, err error) {
   351		master, err = os.OpenFile("/dev/ptmx", os.O_RDWR|unix.O_NOCTTY, 0)
   352		if err != nil {
   353			return nil, nil, err
   354		}
   355		if err := unix.IoctlSetPointerInt(int(master.Fd()), unix.TIOCSPTLCK, 0); err != nil {
   356			master.Close()
   357			return nil, nil, err
   358		}
   359		n, err := unix.IoctlGetInt(int(master.Fd()), unix.TIOCGPTN)
   360		if err != nil {
   361			master.Close()
   362			return nil, nil, err
   363		}
   364		slave, err = os.OpenFile("/dev/pts/"+strconv.Itoa(n), os.O_RDWR|unix.O_NOCTTY, 0)
   365		if err != nil {
   366			master.Close()
   367			return nil, nil, err
   368		}
   369		return master, slave, nil
   370	}
