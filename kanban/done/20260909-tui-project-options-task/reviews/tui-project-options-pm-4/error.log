    90	
    91	func (p *optionsPanel) renderTabBar(palette palette, width int) string {
    92		targets := p.session.AvailableTargets()
    93		active := p.session.Target
    94		if active == "" {
    95			active = config.TargetScope
    96		}
    97		p.tabHits = nil
    98		cursor := 0
    99		var parts []string
   100		for i, target := range targets {
   101			label := t("tui.tab_global")
   102			if target == config.TargetOverlay {
   103				label = t("tui.tab_project")
   104			}
   105			text := " " + label + " "
   106			style := lipgloss.NewStyle().Foreground(palette.Dim).Background(palette.Bg)
   107			if target == active {
   108				style = lipgloss.NewStyle().Foreground(palette.ChromeFg).Background(palette.ChromeBg).Bold(true)
   109			}
   110			rendered := style.Render(text)
   111			p.tabHits = append(p.tabHits, tabHit{target: target, x0: cursor, x1: cursor + displayWidth(text)})
   112			parts = append(parts, rendered)
   113			cursor += displayWidth(text)
   114			if i+1 < len(targets) {
   115				gap := "  "
   116				parts = append(parts, styleFor("popup-dim", palette).Render(gap))
   117				cursor += displayWidth(gap)
   118			}
   119		}
   120		line := strings.Join(parts, "")
   121		if displayWidth(ansi.Strip(line)) > width {
   122			return clipText(ansi.Strip(line), width)
   123		}
   124		return line
   125	}
