   219	// padBlock pads the content into a rectangle of fixed width and height, so the popup border does not jitter.
   220	func padBlock(text string, width, height int, p palette) string {
   221		lines := strings.Split(text, "\n")
   222		if len(lines) > height {
   223			lines = lines[:height]
   224		}
   225		for i, line := range lines {
   226			lines[i] = padLineFill(line, width, p)
   227		}
   228		for len(lines) < height {
   229			lines = append(lines, p.fillLine(width))
   230		}
   231		return strings.Join(lines, "\n")
