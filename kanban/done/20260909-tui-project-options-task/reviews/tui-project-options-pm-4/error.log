    82	func (a *App) openOptions() {
    83		a.openOptionsAt("")
    84	}
    85	
    86	func (a *App) openOptionsAt(section string) {
    87		if a.Options != nil {
    88			return
    89		}
    90		p := themePalette(a.Theme)
    91		spin := spinner.New()
    92		spin.Spinner = spinner.Dot
    93		spin.Style = lipgloss.NewStyle().Foreground(p.Accent).Background(p.Bg)
    94		panel := &optionsPanel{app: a, spinner: spin, initial: section}
    95		panel.detectOverlayNotice()
    96		a.Options = panel
    97		if a.Session != nil {
    98			panel.session = a.Session
    99			if section == "" {
   100				panel.openRoot()
   101			} else {
   102				panel.dispatch(section)
   103			}
   104			return
   105		}
   106		panel.requestSession()
   107	}
   108	
   109	func (p *optionsPanel) detectOverlayNotice() {
   110		loc := overlayDisplayLocation(p)
   111		if loc.Path == "" {
   112			p.overlayNotice = ""
   113			return
   114		}
   115		p.overlayNotice = t("tui.overlay_file", loc.Path)
   116	}
