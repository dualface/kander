   100	func trimTrailingBlank(lines []string) []string {
   101		for len(lines) > 1 && strings.TrimSpace(ansi.Strip(lines[len(lines)-1])) == "" {
   102			lines = lines[:len(lines)-1]
   103		}
   104		return lines
   105	}
   106	
   107	func (p *optionsPanel) content(palette palette, width, height int) (string, string) {
   108		switch {
   109		case p.report != nil:
   110			count := p.report.build(palette, width)
   111			// One blank line is always kept between the report body and the action hint at the bottom.
   112			body := height - 2
   113			if count < body {
   114				body = count
   115			}
   116			if body < 1 {
   117				body = 1
   118			}
   119			p.report.view.Width, p.report.view.Height = width, body
   120			hint := styleFor("popup-dim", palette).Render(t("tui.scroll_esc_back"))
   121			return p.report.title, p.report.view.View() + "\n\n" + hint
   122		case p.loadErr != "":
   123			return t("tui.options_2"), styleFor("popup-warn", palette).Render(p.loadErr)
   124		case p.form == nil:
   125			line := p.spinner.View() + " " + t("tui.detecting_environment")
   126			if p.status != "" {
   127				line = p.spinner.View() + " " + p.status
   128			}
   129			return t("tui.options_2"), styleFor("popup-dim", palette).Render(line)
   130		}
   131		if p.formWidth != width || p.formNatural == 0 {
   132			p.measureForm()
   133		}
   134		p.syncFormTheme(palette)
   135		notice, noticeLines := p.renderScopeChrome(palette, width)
   136		if !p.confirming && notice == "" && p.overlayNotice != "" {
   137			notice = styleFor("popup-dim", palette).Render(clipText(p.overlayNotice, width)) + "\n"
   138			noticeLines = 1
   139		}
   140		p.chromeLines = noticeLines
   141		formHeight, footerGap := fitOptionsForm(p.formNatural, height-noticeLines)
   142		p.form.WithWidth(width)
   143		// Keep Huh's natural height while the content fits. Even when given the same height, WithHeight switches the
   144		// Group to a viewport layout, making a page that could be shown in full take part in scrolling.
   145		if formHeight < p.formNatural {
   146			p.form.WithHeight(formHeight)
   147		}
   148		title := t("tui.kander_options")
   149		switch {
   150		case p.confirming:
   151			title = t("tui.close_options")
   152		case p.current != "":
   153			title = sectionTitle(p.current)
   154		}
   155		// The unsaved marker stays in the title, so it remains visible inside a section too.
   156		if p.dirty {
   157			title += t("tui.unsaved")
   158		}
   159		hint := styleFor("popup-dim", palette).Render(p.hintLine())
   160		// An unconstrained Huh Group may carry the trailing blanks of an initialized viewport. Trim them before adding the hint,
   161		// otherwise those blanks become interior whitespace and the popup cannot hug its actual content.
   162		formView := strings.Join(trimTrailingBlank(strings.Split(p.form.View(), "\n")), "\n")
   163		return title, notice + formView + footerGap + hint
   164	}
   165	
   166	// fitOptionsForm owns the vertical layout of every section: the blank line before the hint is preserved first,
   167	// a shortage drops that blank line next, and only if it still does not fit is the Huh viewport shortened and scrolled.
   168	func fitOptionsForm(natural, available int) (height int, footerGap string) {
   169		footerHeight := 2
   170		footerGap = "\n\n"
   171		if natural+footerHeight > available {
   172			footerHeight = 1
   173			footerGap = "\n"
   174		}
   175		height = natural
   176		if height > available-footerHeight {
   177			height = available - footerHeight
   178		}
   179		if height < 1 {
   180			height = 1
   181		}
   182		return height, footerGap
   183	}
