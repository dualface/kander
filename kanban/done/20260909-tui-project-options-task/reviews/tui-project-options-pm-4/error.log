    69	
    70	// NormalizeReviewStages rewrites a raw review_stages JSON value into the two-scale
    71	// object form. A legacy flat {role: mode} object is copied onto both scales so a
    72	// later deep-merge cannot mix the two shapes. Mixed scale and role keys at the
    73	// same level are rejected with the conflicting names.
    74	func NormalizeReviewStages(raw any) (map[string]any, error) {
    75		obj, ok := raw.(map[string]any)
    76		if !ok {
    77			return nil, configErrorf("config.review_stages_must_be_a_json_object")
    78		}
    79		scales, roles, unknown := classifyReviewStages(obj)
    80		if len(scales) > 0 && len(roles) > 0 {
    81			conflict := append(append([]string{}, scales...), roles...)
    82			return nil, configErrorf(
    83				"config.review_stages_mixes_scale_and_role_keys", strings.Join(sorted(conflict), ", "),
    84			)
    85		}
    86		if len(roles) > 0 || (len(scales) == 0 && reviewStagesLooksFlat(obj)) {
    87			if len(unknown) > 0 {
    88				return nil, configErrorf(
    89					"config.review_stages_has_unknown_roles", strings.Join(unknown, ", "),
    90				)
    91			}
    92			flat := cloneRawObject(obj)
    93			out := make(map[string]any, len(TaskScales))
    94			for _, scale := range TaskScales {
    95				out[scale] = cloneRawObject(flat)
    96			}
    97			return out, nil
    98		}
    99		if len(unknown) > 0 {
   100			return nil, configErrorf(
   101				"config.review_stages_has_unknown_scales", strings.Join(unknown, ", "), strings.Join(TaskScales, ", "),
   102			)
   103		}
   104		return cloneRawObject(obj), nil
   105	}
   106	
   107	func reviewStagesLooksFlat(obj map[string]any) bool {
   108		if len(obj) == 0 {
   109			return false
   110		}
   111		for _, value := range obj {
   112			if _, ok := value.(map[string]any); ok {
   113				return false
   114			}
   115		}
   116		return true
   117	}
   118	
   119	func validateReviewStageRoles(raw any, path string) (map[string]string, error) {
   120		obj, ok := raw.(map[string]any)
   121		if !ok {
   122			return nil, configErrorf("config.review_stages_scale_must_be_a_json_object", path)
   123		}
   124		allowed := reviewRoleSet()
   125		var unknown []string
   126		for key := range obj {
   127			if _, ok := allowed[key]; !ok {
   128				unknown = append(unknown, key)
   129			}
   130		}
   131		if len(unknown) > 0 {
   132			return nil, configErrorf(
   133				"config.review_stages_has_unknown_roles", strings.Join(sorted(unknown), ", "),
   134			)
   135		}
   136		stages := defaultReviewStageRoles()
   137		for _, role := range ReviewRoles {
   138			if _, exists := obj[role]; !exists {
   139				continue
   140			}
   141			mode, err := validateChoice(obj[role], ReviewStageModes, path+"."+role)
   142			if err != nil {
   143				return nil, err
   144			}
   145			stages[role] = mode
   146		}
   147		return stages, nil
   148	}
   149	
   150	func validateReviewStages(raw any) (map[string]map[string]string, error) {
   151		normalized, err := NormalizeReviewStages(raw)
   152		if err != nil {
   153			return nil, err
   154		}
   155		stages := DefaultReviewStages()
   156		for _, scale := range TaskScales {
   157			provided, exists := normalized[scale]
   158			if !exists {
   159				continue
   160			}
   161			roles, err := validateReviewStageRoles(provided, "review_stages."+scale)
   162			if err != nil {
   163				return nil, err
   164			}
   165			stages[scale] = roles
   166		}
   167		return stages, nil
   168	}
   169	
   170	// ReviewStageFor picks the stage policy of one review role for one task scale.
   171	func ReviewStageFor(cfg *Config, scale, role string) (string, error) {
   172		if cfg == nil || cfg.ReviewStages == nil {
   173			return "", configErrorf("config.unknown_task_scale", scale)
   174		}
   175		if !contains(TaskScales, scale) {
   176			return "", configErrorf("config.unknown_task_scale", scale)
   177		}
   178		if !contains(ReviewRoles, role) {
   179			return "", configErrorf("config.review_stages_has_unknown_roles", role)
   180		}
   181		if cfg.ReviewStages[scale] == nil {
   182			return "auto", nil
   183		}
   184		mode := cfg.ReviewStages[scale][role]
   185		if mode == "" {
   186			return "auto", nil
   187		}
   188		return mode, nil
   189	}

