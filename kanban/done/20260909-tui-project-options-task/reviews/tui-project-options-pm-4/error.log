+	}
+	plain := session.text()
+	if !strings.Contains(plain, "Global") || !strings.Contains(plain, "Project") {
+		t.Fatalf("global install should show both tabs\npty:\n%s", plain)
+	}
+	if !strings.Contains(plain, project) {
