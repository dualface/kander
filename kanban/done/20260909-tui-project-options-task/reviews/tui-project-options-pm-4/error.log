   715	func (b *formBinding) applyInterface(p *optionsPanel) {
   716		app := p.app
   717		changed := false
   718		overlay := p.session != nil && p.session.EditingOverlay()
   719		var scopeTUI config.TUI
   720		if p.session != nil && p.session.Config != nil {
   721			scopeTUI = p.session.Config.TUI
   722		}
   723		if containsString(themes, b.theme) && app.Theme != b.theme {
   724			app.Theme = b.theme
   725			scopeTUI.Theme = b.theme
   726			changed = true
   727			if overlay {
   728				p.session.SetTUIField("theme", b.theme)
   729			}
   730			// Huh caches the body during Update, and that cache still uses the old theme at this point.
   731			// Reuse the section rebuild path so the current frame takes effect and focus stays on the theme selector.
   732			p.rebuildAt(interfaceFocusKey("theme"))
   733		}
   734		if count := clampColumns(b.columns); app.Columns != count {
   735			app.Columns = count
   736			scopeTUI.Columns = count
   737			changed = true
   738			if overlay {
   739				p.session.SetTUIField("columns", count)
   740			}
   741		}
   742		if width := clampMinColumnWidth(b.minWidth); app.MinColumnWidth != width {
   743			app.MinColumnWidth = width
   744			scopeTUI.MinColumnWidth = width
   745			changed = true
   746			if overlay {
   747				p.session.SetTUIField("min_column_width", width)
   748			}
   749		}
   750		if refresh := clampRefresh(b.refresh); app.RefreshSecs != refresh {
   751			app.RefreshSecs = refresh
   752			scopeTUI.Refresh = refresh
   753			changed = true
   754			if overlay {
   755				p.session.SetTUIField("refresh", refresh)
   756			}
   757		}
   758		if app.Model.Single != b.single {
   759			app.Model.Single = b.single
   760			scopeTUI.Single = b.single
   761			changed = true
