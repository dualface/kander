    56	// deepMerge copies base and overlays src onto it: objects merge by key,
    57	// scalars and arrays replace wholesale.
    58	func deepMerge(base, overlay map[string]any) map[string]any {
    59		out := cloneRawObjectDeep(base)
    60		for key, value := range overlay {
    61			if overlayObj, ok := value.(map[string]any); ok {
    62				if baseObj, ok := out[key].(map[string]any); ok {
    63					out[key] = deepMerge(baseObj, overlayObj)
    64					continue
    65				}
    66			}
    67			out[key] = cloneRawValue(value)
    68		}
    69		return out
    70	}
