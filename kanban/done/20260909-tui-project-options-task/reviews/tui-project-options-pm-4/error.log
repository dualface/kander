     8	// AgentExecutableFields shares one definition between both task scales.
     9	// Blank edits remove the override instead of persisting an invalid empty value.
    10	func (s *Session) AgentExecutableFields(scale string) []ModelField {
    11		agent := s.Config.KanbanAgents[scale]
    12		if agent == "" {
    13			return nil
    14		}
    15		var out []ModelField
    16		for _, key := range []string{"path", "process_name"} {
    17			field := key
    18			label := config.Text("menu.agent_" + field)
    19			out = append(out, ModelField{Agent: agent, field: field, Label: agent + " " + label, Short: label, Prompt: label,
    20				Placeholder: config.Text("menu.agent_default"),
    21				get: func() string {
    22					d := s.Config.Agents[agent]
    23					if field == "path" {
    24						return d.Path
    25					}
    26					return d.ProcessName
    27				},
    28				set: func(value string) {
    29					if s.Config.Agents == nil {
    30						s.Config.Agents = map[string]config.AgentDefinition{}
    31					}
    32					d := s.Config.Agents[agent]
    33					value = strings.TrimSpace(value)
    34					if field == "path" {
    35						d.Path = value
    36					} else {
    37						d.ProcessName = value
    38					}
    39					if d.Path == "" && d.ProcessName == "" && d.Dialect == "" && d.Args == nil && d.Session == nil {
    40						delete(s.Config.Agents, agent)
    41					} else {
    42						s.Config.Agents[agent] = d
    43					}
    44				},
    45			})
    46		}
    47		return out
    48	}

