    14	// AgentDefinition overrides an execution agent only; reviewers retain their own read-only adapters.
    15	// The map key in Config.Agents is the stable agent name stored on task cards.
    16	type AgentDefinition struct {
    17		Path        string                  `json:"path,omitempty"`
    18		ProcessName string                  `json:"process_name,omitempty"`
    19		Dialect     string                  `json:"dialect,omitempty"`
    20		Args        *AgentArgs              `json:"args,omitempty"`
    21		Session     *AgentSessionDefinition `json:"session,omitempty"`
    22	}
    23	
    24	type AgentArgs struct {
    25		Start  []string `json:"start"`
    26		Resume []string `json:"resume"`
    27	}
    28	
    29	// Allocate is an argv array including the executable. Output is a plain ID or a
    30	// JSON object with the named top-level field. Both forms validate the resulting ID.
    31	type AgentSessionDefinition struct {
    32		Mode      string   `json:"mode"`
    33		Allocate  []string `json:"allocate,omitempty"`
    34		JSONField string   `json:"json_field,omitempty"`
    35	}
