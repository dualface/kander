   149	// RestoreInherit deletes an overlay key and refreshes the effective view.
   150	func (s *Session) RestoreInherit(path ...string) error {
   151		if s.overlayRaw == nil {
   152			s.overlayRaw = map[string]any{}
   153		}
   154		config.OverlayDelete(s.overlayRaw, path...)
   155		if len(path) == 3 && path[0] == "review_stages" {
   156			config.OverlayDelete(s.overlayRaw, "review_stages", path[2])
   157		}
   158		s.OverlayDirty = true
   159		if s.EditingOverlay() {
   160			return s.rebuildOverlayConfig()
   161		}
   162		return nil
   163	}
