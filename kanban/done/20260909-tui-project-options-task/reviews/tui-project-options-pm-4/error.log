   699	// applyModels writes changes made in the model inputs back to the config session immediately.
   700	func (b *formBinding) applyModels(p *optionsPanel) {
   701		for i, field := range b.modelFields {
   702			if i >= len(b.modelValues) || b.modelValues[i] == nil {
   703				continue
   704			}
   705			if field.Value() != *b.modelValues[i] {
   706				field.Set(*b.modelValues[i])
   707				if p.session != nil {
   708					p.session.NoteModelOverride(field, *b.modelValues[i])
   709				}
   710				p.markDirty()
   711			}
   712		}
   713	}
