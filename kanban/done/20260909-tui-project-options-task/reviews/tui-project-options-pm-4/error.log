   259	// keyCmd wraps one key press as a command handed back to Bubble Tea, which delivers it into Update asynchronously.
   260	// The commands returned by the form must not be called in place: the cursor blink chain of a text input contains a tea.Tick,
   261	// and running it synchronously really does sleep for over half a second, which feels like a hitch on every key press.
   262	func keyCmd(key tea.KeyType) tea.Cmd {
   263		return func() tea.Msg { return tea.KeyMsg{Type: key} }
   264	}
   265	
   266	// repeatCmd hands the same command to Bubble Tea n times.
   267	func repeatCmd(n int, cmd tea.Cmd) tea.Cmd {
   268		if n <= 0 {
   269			return nil
   270		}
   271		cmds := make([]tea.Cmd, 0, n)
   272		for i := 0; i < n; i++ {
   273			cmds = append(cmds, cmd)
   274		}
   275		return tea.Batch(cmds...)
   276	}
   277	
   278	// bodyLines returns the rendered lines of the current form body, used to convert mouse coordinates into field positions.
   279	func (p *optionsPanel) currentBodyLines() []string {
   280		if p.form == nil {
   281			return p.bodyLines
   282		}
   283		return trimTrailingBlank(strings.Split(p.form.View(), "\n"))
   284	}
   285	
   286	// optionsMouseActivate is true for a left click or a same-position release.
   287	// mapButtons never sets mouseBtn1Clicked; a real single click arrives as press then release.
   288	func optionsMouseActivate(bstate int) bool {
   289		return mouseLeftClicked(bstate) || mouseButton1Released(bstate)
   290	}
   291	
   292	// HandleMouse gives the popup click-to-focus, double-click confirmation and wheel scrolling.
   293	// Every focus move is turned into a command handed back to Bubble Tea rather than driving the form synchronously here.
   294	func (p *optionsPanel) HandleMouse(x, y, bstate int) tea.Cmd {
   295		if p.report != nil {
   296			delta := mouseWheelDelta(bstate)
   297			if delta > 0 {
   298				p.report.view.ScrollDown(delta * mouseScrollStep)
   299			} else if delta < 0 {
   300				p.report.view.ScrollUp(-delta * mouseScrollStep)
   301			}
   302			return nil
   303		}
   304		if p.form == nil {
   305			return nil
   306		}
   307		if cmd := p.handleTabMouse(x, y, bstate); cmd != nil {
   308			return cmd
   309		}
   310		if delta := mouseWheelDelta(bstate); delta != 0 {
   311			if delta > 0 {
   312				return keyCmd(tea.KeyDown)
   313			}
   314			return keyCmd(tea.KeyUp)
   315		}
   316		if !optionsMouseActivate(bstate) {
   317			return nil
   318		}
   319		if x < p.bodyX || x >= p.bodyX+p.bodyWidth || y < p.bodyY || y >= p.bodyY+p.bodyHeight {
   320			return nil
   321		}
   322		target := y - p.bodyY - p.chromeLines
   323		lines := p.currentBodyLines()
   324		if target < 0 || target >= len(lines) {
   325			return nil
   326		}
   327		move, already := p.focusMove(lines, target)
   328		if already || mouseLeftDoubleClicked(bstate) {
   329			// Clicking an already focused line, or double-clicking, counts as confirmation.
   330			return tea.Batch(move, keyCmd(tea.KeyEnter))
   331		}
   332		return move
   333	}
   334	
   335	// focusMove computes the commands needed to move focus to the target line and reports whether the target already has focus.
   336	// Single-choice pages (the root menu, the close confirmation) move by candidate line; settings pages convert using the actual rendered height
   337	// of each field, independently of whether blank lines sit between them.
   338	func (p *optionsPanel) focusMove(lines []string, target int) (tea.Cmd, bool) {
   339		for i, line := range lines {
   340			if strings.Contains(ansi.Strip(line), focusMarker) {
   341				delta := target - i
   342				switch {
   343				case delta == 0:
   344					return nil, true
   345				case delta > 0:
   346					return repeatCmd(delta, keyCmd(tea.KeyDown)), false
   347				default:
   348					return repeatCmd(-delta, keyCmd(tea.KeyUp)), false
   349				}
   350			}
   351		}
   352		if p.bind == nil || len(p.bind.formFields) == 0 {
   353			return nil, false
   354		}
   355		row, focusable := 0, 0
   356		wanted, current := -1, -1
   357		for _, field := range p.bind.formFields {
   358			view := field.View()
   359			height := lipgloss.Height(view)
   360			if !field.Skip() {
   361				if target >= row && target < row+height {
   362					wanted = focusable
   363				}
   364				if strings.Contains(ansi.Strip(view), focusBorder) {
   365					current = focusable
   366				}
   367				focusable++
   368			}
   369			row += height
   370		}
   371		if wanted < 0 || current < 0 {
   372			return nil, false
   373		}
   374		delta := wanted - current
   375		switch {
   376		case delta == 0:
   377			return nil, true
   378		case delta > 0:
   379			return repeatCmd(delta, huh.NextField), false
   380		default:
   381			return repeatCmd(-delta, huh.PrevField), false
   382		}
   383	}

