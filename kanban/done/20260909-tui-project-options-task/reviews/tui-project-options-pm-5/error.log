   211	// DocumentFromConfig encodes a filled Config as a JSON object. In-memory
   212	// sessions use this when no original document exists. Overlay save and Load
   213	// must use LoadScopeDocument so missing optional sections stay missing.
   214	func DocumentFromConfig(cfg *Config) (map[string]any, error) {
   215		if cfg == nil {
   216			cfg = DefaultConfig()
   217		}
   218		encoded, err := json.Marshal(cfg)
   219		if err != nil {
   220			return nil, configErrorfWrap(err, "config.failed_to_read_config_2", err.Error())
   221		}
   222		raw, err := decodeJSON(encoded)
   223		if err != nil {
   224			return nil, err
   225		}
   226		obj, ok := raw.(map[string]any)
   227		if !ok {
   228			return nil, configErrorf("config.config_root_must_be_a_json_object")
   229		}
   230		return obj, nil
   231	}
   232	
   233	// LoadScopeDocument returns the raw scope JSON object used by overlay merge.
   234	func LoadScopeDocument(missingOK bool) (map[string]any, error) {
   235		path, err := ConfigPath()
   236		if err != nil {
   237			return nil, err
   238		}
   239		_, raw, err := loadScopeRawAt(path, missingOK)
   240		if err != nil {
   241			return nil, err
   242		}
   243		return raw, nil
   244	}
