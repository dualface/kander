    64	func (p *optionsPanel) renderScopeChrome(palette palette, width int) (string, int) {
    65		if p.confirming {
    66			p.tabHits = nil
    67			return "", 0
    68		}
    69		var lines []string
    70		if p.session != nil && len(p.session.AvailableTargets()) > 1 {
    71			lines = append(lines, p.renderTabBar(palette, width))
    72		}
    73		loc := overlayDisplayLocation(p)
    74		if loc.ProjectRoot != "" {
    75			lines = append(lines, styleFor("popup-dim", palette).Render(clipPath(t("tui.project_path", loc.ProjectRoot), width)))
    76		}
    77		if loc.Path != "" {
    78			lines = append(lines, styleFor("popup-dim", palette).Render(clipPath(t("tui.overlay_file", loc.Path), width)))
    79		}
    80		if base := overlayBasePath(p); base != "" {
    81			lines = append(lines, styleFor("popup-dim", palette).Render(clipPath(t("tui.base_config", base), width)))
    82		}
    83		if p.session != nil && p.session.EditingOverlay() && loc.Path != "" && !loc.Exists {
    84			lines = append(lines, styleFor("popup-dim", palette).Render(clipText(t("tui.overlay_will_create"), width)))
    85		}
    86		if len(lines) == 0 {
    87			return "", 0
    88		}
    89		return strings.Join(lines, "\n") + "\n", len(lines)
    90	}
