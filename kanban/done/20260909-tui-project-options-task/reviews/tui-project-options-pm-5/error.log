   314		}
   315		session.send("]")
   316		if !session.waitFor("Overlay file does not exist yet", 6*time.Second) {
   317			t.Fatalf("project tab did not show create hint\npty:\n%s", session.text())
   318		}
   319		session.send("\r")
   320		if !session.waitFor("Global:", 6*time.Second) {
   321			t.Fatalf("project tab did not show inherit prefix\npty:\n%s", session.text())
