   321	// rebuildAt requests a rebuild of the current section after this update, with focus landing back on the selector named by key.
   322	// When the execution agent or the reviewer changes, the model fields on the same screen belong to a different object and must be rebuilt.
   323	func (p *optionsPanel) rebuildAt(key string) {
   324		p.rebuildFocus = key
   325	}
   326	
   327	// rebuildSection rebuilds the current section and moves focus back to the original field.
   328	// The focus move is left to Bubble Tea to run asynchronously; the form commands must not run synchronously here,
   329	// because the blink chain of a text input contains a tea.Tick that would block for over half a second.
   330	func (p *optionsPanel) rebuildSection() tea.Cmd {
   331		key := p.rebuildFocus
   332		p.rebuildFocus = ""
   333		section := p.current
   334		if section == "" {
   335			return nil
   336		}
   337		cmd := p.openSection(section)
   338		// openSection rebuilt bind, so only now is it known which position that selector holds in the new form.
   339		index := 0
   340		if p.bind != nil {
   341			index = p.bind.fieldIndex[key]
   342		}
   343		return tea.Batch(cmd, repeatCmd(index, huh.NextField))
   344	}
   345	
   346	// resizeForm rebuilds the form so every page re-measures its natural height against the new terminal size.
   347	// Huh's WithHeight cannot be undone; a form once compressed by a short terminal can only leave the scrolling layout through a rebuild.
   348	func (p *optionsPanel) resizeForm() tea.Cmd {
   349		if p.form == nil || p.report != nil {
   350			return nil
   351		}
   352		if p.confirming {
   353			return p.openCloseConfirm()
   354		}
   355		if p.current == "" {
   356			return p.openRoot()
   357		}
   358		index := 0
   359		if p.bind != nil {
   360			focused := p.form.GetFocusedField()
   361			for _, field := range p.bind.formFields {
   362				if field.Skip() {
   363					continue
   364				}
   365				if field == focused {
   366					break
   367				}
   368				index++
   369			}
   370		}
   371		section := p.current
   372		cmd := p.openSection(section)
   373		return tea.Batch(cmd, repeatCmd(index, huh.NextField))
   374	}
