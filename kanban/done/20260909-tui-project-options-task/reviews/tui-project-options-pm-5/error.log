   285	func overlayMapsEqual(a, b map[string]any) bool {
   286		if len(a) == 0 && len(b) == 0 {
   287			return true
   288		}
   289		left, err := encodeOverlay(a)
   290		if err != nil {
   291			return false
   292		}
   293		right, err := encodeOverlay(b)
   294		if err != nil {
   295			return false
   296		}
   297		return bytes.Equal(left, right)
   298	}
