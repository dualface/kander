    92	func (p *optionsPanel) renderTabBar(palette palette, width int) string {
    93		targets := p.session.AvailableTargets()
    94		active := p.session.Target
    95		if active == "" {
    96			active = config.TargetScope
    97		}
    98		p.tabHits = nil
    99		cursor := 0
   100		var parts []string
   101		for i, target := range targets {
   102			label := t("tui.tab_global")
   103			if target == config.TargetOverlay {
   104				label = t("tui.tab_project")
   105			}
   106			text := " " + label + " "
   107			style := lipgloss.NewStyle().Foreground(palette.Dim).Background(palette.Bg)
   108			if target == active {
   109				style = lipgloss.NewStyle().Foreground(palette.ChromeFg).Background(palette.ChromeBg).Bold(true)
   110			}
   111			rendered := style.Render(text)
   112			p.tabHits = append(p.tabHits, tabHit{target: target, x0: cursor, x1: cursor + displayWidth(text)})
   113			parts = append(parts, rendered)
   114			cursor += displayWidth(text)
   115			if i+1 < len(targets) {
   116				gap := "  "
   117				parts = append(parts, styleFor("popup-dim", palette).Render(gap))
   118				cursor += displayWidth(gap)
   119			}
   120		}
   121		line := strings.Join(parts, "")
   122		if displayWidth(ansi.Strip(line)) > width {
   123			return clipText(ansi.Strip(line), width)
   124		}
   125		return line
   126	}
