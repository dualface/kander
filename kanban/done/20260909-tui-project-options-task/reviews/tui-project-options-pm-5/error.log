   128	func (p *optionsPanel) hitTab(x, y int) string {
   129		if y != 0 || len(p.tabHits) == 0 {
   130			return ""
   131		}
   132		for _, hit := range p.tabHits {
   133			if x >= hit.x0 && x < hit.x1 {
   134				return hit.target
   135			}
   136		}
   137		return ""
   138	}
   139	
   140	func (p *optionsPanel) handleTabMouse(x, y, bstate int) tea.Cmd {
   141		if p.confirming || p.report != nil || !optionsMouseActivate(bstate) || p.session == nil {
   142			return nil
   143		}
   144		localX := x - p.bodyX
   145		localY := y - p.bodyY
   146		target := p.hitTab(localX, localY)
   147		if target == "" {
   148			return nil
   149		}
   150		return p.switchTab(target)
   151	}
   285	}
