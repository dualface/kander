     9	
    10	// ApplyDoctorConfig adopts the doctor repair result while keeping edits not yet saved in the panel.
    11	func (s *Session) ApplyDoctorConfig(before, after *config.Config, dirty bool) error {
    12		merged := after
    13		edited := s.scopeConfig
    14		if edited == nil {
    15			edited = s.Config
    16		}
    17		preserve := s.ScopeDirty || (dirty && !s.EditingOverlay())
    18		if preserve {
    19			if before == nil {
    20				before = config.DefaultConfig()
    21			}
    22			objects := make([]map[string]any, 3)
    23			for i, cfg := range []*config.Config{before, edited, after} {
    24				data, err := json.Marshal(cfg)
    25				if err != nil {
    26					return err
    27				}
    28				if err := json.Unmarshal(data, &objects[i]); err != nil {
    29					return err
    30				}
    31			}
    32			preserveDoctorEdits(objects[0], objects[1], objects[2])
    33			objects[2]["welcome_complete"] = after.WelcomeComplete
    34			data, err := json.Marshal(objects[2])
    35			if err != nil {
    36				return err
    37			}
    38			merged, err = config.ValidateJSON(data)
    39			if err != nil {
    40				return err
    41			}
    42		}
    43		s.existing = after
    44		s.scopeExisting = config.Clone(after)
    45		s.scopeConfig = merged
    46		if s.EditingOverlay() {
    47			return s.rebuildOverlayConfig()
    48		}
    49		s.Config = merged
    50		return nil
    51	}
    52	
    53	func preserveDoctorEdits(before, edited, after map[string]any) {
    54		for key, value := range edited {
    55			oldObject, oldOK := before[key].(map[string]any)
    56			editObject, editOK := value.(map[string]any)
    57			newObject, newOK := after[key].(map[string]any)
    58			if oldOK && editOK && newOK {
    59				preserveDoctorEdits(oldObject, editObject, newObject)
    60			} else if !reflect.DeepEqual(before[key], value) {
    61				after[key] = value
    62			}
    63		}
    64	}
    65	
    66	// SyncTUI adopts UI preferences that changed outside this session.
    67	// persisted means the value already reached disk and the editing baseline must advance with it, otherwise saving would mistake it for another process's change.
    68	func (s *Session) SyncTUI(value config.TUI, persisted bool) {
    69		if s == nil {
    70			return
    71		}
    72		if s.scopeConfig != nil {
    73			s.scopeConfig.TUI = value
    74		}
    75		if !s.EditingOverlay() && s.Config != nil {
    76			s.Config.TUI = value
    77		}
    78		if persisted && s.existing != nil {
    79			s.existing.TUI = value
    80		}
    81		if persisted && s.scopeExisting != nil {
    82			s.scopeExisting.TUI = value
    83		}
    84	}

