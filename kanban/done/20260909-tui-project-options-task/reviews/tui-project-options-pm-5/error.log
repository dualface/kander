   246	// MergeOverlayOnRaw validates overlay keys against a raw scope JSON document,
   247	// matching Load. Do not pass a filled Config: missing optional sections would
   248	// be filled and then accept overlays that Load rejects.
   249	func MergeOverlayOnRaw(scopeRaw, overlay map[string]any) (*Config, error) {
   250		if scopeRaw == nil {
   251			scopeRaw = map[string]any{}
   252		}
   253		base := cloneRawObjectDeep(scopeRaw)
   254		if len(overlay) == 0 {
   255			return Validate(base)
   256		}
   257		merged, err := mergeOverlayRaw(base, overlay)
   258		if err != nil {
   259			return nil, err
   260		}
   261		return Validate(merged)
   262	}
   263	
   264	// MergeScopeAndOverlay validates a filled Config plus sparse overlay keys.
   265	// Overlay save and Project-tab preview use MergeOverlayOnRaw instead.
   266	func MergeScopeAndOverlay(scope *Config, overlay map[string]any) (*Config, error) {
   267		raw, err := DocumentFromConfig(scope)
   268		if err != nil {
   269			return nil, err
   270		}
   271		return MergeOverlayOnRaw(raw, overlay)
   272	}
