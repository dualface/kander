   580	func (p *optionsPanel) reviewGroup(bind *formBinding) *huh.Group {
   581		session := p.session
   582		cfg := session.Config
   583		bind.reset()
   584		for _, role := range config.ReviewRoles {
   585			if len(bind.formFields) > 0 {
   586				bind.addSpacer()
   587			}
   588			value := cfg.Reviewers[role]
   589			bind.reviewers[role] = &value
   590			bind.fieldIndex[roleFocusKey(role)] = bind.focusable
   591			bind.addField(huh.NewSelect[string]().
   592				Title(p.inheritTitle(role+" Reviewer", value, "reviewers", role)).
   593				Description(t("tui.which_agent_reviews_this_role")).
   594				Options(toOptions(session.ReviewerChoicesFor(value))...).
   595				Value(bind.reviewers[role]).
   596				Inline(true))
   597			bind.addRestore(p, value, "reviewers", role)
   598			// Each role keeps a large and a small stage selector, matching kanban_agents.
   599			for _, scale := range config.TaskScales {
   600				stage, err := config.ReviewStageFor(cfg, scale, role)
   601				if err != nil {
   602					stage = "auto"
   603				}
   604				key := stageFocusKey(role, scale)
   605				bind.stages[key] = &stage
   606				bind.fieldIndex[key] = bind.focusable
   607				bind.addField(huh.NewSelect[string]().
   608					Title(p.inheritTitle(modelIndent+t("tui.review_stage", t("config."+scale)), stage, "review_stages", scale, role)).
   609					// The value line is indented along with the title: a Select puts its value on its own line, so indenting the title alone would look ragged.
   610					Options(reviewStageOptions()...).
   611					Value(bind.stages[key]).
   612					Inline(true))
   613				bind.addRestore(p, stage, "review_stages", scale, role)
   614			}
   615			p.addModelInputs(bind, session.ReviewModelFieldsFor(role))
   616		}
   617		return huh.NewGroup(bind.formFields...)
   618	}
