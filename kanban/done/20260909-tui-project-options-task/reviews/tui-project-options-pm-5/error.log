   376	// requestClose closes the panel; unsaved changes make the user choose first.
   377	func (p *optionsPanel) requestClose() tea.Cmd {
   378		if !p.dirty {
   379			p.close()
   380			return nil
   381		}
   382		return p.openCloseConfirm()
   383	}
