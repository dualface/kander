   717	// applyModels writes changes made in the model inputs back to the config session immediately.
   718	func (b *formBinding) applyModels(p *optionsPanel) {
   719		for i, field := range b.modelFields {
   720			if i >= len(b.modelValues) || b.modelValues[i] == nil {
   721				continue
   722			}
   723			if field.Value() != *b.modelValues[i] {
   724				path := modelOverlayPath(field)
   725				before := p.overridePresence(path...)
   726				field.Set(*b.modelValues[i])
   727				if p.session != nil {
   728					p.session.NoteModelOverride(field, *b.modelValues[i])
   729				}
   730				p.markDirty()
   731				if len(path) > 0 {
   732					p.rebuildIfOverrideChanged(before, modelFocusKey(field), path...)
   733				}
   734			}
   735		}
   736	}
   737	
   738	func (b *formBinding) applyInterface(p *optionsPanel) {
   739		app := p.app
   740		changed := false
   741		overlay := p.session != nil && p.session.EditingOverlay()
   742		var scopeTUI config.TUI
   743		if p.session != nil && p.session.Config != nil {
   744			scopeTUI = p.session.Config.TUI
   745		}
   746		if containsString(themes, b.theme) && app.Theme != b.theme {
   747			app.Theme = b.theme
   748			scopeTUI.Theme = b.theme
   749			changed = true
   750			if overlay {
   751				p.session.SetTUIField("theme", b.theme)
   752			}
   753			// Huh caches the body during Update, and that cache still uses the old theme at this point.
   754			// Reuse the section rebuild path so the current frame takes effect and focus stays on the theme selector.
   755			p.rebuildAt(interfaceFocusKey("theme"))
   756		}
   757		if count := clampColumns(b.columns); app.Columns != count {
   758			app.Columns = count
   759			scopeTUI.Columns = count
   760			changed = true
   761			if overlay {
   762				before := p.overridePresence("tui", "columns")
   763				p.session.SetTUIField("columns", count)
   764				p.rebuildIfOverrideChanged(before, interfaceFocusKey("columns"), "tui", "columns")
   765			}
   766		}
   767		if width := clampMinColumnWidth(b.minWidth); app.MinColumnWidth != width {
   768			app.MinColumnWidth = width
   769			scopeTUI.MinColumnWidth = width
   770			changed = true
   771			if overlay {
   772				before := p.overridePresence("tui", "min_column_width")
   773				p.session.SetTUIField("min_column_width", width)
   774				p.rebuildIfOverrideChanged(before, interfaceFocusKey("min_column_width"), "tui", "min_column_width")
   775			}
   776		}
   777		if refresh := clampRefresh(b.refresh); app.RefreshSecs != refresh {
   778			app.RefreshSecs = refresh
   779			scopeTUI.Refresh = refresh
   780			changed = true
   781			if overlay {
   782				before := p.overridePresence("tui", "refresh")
   783				p.session.SetTUIField("refresh", refresh)
   784				p.rebuildIfOverrideChanged(before, interfaceFocusKey("refresh"), "tui", "refresh")
   785			}
   786		}
   787		if app.Model.Single != b.single {
   788			app.Model.Single = b.single
   789			scopeTUI.Single = b.single
   790			changed = true
   791			if overlay {
   792				p.session.SetTUIField("single", b.single)
   793			}
   794			p.rebuildAt(interfaceFocusKey("single"))
   795		}
   796		if app.Model.ShowArchived != b.archived {
   797			app.Model.ToggleArchived()
   798			changed = true
   799		}
   800		if p.session != nil && p.session.Config != nil && !overlay {
   801			p.session.Config.TUI = scopeTUI
   802		}
   803		if !changed {
   804			return
   805		}
   806		if overlay {
   807			p.markDirty()
   808			return
   809		}
   810		// UI preferences reach config.json as soon as they change, so returning with Esc loses nothing.
   811		p.persistUI()
   812	}
