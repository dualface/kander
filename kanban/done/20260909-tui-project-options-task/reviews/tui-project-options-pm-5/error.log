   367	// SaveOverlayIfUnchanged writes only explicit overlay keys after validating the
   368	// merged effective config. An empty overlay deletes the file and never creates one.
   369	func SaveOverlayIfUnchanged(path string, overlay, baseline map[string]any) (string, error) {
   370		if path == "" {
   371			return "", configErrorf("config.failed_to_inspect_path", ".")
   372		}
   373		if overlay == nil {
   374			overlay = map[string]any{}
   375		}
   376		if err := validateOverlayKeys(path, overlay); err != nil {
   377			return "", err
   378		}
   379		raw, err := LoadScopeDocument(true)
   380		if err != nil {
   381			return "", err
   382		}
   383		if _, err := MergeOverlayOnRaw(raw, overlay); err != nil {
   384			return "", err
   385		}
   386		abs, err := lexicalAbsolute(path)
   387		if err != nil {
   388			return "", err
   389		}
   390		lockPath, err := overlayAdvisoryLock(abs)
   391		if err != nil {
   392			return "", err
   393		}
   394		err = withConfigLockFile(abs, lockPath, func() error {
   395			current, _, readErr := readOverlayMapAt(abs)
   396			if readErr != nil {
   397				return readErr
   398			}
   399			if !overlayMapsEqual(current, baseline) {
   400				return configErrorf("config.configuration_changed_while_editing")
   401			}
   402			if len(overlay) == 0 {
   403				return removeOverlayFile(abs)
   404			}
   405			return writeOverlayAt(abs, overlay)
   406		})
   407		if err != nil {
   408			return "", err
   409		}
   410		return abs, nil
   411	}
