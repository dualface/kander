   274	func encodeOverlay(obj map[string]any) ([]byte, error) {
   275		if obj == nil {
   276			obj = map[string]any{}
   277		}
   278		payload, err := json.MarshalIndent(obj, "", "  ")
   279		if err != nil {
   280			return nil, err
   281		}
   282		return append(payload, '\n'), nil
   283	}
