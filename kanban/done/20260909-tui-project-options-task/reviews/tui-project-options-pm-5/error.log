   815	// installing tmux occupies the terminal and changes the local environment, so it must not run as the cursor moves.
   816	func (b *formBinding) commitSideEffects(p *optionsPanel) {
   817		switch p.current {
   818		case sectionExecution:
   819			b.commitLauncher(p)
   820		}
