   353		if err := fs.EnsureInheritedDirectoryPath(filepath.Dir(abs)); err != nil {
   354			return wrapSaveError(path, err)
   355		}
   356		if err := fs.WriteTextAtomicInherited(anchor, abs, string(payload), true); err != nil {
   357			return wrapSaveError(path, err)
   358		}
