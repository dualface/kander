   296			t.Fatalf("board did not render\npty:\n%s", session.text())
   297		}
   298		session.send("o")
   299		if !session.waitFor("Save and apply", 10*time.Second) {
   300			t.Fatalf("options panel did not open\npty:\n%s", session.text())
   301		}
