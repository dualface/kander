    15	
    16	func (p *optionsPanel) inheritTitle(title, display string, path ...string) string {
    17		if p.session == nil || !p.session.EditingOverlay() || p.session.FieldOverridden(path...) {
    18			return title
    19		}
    20		return title + "  " + p.session.FormatInherited(display)
    21	}
    22	
    23	func (p *optionsPanel) overridePresence(path ...string) bool {
    24		return p.session != nil && p.session.FieldOverridden(path...)
    25	}
    26	
    27	func (p *optionsPanel) rebuildIfOverrideChanged(before bool, key string, path ...string) {
    28		if p.session == nil || !p.session.EditingOverlay() {
    29			return
    30		}
    31		if p.session.FieldOverridden(path...) != before {
    32			p.rebuildAt(key)
    33		}
    34	}
    35	
    36	func (b *formBinding) addRestore(p *optionsPanel, display string, path ...string) {
    37		if p.session == nil || !p.session.EditingOverlay() || !p.session.FieldOverridden(path...) {
    38			return
    39		}
    40		flag := false
    41		b.restores = append(b.restores, restoreField{
    42			path: append([]string{}, path...),
    43			flag: &flag,
    44		})
    45		b.addField(huh.NewConfirm().
    46			Title(modelIndent + t("tui.restore_field_inherit") + "  " + display).
    47			Value(&flag).
    48			Inline(true))
    49	}
    50	
    51	func (b *formBinding) applyRestores(p *optionsPanel) bool {
    52		if p.session == nil {
    53			return false
    54		}
    55		changed := false
    56		for _, item := range b.restores {
    57			if item.flag == nil || !*item.flag {
    58				continue
    59			}
    60			if err := p.session.RestoreInherit(item.path...); err != nil {
    61				p.showReport(t("tui.load_failed"), nil, err.Error())
    62				continue
    63			}
    64			changed = true
    65		}
    66		if changed {
    67			p.syncAppFromSession()
    68			p.dirty = p.session.HasUnsaved()
    69			p.rebuildAt("restored")
    70		}
    71		return changed
    72	}
    73	
    74	func (p *optionsPanel) syncAppFromSession() {
    75		if p == nil || p.app == nil || p.session == nil || p.session.Config == nil {
    76			return
    77		}
    78		tui := p.session.Config.TUI
    79		p.app.Theme = tui.Theme
    80		p.app.Columns = tui.Columns
    81		p.app.MinColumnWidth = tui.MinColumnWidth
    82		p.app.RefreshSecs = tui.Refresh
    83		p.app.Model.Single = tui.Single
    84	}
