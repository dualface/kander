   413	// overlayAdvisoryLock keeps the exclusive lock out of the project tree so a
   414	// save cannot leave .kander-config.json.lock next to user sources.
   415	func overlayAdvisoryLock(overlay string) (string, error) {
   416		cfgPath, err := ConfigPath()
   417		if err != nil {
   418			return "", err
   419		}
   420		sum := sha256.Sum256([]byte(overlay))
