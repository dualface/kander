     5	// SetRules keeps both configuration UIs on the same validation and copy boundary.
     6	func (s *Session) SetRules(rules config.Rules) error {
     7		if err := config.ValidateRules(rules); err != nil {
     8			return err
     9		}
    10		previous := s.Config.Rules.Clone()
    11		s.Config.Rules = rules.Clone()
    12		if s.EditingOverlay() {
    13			for _, module := range config.RuleModules {
    14				if previous[module] != rules[module] {
    15					s.noteOverride([]string{"rules", module}, rules[module])
    16				}
    17			}
    18			return nil
    19		}
    20		s.ScopeDirty = true
    21		return nil
    22	}
    23	
    24	func RulesSessionNotice() string {
    25		return config.Text("rules.session_notice")
    26	}
    27	
    28	func editRules(session *Session) error {
    29		for {
    30			var choices []Choice
    31			for _, module := range config.RuleModules {
    32				state := config.Text("rules.off")
    33				if session.Config.Rules[module] {
    34					state = config.Text("rules.on")
    35				}
    36				choices = append(choices, Choice{Value: module, Label: config.RuleLabel(module) + ": " + state})
    37			}
    38			choices = append(choices,
    39				Choice{Value: "all", Label: config.Text("rules.all")},
    40				Choice{Value: "none", Label: config.Text("rules.none")},
    41				Choice{Value: "back", Label: config.Text("rules.back")},
    42			)
    43			selected, err := askChoice(config.Text("rules.toggle"), choices, "back")
    44			if err != nil {
    45				return err
    46			}
    47			if selected == "back" {
    48				return nil
    49			}
    50			rules := session.Config.Rules.Clone()
    51			if selected == "all" || selected == "none" {
    52				rules = config.DefaultRules(selected == "all")
    53			} else {
    54				rules[selected] = !rules[selected]
    55			}
    56			if err := session.SetRules(rules); err != nil {
    57				warning(err.Error())
    58			}
    59		}
    60	}
