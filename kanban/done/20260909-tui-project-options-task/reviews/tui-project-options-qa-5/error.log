    53	func preserveDoctorEdits(before, edited, after map[string]any) {
    54		for key, value := range edited {
    55			oldObject, oldOK := before[key].(map[string]any)
    56			editObject, editOK := value.(map[string]any)
    57			newObject, newOK := after[key].(map[string]any)
    58			if oldOK && editOK && newOK {
    59				preserveDoctorEdits(oldObject, editObject, newObject)
    60			} else if !reflect.DeepEqual(before[key], value) {
    61				after[key] = value
    62			}
    63		}
    64	}
