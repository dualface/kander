    99	func (s *Session) prepare(configValid bool) error {
   100		s.agents = findAgents(s.existing)
   101		labels := agentLabels()
   102		for name, state := range s.agents {
   103			if state.Path != "" && !agentUsable(state) {
   104				warning(config.Text(
   105					"menu.version_failed_unavailable_as_a_new_choice", labels[name], state.Path,
   106				))
   107			}
   108		}
   109		firstExecution := ""
   110		for _, name := range config.AgentNames(s.existing) {
   111			state := s.agents[name]
   112			if labels[name] == "" {
   113				labels[name] = name
   114			}
   115			label := labels[name] + config.Text("menu.not_currently_installed")
   116			if agentUsable(state) {
   117				if firstExecution == "" {
   118					firstExecution = name
   119				}
   120				label = labels[name] + " (" + state.Version + ")"
   121			}
   122			// Unavailable agents remain selectable so their executable can be configured.
   123			s.exec = append(s.exec, Choice{Value: name, Label: label})
   124		}
   125		if firstExecution == "" && !s.existing.WelcomeComplete {
   126			return errors.New(config.Text("menu.no_usable_agent_found_version_must_succeed_install_codex"))
   127		}
   128		for _, name := range config.ReviewAgents {
   129			if reviewerUsable(s.agents[name]) {
   130				s.review = append(s.review, Choice{Value: name, Label: labels[name] + " (" + reviewerState(s.agents[name]).Version + ")"})
   131			}
   132		}
   133		if len(s.review) == 0 && !s.existing.WelcomeComplete {
   134			return errors.New(config.Text(
   135				"menu.no_usable_reviewer_found_install_codex_claude_grok_or",
   136			))
   137		}
   138	
   139		cfg := config.DefaultConfig()
   140		cfg.Agents = config.CloneAgents(s.existing.Agents)
   141		cfg.Models = copyModels(s.existing.Models)
   142		cfg.KanbanAgent = s.existing.KanbanAgent
   143		cfg.AgentLanguage = s.existing.AgentLanguage
   144		cfg.KanbanAgents = map[string]string{}
   145		for k, v := range s.existing.KanbanAgents {
   146			cfg.KanbanAgents[k] = v
   147		}
   148		if !s.existing.WelcomeComplete {
   149			if !agentUsable(s.agents[cfg.KanbanAgent]) {
   150				cfg.KanbanAgent = firstExecution
   151			}
   152			for _, scale := range config.TaskScales {
   153				if !agentUsable(s.agents[cfg.KanbanAgents[scale]]) {
   154					cfg.KanbanAgents[scale] = cfg.KanbanAgent
   155				}
   156			}
   157		}
   158		cfg.Reviewers = map[string]string{}
   159		for _, role := range config.ReviewRoles {
   160			previous := s.existing.Reviewers[role]
   161			cfg.Reviewers[role] = previous
   162			if !s.existing.WelcomeComplete && !reviewerUsable(s.agents[previous]) {
   163				cfg.Reviewers[role] = s.review[0].Value
   164			}
   165		}
   166		cfg.Launcher = s.existing.Launcher
   167		s.normalizeLauncher(cfg)
   168		cfg.TUI = s.existing.TUI
   169		cfg.Rules = s.existing.Rules.Clone()
   170		cfg.ReviewStages = cloneReviewStages(s.existing.ReviewStages)
   171		if configValid {
