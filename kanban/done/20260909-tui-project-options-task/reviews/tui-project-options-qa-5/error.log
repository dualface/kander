   189	func (s *Session) normalizeLauncher(cfg *config.Config) {
   190		if s.existing.WelcomeComplete {
   191			return
   192		}
   193		switch {
   194		case isWindowsOS() && (cfg.Launcher == "tmux" || cfg.Launcher == "tmux-session"):
   195			cfg.Launcher = "console"
   196			warning(config.Text(
   197				"menu.windows_does_not_support_tmux_using_console",
   198			))
   199		case (cfg.Launcher == "tmux" || cfg.Launcher == "tmux-session") && lookPath("tmux") == "":
   200			cfg.Launcher = "foreground"
   201			warning(config.Text(
   202				"menu.tmux_is_not_installed_using_foreground_the_launcher_menu",
   203			))
   204		// On POSIX auto holds as long as tmux exists, so a missing herdr must not
   205		// rewrite it; on Windows auto can only land on herdr, so a missing herdr does.
   206		case (cfg.Launcher == "herdr" || (cfg.Launcher == "auto" && isWindowsOS())) && lookPath("herdr") == "":
   207			switch {
   208			case isWindowsOS():
   209				cfg.Launcher = "console"
   210			case lookPath("tmux") != "":
   211				cfg.Launcher = "tmux"
   212			default:
   213				cfg.Launcher = "foreground"
   214			}
   215			warning(config.Text(
   216				"menu.herdr_is_not_installed_using", cfg.Launcher,
   217			))
   218		}
   219	}
