   210	
   211	// spaceSaveReport splits the agent wiring results and the closing notes into readable paragraphs.
   212	func spaceSaveReport(lines []menu.ReportLine) []menu.ReportLine {
   213		out := make([]menu.ReportLine, 0, len(lines)+2)
   214		for index, line := range lines {
   215			if index > 0 && (line.Level == menu.LevelOK || line.Level == menu.LevelWarning ||
   216				(line.Level == menu.LevelNote && lines[index-1].Level != menu.LevelNote)) {
   217				out = append(out, menu.ReportLine{})
   218			}
   219			out = append(out, line)
   220		}
   221		return out
   222	}
   223	
   224	// build wraps and colors the lines at the given width and returns the actual line count.
   225	func (r *reportView) build(palette palette, width int) int {
   226		var body []string
   227		if r.extra != "" {
   228			for _, text := range wrapText(r.extra, width) {
   229				body = append(body, styleFor("popup-ok", palette).Render(text))
   230			}
   231			if len(r.lines) > 0 {
   232				body = append(body, "")
   233			}
   234		}
   235		for _, line := range r.lines {
   236			style := styleFor(reportTag(line.Level), palette)
   237			for _, raw := range strings.Split(line.Text, "\n") {
   238				for _, text := range wrapText(raw, width) {
   239					body = append(body, style.Render(text))
   240				}
   241			}
   242		}
   243		if len(body) == 0 {
   244			body = append(body, styleFor("popup-dim", palette).Render(t("tui.no_output")))
   245		}
   246		r.view.SetContent(strings.Join(body, "\n"))
   247		r.width = width
   248		return len(body)
   249	}
   250	
   251	func reportTag(level string) string {
   252		switch level {
   253		case menu.LevelWarning:
   254			return "popup-warn"
   255		case menu.LevelOK:
   256			return "popup-ok"
   257		case menu.LevelNote:
   258			return "popup-title"
   259		}
   260		return "popup"
   261	}
