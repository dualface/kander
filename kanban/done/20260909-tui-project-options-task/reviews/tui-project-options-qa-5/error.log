   161	// disableFilter turns off candidate filtering: the candidates are all short, and filtering would only swallow keys such as q.
   162	func disableFilter(keys *huh.KeyMap) {
   163		keys.Select.Filter = key.NewBinding(key.WithDisabled())
   164		keys.Select.SetFilter = key.NewBinding(key.WithDisabled())
   165		keys.Select.ClearFilter = key.NewBinding(key.WithDisabled())
   166	}
   167	
   168	// rootKeyMap is for the root menu. The root menu is a list of items: ↑↓ moves between them, Enter enters one.
   169	func rootKeyMap() *huh.KeyMap {
   170		keys := huh.NewDefaultKeyMap()
   171		keys.Quit = key.NewBinding(key.WithKeys("esc"), key.WithHelp("esc", t("tui.close")))
   172		disableFilter(keys)
   173		return keys
   174	}
   175	
   176	// sectionKeyMap is for a section form. A section is a settings list rather than a wizard:
   177	// ↑↓ moves between fields and ←→ edits in place, so there is no need to Enter all the way through.
   178	func sectionKeyMap() *huh.KeyMap {
   179		keys := huh.NewDefaultKeyMap()
   180		keys.Quit = key.NewBinding(key.WithKeys("esc"), key.WithHelp("esc", t("tui.back")))
   181		disableFilter(keys)
   182	
   183		// Enter always means "submit this section" instead of "jump to the next field"; fields are changed with ↑↓ or Tab.
   184		next := key.NewBinding(key.WithKeys("down", "tab"), key.WithHelp("↑↓", t("tui.move")))
   185		prev := key.NewBinding(key.WithKeys("up", "shift+tab"))
   186		submit := key.NewBinding(key.WithKeys("enter"), key.WithHelp("enter", t("tui.submit")))
   187		change := key.NewBinding(key.WithKeys("right", "l"), key.WithHelp("←→", t("tui.change")))
   188		changeBack := key.NewBinding(key.WithKeys("left", "h"))
   189	
   190		keys.Select.Next = next
   191		keys.Select.Prev = prev
   192		keys.Select.Submit = submit
   193		// ↑↓ is given to field navigation and values change with ←→; only an Inline Select enables Left/Right.
   194		keys.Select.Up = key.NewBinding(key.WithDisabled())
   195		keys.Select.Down = key.NewBinding(key.WithDisabled())
   196		keys.Select.Left = changeBack
   197		keys.Select.Right = change
   198	
   199		keys.Confirm.Next = next
   200		keys.Confirm.Prev = prev
   201		keys.Confirm.Submit = submit
   202		keys.Confirm.Toggle = key.NewBinding(key.WithKeys("left", "right", "h", "l"), key.WithHelp("←→", t("tui.toggle")))
   203	
   204		// Inside a text input ←→ still moves the cursor, and only the up/down keys are given to field navigation.
   205		keys.Input.Next = next
   206		keys.Input.Prev = prev
   207		keys.Input.Submit = submit
   208		return keys
   209	}
