   222	// openRoot builds the root menu: one Select listing the sections and their current values.
   223	// p.section is deliberately not reset: a Huh Select restores its selection from the bound value, which is what lets a return
   224	// from a child land on the item entered from. On the first open it is still empty and Huh falls to the first item.
   225	func (p *optionsPanel) openRoot() tea.Cmd {
   226		p.current = ""
   227		p.bind = nil
   228		options := []huh.Option[string]{
   229			huh.NewOption(p.rootLabel(t("tui.interface"), p.interfaceSummary()), sectionInterface),
   230		}
   231		if p.session != nil {
   232			cfg := p.session.Config
   233			options = append(options,
   234				huh.NewOption(p.rootLabel(t("tui.execution_and_models"), config.FormatKanbanAgentsSummary(cfg)+" · "+cfg.Launcher), sectionExecution),
   235				huh.NewOption(p.rootLabel(t("tui.review_and_models"), p.reviewSummary()), sectionReview),
   236				huh.NewOption(t("rules.modules"), sectionRules),
   237				huh.NewOption(t("flow.title"), sectionFlow),
   238			)
   239		}
   240		options = append(options,
   241			huh.NewOption(p.rootLabel(t("tui.environment_check"), ""), sectionDoctor),
   242			huh.NewOption(p.rootLabel(t("tui.save_and_apply"), p.dirtyLabel()), sectionSave),
   243			huh.NewOption(p.rootLabel(t("tui.close_2"), ""), sectionClose),
   244		)
   245		form := p.newForm(rootKeyMap(), huh.NewGroup(
   246			huh.NewSelect[string]().
   247				Description(t("tui.enter_to_open_esc_to_close")).
   248				Options(options...).
   249				Value(&p.section),
   250		))
   251		return p.startForm(form)
   252	}
