    69	// SyncTUI adopts UI preferences that changed outside this session.
    70	// persisted means the value already reached disk and the editing baseline must advance with it, otherwise saving would mistake it for another process's change.
    71	func (s *Session) SyncTUI(value config.TUI, persisted bool) {
    72		if s == nil {
    73			return
    74		}
    75		if s.scopeConfig != nil {
    76			s.scopeConfig.TUI = value
    77		}
    78		if !s.EditingOverlay() && s.Config != nil {
    79			s.Config.TUI = value
    80		}
    81		if persisted && s.existing != nil {
    82			s.existing.TUI = value
