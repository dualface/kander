    10	// ApplyDoctorConfig adopts the doctor repair result while keeping edits not yet saved in the panel.
    11	func (s *Session) ApplyDoctorConfig(before, after *config.Config, dirty bool) error {
    12		merged := after
    13		edited := s.scopeConfig
    14		if edited == nil {
    15			edited = s.Config
    16		}
    17		preserve := s.ScopeDirty || (dirty && !s.EditingOverlay())
    18		if preserve {
    19			if before == nil {
    20				before = config.DefaultConfig()
    21			}
    22			objects := make([]map[string]any, 3)
    23			for i, cfg := range []*config.Config{before, edited, after} {
    24				data, err := json.Marshal(cfg)
    25				if err != nil {
    26					return err
    27				}
    28				if err := json.Unmarshal(data, &objects[i]); err != nil {
    29					return err
    30				}
    31			}
    32			preserveDoctorEdits(objects[0], objects[1], objects[2])
    33			objects[2]["welcome_complete"] = after.WelcomeComplete
    34			data, err := json.Marshal(objects[2])
    35			if err != nil {
    36				return err
    37			}
    38			merged, err = config.ValidateJSON(data)
    39			if err != nil {
    40				return err
    41			}
    42		}
    43		s.existing = after
    44		s.scopeExisting = config.Clone(after)
    45		s.scopeConfig = merged
    46		if raw, err := config.DocumentFromConfig(merged); err == nil {
    47			s.scopeRaw = raw
    48		}
    49		if s.EditingOverlay() {
    50			return s.rebuildOverlayConfig()
    51		}
    52		s.Config = merged
    53		return nil
    54	}
    55	
    56	func preserveDoctorEdits(before, edited, after map[string]any) {
    57		for key, value := range edited {
    58			oldObject, oldOK := before[key].(map[string]any)
    59			editObject, editOK := value.(map[string]any)
    60			newObject, newOK := after[key].(map[string]any)
    61			if oldOK && editOK && newOK {
    62				preserveDoctorEdits(oldObject, editObject, newObject)
    63			} else if !reflect.DeepEqual(before[key], value) {
    64				after[key] = value
    65			}
    66		}
    67	}
