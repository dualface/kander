    84			if err != nil {
    85				return err
    86			}
    87			s.overlayRaw = raw
    88			s.overlayExisting = config.CloneOverlay(raw)
    89		}
    90		if err := s.ensureScopeRaw(); err != nil {
    91			return err
    92		}
    93		if paths.Mode == config.ModeProject {
    94			return s.SetTarget(config.TargetOverlay)
    95		}
    96		return nil
    97	}
    98	
    99	// AttachOverlay installs a test overlay location without probing the real cwd.
   100	func (s *Session) AttachOverlay(mode config.Mode, loc config.OverlayLocation, raw map[string]any) error {
   101		s.InstallMode = mode
   102		s.OverlayLocation = loc
   103		s.overlayRaw = config.CloneOverlay(raw)
   104		s.overlayExisting = config.CloneOverlay(raw)
   105		if err := s.ensureScopeRaw(); err != nil {
   106			return err
   107		}
   108		if mode == config.ModeProject {
   109			return s.SetTarget(config.TargetOverlay)
   110		}
   111		return nil
   112	}
   113	
   114	// SetTarget switches the edit buffer. Unsaved edits on the other tab are kept.
   115	func (s *Session) SetTarget(target string) error {
   116		if target == config.TargetOverlay {
   117			merged, err := s.previewOverlay()
   118			if err != nil {
   119				if !s.overlayDraft {
   120					return err
   121				}
   122				merged, err = s.previewOverlayDraft(s.overlayRaw)
   123				if err != nil {
   124					return err
   125				}
   126			} else {
   127				s.overlayDraft = false
   128			}
   129			if s.Target == config.TargetScope && s.Config != nil {
   130				s.scopeConfig = s.Config
   131			}
   132			s.Target = target
   133			s.Config = merged
   134			return nil
   135		}
   136		if s.scopeConfig == nil {
   137			s.scopeConfig = s.Config
   138		}
   139		s.Target = target
   140		s.Config = s.scopeConfig
   141		return nil
   142	}
   143	
   144	func (s *Session) previewOverlay() (*config.Config, error) {
   145		if err := s.ensureScopeRaw(); err != nil {
   146			return nil, err
   147		}
   148		return config.MergeOverlayOnRaw(s.scopeRaw, s.overlayRaw)
   149	}
   150	
   151	func (s *Session) ensureScopeRaw() error {
   152		if s.scopeRaw != nil {
   153			return nil
   154		}
   155		raw, err := config.LoadScopeDocument(true)
   156		if err == nil {
   157			s.scopeRaw = raw
   158			return nil
   159		}
   160		base := s.scopeBuffer()
   161		if base == nil {
   162			base = s.existing
   163		}
   164		encoded, encErr := config.DocumentFromConfig(base)
   165		if encErr != nil {
   166			return err
   167		}
   168		s.scopeRaw = encoded
   169		return nil
   170	}
   171	
   172	func (s *Session) rebuildOverlayConfig() error {
   173		merged, err := s.previewOverlay()
   174		if err != nil {
   175			return err
   176		}
   177		s.overlayDraft = false
   178		s.Config = merged
   179		return nil
   180	}
   181	
   182	func (s *Session) applyOverlayEdit(mutate func(map[string]any)) error {
   183		if err := s.ensureScopeRaw(); err != nil {
   184			return err
   185		}
   186		candidate := config.CloneOverlay(s.overlayRaw)
   187		mutate(candidate)
   188		merged, err := config.MergeOverlayOnRaw(s.scopeRaw, candidate)
   189		if err != nil {
   190			return err
   191		}
   192		s.overlayRaw = candidate
   193		s.OverlayDirty = true
   194		s.overlayDraft = false
   195		s.Config = merged
   196		return nil
   197	}
   198	
   199	func (s *Session) applyOverlaySet(path []string, value any) error {
   200		return s.applyOverlayEdit(func(candidate map[string]any) {
   201			if len(path) == 3 && path[0] == "review_stages" {
   202				expandReviewStagesOverlay(candidate)
   203			}
   204			config.OverlaySet(candidate, value, path...)
   205		})
   206	}
   207	
   208	func (s *Session) syncScopeRaw(path []string, value any) {
   209		if s.scopeRaw == nil || len(path) == 0 {
   210			return
   211		}
   212		if _, ok := s.scopeRaw[path[0]]; !ok {
   213			filled, err := config.DocumentFromConfig(s.Config)
   214			if err == nil {
   215				if section, exists := filled[path[0]]; exists {
   216					s.scopeRaw[path[0]] = section
   217					return
   218				}
   219			}
   220		}
   221		config.OverlaySet(s.scopeRaw, value, path...)
   222	}
   223	
   224	func (s *Session) noteOverride(path []string, value any) error {
   225		if !s.EditingOverlay() {
   226			s.ScopeDirty = true
   227			s.syncScopeRaw(path, value)
   228			return nil
   229		}
   230		err := s.applyOverlaySet(path, value)
   231		if err != nil {
   232			// Keep invalid edits visible and dirty. Save validates this same candidate
   233			// and reports the error instead of silently publishing the old overlay.
   234			config.OverlaySet(s.overlayRaw, value, path...)
   235			s.OverlayDirty = true
   236			s.overlayDraft = true
   237		}
   238		return err
   239	}
   240	
   241	// RestoreInherit deletes an overlay key and refreshes the effective view.
   242	func (s *Session) RestoreInherit(path ...string) error {
   243		if len(path) == 0 {
   244			return nil
   245		}
   246		if err := s.ensureScopeRaw(); err != nil {
   247			return err
   248		}
   249		candidate := config.CloneOverlay(s.overlayRaw)
   250		if len(path) == 3 && path[0] == "review_stages" {
   251			expandReviewStagesOverlay(candidate)
   252		}
   253		config.OverlayDelete(candidate, path...)
   254		merged, err := config.MergeOverlayOnRaw(s.scopeRaw, candidate)
   255		if err != nil {
   256			if !s.overlayDraft {
   257				return err
   258			}
   259			merged, err = s.previewOverlayDraft(candidate)
   260			if err != nil {
   261				return err
   262			}
   263			s.overlayDraft = true
   264		} else {
   265			s.overlayDraft = false
   266		}
   267		s.overlayRaw = candidate
   268		s.OverlayDirty = true
   269		if s.EditingOverlay() {
   270			s.Config = merged
   271		}
   272		return nil
   273	}
   274	
   275	// SetTUIField updates one TUI key so a Project-tab edit cannot copy the whole section.
   276	// An invalid overlay edit remains visible and dirty; the returned error also blocks Save.
   277	func (s *Session) SetTUIField(field string, value any) error {
   278		if s.Config == nil {
   279			return nil
   280		}
   281		switch field {
   282		case "theme":
   283			if text, ok := value.(string); ok {
   284				s.Config.TUI.Theme = text
   285			}
   286		case "columns":
   287			if n, ok := intValue(value); ok {
   288				s.Config.TUI.Columns = n
   289			}
   290		case "min_column_width":
   291			if n, ok := intValue(value); ok {
   292				s.Config.TUI.MinColumnWidth = n
   293			}
   294		case "refresh":
   295			if n, ok := intValue(value); ok {
   296				s.Config.TUI.Refresh = n
   297			}
   298		case "single":
   299			if flag, ok := value.(bool); ok {
   300				s.Config.TUI.Single = flag
   301			}
   302		}
   303		return s.noteOverride([]string{"tui", field}, value)
   304	}
   305	
   306	// NoteModelOverride records a model or executable field the user actually edited.
   307	func (s *Session) NoteModelOverride(field ModelField, value string) {
   308		if field.Agent == "" || field.field == "" {
   309			return
   310		}
   311		switch field.field {
   312		case "path", "process_name":
   313			if value == "" {
   314				if s.EditingOverlay() {
   315					_ = s.RestoreInherit("agents", field.Agent, field.field)
   316				} else {
   317					s.noteOverride([]string{"agents", field.Agent, field.field}, value)
   318				}
   319				return
   320			}
   321			s.noteOverride([]string{"agents", field.Agent, field.field}, value)
   322		case "model", "effort":
   323			s.noteOverride([]string{"models", "review_roles", field.Agent, field.field}, value)
   324		default:
   325			s.noteOverride([]string{"models", "kanban", field.Agent, field.field}, value)
   326		}
   327	}
   328	
   329	func (s *Session) expandOverlayReviewStages() {
   330		expandReviewStagesOverlay(s.overlayRaw)
   331	}
   332	
   333	func expandReviewStagesOverlay(overlay map[string]any) {
   334		if overlay == nil {
   335			return
   336		}
   337		stages, ok := overlay["review_stages"]
   338		if !ok {
   339			return
   340		}
   341		if obj, ok := stages.(map[string]any); ok {
   342			if _, hasLarge := obj["large"]; hasLarge {
   343				return
   344			}
   345			if _, hasSmall := obj["small"]; hasSmall {
   346				return
   347			}
   348		}
   349		normalized, err := config.NormalizeReviewStages(stages)
   350		if err != nil {
   351			return
   352		}
   353		overlay["review_stages"] = normalized
   354	}
   355	
   356	func (s *Session) scopeBuffer() *config.Config {
   357		if s != nil && s.scopeConfig != nil {
   358			return s.scopeConfig
   359		}
   360		return s.Config
   361	}
   362	
   363	func (s *Session) saveScope() (string, error) {
   364		cfg := s.scopeBuffer()
   365		if cfg == nil {
   366			return "", nil
   367		}
   368		cfg.WelcomeComplete = true
   369		baseline := s.scopeExisting
   370		if baseline == nil {
   371			baseline = s.existing
   372		}
   373		path, err := config.SaveIfUnchanged(cfg, baseline)
   374		if err == nil {
   375			s.existing = config.Clone(cfg)
   376			s.scopeExisting = config.Clone(cfg)
   377			s.scopeConfig = cfg
   378			if raw, rawErr := config.DocumentFromConfig(cfg); rawErr == nil {
   379				s.scopeRaw = raw
   380			}
   381			if s.EditingOverlay() {
   382				_ = s.rebuildOverlayConfig()
   383			} else {
   384				s.Config = cfg
   385			}
   386			s.ScopeDirty = false
   387		}
   388		return path, err
   389	}
   390	
   391	// SaveAllDirty writes every unpublished tab. Save still writes only the active tab
   392	// so a section submit on Project cannot copy merged values into the scope file.
   393	func (s *Session) SaveAllDirty() (string, error) {
   394		if s == nil {
   395			return "", nil
   396		}
   397		var last string
   398		if s.ScopeDirty {
   399			path, err := s.saveScope()
   400			if err != nil {
   401				return last, err
   402			}
   403			last = path
   404		}
   405		if s.OverlayDirty {
   406			path, err := s.saveOverlay()
   407			if err != nil {
   408				return last, err
   409			}
   410			last = path
   411		}
   412		if last != "" {
   413			return last, nil
   414		}
   415		return s.Save()
   416	}
   417	
   418	func (s *Session) saveOverlay() (string, error) {
   419		if s.OverlayLocation.Path == "" {
   420			return "", config.ErrMissingOverlayPath()
   421		}
   422		path, err := config.SaveOverlayIfUnchanged(s.OverlayLocation.Path, s.overlayRaw, s.overlayExisting)
   423		if err == nil {
   424			s.overlayExisting = config.CloneOverlay(s.overlayRaw)
   425			s.OverlayLocation.Exists = len(s.overlayRaw) > 0
   426			s.OverlayDirty = false
   427			s.overlayDraft = false
   428		}
   429		return path, err
   430	}
   431	
   432	func intValue(value any) (int, bool) {
   433		switch typed := value.(type) {
   434		case int:
   435			return typed, true
   436		default:
   437			return 0, false
   438		}
   439	}

