   174	// reportRulesIntegration reports whether every configured execution agent's rules file references
   175	// the Kander entry; in repair mode it writes the missing references instead of only warning.
   176	func reportRulesIntegration(cfg *config.Config, paths config.InstallPaths, repair bool) bool {
   177		healthy := true
   178		effective, err := config.Effective(cfg)
   179		if err != nil {
   180			return healthy
   181		}
   182		labels := agentLabels()
   183		entry := rulesEntry(paths)
   184		seen := map[string]struct{}{}
   185		for _, selected := range config.ExecutionAgentsInUse(effective) {
   186			target := install.AgentRulesTarget(selected, paths)
   187			if _, ok := seen[target]; ok && target != "" {
   188				continue
   189			}
   190			seen[target] = struct{}{}
   191			if repair {
   192				outcome, ensureErr := install.EnsureRulesIntegration(selected, paths)
   193				if ensureErr != nil {
   194					healthy = false
   195					warning(config.Text("menu.is_not_connected_to_kander_rules", labels[selected], ensureErr.Error()))
   196					hint(config.Text("menu.follow_the_readme_integration_section_and_point_the_rules", entry))
   197					continue
   198				}
   199				if outcome.Status == install.IntegrationPresent {
   200					success(config.Text("menu.is_connected_to_kander_rules", labels[selected], outcome.Target))
   201				} else {
   202					success(config.Text("menu.added_kander_rules_reference", labels[selected], outcome.Target))
   203				}
   204				continue
   205			}
   206			integrated, detail := rulesIntegration(selected, paths)
   207			if integrated {
   208				success(config.Text("menu.is_connected_to_kander_rules", labels[selected], detail))
   209				continue
   210			}
   211			healthy = false
   212			warning(config.Text("menu.is_not_connected_to_kander_rules", labels[selected], detail))
   213			hint(config.Text("menu.follow_the_readme_integration_section_and_point_the_rules", entry))
   214		}
   215		return healthy
   216	}
