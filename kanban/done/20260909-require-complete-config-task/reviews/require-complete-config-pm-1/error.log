   128			existing, err := config.LoadScope(false)
   129			if err != nil {
   130				return sessionResult{err: err}
   131			}
   132			session, sessionErr := menu.NewSession(existing, true)
   133			return sessionResult{session: session, err: sessionErr}
   134		}
   135	}
