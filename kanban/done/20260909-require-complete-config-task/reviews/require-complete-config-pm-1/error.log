   208	}
   209	
   210	// spaceSaveReport splits the agent wiring results and the closing notes into readable paragraphs.
   211	func spaceSaveReport(lines []menu.ReportLine) []menu.ReportLine {
   212		out := make([]menu.ReportLine, 0, len(lines)+2)
   213		for index, line := range lines {
   214			if index > 0 && (line.Level == menu.LevelOK || line.Level == menu.LevelWarning ||
   215				(line.Level == menu.LevelNote && lines[index-1].Level != menu.LevelNote)) {
   216				out = append(out, menu.ReportLine{})
   217			}
   218			out = append(out, line)
   219		}
   220		return out
   221	}
   222	
   223	// build wraps and colors the lines at the given width and returns the actual line count.
   224	func (r *reportView) build(palette palette, width int) int {
   225		var body []string
   226		if r.extra != "" {
   227			for _, text := range wrapText(r.extra, width) {
   228				body = append(body, styleFor("popup-ok", palette).Render(text))
   229			}
   230			if len(r.lines) > 0 {
   231				body = append(body, "")
   232			}
   233		}
   234		for _, line := range r.lines {
   235			style := styleFor(reportTag(line.Level), palette)
   236			for _, raw := range strings.Split(line.Text, "\n") {
   237				for _, text := range wrapText(raw, width) {
   238					body = append(body, style.Render(text))
   239				}
   240			}
   241		}
   242		if len(body) == 0 {
   243			body = append(body, styleFor("popup-dim", palette).Render(t("tui.no_output")))
   244		}
   245		r.view.SetContent(strings.Join(body, "\n"))
   246		r.width = width
   247		return len(body)
   248	}
   249	
   250	func reportTag(level string) string {
   251		switch level {
   252		case menu.LevelWarning:
   253			return "popup-warn"
   254		case menu.LevelOK:
   255			return "popup-ok"
   256		case menu.LevelNote:
   257			return "popup-title"
   258		}
   259		return "popup"
   260	}

