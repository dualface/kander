   137	type sessionResult struct {
   138		session *menu.Session
   139		err     error
   140	}
   141	
   142	type doctorResult struct {
   143		lines   []menu.ReportLine
   144		healthy bool
   145		before  *config.Config
   146		after   *config.Config
   147	}
   148	
   149	// applyWork consumes the result of a background task; the Bubble Tea shell calls it on a workMsg.
   150	func (a *App) applyWork(payload any) tea.Cmd {
   151		if result, ok := payload.(startPreviewResult); ok {
   152			a.applyStartPreview(result)
   153			return nil
   154		}
   155		if result, ok := payload.(startResult); ok {
   156			a.applyStartResult(result)
   157			return nil
   158		}
   159		if result, ok := payload.(focusResult); ok {
   160			a.focusRunning = false
   161			a.showFocusNotice(result.message)
   162			return nil
   163		}
   164		panel := a.Options
   165		if panel == nil {
   166			return nil
   167		}
   168		switch result := payload.(type) {
   169		case sessionResult:
   170			if result.err != nil {
   171				panel.loadErr = result.err.Error()
   172				return nil
   173			}
   174			a.Session = result.session
   175			panel.session = result.session
   176			if panel.initial != "" {
   177				section := panel.initial
   178				panel.initial = ""
   179				return panel.dispatch(section)
   180			}
   181			return panel.openRoot()
   182		case terminalToolsResult:
   183			return panel.beginDoctor(result.tools)
   184		case doctorResult:
   185			panel.status = ""
   186			if panel.session != nil && result.after != nil {
   187				if err := panel.session.ApplyDoctorConfig(result.before, result.after, panel.dirty); err != nil {
   188					result.lines = append(result.lines, menu.ReportLine{Level: menu.LevelWarning, Text: err.Error()})
   189				}
   190			}
   191			panel.showReport(t("tui.environment_check"), append(panel.doctorLines, result.lines...), "")
   192			panel.doctorLines = nil
   193		}
   194		return nil
   195	}
   196	
   197	func (p *optionsPanel) close() {
   198		p.app.Options = nil
   199	}
   200	
   201	func (p *optionsPanel) markDirty() {
   202		p.dirty = true
   203	}
   204	
   205	// showReport displays one report through a viewport, on top of the form.
   206	func (p *optionsPanel) showReport(title string, lines []menu.ReportLine, extra string) {
