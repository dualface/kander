   181	// reportRulesIntegration reports whether every configured execution agent's rules file references
   182	// the Kander entry; in repair mode it writes the missing references instead of only warning.
   183	func reportRulesIntegration(cfg *config.Config, paths config.InstallPaths, repair bool) bool {
   184		healthy := true
   185		effective, err := config.Effective(cfg)
   186		if err != nil {
   187			return healthy
   188		}
   189		labels := agentLabels()
   190		entry := rulesEntry(paths)
   191		seen := map[string]struct{}{}
   192		for _, selected := range config.ExecutionAgentsInUse(effective) {
   193			target := install.AgentRulesTarget(selected, paths)
   194			if _, ok := seen[target]; ok && target != "" {
   195				continue
   196			}
   197			seen[target] = struct{}{}
   198			if repair {
   199				outcome, ensureErr := install.EnsureRulesIntegration(selected, paths)
   200				if ensureErr != nil {
   201					healthy = false
   202					warning(config.Text("menu.is_not_connected_to_kander_rules", labels[selected], ensureErr.Error()))
   203					hint(config.Text("menu.follow_the_readme_integration_section_and_point_the_rules", entry))
   204					continue
   205				}
   206				if outcome.Status == install.IntegrationPresent {
   207					success(config.Text("menu.is_connected_to_kander_rules", labels[selected], outcome.Target))
   208				} else {
   209					success(config.Text("menu.added_kander_rules_reference", labels[selected], outcome.Target))
   210				}
   211				continue
   212			}
   213			integrated, detail := rulesIntegration(selected, paths)
   214			if integrated {
   215				success(config.Text("menu.is_connected_to_kander_rules", labels[selected], detail))
   216				continue
   217			}
   218			healthy = false
   219			warning(config.Text("menu.is_not_connected_to_kander_rules", labels[selected], detail))
   220			hint(config.Text("menu.follow_the_readme_integration_section_and_point_the_rules", entry))
   221		}
   222		return healthy
   223	}
