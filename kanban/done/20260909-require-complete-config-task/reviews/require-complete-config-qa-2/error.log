    40	func repairConfiguredTools(cfg *config.Config, agents map[string]agentState, tools TerminalTools) []string {
    41		var changes []string
    42		choose := func(names []string, review bool) string {
    43			for _, name := range names {
    44				if !review && agentUsable(agents[name]) || review && reviewerUsable(agents[name]) {
    45					return name
    46				}
    47			}
    48			return ""
    49		}
    50		set := func(field string, old *string, replacement string) {
    51			if replacement == "" || *old == replacement {
    52				return
    53			}
    54			changes = append(changes, field+": "+*old+" -> "+replacement)
    55			*old = replacement
    56		}
    57		execution := choose(config.AgentNames(cfg), false)
    58		if !agentUsable(agents[cfg.KanbanAgent]) {
    59			set("kanban_agent", &cfg.KanbanAgent, execution)
    60		}
    61		for _, scale := range config.TaskScales {
    62			selected := cfg.KanbanAgents[scale]
    63			if !agentUsable(agents[selected]) && execution != "" {
    64				set("kanban_agents."+scale, &selected, cfg.KanbanAgent)
    65				cfg.KanbanAgents[scale] = selected
    66			}
    67		}
    68		reviewer := choose(config.ReviewAgents, true)
    69		for _, role := range config.ReviewRoles {
    70			selected := cfg.Reviewers[role]
    71			if !reviewerUsable(agents[selected]) && reviewer != "" {
    72				set("reviewers."+role, &selected, reviewer)
    73				cfg.Reviewers[role] = selected
    74				// Models are bound to the reviewer; picking a new one adopts that reviewer's model settings.
    75				entry := cfg.Models.Review[selected]
    76				cfg.Models.ReviewRoles[role] = map[string]string{"model": entry["model"], "effort": entry["effort"]}
    77			}
    78		}
    79		if !doctorLauncherAvailable(cfg.Launcher, tools) {
    80			replacement := "foreground"
    81			switch {
    82			case isWindowsOS():
    83				replacement = "console"
    84			case tools.Herdr.Available():
    85				replacement = "herdr"
    86			case tools.Tmux.Available():
    87				replacement = "tmux-session"
    88			}
    89			set("launcher", &cfg.Launcher, replacement)
    90		}
    91		// Once an execution agent and a reviewer exist, the repaired choices should immediately become the effective config.
    92		if execution != "" && reviewer != "" {
    93			cfg.WelcomeComplete = true
    94		}
    95		return changes
    96	}
