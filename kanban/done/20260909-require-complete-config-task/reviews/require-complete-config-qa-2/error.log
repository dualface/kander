   138		agents := map[string]agentState{}
   139		reviewSet := map[string]struct{}{}
   140		for _, name := range config.ReviewAgents {
   141			reviewSet[name] = struct{}{}
   142		}
   143		for _, name := range config.AgentNames(cfg) {
   144			executable := config.AgentPath(cfg, name)
   145			program := process.ResolveAgentProgram(executable)
   146			state := agentState{
