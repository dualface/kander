    98	// doctorLauncherAvailable only serves the "should we rewrite the user's
    99	// launcher" decision, which is why it asks herdr for Installed() rather than
   100	// Available(): when herdr is installed but not on PATH yet, telling the user to
   101	// reopen the terminal beats silently switching the config to console. It does
   102	// not mean the launcher can start right now — prepareLaunch still requires
   103	// herdr to actually be on PATH.
   104	func doctorLauncherAvailable(launcher string, tools TerminalTools) bool {
   105		if launcher == "foreground" {
   106			return true
   107		}
   108		if isWindowsOS() && (launcher == "tmux" || launcher == "tmux-session") {
   109			return false
   110		}
   111		if launcher == "console" {
   112			return isWindowsOS()
   113		}
   114		switch launcher {
   115		case "auto":
   116			return tools.Herdr.Installed() || tools.Tmux.Available()
   117		case "herdr":
   118			return tools.Herdr.Installed()
   119		case "tmux", "tmux-session":
   120			return tools.Tmux.Available()
   121		}
   122		return false
   123	}
