     8	func repairDoctorConfig(agents map[string]agentState, tools TerminalTools) (*config.Config, bool) {
     9		var changes []string
    10		language := "en"
    11		// Config result messages only use the language of the on-disk config, unaffected by the UI or process language override.
    12		text := func(id string, args ...any) string {
    13			return i18n.Text(language, id, args...)
    14		}
    15	
    16		cfg, result, err := config.Repair(func(cfg *config.Config) {
    17			language = cfg.Language
    18			changes = repairConfiguredTools(cfg, agents, tools)
    19		})
    20		if result.BackupPath != "" {
    21			hint(text("menu.original_config_backed_up") + result.BackupPath)
    22		}
    23		if err != nil {
    24			warning(text("menu.config_repair_failed") + err.Error())
    25			return nil, false
    26		}
    27		if result.Created {
    28			success(text("menu.created_and_saved_config_json") + result.Path)
    29		} else if result.Changed {
    30			success(text("menu.updated_and_saved_config_json") + result.Path)
    31		} else {
    32			success(text("menu.config_json_is_unchanged") + result.Path)
    33		}
    34		for _, change := range changes {
    35			hint(change)
    36		}
    37		return cfg, true
    38	}
