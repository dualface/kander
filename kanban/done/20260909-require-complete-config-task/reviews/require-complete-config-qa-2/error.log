   214	// spaceSaveReport splits the agent wiring results and the closing notes into readable paragraphs.
   215	func spaceSaveReport(lines []menu.ReportLine) []menu.ReportLine {
   216		out := make([]menu.ReportLine, 0, len(lines)+2)
   217		for index, line := range lines {
   218			if index > 0 && (line.Level == menu.LevelOK || line.Level == menu.LevelWarning ||
   219				(line.Level == menu.LevelNote && lines[index-1].Level != menu.LevelNote)) {
   220				out = append(out, menu.ReportLine{})
   221			}
   222			out = append(out, line)
   223		}
   224		return out
   225	}
