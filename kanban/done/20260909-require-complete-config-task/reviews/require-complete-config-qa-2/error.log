   130	func (h *harness) fakeCommand(name, body string) {
   131		h.t.Helper()
   132		if body == "" {
   133			body = "#!/bin/sh\nprintf '%s\\n' '" + name + " test-version'\n"
   134		}
   135		path := filepath.Join(h.fakeBin, name)
   136		if err := os.WriteFile(path, []byte(body), 0o755); err != nil {
   137			h.t.Fatal(err)
   138		}
   139	}
