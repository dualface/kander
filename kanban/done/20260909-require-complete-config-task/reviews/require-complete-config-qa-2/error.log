    83	
    84	func newHarness(t *testing.T) *harness {
    85		t.Helper()
    86		root := t.TempDir()
    87		home := filepath.Join(root, "home")
    88		if err := os.MkdirAll(home, 0o755); err != nil {
    89			t.Fatal(err)
    90		}
    91		fakeBin := filepath.Join(root, "bin")
    92		if err := os.MkdirAll(fakeBin, 0o755); err != nil {
    93			t.Fatal(err)
    94		}
    95		if err := copyFile(testKander, filepath.Join(fakeBin, "kander"), 0o755); err != nil {
    96			t.Fatal(err)
    97		}
    98		// In-process probes (the herdr default install directory and friends) also
    99		// read HOME/USERPROFILE/LOCALAPPDATA, so isolate those to the temp dir too
   100		// instead of letting them reach the developer's real home.
   101		t.Setenv("HOME", home)
   102		t.Setenv("USERPROFILE", home)
   103		t.Setenv("LOCALAPPDATA", filepath.Join(home, "AppData", "Local"))
   104		cfg := filepath.Join(home, ".config", "kander", "config.json")
   105		h := &harness{
   106			t: t, root: root, home: home, configPath: cfg, fakeBin: fakeBin,
   107			env: envWith(home, cfg, fakeBin),
   108		}
   109		return h
   110	}
   111	
   112	func copyFile(src, dest string, mode os.FileMode) error {
   113		in, err := os.Open(src)
   114		if err != nil {
   115			return err
   116		}
   117		defer in.Close()
   118		if err := os.MkdirAll(filepath.Dir(dest), 0o755); err != nil {
   119			return err
   120		}
   121		out, err := os.OpenFile(dest, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, mode)
   122		if err != nil {
   123			return err
   124		}
   125		defer out.Close()
   126		_, err = io.Copy(out, in)
   127		return err
   128	}
