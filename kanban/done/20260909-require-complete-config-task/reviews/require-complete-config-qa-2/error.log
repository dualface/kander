    49	func envWith(home, configPath, path string) []string {
    50		env := os.Environ()
    51		blocked := map[string]struct{}{
    52			"KANDER_LANG": {}, "KANDER_LANG_CLI": {}, "KANDER_CONFIG": {},
    53			"HOME": {}, "PATH": {}, "NO_COLOR": {}, "LC_ALL": {}, "LC_MESSAGES": {}, "LANG": {},
    54			"HERDR_ENV": {}, "HERDR_WORKSPACE_ID": {}, "HERDR_TAB_ID": {}, "HERDR_PANE_ID": {},
    55			"TMUX": {}, "GIT_DIR": {}, "GIT_WORK_TREE": {}, "GIT_COMMON_DIR": {},
    56		}
    57		out := make([]string, 0, len(env)+8)
    58		for _, item := range env {
    59			name, _, _ := strings.Cut(item, "=")
    60			if _, ok := blocked[name]; ok {
    61				continue
    62			}
    63			out = append(out, item)
    64		}
    65		out = append(out,
    66			"HOME="+home,
    67			"USERPROFILE="+home,
    68			"KANDER_CONFIG="+configPath,
    69			"KANDER_LANG=cn",
    70			"PATH="+path,
    71		)
    72		return out
    73	}
