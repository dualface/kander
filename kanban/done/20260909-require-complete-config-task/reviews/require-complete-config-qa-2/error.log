    16		if runtime.GOOS == "windows" {
    17			abs, err := lexicalAbsolute(path)
    18			if err != nil {
    19				return nil, err
    20			}
    21			anchor, err := volumeAnchor(abs)
    22			if err != nil {
    23				return nil, err
    24			}
    25			file, err := fs.OpenRegularFileIfExists(anchor, abs)
    26			if err != nil {
    27				return nil, err
    28			}
    29			if file == nil {
    30				return nil, nil
    31			}
    32			defer file.Close()
    33			data, err := io.ReadAll(file)
    34			if err != nil {
    35				return nil, err
    36			}
    37			return data, nil
    38		}
    39		info, err := os.Stat(path)
    40		if err != nil {
    41			if os.IsNotExist(err) {
    42				return nil, nil
