   227	// build wraps and colors the lines at the given width and returns the actual line count.
   228	func (r *reportView) build(palette palette, width int) int {
   229		var body []string
   230		if r.extra != "" {
   231			for _, text := range wrapText(r.extra, width) {
   232				body = append(body, styleFor("popup-ok", palette).Render(text))
   233			}
   234			if len(r.lines) > 0 {
   235				body = append(body, "")
   236			}
   237		}
   238		for _, line := range r.lines {
   239			style := styleFor(reportTag(line.Level), palette)
   240			for _, raw := range strings.Split(line.Text, "\n") {
   241				for _, text := range wrapText(raw, width) {
   242					body = append(body, style.Render(text))
   243				}
   244			}
   245		}
   246		if len(body) == 0 {
   247			body = append(body, styleFor("popup-dim", palette).Render(t("tui.no_output")))
   248		}
   249		r.view.SetContent(strings.Join(body, "\n"))
   250		r.width = width
   251		return len(body)
   252	}
