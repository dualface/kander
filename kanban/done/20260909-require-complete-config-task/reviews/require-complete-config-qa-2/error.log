    17	func initGitDir(t *testing.T, dir string) {
    18		t.Helper()
    19		if err := os.MkdirAll(dir, 0o755); err != nil {
    20			t.Fatal(err)
    21		}
    22		cmd := exec.Command("git", "init", "-q", dir)
    23		cmd.Dir = dir
    24		if out, err := cmd.CombinedOutput(); err != nil {
    25			t.Fatalf("git init: %v\n%s", err, out)
    26		}
    27		for _, args := range [][]string{
    28			{"-C", dir, "config", "user.email", "kander@example.com"},
    29			{"-C", dir, "config", "user.name", "Kander Test"},
    30			{"-C", dir, "commit", "--allow-empty", "-q", "-m", "init"},
    31		} {
    32			cmd := exec.Command("git", args...)
    33			cmd.Dir = dir
    34			if out, err := cmd.CombinedOutput(); err != nil {
    35				t.Fatalf("git %s: %v\n%s", strings.Join(args, " "), err, out)
    36			}
    37		}
    38	}
