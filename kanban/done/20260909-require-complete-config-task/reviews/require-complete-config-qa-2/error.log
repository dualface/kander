   153	// applyWork consumes the result of a background task; the Bubble Tea shell calls it on a workMsg.
   154	func (a *App) applyWork(payload any) tea.Cmd {
   155		if result, ok := payload.(startPreviewResult); ok {
   156			a.applyStartPreview(result)
   157			return nil
   158		}
   159		if result, ok := payload.(startResult); ok {
   160			a.applyStartResult(result)
   161			return nil
   162		}
   163		if result, ok := payload.(focusResult); ok {
   164			a.focusRunning = false
   165			a.showFocusNotice(result.message)
   166			return nil
   167		}
   168		panel := a.Options
   169		if panel == nil {
   170			return nil
   171		}
   172		switch result := payload.(type) {
   173		case sessionResult:
   174			if result.err != nil {
   175				panel.loadErr = result.err.Error()
   176				return nil
   177			}
   178			a.Session = result.session
   179			panel.session = result.session
   180			if panel.initial != "" {
   181				section := panel.initial
   182				panel.initial = ""
   183				return panel.dispatch(section)
   184			}
   185			return panel.openRoot()
   186		case terminalToolsResult:
   187			return panel.beginDoctor(result.tools)
   188		case doctorResult:
   189			panel.status = ""
   190			if panel.session != nil && result.after != nil {
   191				if err := panel.session.ApplyDoctorConfig(result.before, result.after, panel.dirty); err != nil {
   192					result.lines = append(result.lines, menu.ReportLine{Level: menu.LevelWarning, Text: err.Error()})
   193				}
   194			}
   195			panel.showReport(t("tui.environment_check"), append(panel.doctorLines, result.lines...), "")
   196			panel.doctorLines = nil
   197		}
   198		return nil
   199	}
