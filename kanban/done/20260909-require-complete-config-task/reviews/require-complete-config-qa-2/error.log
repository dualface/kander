    49	func contentHeight(view string) int {
    50		n := len(trimTrailingBlank(strings.Split(view, "\n")))
    51		if n < 1 {
    52			return 1
    53		}
    54		return n
    55	}
    56	
    57	func optionsHeader(left string, width int) string {
    58		right := clipText(version.String(), width)
    59		rightWidth := displayWidth(right)
    60		if rightWidth >= width {
    61			return padLine(right, width)
    62		}
    63		left = clipText(left, width-rightWidth-1)
    64		gap := width - displayWidth(left) - rightWidth
    65		return left + strings.Repeat(" ", gap) + right
    66	}
