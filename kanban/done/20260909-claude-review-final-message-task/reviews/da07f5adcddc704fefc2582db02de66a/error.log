   212	func copySpecSnapshot(src, runtime, dest string) error {
   213		data, err := os.ReadFile(src)
   214		if err != nil {
   215			return err
   216		}
   217		if err := fs.WriteTextAtomic(runtime, dest, string(data), false); err != nil {
   218			return err
   219		}
   220		return fs.MakeRegularFileReadOnly(runtime, dest)
   221	}
