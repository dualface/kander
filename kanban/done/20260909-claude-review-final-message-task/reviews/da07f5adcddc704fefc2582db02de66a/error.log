    43	func gitStatus(root string) (bool, string) {
    44		stdout, _, code, err := gitCommand([]string{
    45			"-c", "core.fsmonitor=false",
    46			"status",
    47			"--porcelain=v1",
    48			"--untracked-files=all",
    49			"--ignore-submodules=none",
    50		}, root, "")
    51		if err != nil {
    52			return false, ""
    53		}
    54		return code == 0, strings.TrimRight(stdout, "\r\n")
    55	}
