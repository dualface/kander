    57	func pathsOverlap(first, second string) bool {
    58		left, err1 := filepath.EvalSymlinks(first)
    59		right, err2 := filepath.EvalSymlinks(second)
    60		if err1 != nil {
    61			left = first
    62		}
    63		if err2 != nil {
    64			right = second
    65		}
    66		left = filepath.Clean(left)
    67		right = filepath.Clean(right)
    68		if runtimeEqualFold() {
    69			left = strings.ToLower(left)
    70			right = strings.ToLower(right)
    71		}
    72		rel, err := filepath.Rel(left, right)
    73		if err == nil && (rel == "." || !strings.HasPrefix(rel, "..")) {
    74			return true
    75		}
    76		rel, err = filepath.Rel(right, left)
    77		if err == nil && (rel == "." || !strings.HasPrefix(rel, "..")) {
    78			return true
    79		}
    80		return false
    81	}
    82	
    83	func runtimeEqualFold() bool {
    84		return os.PathSeparator == '\\'
    85	}
