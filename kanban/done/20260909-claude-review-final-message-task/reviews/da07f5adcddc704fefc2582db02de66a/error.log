   180	func buildPrompt(ctx reviewContext, evidenceFile, taskContext string) string {
   181		scopeRules := "Review the complete code state against the task context, not merely the " + ctx.base + ".." + ctx.commit + " diff, but\n" +
   182			"report only issues introduced, worsened, or concealed by that range. Use unchanged surrounding code\n" +
   183			"only to establish context and impact; omit unrelated pre-existing issues. Use the range metadata and\n" +
