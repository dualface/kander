   184			out, openErr := fs.OpenWritableRegularFile(outputRoot, outputFile)
   185			if openErr != nil {
   186				fail(openErr)
   187				return exitCode
   188			}
   189			defer out.Close()
   190			reviewerStdout = out
   191		}
   192	
   193		if ctx.archive != nil {
   194			if err = ctx.archive.snapshotRuntime(runtime); err != nil {
   195				fail(err)
   196				return exitCode
   197			}
   198			if err = ctx.archive.phase("launching", "unknown"); err != nil {
   199				fail(err)
   200				return exitCode
   201			}
   202		}
   203		lp, err = launchProcess(inv, processCWD, promptStream, reviewerStdout, errorStream)
   204		if err != nil {
   205			if ctx.archive != nil {
   206				ctx.archive.run.LaunchStatus = "not_started"
   207			}
   208			fail(newGate(127,
   209				"review.could_not_start_cli", ctx.settings.name, err.Error(),
   210			))
   211			return exitCode
   212		}
   213		reviewStarted = true
   214		if ctx.archive != nil {
   215			if err = ctx.archive.phase("running", "started"); err != nil {
   216				fail(err)
   217				return exitCode
   218			}
   219		}
   220		exitCode, timedOut = monitorProcess(ctx, outputRoot, lp, errorFile, abort)
   221		treeAttempted = true
   222		lingering, stopErr := stopProcessTree(lp)
   223		if stopErr != nil {
   224			fail(stopErr)
   225			return exitCode
   226		}
