    44	func executeInRuntime(ctx reviewContext, runtime string, abort <-chan os.Signal) (exitCode int) {
    45		outputRoot := runtime
    46		outputName := ctx.settings.outputName
    47		if ctx.archive != nil {
    48			outputRoot = ctx.archive.staging
    49			outputName = "output.raw"
    50		}
    51		outputFile := filepath.Join(outputRoot, outputName)
    52		stdoutFile := filepath.Join(outputRoot, "stdout.log")
    53		errorFile := filepath.Join(outputRoot, "error.log")
    54		evidenceFile := filepath.Join(runtime, "evidence.txt")
    55		promptFile := filepath.Join(runtime, "prompt.txt")
    56		stdinFile := filepath.Join(runtime, "stdin.txt")
    57	
    58		var lp *launchedProcess
    59		reviewStarted := false
    60		treeAttempted := false
    61		treeCollected := false
    62		var failure *gateError
    63		timedOut := false
    64		outputPrinted := false
    65	
    66		fail := func(err error) {
    67			var ge *gateError
    68			if errors.As(err, &ge) {
    69				failure = ge
    70				exitCode = ge.code
    71				return
    72			}
    73			failure = newGate(2, "review.review_runtime_i_o_failed", runtime, err.Error())
    74			exitCode = 2
    75		}
    76	
    77		defer func() {
    78			if lp != nil && !treeAttempted {
    79				treeAttempted = true
    80				if _, err := stopProcessTree(lp); err != nil {
    81					var ge *gateError
    82					if errors.As(err, &ge) {
    83						failure = ge
    84						exitCode = ge.code
    85					}
    86				} else {
    87					treeCollected = true
    88				}
    89			}
    90			if failure != nil && failure.message != "" {
    91				if ctx.archive != nil {
    92					ctx.archive.reason = failure.message
    93				}
    94				userError(failure.message)
    95			}
    96			if reviewStarted && !treeCollected {
    97				if ctx.archive != nil {
    98					ctx.archive.reason = config.Text("review.archive_tree_incomplete")
    99				}
   100				exitCode = 2
   101			} else if reviewStarted && !targetIsUnchanged(ctx) {
   102				if ctx.archive != nil {
   103					ctx.archive.reason = config.Text("review.review_modified_the_target_worktree", ctx.settings.name, ctx.root)
   104				}
   105				userError(config.Text(
   106					"review.review_modified_the_target_worktree", ctx.settings.name, ctx.root,
   107				))
   108				exitCode = 2
   109			}
   110			if ctx.archive != nil && exitCode != 0 && !outputPrinted {
   111				printFile(outputRoot, outputFile, os.Stdout)
   112			}
   113		}()
   114	
   115		taskContext := ctx.taskContext
   116		if (ctx.archive != nil || ctx.agent == "claude" || ctx.agent == "cursor") && ctx.taskSpec != "" {
   117			snapshot := filepath.Join(runtime, "task-spec.md")
   118			var snapshotErr error
   119			if ctx.archive != nil {
   120				snapshotErr = fs.WriteTextAtomic(runtime, snapshot, string(ctx.archive.taskSnapshot), false)
   121				if snapshotErr == nil {
   122					snapshotErr = fs.MakeRegularFileReadOnly(runtime, snapshot)
   123				}
   124			} else {
   125				snapshotErr = copySpecSnapshot(ctx.taskSpec, runtime, snapshot)
   126			}
   127			if snapshotErr != nil {
   128				fail(newGate(2,
   129					"review.could_not_snapshot_spec_file_for", ctx.settings.name, ctx.taskSpec,
   130				))
   131				return exitCode
   132			}
   133			taskContext = "Authoritative spec file: " + snapshot + ". Read it completely before reviewing."
   134		}
