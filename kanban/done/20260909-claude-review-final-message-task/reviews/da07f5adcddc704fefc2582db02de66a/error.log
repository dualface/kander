    87	func writeEvidence(ctx reviewContext, runtime, path string) error {
    88		commands := []struct {
    89			heading string
    90			args    []string
    91		}{
    92			{"\n=== COMMITS ===\n", []string{"log", "--no-ext-diff", "--no-textconv", "--format=fuller", "--no-patch", ctx.base + ".." + ctx.commit}},
    93			{"\n=== FILE LEDGER ===\n", []string{"diff", "--no-ext-diff", "--no-textconv", "--find-renames", "--name-status", ctx.base + ".." + ctx.commit}},
    94			{"\n=== PATCH ===\n", []string{"diff", "--no-ext-diff", "--no-textconv", "--find-renames", "--patch", ctx.base + ".." + ctx.commit}},
    95			{"\n=== COMMIT TREE ===\n", []string{"ls-tree", "-r", ctx.commit}},
    96		}
    97		if ctx.reviewed != "" {
    98			fixRange := ctx.reviewed + ".." + ctx.commit
    99			commands = append(commands,
   100				struct {
   101					heading string
   102					args    []string
   103				}{"\n=== FIX RANGE COMMITS ===\n", []string{"log", "--no-ext-diff", "--no-textconv", "--format=fuller", "--no-patch", fixRange}},
   104				struct {
   105					heading string
   106					args    []string
   107				}{"\n=== FIX RANGE FILE LEDGER ===\n", []string{"diff", "--no-ext-diff", "--no-textconv", "--find-renames", "--name-status", fixRange}},
   108				struct {
   109					heading string
   110					args    []string
   111				}{"\n=== FIX RANGE PATCH ===\n", []string{"diff", "--no-ext-diff", "--no-textconv", "--find-renames", "--patch", fixRange}},
   112			)
   113		}
   114		var b strings.Builder
   115		b.WriteString("Review range: " + ctx.base + ".." + ctx.commit + "\n")
   116		if ctx.reviewed != "" {
   117			b.WriteString("Incremental re-review; fix range: " + ctx.reviewed + ".." + ctx.commit + "\n")
   118		}
   119		for _, command := range commands {
   120			stdout, stderr, code, err := gitCommand(command.args, ctx.root, "")
