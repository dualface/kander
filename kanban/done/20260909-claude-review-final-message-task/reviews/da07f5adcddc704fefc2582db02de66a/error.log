   137	func targetIsUnchanged(ctx reviewContext) bool {
   138		stdout, _, code, err := gitCommand([]string{"rev-parse", "HEAD"}, ctx.root, "")
   139		if err != nil || code != 0 || strings.TrimSpace(stdout) != ctx.commit {
   140			return false
   141		}
   142		ok, status := gitStatus(ctx.root)
