   136			fail(err)
   137			return exitCode
   138		}
   139		if err := process.WriteTaskFile(runtime, promptFile, buildPrompt(ctx, evidenceFile, taskContext)); err != nil {
   140			fail(err)
   141			return exitCode
   142		}
   143		instruction := process.TaskFileInstruction("Perform the "+ctx.role+" review.", promptFile) + "\n"
   144		if err := fs.WriteTextAtomic(runtime, stdinFile, instruction, false); err != nil {
   145			fail(err)
   146			return exitCode
   147		}
   148		for _, path := range []string{outputFile, stdoutFile, errorFile} {
   149			if ctx.archive != nil {
   150				continue
   151			}
   152			if err := fs.WriteTextAtomic(outputRoot, path, "", false); err != nil {
   153				fail(err)
   154				return exitCode
   155			}
   156		}
   157		inv, processCWD, err := reviewerArguments(ctx, runtime, outputFile, promptFile)
   158		if err != nil {
   159			fail(err)
   160			return exitCode
   161		}
   162	
   163		promptStream, err := fs.OpenRegularFileIfExists(runtime, stdinFile)
   164		if err != nil {
   165			fail(err)
   166			return exitCode
   167		}
   168		defer promptStream.Close()
   169		stdoutStream, err := fs.OpenWritableRegularFile(outputRoot, stdoutFile)
   170		if err != nil {
   171			fail(err)
   172			return exitCode
   173		}
   174		defer stdoutStream.Close()
   175		errorStream, err := fs.OpenWritableRegularFile(outputRoot, errorFile)
   176		if err != nil {
   177			fail(err)
   178			return exitCode
   179		}
   180		defer errorStream.Close()
