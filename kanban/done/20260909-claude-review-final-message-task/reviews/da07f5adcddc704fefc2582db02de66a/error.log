   146	func incrementalScopeRules(ctx reviewContext) string {
   147		return "This is an incremental re-review by the same role on the same review base. Your role already\n" +
   148			"reviewed commit " + ctx.reviewed + "; the fix range " + ctx.reviewed + ".." + ctx.commit + " is the\n" +
   149			"only new material, and the caller's review context lists every finding from your previous round\n" +
   150			"with its disposition. Do two things and nothing more:\n" +
   151			"1. For every listed prior finding, verify at " + ctx.commit + " whether it is closed, still open, or\n" +
   152			"   only partially fixed, and report that per finding ID with exact evidence. A disputed finding\n" +
   153			"   is re-examined only against the caller's stated evidence; do not restate it without new facts.\n" +
   154			"2. Report a new gate finding only when the fix range introduces, worsens, or conceals it, or when a\n" +
   155			"   prior fix breaks a requirement it touched. Treat code unchanged since " + ctx.reviewed + " as\n" +
   156			"   already accepted by your role: do not re-audit it, do not raise findings on it, and do not widen\n" +
   157			"   the review into unchanged areas. Use unchanged code only to judge the impact of the fix range.\n" +
   158			"   A finding on code outside the fix range that is not blocking goes to NON-BLOCKING with the tag\n" +
   159			"   [outside-fix-range]; only a blocking defect introduced by the fix may enter the gate findings.\n" +
   160			"The FIX RANGE sections of the evidence file are your navigation; the full " + ctx.base + ".." + ctx.commit + "\n" +
   161			"range is context only.\n"
   162	}
