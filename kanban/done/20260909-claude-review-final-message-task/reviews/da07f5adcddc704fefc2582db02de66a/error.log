   168		raw, err := fs.ReadRegularFile(runtime, outputFile)
   169		var result any
   170		if err == nil && (ctx.archive == nil || utf8.Valid(raw)) {
   171			if decodeErr := json.Unmarshal(raw, &result); decodeErr != nil {
   172				result = nil
   173			}
   174		}
   175		var text string
   176		var valid bool
   177		var message string
   178		if ctx.agent == "grok" {
   179			obj, ok := result.(map[string]any)
   180			if ok {
   181				text, _ = obj["text"].(string)
   182				valid = obj["stopReason"] == "end_turn" && text != ""
   183			}
   184			message = config.Text("review.grok_review_did_not_complete_with_review_text")
   185		} else if ctx.agent == "claude" || ctx.agent == "cursor" {
   186			obj, ok := result.(map[string]any)
   187			if ok {
   188				text, _ = obj["result"].(string)
   189				valid = obj["type"] == "result" && obj["subtype"] == "success" && obj["is_error"] == false && text != ""
   190			}
   191			message = config.Text(
   192				"review.review_did_not_complete_with_review_text", ctx.settings.name,
   193			)
   194		} else {
   195			printFile(runtime, outputFile, os.Stdout)
   196			return newGate(1, "review.unsupported_reviewer_agent", ctx.agent)
   197		}
   198		if !valid {
   199			printFile(runtime, outputFile, os.Stdout)
   200			return newGateMsg(1, message)
   201		}
   202		if ctx.archive != nil {
   203			ctx.archive.report = []byte(text)
   204			_, _ = os.Stdout.Write(ctx.archive.report)
   205			syncStream(os.Stdout)
   206			return nil
   207		}
   208		fmt.Println(text)
   209		return nil
   210	}
