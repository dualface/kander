   228		if exitCode == 0 && lingering {
   229			fail(newGate(2,
   230				"review.review_left_background_child_processes_the_result_was_rejected", ctx.settings.name,
   231			))
   232			return exitCode
   233		}
   234		if timedOut || exitCode != 0 {
   235			outputPrinted = true
   236			printFile(outputRoot, errorFile, os.Stderr)
   237			printFile(outputRoot, stdoutFile, os.Stdout)
   238			printFile(outputRoot, outputFile, os.Stdout)
   239			return exitCode
   240		}
   241		errorOutput, readErr := fs.ReadRegularFile(outputRoot, errorFile)
   242		if readErr != nil {
   243			fail(readErr)
   244			return exitCode
   245		}
   246		if len(errorOutput) > 0 {
   247			_, _ = os.Stderr.Write(errorOutput)
   248			syncStream(os.Stderr)
   249		}
   250		outputPrinted = true
   251		if err := parseReviewOutput(ctx, outputRoot, outputFile, stdoutFile); err != nil {
   252			fail(err)
   253			return exitCode
   254		}
   255		exitCode = 0
   256		return exitCode
   257	}
   258	
   259	func monitorProcess(ctx reviewContext, runtime string, lp *launchedProcess, errorFile string, abort <-chan os.Signal) (int, bool) {
   260		started := time.Now()
   261		nextCheck := started.Add(time.Duration(ctx.settings.checkInterval) * time.Second)
   262		attachTracker(ctx, lp)
   263		if abort == nil {
   264			abort = make(chan os.Signal)
   265		}
   266		for {
   267			observeTracker(lp)
   268			select {
   269			case <-lp.waitDone:
   270				observeTracker(lp)
   271				return waitExitCode(lp.waitErr, lp), false
   272			case sig := <-abort:
   273				return signalExitCode(sig), true
   274			default:
   275			}
   276			if time.Since(started) >= time.Duration(ctx.settings.maxRuntime)*time.Second {
   277				userError(config.Text(
   278					"review.review_exceeded_seconds", ctx.settings.name, itoa(ctx.settings.maxRuntime),
   279				))
   280				return 124, true
   281			}
   282			now := time.Now()
   283			if !now.Before(nextCheck) {
   284				elapsed := int(now.Sub(started).Seconds())
   285				msg := config.Text(
   286					"review.review_is_still_running_after_s", ctx.settings.name, itoa(elapsed),
   287				)
   288				_, _ = os.Stderr.WriteString(msg + "\n")
   289				printErrorTail(runtime, errorFile)
   290				nextCheck = nextCheck.Add(time.Duration(ctx.settings.checkInterval) * time.Second)
   291			}
   292			remaining := time.Duration(ctx.settings.maxRuntime)*time.Second - time.Since(started)
   293			if remaining < 10*time.Millisecond {
   294				remaining = 10 * time.Millisecond
   295			}
   296			slice := monitorSlice(ctx, remaining)
   297			timer := time.NewTimer(slice)
   298			select {
   299			case <-lp.waitDone:
   300				timer.Stop()
   301				observeTracker(lp)
   302				return waitExitCode(lp.waitErr, lp), false
   303			case sig := <-abort:
   304				timer.Stop()
   305				return signalExitCode(sig), true
   306			case <-timer.C:
   307				observeTracker(lp)
   308			}
   309		}
   310	}
   311	
   312	func signalExitCode(sig os.Signal) int {
   313		if s, ok := sig.(syscall.Signal); ok {
   314			return 128 + int(s)
   315		}
   316		return 130
   317	}

