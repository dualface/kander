func assertArg(t *testing.T, argv []string, flag, value string) {
	t.Helper()
	for i, v := range argv {
		if v == flag {
			if i+1 >= len(argv) || argv[i+1] != value {
				t.Fatalf("%s want %q in %v", flag, value, argv)
			}
			return
		}
