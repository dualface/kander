    29			userError(config.Text(
    30				"review.could_not_safely_clean_the_private_review_runtime", cleanup.Error(),
    31			))
    32			if ctx.archive != nil {
    33				ctx.archive.reason = cleanup.Error()
    34				return ctx.archive.finish(2)
    35			}
    36			return 2
    37		}
    38		if ctx.archive != nil {
    39			return ctx.archive.finish(code)
    40		}
    41		return code
    42	}
