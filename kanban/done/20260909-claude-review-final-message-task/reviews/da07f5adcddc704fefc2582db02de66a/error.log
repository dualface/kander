    19	
    20	func gitCommandContext(ctx context.Context, arguments []string, cwd, inputText string) (stdout, stderr string, code int, err error) {
    21		cmd := exec.CommandContext(ctx, "git", arguments...)
    22		cmd.WaitDelay = 100 * time.Millisecond
    23		if cwd != "" {
    24			cmd.Dir = cwd
    25		}
    26		cmd.Env = append(os.Environ(), "GIT_OPTIONAL_LOCKS=0")
    27		cmd.Stdin = strings.NewReader(inputText)
    28		var outBuf, errBuf bytes.Buffer
    29		cmd.Stdout = &outBuf
    30		cmd.Stderr = &errBuf
    31		runErr := cmd.Run()
    32		stdout = outBuf.String()
    33		stderr = errBuf.String()
    34		if runErr == nil {
    35			return stdout, stderr, 0, nil
    36		}
    37		if ee, ok := runErr.(*exec.ExitError); ok {
    38			return stdout, stderr, ee.ExitCode(), nil
    39		}
    40		return stdout, stderr, 0, newGate(2, "review.could_not_run_git", runErr.Error())
    41	}
