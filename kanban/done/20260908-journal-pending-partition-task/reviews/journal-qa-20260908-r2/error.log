   167	// PreviewStart resolves task size, configured agent and launcher without claiming
   168	// a task, allocating a session or creating a terminal container.
   169	func PreviewStart(root, taskID string) (preview StartPreview, err error) {
   170		var warnings board.WarningLog
   171		defer func() { preview.Warnings = warnings.Messages() }()
   172		snapshot, err := board.ReadSnapshotWithWarnings(root, taskID, &warnings)
   173		if err != nil {
