   175		}
   176		cfg, err := loadEffective()
   177		if err != nil {
   178			return StartPreview{}, err
   179		}
   180		agent, err := config.KanbanAgentFor(cfg, snapshot.Entry.Kind)
   181		if err != nil {
   182			return StartPreview{}, err
   183		}
   184		launcher, err := resolveStartLauncher(cfg.Launcher)
   185		if err != nil {
   186			return StartPreview{}, err
   187		}
   188		return StartPreview{TaskID: taskID, State: snapshot.Entry.State, Size: snapshot.Entry.Kind, Agent: agent, Launcher: launcher}, nil
   189	}
