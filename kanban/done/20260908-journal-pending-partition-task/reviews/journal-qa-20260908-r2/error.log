    85	func (a *App) handleStartConfirmation(key string) {
    86		request := *a.StartConfirmation
    87		a.StartConfirmation = nil
    88		if key != "y" {
    89			return
    90		}
    91		run := a.StartTask
    92		a.startsRunning++
    93		a.pendingWork = func() any {
    94			result, err := run(request)
    95			return startResult{result, err}
    96		}
    97		a.showFocusNotice(t("tui.start_starting", request.TaskID))
    98	}
