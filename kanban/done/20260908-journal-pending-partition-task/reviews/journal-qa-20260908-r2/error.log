    33	func runTaskStart(request startRequest) (result launch.StartResult, err error) {
    34		var warnings board.WarningLog
    35		defer func() { result.Warnings = append(warnings.Messages(), result.Warnings...) }()
    36		if !backgroundStartLauncher(request.Launcher) {
    37			return launch.StartResult{}, fmt.Errorf("%s", t("tui.start_use_cli", request.Launcher))
    38		}
    39		if request.State == "backlog" {
    40			snapshot, err := board.ReadSnapshotWithWarnings(request.root, request.TaskID, &warnings)
    41			if err != nil {
    42				return launch.StartResult{}, err
    43			}
    44			if snapshot.Entry.State != "backlog" {
    45				return launch.StartResult{}, fmt.Errorf("%s", t("tui.start_state_changed", request.TaskID))
    46			}
    47			if _, err := board.MoveEntry(snapshot.Entry, request.root, "todo"); err != nil {
    48				return launch.StartResult{}, err
    49			}
    50		}
    51		return launch.Start(request.root, request.Agent, request.Launcher, request.TaskID)
    52	}
    53	
    54	func backgroundStartLauncher(launcher string) bool {
    55		return launcher == "herdr" || launcher == "tmux" || launcher == "tmux-session"
    56	}
