   100	func (a *App) applyStartResult(result startResult) {
   101		if a.startsRunning > 0 {
   102			a.startsRunning--
   103		}
   104		defer func() {
   105			if a.quitAfterStarts && a.startsRunning == 0 {
   106				a.Running = false
   107			}
   108		}()
   109		a.refreshBoard()
   110		message := ""
   111		compact := ""
   112		if result.err != nil {
   113			message = t("tui.start_failed", result.err.Error())
   114		} else {
   115			r := result.result
   116			address := r.Outcome.Tab + ":" + r.Outcome.Pane
   117			if r.Plan.Launcher != "herdr" {
   118				address = r.Plan.Session + ":" + r.Outcome.Window + ":" + r.Outcome.Pane
   119			}
   120			message = t("tui.start_success", r.TaskID, r.Agent, r.Plan.Launcher, address)
   121			compact = t("tui.start_success_compact", r.Agent, r.Plan.Launcher, address)
   122		}
   123		for _, warning := range result.result.Warnings {
   124			message += " " + warning
   125			compact += " " + warning
   126		}
   127		a.showFocusNotice(message)
   128		if result.err == nil {
   129			a.startNotice = &startNotice{a.CopyNotice, strings.ReplaceAll(printableText(ansi.Strip(compact)), "\n", " ")}
   130		}
   131	}
