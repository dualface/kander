 			return count, fmt.Errorf("%s: %w", record.ID, err)
 		}
 		if record.Purpose == "migration" || len(record.Migrations) > 0 {
 			count += len(record.Revisions)
 		}
 	}
+	pruneJournal(root)
 	return count, nil
 }
 
