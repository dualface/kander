   135				phase := phases[file.name]
   136				partition := "pending"
   137				if phase == "committed" {
   138					partition = "committed"
   139				} else if phase != "prepared" {
   140					return kanbanError("board.transaction_invalid", file.name)
   141				}
   142				if file.partition == partition {
   143					continue
   144				}
   145				if err := fs.Rename(root, file.path(root), control(root, "operations", partition, file.name)); err != nil {
   146					return err
   147				}
   148				count++
   149				if err := checkpoint("journal-partitioned"); err != nil {
   150					return err
   151				}
   152			}
   153			return nil
   154		})
   155		if err == nil {
   156			_, _ = os.Stderr.WriteString(t("board.journal_partitioned", itoa(count)) + "\n")
   157		}
   158		return err
   159	}
   160	
   161	func commitOperation(root, path string, record *OperationRecord, checkpoint func(string) error) error {
   162		return withJournalLock(root, false, func() error {
   163			record.Phase = "committed"
   164			if err := writeJSON(root, path, record, true); err != nil {
   165				return err
   166			}
   167			if err := checkpoint("journal-committed-phase"); err != nil {
   168				return err
   169			}
   170			target := control(root, "operations", "committed", record.ID+".json")
   171			if filepath.Clean(path) != target {
   172				if err := fs.Rename(root, path, target); err != nil {
   173					return err
   174				}
   175			}
   176			warnJournalCleanup(pruneCommitted(root, checkpoint))
   177			return nil
   178		})
   179	}
     1	package board
     2	
     3	import (
     4		"errors"
     5		"os"
     6		"sort"
     7		"time"
     8	
     9		"github.com/dualface/kander/internal/fs"
    10	)
    11	
    12	// Keep 100 recent commits for local diagnosis while bounding normal journal
    13	// storage and metadata scans. Migration staging evidence is retained separately.
    14	const committedJournalRetention = 100
    15	
    16	func warnJournalCleanup(err error) {
    17		if err != nil {
    18			_, _ = os.Stderr.WriteString(t("board.journal_cleanup_warning", err.Error()) + "\n")
    19		}
    20	}
    21	
    22	func pruneJournal(root string) {
    23		warnJournalCleanup(withJournalLock(root, false, func() error {
    24			return pruneCommitted(root, func(string) error { return nil })
    25		}))
    26	}
    27	
    28	// pruneCommitted holds the exclusive journal lock. It never parses old redo
    29	// images; staging directory identities conservatively pin matching records.
    30	func pruneCommitted(root string, checkpoint func(string) error) error {
    31		files, err := journalFiles(root)
    32		if err != nil {
    33			return err
    34		}
    35		staging, err := fs.ListDirectory(root, control(root, "migrations"))
    36		if err != nil {
    37			return err
    38		}
    39		protected := map[string]bool{}
    40		for _, entry := range staging {
    41			if entry.Kind != fs.KindDirectory {
    42				return kanbanError("board.transaction_invalid", entry.Name)
    43			}
    44			protected[entry.Name+".json"] = true
    45		}
    46		type candidate struct {
    47			file journalFile
    48			time time.Time
    49		}
    50		var committed []candidate
    51		for _, file := range files {
    52			if file.partition != "committed" {
    53				continue
    54			}
    55			handle, err := fs.OpenRegularFileIfExists(root, file.path(root))
    56			if err != nil {
    57				return err
    58			}
    59			if handle == nil {
    60				return kanbanError("board.transaction_conflict", file.name)
    61			}
    62			info, statErr := handle.Stat()
    63			if err := errors.Join(statErr, handle.Close()); err != nil {
    64				return err
    65			}
    66			committed = append(committed, candidate{file, info.ModTime()})
    67		}
    68		sort.Slice(committed, func(i, j int) bool {
    69			if committed[i].time.Equal(committed[j].time) {
    70				return committed[i].file.name > committed[j].file.name
    71			}
    72			return committed[i].time.After(committed[j].time)
    73		})
    74		for i := committedJournalRetention; i < len(committed); i++ {
    75			file := committed[i].file
    76			if protected[file.name] {
    77				continue
    78			}
    79			if _, err := fs.RemoveRegularFileIfExists(root, file.path(root)); err != nil {
    80				return err
    81			}
    82			if err := checkpoint("journal-pruned"); err != nil {
    83				return err
    84			}
    85		}
    86		return nil
    87	}

