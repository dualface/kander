	State         DispatchState          `json:"state"`
	Attempts      uint64                 `json:"attempts"`
	Accepted      *DispatchReceipt       `json:"accepted,omitempty"`
	Completed     *DispatchReceipt       `json:"completed,omitempty"`
	Reason        string                 `json:"reason,omitempty"`
}

