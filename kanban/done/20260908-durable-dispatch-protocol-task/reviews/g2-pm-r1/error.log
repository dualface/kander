	if err != nil {
		return err
	}
	rules, err := launch.RuleLoadingWithLanguage(paths, s.Text)
	if err != nil {
		return err
	}
	message := rules + "\n\n" + launch.DispatchInstruction(paths, d) + "\n\n" + d.Input.Message
