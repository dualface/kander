   282	// One P3 budget covers forward/reverse observation and final readiness checks.
   283	func resolveDispatchTarget(ctx context.Context, s board.Snapshot, override string) (DirectTarget, bool, bool, error) {
   284		ctx, cancel := context.WithTimeout(ctx, liveness.DefaultBatchBudget)
   285		defer cancel()
   286		value := board.MetadataFrom(s.Text, board.FieldWindow)
   287		if override == "" {
   288			observation := launch.DispatchObservation(ctx, s)
   289			if !observation.ValidFor(s.Entry, s.Text) {
   290				return DirectTarget{}, false, false, notifyError("launch.dispatch_recovery_unproven", s.Entry.TaskID, observation.Detail)
   291			}
   292			if observation.Status == liveness.Stopped {
   293				return DirectTarget{}, true, false, nil
   294			}
   295			if observation.Status != liveness.Alive && observation.Status != liveness.Drifted {
   296				return DirectTarget{}, false, false, notifyError("launch.dispatch_recovery_unproven", s.Entry.TaskID, observation.Detail)
   297			}
   298			if observation.NewWindow != "" {
   299				value = observation.NewWindow
   300			}
   301		}
   302		target, busy, err := dispatchTarget(ctx, value, override, s.Entry.TaskID, s.Text)
   303		return target, false, busy, err
   304	}

