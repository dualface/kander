   156	
   157	func resumeDispatch(parent context.Context, root string, agent *string, launcher, task string, d board.Dispatch, launched *ResumeLaunch) error {
   158		if dispatchFinished(d) && agent == nil {
   159			return PrintDispatchResult(d)
   160		}
   161		ctx, cancel := context.WithDeadline(parent, d.Input.ConfirmBy)
   162		defer cancel()
   163		s, err := board.ReadSnapshot(root, task)
