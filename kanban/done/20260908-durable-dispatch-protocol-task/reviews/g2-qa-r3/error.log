   215	// dispatchTarget rechecks readiness with the same context as P3's observation.
   216	// Missing identity and probe errors never authorize a recovery process.
   217	func dispatchTarget(ctx context.Context, value, override, task, text string) (DirectTarget, bool, error) {
   218		session, err := launch.ResolvedSession(task, text)
   219		if err != nil {
   220			return DirectTarget{}, false, err
   221		}
   222		if match := herdrWindowRe.FindStringSubmatch(value); match != nil || override != "" {
   223			program, err := lookPath("herdr")
   224			if err != nil {
   225				return DirectTarget{}, false, err
   226			}
   227			pane := override
   228			if pane == "" {
   229				pane = match[2]
   230			}
   231			found, err := probe.ProbeHerdrPaneContext(ctx, program, pane)
   232			if err != nil {
   233				return DirectTarget{}, false, err
   234			}
   235			if found.Pane == nil || session.Reference == "" || herdrSessionReference(found.Pane) != session.Reference || found.Pane["agent"] != session.Agent {
   236				return DirectTarget{}, false, notifyError("launch.dispatch_recovery_unproven", task, "identity")
   237			}
   238			status, _ := found.Pane["agent_status"].(string)
   239			tab := probe.PublicID(found.Pane["tab_id"])
   240			if tab == "" {
   241				return DirectTarget{}, false, notifyError("launch.dispatch_recovery_unproven", task, "tab")
   242			}
   243			return DirectTarget{Kind: "herdr", Program: program, PaneID: pane, Window: "herdr:" + tab + ":" + pane}, status != "idle" && status != "done", nil
   244		}
   245		if match := tmuxWindowRe.FindStringSubmatch(value); match != nil {
   246			program, err := lookPath("tmux")
   247			if err != nil {
   248				return DirectTarget{}, false, err
   249			}
   250			found, err := probe.ProbeTmuxPaneContext(ctx, program, match[4])
   251			if err != nil {
   252				return DirectTarget{}, false, err
   253			}
   254			f := found.Facts
   255			if f == nil || f.Dead != "0" || f.Command != agentCommandName(session.Agent) || session.Reference == "" || f.SessionMarker != session.Reference {
   256				return DirectTarget{}, false, notifyError("launch.dispatch_recovery_unproven", task, "identity")
   257			}
   258			return DirectTarget{Kind: "tmux", Program: program, PaneID: match[4], Window: value}, f.InMode != "0", nil
   259		}
   260		return DirectTarget{}, false, notifyError("launch.dispatch_recovery_unproven", task, value)
   261	}
   262	
   263	func sendDispatch(ctx context.Context, target DirectTarget, instruction string) error {
   264		var commands [][]string
   265		if target.Kind == "herdr" {
   266			commands = [][]string{{"agent", "prompt", target.PaneID, instruction}}
   267		} else {
   268			commands = [][]string{{"send-keys", "-t", target.PaneID, "-l", instruction}, {"send-keys", "-t", target.PaneID, "Enter"}}
   269		}
   270		for _, args := range commands {
   271			result, e := probe.CaptureContext(ctx, target.Program, args)
   272			if e != nil {
   273				return e
   274			}
   275			if result.Code != 0 {
   276				return fmt.Errorf("%s", herdrFailureDetail(result))
   277			}
   278		}
   279		return nil
   280	}
