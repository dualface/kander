   216	// ParseDispatchOptions shares the notify/resume flag spelling and rejects duplicates.
   217	func ParseDispatchOptions(args []string) ([]string, DispatchOptions, error) {
   218		var o DispatchOptions
   219		var rest []string
   220		values := map[string]*string{"--dispatch-id": &o.ID, "--kind": &o.Kind, "--base": &o.Base}
   221		seen := map[string]bool{}
   222		for i := 0; i < len(args); i++ {
   223			name, value, inline := strings.Cut(args[i], "=")
   224			field, ok := values[name]
   225			if !ok {
   226				rest = append(rest, args[i])
   227				// Preserve the value boundary owned by the notify/resume parser.
   228				// A message or path may itself look like a dispatch control option.
   229				if !inline && i+1 < len(args) {
   230					switch name {
   231					case "--message", "--message-file", "--timeout", "--agent", "--launcher", "--pane":
   232						i++
   233						rest = append(rest, args[i])
   234					}
   235				}
   236				continue
   237			}
   238			if seen[name] {
   239				return nil, o, launchError("board.unknown_option", name)
   240			}
   241			seen[name] = true
   242			if !inline {
   243				i++
   244				if i >= len(args) {
   245					return nil, o, launchError("board.option_requires_a_value", name)
   246				}
   247				value = args[i]
   248			}
   249			if value == "" {
   250				return nil, o, launchError("board.option_requires_a_value", name)
   251			}
   252			*field = value
   253		}
   254		return rest, o, nil
   255	}
   256	
   257	func validateResumedDispatch(root string, entry board.Entry, text string, plan LaunchPlan, outcome LaunchOutcome, session AgentSession, timeout float64) error {
   258		id := board.MetadataFrom(text, "DISPATCH_ID")
   259		if id == "" {
   260			return validateResumedAgent(plan, outcome, session, timeout)
   261		}
   262		d, err := board.ReadDispatch(root, entry.TaskID, id)
   263		if err != nil {
   264			return err
   265		}
   266		remaining := time.Until(d.Input.ConfirmBy).Seconds()
   267		if remaining < timeout {
   268			timeout = remaining
   269		}
   270		receipt := func() (bool, error) {
   271			current, err := board.ReadDispatch(root, entry.TaskID, id)
   272			if err != nil {
   273				return false, err
   274			}
   275			if current.Authorization != d.Authorization {
   276				return false, launchError("board.dispatch_conflict", id)
   277			}
   278			return dispatchFinished(current), nil
   279		}
   280		deadline := nowFn().Add(time.Duration(timeout * float64(time.Second)))
   281		if err = validateResumedAgentReceipt(plan, outcome, session, timeout, receipt); err != nil {
   282			return err
   283		}
   284		// Process liveness can consume the entire acceptance budget. Reconcile once
   285		// more before reporting pending; preserve any executor whose delivery is unknown.
   286		consumed, err := receipt()
   287		if err != nil {
   288			return err
   289		}
   290		if !consumed && !nowFn().Before(deadline) {
   291			return launchError("launch.dispatch_pending", id)
   292		}
   293		return nil
   294	}
   295	
   296	type resumeBinding struct {
   297		Authorization board.ExecutionAuthorization
   298		Outcome       *ResumeLaunch
   299	}
   300	
   301	// WaitForResumedForeground preserves foreground ownership after the bounded
   302	// dispatch phase. Call only after releasing the transport lease.
   303	func WaitForResumedForeground(result ResumeLaunch) error {
   304		if result.Plan.Launcher != "foreground" || result.Outcome.Wait == nil {
   305			return nil
   306		}
   307		code, err := result.Outcome.Wait()
   308		if err != nil {
   309			return err
   310		}
   311		if code != 0 {
   312			return launchError("notify.resumed_agent_passed_liveness_validation_then_exited_with_status", code)
   313		}
   314		return nil
   315	}

