   188		// cannot erase a receipt consumed while launch/liveness validation ran.
   189		paths, err := currentInstallPaths()
   190		if err != nil {
   191			return err
   192		}
   193		msg := DispatchInstruction(paths, d) + "\n\n" + d.Input.Message
   194		deadline, _ := ctx.Deadline()
   195		remaining := time.Until(deadline).Seconds()
   196		if remaining <= 0 {
   197			return launchError("launch.dispatch_pending", d.Input.ID)
   198		}
   199		err = commandResumeLegacy(root, agent, launcher, task, msg, "", true, remaining, resumeBinding{Authorization: d.Authorization, Outcome: launched})
   200		current, readErr := board.ReadDispatch(root, task, d.Input.ID)
   201		if readErr != nil {
   202			return readErr
   203		}
   204		if dispatchFinished(current) {
   205			return PrintDispatchResult(current)
   206		}
   207		if err != nil {
   208			return err
   209		}
   210		if ctx.Err() != nil {
   211			return launchError("launch.dispatch_pending", d.Input.ID)
   212		}
   213		return PrintDispatchResult(current)
   214	}
