   165			return err
   166		}
   167		if agent == nil {
   168			observation := DispatchObservation(ctx, s)
   169			if !observation.ValidFor(s.Entry, s.Text) || observation.Status != liveness.Stopped {
   170				return launchError("launch.dispatch_recovery_unproven", d.Input.ID, observation.Detail)
   171			}
   172		} else {
   173			// An explicit --agent is the existing user-authorized takeover entrance.
   174			d, err = board.ReauthorizeDispatch(root, task, d.Input.ID, d.Revision)
   175			if err != nil {
   176				return err
   177			}
   178			s, err = board.ReadExecutionSnapshot(root, task, d.Authorization)
   179			if err != nil {
   180				return err
   181			}
   182		}
   183		d, err = board.BeginDispatchAttempt(root, task, d.Input.ID, d.Revision, s.Revision)
   184		if err != nil {
   185			return err
   186		}
