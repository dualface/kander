   613	// apply writes the values changed in the form back to App and the config session immediately.
   614	// Huh updates its bound pointers as the cursor moves, which is what makes changes take effect while selecting;
   615	// returning with Esc loses nothing, because the changes already landed in the session.
   616	// Items with side effects (installing tmux) are not run here, see commitSideEffects.
   617	func (b *formBinding) apply(p *optionsPanel) {
   618		switch p.current {
   619		case sectionRules:
   620			b.applyRules(p)
   621		case sectionInterface:
   622			b.applyInterface(p)
   623			if p.session != nil && b.language != "" && p.session.Config.Language != b.language {
   624				p.session.SetLanguage(b.language)
   625				p.app.Context = tuiPageContext()
   626				p.markDirty()
   627			}
   628			if p.session != nil && b.agentLanguage != "" && p.session.Config.AgentLanguage != b.agentLanguage {
   629				p.session.SetAgentLanguage(b.agentLanguage)
   630				p.markDirty()
   631			}
   632		case sectionExecution:
   633			session := p.session
   634			// The agent changed, so the model fields below it belong to a different object and this screen must be rebuilt;
   635			// focus returns to the line just edited so the interaction is not interrupted.
   636			if session.Config.KanbanAgents["large"] != b.large {
   637				session.SetExecutionAgent("large", b.large)
   638				p.markDirty()
   639				p.rebuildAt(scaleFocusKey("large"))
   640			}
   641			if session.Config.KanbanAgents["small"] != b.small {
   642				session.SetExecutionAgent("small", b.small)
   643				p.markDirty()
   644				p.rebuildAt(scaleFocusKey("small"))
   645			}
   646			if b.launcher != menu.LauncherInstallValue && session.Config.Launcher != b.launcher {
   647				session.SetLauncher(b.launcher)
   648				p.markDirty()
   649			}
   650			b.applyModels(p)
   651		case sectionReview:
   652			session := p.session
   653			for _, role := range config.ReviewRoles {
   654				value := b.reviewers[role]
   655				if value != nil && session.Config.Reviewers[role] != *value {
   656					session.SetReviewer(role, *value)
   657					// The old values were configured for the old reviewer, so after the switch they are reset to the new reviewer's defaults.
   658					session.ResetReviewRoleModel(role)
   659					p.markDirty()
   660					p.rebuildAt(roleFocusKey(role))

