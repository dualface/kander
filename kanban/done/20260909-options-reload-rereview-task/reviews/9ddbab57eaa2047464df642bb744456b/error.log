   767	// commitSideEffects runs the actions that may only fire once the user confirms the whole section:
   768	// installing tmux occupies the terminal and changes the local environment, so it must not run as the cursor moves.
   769	func (b *formBinding) commitSideEffects(p *optionsPanel) {
   770		switch p.current {
