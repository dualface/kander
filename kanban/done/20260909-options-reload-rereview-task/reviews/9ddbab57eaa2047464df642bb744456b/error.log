    10	// ApplyDoctorConfig adopts the doctor repair result while keeping edits not yet saved in the panel.
    11	func (s *Session) ApplyDoctorConfig(before, after *config.Config, dirty bool) error {
    12		merged := after
    13		if dirty {
    14			if before == nil {
    15				before = config.DefaultConfig()
    16			}
    17			objects := make([]map[string]any, 3)
    18			for i, cfg := range []*config.Config{before, s.Config, after} {
    19				data, err := json.Marshal(cfg)
    20				if err != nil {
    21					return err
    22				}
    23				if err := json.Unmarshal(data, &objects[i]); err != nil {
    24					return err
    25				}
    26			}
    27			preserveDoctorEdits(objects[0], objects[1], objects[2])
    28			objects[2]["welcome_complete"] = after.WelcomeComplete
    29			data, err := json.Marshal(objects[2])
    30			if err != nil {
    31				return err
    32			}
    33			merged, err = config.ValidateJSON(data)
    34			if err != nil {
    35				return err
    36			}
    37		}
    38		s.existing = after
    39		s.Config = merged
    40		return nil
    41	}
    42	
    43	func preserveDoctorEdits(before, edited, after map[string]any) {
    44		for key, value := range edited {
    45			oldObject, oldOK := before[key].(map[string]any)
    46			editObject, editOK := value.(map[string]any)
    47			newObject, newOK := after[key].(map[string]any)
    48			if oldOK && editOK && newOK {
    49				preserveDoctorEdits(oldObject, editObject, newObject)
    50			} else if !reflect.DeepEqual(before[key], value) {
    51				after[key] = value
    52			}
    53		}
    54	}
    55	
    56	// SyncTUI adopts UI preferences that changed outside this session.
    57	// persisted means the value already reached disk and the editing baseline must advance with it, otherwise saving would mistake it for another process's change.
    58	func (s *Session) SyncTUI(value config.TUI, persisted bool) {
    59		if s == nil {
    60			return
    61		}
    62		if s.Config != nil {
    63			s.Config.TUI = value
    64		}
    65		if persisted && s.existing != nil {
    66			s.existing.TUI = value
    67		}
    68	}

