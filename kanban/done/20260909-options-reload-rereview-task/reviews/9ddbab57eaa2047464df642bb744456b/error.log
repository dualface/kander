   522	// abortSection handles Esc: a section returns to the root menu, the root menu closes the panel.
   523	// Changed values are kept (apply wrote them back long ago); only side effects that need confirmation are skipped.
   524	func (p *optionsPanel) abortSection() tea.Cmd {
   525		if p.current == sectionDoctor {
