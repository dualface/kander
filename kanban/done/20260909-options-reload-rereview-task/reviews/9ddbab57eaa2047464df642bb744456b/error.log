   512	// Summary returns the "current configuration" overview shown in the menu title and at the top of the panel.
   513	func (s *Session) Summary() []string {
   514		cfg := s.Config
   515		lines := []string{config.Text("menu.current_configuration")}
   516		lines = append(lines, config.Text("rules.modules")+": "+config.FormatRulesSummary(cfg.Rules))
   517		for _, agent := range config.ExecutionAgentsInUse(cfg) {
   518			entry := cfg.Models.Kanban[agent]
   519			lines = append(lines, "  kanban "+agent+": "+config.FormatKanbanModelSummary(agent, entry))
   520		}
   521		seen := map[string]struct{}{}
   522		for _, role := range config.ReviewRoles {
   523			reviewer := cfg.Reviewers[role]
   524			if _, ok := seen[reviewer]; ok {
   525				continue
   526			}
   527			seen[reviewer] = struct{}{}
   528			entry := cfg.Models.Review[reviewer]
   529			lines = append(lines, "  review "+reviewer+": "+config.FormatReviewModelSummary(entry))
   530		}
   531		return lines
   532	}
