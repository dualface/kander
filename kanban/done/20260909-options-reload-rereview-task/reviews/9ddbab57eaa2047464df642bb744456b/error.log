   548		case sectionDoctor:
   549			p.status = t("tui.running_environment_check")
   550			p.app.pendingWork = func() any {
   551				return terminalToolsResult{tools: menu.CheckTerminalTools()}
   552			}
   553			p.form = nil
   554			return nil
   555		case "":
