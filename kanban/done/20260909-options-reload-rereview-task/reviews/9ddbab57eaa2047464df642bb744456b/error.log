   123	func loadOptionsSession() sessionResult {
   124		if _, err := config.Load(false); err != nil {
   125			return sessionResult{err: err}
   126		}
   127		existing, scopeRaw, err := config.LoadScopeRaw(true)
   128		if err != nil {
   129			return sessionResult{err: err}
   130		}
   131		overlayPath, overlayRaw, err := config.ReadOverlay("")
   132		if err != nil {
   133			return sessionResult{err: err}
   134		}
   135		if overlayRaw != nil {
   136			if _, err := config.ApplyOverlay(existing, overlayRaw); err != nil {
   137				return sessionResult{err: err}
   138			}
   139		}
   140		language := ""
   141		if existing.WelcomeComplete {
   142			language = overlayLanguage(overlayRaw)
   143			if language == "" {
   144				language = config.ExplicitConfigLanguage(scopeRaw)
   145			}
   146		}
   147		session, sessionErr := newOptionsSession(existing, true)
   148		if sessionErr != nil {
   149			return sessionResult{err: sessionErr}
   150		}
   151		return sessionResult{session: session, overlayPath: overlayPath, language: language}
   152	}
   153	
   154	func overlayLanguage(overlay map[string]any) string {
   155		if overlay == nil {
   156			return ""
   157		}
   158		lang, _ := overlay["language"].(string)
   159		if containsString(config.Languages, lang) {
   160			return lang
   161		}
   162		return ""
   163	}
