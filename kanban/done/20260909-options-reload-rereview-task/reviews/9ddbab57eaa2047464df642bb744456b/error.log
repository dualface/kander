   311	// Update is the input entry point of the panel: the report first, then the current Huh form.
   312	func (p *optionsPanel) Update(msg tea.Msg) tea.Cmd {
   313		if tick, ok := msg.(spinner.TickMsg); ok {
   314			if p.form != nil || p.loadErr != "" {
   315				return nil
   316			}
   317			var cmd tea.Cmd
   318			p.spinner, cmd = p.spinner.Update(tick)
   319			return cmd
   320		}
   321		if p.report != nil {
   322			return p.updateReport(msg)
   323		}
   324		if event, ok := msg.(tea.KeyMsg); ok && p.form != nil && !p.acceptsText() {
   325			switch mapKey(event) {
   326			case "q", "Q", "o", "O":
   327				// Consistent with the rest of the board: q closes, and pressing o again closes too.
   328				return p.requestClose()
   329			}
   330		}
   331		if p.form == nil {
   332			if key, ok := msg.(tea.KeyMsg); ok {
   333				switch mapKey(key) {
   334				case "esc", "q", "Q":
   335					p.close()
   336				}
   337			}
   338			return nil
   339		}
   340		return p.updateForm(msg)
   341	}
   342	
   343	func (p *optionsPanel) updateReport(msg tea.Msg) tea.Cmd {
   344		if key, ok := msg.(tea.KeyMsg); ok {
   345			switch mapKey(key) {
   346			case "esc", "q", "Q", "enter", "backspace":
   347				p.report = nil
   348				if p.form == nil && p.session != nil {
   349					return p.openRoot()
   350				}
   351				return nil
   352			}
   353		}
   354		var cmd tea.Cmd
   355		p.report.view, cmd = p.report.view.Update(msg)
   356		return cmd
   357	}
   358	
   359	// acceptsText reports whether the current section contains a text input;
   360	// while it does, q and o must reach the input verbatim and the panel is closed with Esc instead.
   361	func (p *optionsPanel) acceptsText() bool {
   362		return p.current == sectionExecution || p.current == sectionReview
   363	}
   364	
   365	// rebuildAt requests a rebuild of the current section after this update, with focus landing back on the selector named by key.
   366	// When the execution agent or the reviewer changes, the model fields on the same screen belong to a different object and must be rebuilt.
   367	func (p *optionsPanel) rebuildAt(key string) {
   368		p.rebuildFocus = key
   369	}
   370	
   371	// rebuildSection rebuilds the current section and moves focus back to the original field.
   372	// The focus move is left to Bubble Tea to run asynchronously; the form commands must not run synchronously here,
   373	// because the blink chain of a text input contains a tea.Tick that would block for over half a second.
   374	func (p *optionsPanel) rebuildSection() tea.Cmd {
   375		key := p.rebuildFocus
   376		p.rebuildFocus = ""
   377		section := p.current
   378		if section == "" {
   379			return nil
   380		}
   381		cmd := p.openSection(section)
   382		// openSection rebuilt bind, so only now is it known which position that selector holds in the new form.
   383		index := 0
   384		if p.bind != nil {
   385			index = p.bind.fieldIndex[key]
   386		}
   387		return tea.Batch(cmd, repeatCmd(index, huh.NextField))
   388	}
   389	
   390	// resizeForm rebuilds the form so every page re-measures its natural height against the new terminal size.
   391	// Huh's WithHeight cannot be undone; a form once compressed by a short terminal can only leave the scrolling layout through a rebuild.
   392	func (p *optionsPanel) resizeForm() tea.Cmd {
   393		if p.form == nil || p.report != nil {
   394			return nil
   395		}
   396		if p.confirming {
   397			return p.openCloseConfirm()
   398		}
   399		if p.current == "" {
   400			return p.openRoot()
   401		}
   402		index := 0
   403		if p.bind != nil {
   404			focused := p.form.GetFocusedField()
   405			for _, field := range p.bind.formFields {
   406				if field.Skip() {
   407					continue
   408				}
   409				if field == focused {
   410					break
   411				}
   412				index++
   413			}
   414		}
   415		section := p.current
   416		cmd := p.openSection(section)
   417		return tea.Batch(cmd, repeatCmd(index, huh.NextField))
   418	}
   419	
   420	// requestClose closes the panel; unsaved changes make the user choose first.
   421	func (p *optionsPanel) requestClose() tea.Cmd {
   422		if !p.dirty {
   423			p.close()
   424			return nil
   425		}
   426		return p.openCloseConfirm()
   427	}
   428	
   429	func (p *optionsPanel) updateForm(msg tea.Msg) tea.Cmd {
   430		// Inside the panel Enter always means "submit the current form", no matter which field the cursor is on;
   431		// Huh treats Enter as "move to the next field" by default, so it is intercepted here first.
   432		if event, ok := msg.(tea.KeyMsg); ok && mapKey(event) == "enter" {
   433			if p.bind != nil {
   434				p.bind.apply(p)
   435			}
   436			if p.confirming {
   437				return p.finishCloseConfirm()
   438			}
   439			return p.finishSection()
   440		}
   441		model, cmd := p.form.Update(msg)
   442		if form, ok := model.(*huh.Form); ok {
   443			p.form = form
   444		}
   445		// Bound values are written back as the cursor moves, which is what lets UI preferences such as the theme preview while being selected.
   446		if p.bind != nil {
   447			p.bind.apply(p)
   448		}
   449		if p.rebuildFocus != "" {
   450			return tea.Batch(cmd, p.rebuildSection())
   451		}
   452		switch p.form.State {
   453		case huh.StateCompleted:
   454			if p.confirming {
   455				return p.finishCloseConfirm()
   456			}
   457			return tea.Batch(cmd, p.finishSection())
   458		case huh.StateAborted:
   459			if p.confirming {
   460				p.confirming = false
   461				return p.openRoot()
   462			}
   463			return p.abortSection()
   464		}
   465		return cmd
   466	}
   467	
   468	func (p *optionsPanel) finishCloseConfirm() tea.Cmd {
   469		p.confirming = false
   470		switch p.closeChoice {
   471		case closeSave:
   472			p.save()
   473			return nil
   474		case closeDiscard:
   475			p.close()
   476			return nil
   477		}
   478		return p.openRoot()
   479	}
   480	
   481	// finishSection runs the side effects and returns to the root menu once a section form is confirmed.
   482	// Ordinary values were already written back in apply; interface / task execution / review / rules reach disk on submit,
   483	// so there is no need to return to the root menu and pick "save and apply".
   484	func (p *optionsPanel) finishSection() tea.Cmd {
   485		if p.current == sectionDoctor {
   486			return p.finishHerdrInstall()
   487		}
   488		if p.current == "" {
   489			return p.dispatch(p.section)
   490		}
   491		if p.bind != nil {
   492			p.bind.commitSideEffects(p)
   493		}
   494		if p.savesOnSubmit() {
   495			if err := p.persistNow(); err != nil {
   496				p.showReport(t("tui.save_failed"), nil, err.Error())
   497				return nil
   498			}
   499		}
   500		p.current = ""
   501		return p.openRoot()
   502	}
   503	
   504	func (p *optionsPanel) savesOnSubmit() bool {
   505		return p.current == sectionInterface || p.current == sectionExecution || p.current == sectionReview || p.current == sectionRules
   506	}
   507	
   508	// persistNow writes the current session to the config file, UI preferences included.
   509	func (p *optionsPanel) persistNow() error {
   510		p.persistUI()
   511		if p.session == nil {
   512			return nil
   513		}
   514		p.session.Config.WelcomeComplete = true
   515		if _, err := p.session.Save(); err != nil {
   516			return err
   517		}
   518		p.dirty = false
   519		return nil
   520	}
   521	
   522	// abortSection handles Esc: a section returns to the root menu, the root menu closes the panel.
   523	// Changed values are kept (apply wrote them back long ago); only side effects that need confirmation are skipped.
   524	func (p *optionsPanel) abortSection() tea.Cmd {
   525		if p.current == sectionDoctor {
   526			p.installHerdr = false
   527			return p.finishHerdrInstall()
