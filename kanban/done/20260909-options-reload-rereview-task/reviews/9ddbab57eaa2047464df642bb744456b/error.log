   335			}
   336			cfg.Language = lang
   337			_, saveErr := saveConfigAt(path, cfg)
   338			return saveErr
   339		})
   340	}
   341	
   342	func configEditConflicts(current, baseline, target *Config) bool {
   343		if current == nil || baseline == nil || target == nil {
   344			return true
   345		}
   346		currentValue := reflect.ValueOf(*current)
   347		baselineValue := reflect.ValueOf(*baseline)
   348		targetValue := reflect.ValueOf(*target)
   349		for i := 0; i < currentValue.NumField(); i++ {
   350			currentField := currentValue.Field(i).Interface()
   351			baselineField := baselineValue.Field(i).Interface()
   352			targetField := targetValue.Field(i).Interface()
   353			if !reflect.DeepEqual(currentField, baselineField) && !reflect.DeepEqual(currentField, targetField) {
   354				return true
   355			}
   356		}
   357		return false
   358	}
   359	
   360	// SaveIfUnchanged saves only while the on-disk config still equals the editing baseline; a missing file may be created directly.
   361	func SaveIfUnchanged(cfg, baseline *Config) (string, error) {
   362		path, err := ConfigPath()
   363		if err != nil {
   364			return "", err
   365		}
   366		var saved string
   367		err = withConfigLock(path, func() error {
   368			data, readErr := readConfigBytes(path)
   369			if readErr != nil {
   370				return configErrorfWrap(readErr, "config.failed_to_read_config", path, readErr.Error())
   371			}
   372			if data != nil {
   373				current, loadErr := loadValidated(path, false)
   374				if loadErr != nil {
   375					return loadErr
   376				}
   377				if configEditConflicts(current, baseline, cfg) {
   378					return configErrorf("config.configuration_changed_while_editing")
   379				}
   380			}
   381			var saveErr error
   382			saved, saveErr = saveConfigAt(path, cfg)
   383			return saveErr
   384		})
   385		return saved, err
   386	}

