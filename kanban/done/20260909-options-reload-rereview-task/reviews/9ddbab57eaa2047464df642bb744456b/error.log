   561	func (p *optionsPanel) save() {
   562		p.persistUI()
   563		if p.session == nil {
   564			p.status = t("tui.environment_not_ready_interface_preferences_saved")
   565			return
   566		}
   567		finishLines, err := p.session.Finish()
   568		finishLines = spaceSaveReport(finishLines)
   569		if err != nil {
   570			p.showReport(t("tui.save_failed"), finishLines, err.Error())
   571			return
   572		}
   573		path, err := p.session.Save()
   574		if err != nil {
   575			p.showReport(t("tui.save_failed"), finishLines, err.Error())
   576			return
   577		}
   578		p.dirty = false
   579		p.app.Context = tuiPageContext()
   580		p.showReport(
   581			t("tui.configuration_saved"),
   582			finishLines,
   583			t("tui.configuration_saved_2")+path,
   584		)
   585		p.form = nil
   586	}
   587	
   588	func (p *optionsPanel) persistUI() {
   589		if p.session == nil {
   590			return
   591		}
   592		// Write the session's scope TUI, not the merged App display values.
   593		written, err := savePrefs(prefsFromConfig(p.session.Config.TUI))
   594		// When the write fails, only the edited value in the session is updated and the baseline is not advanced.
   595		p.session.SyncTUI(written, err == nil)
   596		if err != nil {
   597			p.app.PrefsError = err.Error()
   598			return
   599		}
   600		p.app.PrefsError = ""
   601	}
