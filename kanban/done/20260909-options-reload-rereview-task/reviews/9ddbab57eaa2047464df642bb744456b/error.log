   180	// applyWork consumes the result of a background task; the Bubble Tea shell calls it on a workMsg.
   181	func (a *App) applyWork(payload any) tea.Cmd {
   182		if result, ok := payload.(startPreviewResult); ok {
   183			a.applyStartPreview(result)
   184			return nil
   185		}
   186		if result, ok := payload.(startResult); ok {
   187			a.applyStartResult(result)
   188			return nil
   189		}
   190		if result, ok := payload.(focusResult); ok {
   191			a.focusRunning = false
   192			a.showFocusNotice(result.message)
   193			return nil
   194		}
   195		panel := a.Options
   196		if panel == nil {
   197			return nil
   198		}
   199		switch result := payload.(type) {
   200		case sessionResult:
   201			if result.seq != panel.loadSeq {
   202				return nil
   203			}
   204			if result.err != nil {
   205				panel.loadErr = result.err.Error()
   206				a.Session = nil
   207				panel.session = nil
   208				panel.overlayNotice = ""
   209				return nil
   210			}
   211			a.Session = result.session
   212			panel.session = result.session
   213			panel.loadedTUI = result.session.Config.TUI
   214			panel.appliedTUI = nil
   215			if result.language != "" {
   216				config.BindConfigLanguage(&config.Config{Language: result.language})
   217			} else {
   218				config.BindConfigLanguage(nil)
   219			}
   220			if result.overlayPath != "" {
   221				panel.overlayNotice = t("tui.overlay_notice")
   222			} else {
   223				panel.overlayNotice = ""
   224			}
   225			if panel.initial != "" {
   226				section := panel.initial
   227				panel.initial = ""
   228				return panel.dispatch(section)
   229			}
   230			return panel.openRoot()
   231		case terminalToolsResult:
   232			return panel.beginDoctor(result.tools)
   233		case doctorResult:
   234			panel.status = ""
   235			if panel.session != nil && result.after != nil {
   236				if err := panel.session.ApplyDoctorConfig(result.before, result.after, panel.dirty); err != nil {
   237					result.lines = append(result.lines, menu.ReportLine{Level: menu.LevelWarning, Text: err.Error()})
   238				}
   239			}
   240			panel.showReport(t("tui.environment_check"), append(panel.doctorLines, result.lines...), "")
   241			panel.doctorLines = nil
   242		}
   243		return nil
   244	}
