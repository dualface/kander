   775	
   776	func (b *formBinding) commitLauncher(p *optionsPanel) {
   777		session := p.session
   778		if b.launcher != menu.LauncherInstallValue {
   779			return
   780		}
   781		// Installing tmux occupies the current terminal, so hand the terminal over first and return to the alt-screen afterwards.
   782		p.app.pendingShell = func() {
   783			lines, installed := session.InstallTmux()
   784			menu.FlushReport(lines)
   785			if installed {
   786				session.SetLauncher("tmux")
   787				p.markDirty()
   788			}
   789		}
   790	}
