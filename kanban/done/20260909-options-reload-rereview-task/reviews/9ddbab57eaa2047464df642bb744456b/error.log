   333	// openSection builds the form of one section.
   334	func (p *optionsPanel) openSection(section string) tea.Cmd {
   335		p.current = section
   336		tui := p.scopeTUI()
   337		bind := &formBinding{
   338			theme:     tui.Theme,
   339			columns:   tui.Columns,
   340			minWidth:  tui.MinColumnWidth,
   341			refresh:   tui.Refresh,
   342			single:    tui.Single,
   343			archived:  p.app.Model.ShowArchived,
   344			reviewers: map[string]*string{},
   345			stages:    map[string]*string{},
   346		}
   347		p.bind = bind
   348		var group *huh.Group
   349		switch section {
   350		case sectionInterface:
   351			group = p.interfaceGroup(bind)
   352		case sectionExecution:
   353			group = p.executionGroup(bind)
   354		case sectionReview:
   355			group = p.reviewGroup(bind)
   356		case sectionRules:
   357			group = p.rulesGroup(bind)
   358		default:
   359			return p.openRoot()
   360		}
   361		form := p.newForm(sectionKeyMap(), group)
   362		return p.startForm(form)
   363	}
