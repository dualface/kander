   209				"menu.windows_does_not_support_tmux_using_console",
   210			))
   211		case (cfg.Launcher == "tmux" || cfg.Launcher == "tmux-session") && lookPath("tmux") == "":
   212			cfg.Launcher = "foreground"
   213			warning(config.Text(
   214				"menu.tmux_is_not_installed_using_foreground_the_launcher_menu",
   215			))
   216		// On POSIX auto holds as long as tmux exists, so a missing herdr must not
   217		// rewrite it; on Windows auto can only land on herdr, so a missing herdr does.
   218		case (cfg.Launcher == "herdr" || (cfg.Launcher == "auto" && isWindowsOS())) && lookPath("herdr") == "":
   219			switch {
   220			case isWindowsOS():
   221				cfg.Launcher = "console"
   222			case lookPath("tmux") != "":
   223				cfg.Launcher = "tmux"
   224			default:
   225				cfg.Launcher = "foreground"
   226			}
   227			warning(config.Text(
   228				"menu.herdr_is_not_installed_using", cfg.Launcher,
   229			))
   230		}
   231	}
