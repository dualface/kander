   169	// RefreshCopy re-translates cached agent labels after the UI language changes.
   170	// Sessions built without a probe keep their existing labels.
   171	func (s *Session) RefreshCopy() {
   172		if s == nil || s.agents == nil {
   173			return
   174		}
   175		labels := agentLabels()
   176		for i, choice := range s.exec {
   177			name := choice.Value
   178			label := labels[name]
   179			if label == "" {
   180				label = name
   181			}
   182			state := s.agents[name]
   183			if agentUsable(state) {
   184				s.exec[i].Label = label + " (" + state.Version + ")"
   185				continue
   186			}
   187			s.exec[i].Label = label + config.Text("menu.not_currently_installed")
   188		}
   189		for i, choice := range s.review {
   190			name := choice.Value
   191			label := labels[name]
   192			if label == "" {
   193				label = name
   194			}
   195			if reviewerUsable(s.agents[name]) {
   196				s.review[i].Label = label + " (" + reviewerState(s.agents[name]).Version + ")"
   197			}
   198		}
   199	}
