   239		}
   240		if data == nil {
   241			return "", nil, nil
   242		}
   243		raw, err := decodeJSON(data)
   244		if err != nil {
   245			return "", nil, configErrorfWrap(err, "config.overlay_invalid_json", path, err.Error())
   246		}
   247		obj, ok := raw.(map[string]any)
   248		if !ok {
   249			return "", nil, configErrorf("config.overlay_root_must_be_a_json_object", path)
   250		}
   251		if err := validateOverlayKeys(path, obj); err != nil {
   252			return "", nil, err
   253		}
   254		return path, obj, nil
   255	}
