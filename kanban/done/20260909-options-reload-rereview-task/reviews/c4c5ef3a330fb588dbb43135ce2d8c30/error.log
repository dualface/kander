   201	func (s *Session) normalizeLauncher(cfg *config.Config) {
   202		if s.existing.WelcomeComplete {
   203			return
   204		}
   205		switch {
   206		case isWindowsOS() && (cfg.Launcher == "tmux" || cfg.Launcher == "tmux-session"):
   207			cfg.Launcher = "console"
