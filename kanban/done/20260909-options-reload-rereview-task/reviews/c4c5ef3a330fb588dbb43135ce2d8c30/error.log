   425		raw, err := decodeJSON(encoded)
   426		if err != nil {
   427			t.Fatal(err)
   428		}
   429		obj, ok := raw.(map[string]any)
   430		if !ok {
   431			t.Fatal("scope object")
   432		}
   433		delete(obj, "rules")
   434		overlay := map[string]any{"rules": map[string]any{"git": false}}
   435		if err := ValidateOverlayMerge(obj, overlay); err != nil {
