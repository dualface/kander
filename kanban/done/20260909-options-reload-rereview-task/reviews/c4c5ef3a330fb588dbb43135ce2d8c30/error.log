    14	func TestOpenOptionsReloadsScopeFromDisk(t *testing.T) {
    15		app := newPanelApp(t)
    16		initial := config.DefaultConfig()
    17		initial.WelcomeComplete = true
    18		initial.KanbanAgent = "codex"
    19		stale := newTestSession(t, initial)
    20		stale.Config.KanbanAgent = "claude"
    21		useTestOptionsSession(t)
    22		app.Session = stale
    23		app.openOptions()
    24		finishOptionsLoad(t, app)
    25		if app.Session == stale {
    26			t.Fatal("open reused the in-memory session")
    27		}
    28		if app.Session.Config.KanbanAgent != "codex" {
    29			t.Fatalf("session agent=%s", app.Session.Config.KanbanAgent)
    30		}
    31		app.Options.close()
    32		loaded, err := config.LoadScope(true)
    33		if err != nil {
    34			t.Fatal(err)
    35		}
    36		loaded.KanbanAgent = "grok"
    37		if _, err := config.Save(loaded); err != nil {
    38			t.Fatal(err)
    39		}
    40		app.openOptions()
    41		finishOptionsLoad(t, app)
    42		if app.Session.Config.KanbanAgent != "grok" {
    43			t.Fatalf("reopen agent=%s", app.Session.Config.KanbanAgent)
    44		}
    45	}
