   186	// ValidateOverlayMerge validates overlay against the unmerged scope object using
   187	// the same raw merge as Load. It must not serialize a default-filled Config.
   188	func ValidateOverlayMerge(scopeRaw map[string]any, overlay map[string]any) error {
   189		if overlay == nil {
   190			return nil
   191		}
   192		if scopeRaw == nil {
   193			return configErrorf("config.config_root_must_be_a_json_object")
   194		}
   195		merged, err := mergeOverlayRaw(cloneRawObjectDeep(scopeRaw), overlay)
   196		if err != nil {
   197			return err
   198		}
   199		_, err = Validate(merged)
   200		return err
   201	}
   202	
   203	// ApplyOverlay returns the validated config of scope with overlay merged on top.
   204	// A nil overlay leaves the scope values unchanged.
   205	func ApplyOverlay(scope *Config, overlay map[string]any) (*Config, error) {
   206		if scope == nil {
   207			return nil, configErrorf("config.config_root_must_be_a_json_object")
   208		}
   209		if overlay == nil {
   210			return Clone(scope), nil
   211		}
   212		encoded, err := json.Marshal(scope)
   213		if err != nil {
   214			return nil, configErrorfWrap(err, "config.failed_to_read_config_2", err.Error())
   215		}
   216		raw, err := decodeJSON(encoded)
   217		if err != nil {
   218			return nil, err
   219		}
   220		obj, ok := raw.(map[string]any)
   221		if !ok {
   222			return nil, configErrorf("config.config_root_must_be_a_json_object")
   223		}
   224		merged, err := mergeOverlayRaw(obj, overlay)
   225		if err != nil {
   226			return nil, err
   227		}
   228		return Validate(merged)
   229	}
