+		t.Fatal(err)
+	}
+	obj, ok := raw.(map[string]any)
+	if !ok {
+		t.Fatal("scope object")
+	}
+	delete(obj, "rules")
+	overlay := map[string]any{"rules": map[string]any{"git": false}}
