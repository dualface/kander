   268	// spaceSaveReport splits the agent wiring results and the closing notes into readable paragraphs.
   269	func spaceSaveReport(lines []menu.ReportLine) []menu.ReportLine {
   270		out := make([]menu.ReportLine, 0, len(lines)+2)
   271		for index, line := range lines {
   272			if index > 0 && (line.Level == menu.LevelOK || line.Level == menu.LevelWarning ||
   273				(line.Level == menu.LevelNote && lines[index-1].Level != menu.LevelNote)) {
   274				out = append(out, menu.ReportLine{})
   275			}
   276			out = append(out, line)
   277		}
   278		return out
   279	}
