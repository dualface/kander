   258	
   259	// spaceSaveReport splits the agent wiring results and the closing notes into readable paragraphs.
   260	func spaceSaveReport(lines []menu.ReportLine) []menu.ReportLine {
   261		out := make([]menu.ReportLine, 0, len(lines)+2)
   262		for index, line := range lines {
   263			if index > 0 && (line.Level == menu.LevelOK || line.Level == menu.LevelWarning ||
   264				(line.Level == menu.LevelNote && lines[index-1].Level != menu.LevelNote)) {
   265				out = append(out, menu.ReportLine{})
   266			}
   267			out = append(out, line)
   268		}
   269		return out
   270	}
   271	
   272	// build wraps and colors the lines at the given width and returns the actual line count.
   273	func (r *reportView) build(palette palette, width int) int {
   274		var body []string
   275		if r.extra != "" {
   276			for _, text := range wrapText(r.extra, width) {
   277				body = append(body, styleFor("popup-ok", palette).Render(text))
   278			}
   279			if len(r.lines) > 0 {
   280				body = append(body, "")
   281			}
   282		}
   283		for _, line := range r.lines {
   284			style := styleFor(reportTag(line.Level), palette)
   285			for _, raw := range strings.Split(line.Text, "\n") {
   286				for _, text := range wrapText(raw, width) {
   287					body = append(body, style.Render(text))
   288				}
   289			}
   290		}
   291		if len(body) == 0 {
   292			body = append(body, styleFor("popup-dim", palette).Render(t("tui.no_output")))
   293		}
   294		r.view.SetContent(strings.Join(body, "\n"))
   295		r.width = width
   296		return len(body)
   297	}
   298	
   299	func reportTag(level string) string {
   300		switch level {
   301		case menu.LevelWarning:
   302			return "popup-warn"
   303		case menu.LevelOK:
   304			return "popup-ok"
   305		case menu.LevelNote:
   306			return "popup-title"
   307		}
   308		return "popup"
   309	}
