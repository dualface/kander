   203	func withConfigLock(path string, fn func() error) error {
   204		abs, err := lexicalAbsolute(path)
   205		if err != nil {
   206			return err
   207		}
   208		anchor, err := volumeAnchor(abs)
   209		if err != nil {
   210			return err
   211		}
   212		if err := fs.EnsureInheritedDirectoryPath(filepath.Dir(abs)); err != nil {
   213			return wrapSaveError(path, err)
   214		}
   215		lockFile, err := fs.OpenAppendFile(anchor, abs+".lock")
   216		if err != nil {
   217			return wrapSaveError(path, err)
   218		}
   219		lock, err := fs.LockExclusive(lockFile.File)
   220		if err != nil {
   221			_ = lockFile.Close()
   222			return wrapSaveError(path, err)
   223		}
   224		operationErr := fn()
   225		unlockErr := lock.Unlock()
   226		closeErr := lockFile.Close()
   227		if operationErr != nil {
   228			return operationErr
   229		}
   230		if unlockErr != nil {
   170		main, err := gitMainWorktree(start)
   171		if err != nil {
   172			return "", err
   173		}
   174		if main != "" {
   175			return inspectOverlayCandidate(filepath.Join(main, OverlayFilename))
   176		}
   177		return walkOverlay(start)
   178	}
