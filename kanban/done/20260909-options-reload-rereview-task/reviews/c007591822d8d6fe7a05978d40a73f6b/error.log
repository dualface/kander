+func runOptionsLoad(t *testing.T, app *App) {
+	t.Helper()
+	if app.pendingWork == nil {
+		t.Fatal("openOptions should reload from disk")
+	}
+	work := app.pendingWork
+	app.pendingWork = nil
+	cmd := app.applyWork(work())
+	if app.Options == nil {
