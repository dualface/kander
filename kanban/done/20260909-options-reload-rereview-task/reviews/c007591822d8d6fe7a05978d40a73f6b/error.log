   460	func minColumnWidthChoices(current int) []int {
   461		out := make([]int, 0, (maxMinColumnWidth-minMinColumnWidth)/minColumnWidthStep+2)
   462		seen := map[int]bool{}
   463		current = clampMinColumnWidth(current)
   464		for width := minMinColumnWidth; width <= maxMinColumnWidth; width += minColumnWidthStep {
   465			out = append(out, width)
   466			seen[width] = true
   467		}
   468		if !seen[current] {
   469			out = append([]int{current}, out...)
   470		}
   471		return out
   472	}
