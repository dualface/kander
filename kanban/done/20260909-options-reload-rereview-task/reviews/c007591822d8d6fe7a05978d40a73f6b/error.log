   186	// ApplyOverlay returns the validated config of scope with overlay merged on top.
   187	// A nil overlay leaves the scope values unchanged.
   188	func ApplyOverlay(scope *Config, overlay map[string]any) (*Config, error) {
   189		if scope == nil {
   190			return nil, configErrorf("config.config_root_must_be_a_json_object")
   191		}
   192		if overlay == nil {
   193			return Clone(scope), nil
   194		}
   195		encoded, err := json.Marshal(scope)
   196		if err != nil {
   197			return nil, configErrorfWrap(err, "config.failed_to_read_config_2", err.Error())
   198		}
   199		raw, err := decodeJSON(encoded)
   200		if err != nil {
   201			return nil, err
   202		}
   203		obj, ok := raw.(map[string]any)
   204		if !ok {
   205			return nil, configErrorf("config.config_root_must_be_a_json_object")
   206		}
   207		merged, err := mergeOverlayRaw(obj, overlay)
   208		if err != nil {
   209			return nil, err
   210		}
   211		return Validate(merged)
   212	}
