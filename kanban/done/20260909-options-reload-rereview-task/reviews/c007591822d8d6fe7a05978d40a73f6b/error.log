   365	// rebuildAt requests a rebuild of the current section after this update, with focus landing back on the selector named by key.
   366	// When the execution agent or the reviewer changes, the model fields on the same screen belong to a different object and must be rebuilt.
   367	func (p *optionsPanel) rebuildAt(key string) {
   368		p.rebuildFocus = key
   369	}
   370	
   371	// rebuildSection rebuilds the current section and moves focus back to the original field.
   372	// The focus move is left to Bubble Tea to run asynchronously; the form commands must not run synchronously here,
   373	// because the blink chain of a text input contains a tea.Tick that would block for over half a second.
   374	func (p *optionsPanel) rebuildSection() tea.Cmd {
   375		key := p.rebuildFocus
   376		p.rebuildFocus = ""
   377		section := p.current
   378		if section == "" {
   379			return nil
   380		}
   381		cmd := p.openSection(section)
   382		// openSection rebuilt bind, so only now is it known which position that selector holds in the new form.
   383		index := 0
   384		if p.bind != nil {
   385			index = p.bind.fieldIndex[key]
   386		}
   387		return tea.Batch(cmd, repeatCmd(index, huh.NextField))
   388	}
