   464	func (s *Session) finish() error {
   465		if err := config.ValidateRules(s.Config.Rules); err != nil {
   466			return err
   467		}
   468		labels := agentLabels()
   469		paths, err := currentPaths()
   470		if err != nil {
   471			return err
   472		}
   473		entry := rulesEntry(paths)
   474		seen := map[string]struct{}{}
   475		for _, selected := range config.ExecutionAgentsInUse(s.Config) {
   476			target := install.AgentRulesTarget(selected, paths)
   477			if _, ok := seen[target]; ok && target != "" {
   478				continue
   479			}
   480			seen[target] = struct{}{}
   481			outcome, ensureErr := install.EnsureRulesIntegration(selected, paths)
   482			if ensureErr != nil {
   483				warning(config.Text("menu.is_not_connected_to_kander_rules", labels[selected], ensureErr.Error()))
   484				hint(config.Text(
   485					"menu.follow_the_readme_integration_section_and_point_the_rules", entry,
   486				))
   487				continue
   488			}
   489			if outcome.Status == install.IntegrationPresent {
   490				success(config.Text("menu.is_connected_to_kander_rules", labels[selected], outcome.Target))
   491			} else {
   492				success(config.Text("menu.added_kander_rules_reference", labels[selected], outcome.Target))
   493			}
   494		}
   495		note(config.Text(
   496			"menu.note_kanban_start_uses_the_agent_s_no_confirmation",
   497		))
   498		note(RulesSessionNotice())
   499		s.Config.WelcomeComplete = true
   500		return nil
   501	}
