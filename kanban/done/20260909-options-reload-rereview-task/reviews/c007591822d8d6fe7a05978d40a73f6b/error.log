   111	
   112	func (p program) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
   113		switch event := msg.(type) {
   114		case tea.WindowSizeMsg:
   115			oldWidth, oldHeight := p.app.Width, p.app.Height
   116			p.app.Width, p.app.Height = event.Width, event.Height
   117			p.app.clampDetailCursor()
   118			if p.app.Options != nil && (oldWidth != event.Width || oldHeight != event.Height) {
   119				return p, p.app.Options.resizeForm()
   120			}
   121			return p, nil
   122		case tickMsg:
   123			if p.app.Now().Sub(p.app.LastRefresh) >= time.Duration(p.app.RefreshSecs)*time.Second {
   124				p.app.refreshBoard()
   125			}
   126			return p, tickCmd()
   127		case shellDoneMsg:
   128			return p, p.app.takePending()
   129		case workMsg:
   130			cmd := p.app.applyWork(event.payload)
   131			if !p.app.Running {
   132				return p, tea.Quit
   133			}
   134			return p, tea.Batch(cmd, p.app.takePending())
   135		}
   136		cmd := p.app.Update(msg)
   137		if !p.app.Running {
   138			return p, tea.Quit
   139		}
   140		return p, tea.Batch(cmd, p.app.takePending())
   141	}
