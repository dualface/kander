    72		candidates := []string{name}
    73		if isWindowsOS() {
    74			candidates = []string{name + ".exe", name}
    75		}
    76		for _, candidate := range candidates {
    77			path := filepath.Join(binDir, candidate)
    78			if fileExists(path) {
    79				return path
    80			}
    81		}
    82		return ""
    83	}
