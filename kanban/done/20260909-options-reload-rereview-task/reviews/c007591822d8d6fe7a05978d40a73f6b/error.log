   147	// takePending takes the terminal handover requests and background tasks App has queued, returning nil when there are none.
   148	func (a *App) takePending() tea.Cmd {
   149		var cmds []tea.Cmd
   150		if a.pendingShell != nil {
   151			run := a.pendingShell
   152			a.pendingShell = nil
   153			cmds = append(cmds, tea.Exec(&shellOut{run: run}, func(error) tea.Msg { return shellDoneMsg{} }))
   154		}
   155		if a.pendingWork != nil {
   156			work := a.pendingWork
   157			a.pendingWork = nil
   158			cmds = append(cmds, func() tea.Msg { return workMsg{payload: work()} })
   159		}
   160		if len(cmds) == 0 {
   161			return nil
   162		}
   163		return tea.Batch(cmds...)
   164	}
