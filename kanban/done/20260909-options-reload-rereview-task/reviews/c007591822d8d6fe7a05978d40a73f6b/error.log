   100	func agentVersion(program *process.AgentProgram) string {
   101		if program == nil {
   102			return versionFailedText()
   103		}
   104		inv, err := process.NewProcessInvocation(*program, []string{"--version"}, nil)
   105		if err != nil {
   106			return versionFailedText()
   107		}
   108		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
   109		defer cancel()
   110		var env []string
   111		if inv.Env != nil {
   112			for k, v := range inv.Env {
   113				env = append(env, k+"="+v)
   114			}
   115		}
   116		result, err := probe.CaptureWithEnv(ctx, inv.Argv[0], inv.Argv[1:], env)
   117		if err != nil || result.Code != 0 {
   118			return versionFailedText()
   119		}
   120		out := result.Stdout + result.Stderr
   121		lines := strings.Split(strings.TrimSpace(string(out)), "\n")
   122		if len(lines) == 0 || lines[0] == "" {
   123			return versionFailedText()
   124		}
   125		return lines[0]
   126	}
   127	
   128	func agentUsable(state agentState) bool {
   129		failed := versionFailedText()
   130		return state.Path != "" && state.Version != "" && state.Version != failed
   131	}
   132	
   133	func findAgents(configs ...*config.Config) map[string]agentState {
   134		var cfg *config.Config
   135		if len(configs) > 0 {
   136			cfg = configs[0]
   137		}
   138		agents := map[string]agentState{}
   139		reviewSet := map[string]struct{}{}
   140		for _, name := range config.ReviewAgents {
   141			reviewSet[name] = struct{}{}
   142		}
   143		for _, name := range config.AgentNames(cfg) {
   144			executable := config.AgentPath(cfg, name)
   145			program := process.ResolveAgentProgram(executable)
   146			state := agentState{
   147				Execution: true,
   148				Review:    false,
   149			}
   150			if _, ok := reviewSet[name]; ok {
   151				state.Review = true
   152			}
   153			if program != nil {
   154				state.Path = program.Path
   155				state.Version = agentVersion(program)
   156				state.Batch = program.Batch
   157			}
   158			if state.Review {
   159				reviewPath := config.AgentExecutableName(name)
   160				if override := os.Getenv(strings.ToUpper(name) + "_REVIEW_BIN"); override != "" {
   161					reviewPath = override
   162				}
   163				if reviewPath != executable {
   164					reviewer := agentState{Review: true}
   165					if program := process.ResolveAgentProgram(reviewPath); program != nil {
   166						reviewer.Path = program.Path
   167						reviewer.Version = agentVersion(program)
   168						reviewer.Batch = program.Batch
   169					}
   170					state.reviewer = &reviewer
   171				}
   172			}
   173			agents[name] = state
   174		}
   175		return agents
   176	}
