   243		}
   244		overlayCopy := cloneRawObjectDeep(overlay)
   245		if err := normalizeReviewStagesField(overlayCopy); err != nil {
   246			return nil, err
   247		}
   248		return deepMerge(scope, overlayCopy), nil
