    88			if isWindowsOS() && name == "kander" {
    89				expected = filepath.Join(paths.BinDir, name+".exe")
    90			}
    91			return config.Text(
    92				"menu.is_not_in_the_project_command_root", name, expected,
    93			)
    94		}
    95		return config.Text(
    96			"menu.is_not_in_path_add_local_bin_to_path", name,
    97		)
    98	}
