    58	// scalars and arrays replace wholesale.
    59	func deepMerge(base, overlay map[string]any) map[string]any {
    60		out := cloneRawObjectDeep(base)
    61		for key, value := range overlay {
    62			if overlayObj, ok := value.(map[string]any); ok {
    63				if baseObj, ok := out[key].(map[string]any); ok {
    64					out[key] = deepMerge(baseObj, overlayObj)
    65					continue
    66				}
    67			}
    68			out[key] = cloneRawValue(value)
    69		}
    70		return out
    71	}
