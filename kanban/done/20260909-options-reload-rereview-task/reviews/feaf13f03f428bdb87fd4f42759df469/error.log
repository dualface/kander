    16	func printConfig(cfg *config.Config) error {
    17		lines, err := config.FormatConfigLines(cfg)
    18		if err != nil {
    19			return err
    20		}
    21		for _, line := range lines {
    22			fmt.Println(line)
    23		}
    24		return nil
    25	}
    26	
    27	var errHelp = errors.New("help")
    28	
    29	func parseConfigArgs(args []string) (jsonOut bool, err error) {
    30		for _, arg := range args {
    31			switch arg {
    32			case "--json":
    33				jsonOut = true
    34			case "-h", "--help":
    35				fmt.Println(config.Text("menu.usage_kander_config_json"))
    36				return false, errHelp
    37			default:
    38				return false, errors.New(config.Text("board.unknown_option", arg))
    39			}
    40		}
    41		return jsonOut, nil
    42	}
    43	
    44	// Doctor implements kander doctor.
    45	func Doctor(args []string) int {
    46		prepareLanguage()
    47		for _, arg := range args {
    48			if arg == "-h" || arg == "--help" {
    49				fmt.Println(config.Text("menu.usage_kander_doctor"))
    50				return 0
    51			}
    52			fmt.Fprintln(os.Stderr, "kander:", config.Text("board.unknown_option", arg))
    53			return 2
    54		}
    55		if printDoctorWithTools(offerHerdrInstall(CheckTerminalTools()), true) {
    56			return 0
    57		}
    58		return 1
    59	}
    60	
    61	// Config implements kander config [--json].
    62	func Config(args []string) int {
    63		prepareLanguage()
    64		jsonOut, err := parseConfigArgs(args)
    65		if err != nil {
    66			if errors.Is(err, errHelp) {
    67				return 0
    68			}
    69			fmt.Fprintln(os.Stderr, "kander:", err)
    70			return 2
    71		}
    72		cfg, err := config.Load(false)
    73		if err != nil {
    74			fmt.Fprintln(os.Stderr, "kander:", err)
    75			return 1
    76		}
    77		if jsonOut {
    78			for _, warning := range config.AgentWarnings(cfg) {
    79				fmt.Fprintln(os.Stderr, warning)
    80			}
    81			payload, err := json.MarshalIndent(cfg, "", "  ")
    82			if err != nil {
    83				fmt.Fprintln(os.Stderr, "kander:", err)
    84				return 1
    85			}
    86			fmt.Println(string(payload))
    87			return 0
    88		}
    89		if err := printConfig(cfg); err != nil {
    90			fmt.Fprintln(os.Stderr, "kander:", err)
    91			return 1
    92		}
    93		return 0
    94	}
