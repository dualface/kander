   249	// LauncherInstallValue is the value of the "install tmux" item in the launcher list.
   250	const LauncherInstallValue = "install-tmux"
   251	
   252	// LauncherChoices returns the launchers available on the current platform, plus the install item when tmux is missing.
   253	func (s *Session) LauncherChoices() []Choice {
   254		if isWindowsOS() {
   255			return windowsLauncherChoices(s.Config)
   256		}
   257		foreground := Choice{Value: "foreground", Label: config.Text("menu.foreground_in_this_terminal")}
   258		choices := []Choice{autoLauncherChoice()}
   259		if lookPath("tmux") != "" {
   260			choices = append(choices, tmuxLauncherChoices()...)
   261			choices = append(choices, herdrLauncherChoices(s.Config)...)
   262			return append(choices, foreground)
   263		}
   264		unavailable := config.Text("menu.not_currently_installed")
   265		for _, item := range tmuxLauncherChoices() {
   266			if s.Config.Launcher == item.Value {
   267				choices = append(choices, Choice{Value: item.Value, Label: item.Label + unavailable})
   268			}
   269		}
   270		choices = append(choices, herdrLauncherChoices(s.Config)...)
   271		return append(choices, foreground, Choice{
   272			Value: LauncherInstallValue,
   273			Label: config.Text("menu.install_tmux_and_use_a_new_window"),
   274		})
   275	}
