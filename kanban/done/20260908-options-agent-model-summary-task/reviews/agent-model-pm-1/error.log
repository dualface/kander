     8	func (p *optionsPanel) openFlow() {
     9		if p.session == nil {
    10			return
    11		}
    12		var lines []menu.ReportLine
    13		for _, line := range flow.Build(p.session.Config) {
    14			if line.Kind == flow.Assignment && line.Args[len(line.Args)-1] == "" {
    15				line.Args[len(line.Args)-1] = t("flow.cli_default")
    16			}
    17			text := t(line.Key, line.Args...)
    18			level := menu.LevelInfo
    19			if line.Kind == flow.Heading {
    20				if len(lines) > 0 {
    21					lines = append(lines, menu.ReportLine{})
    22				}
    23				level = menu.LevelNote
    24			} else {
    25				text = "  " + text
    26			}
    27			lines = append(lines, menu.ReportLine{Level: level, Text: text})
    28		}
    29		title := t("flow.title")
    30		if p.dirty {
    31			title += t("tui.unsaved")
    32		}
    33		p.showReport(title, lines, "")
    34		p.form = nil
    35	}
