    11	func TestEffectiveAssignments(t *testing.T) {
    12		cfg := config.DefaultConfig()
    13		cfg.KanbanAgents["large"], cfg.KanbanAgents["small"] = "claude", "codex"
    14		cfg.Models.Kanban["claude"] = map[string]string{"large_model": "large-model", "model": "legacy-large"}
    15		cfg.Models.Kanban["codex"] = map[string]string{"model": "legacy-small"}
    16		cfg.Reviewers["PM"], cfg.Reviewers["QA"] = "claude", "codex"
    17		cfg.Models.ReviewRoles["PM"] = map[string]string{"model": "pm-model"}
    18		cfg.Models.ReviewRoles["QA"] = map[string]string{}
    19		cfg.Models.Review["codex"] = map[string]string{"model": "qa-fallback"}
    20		cfg.ReviewStages = map[string]string{"PM": "required", "QA": "auto", "CSA": "skip", "Hacker": "skip"}
    21		before := config.Clone(cfg)
    22		want := []Line{
    23			{Kind: Heading, Key: "flow.execution"},
    24			{Kind: Assignment, Key: "flow.large", Args: []any{"claude", "large-model"}},
    25			{Kind: Assignment, Key: "flow.small", Args: []any{"codex", "legacy-small"}},
    26			{Kind: Heading, Key: "flow.review"},
    27			{Kind: Note, Key: "flow.stage_one"},
    28			{Kind: Assignment, Key: "flow.role_required", Args: []any{"PM", "claude", "pm-model"}},
    29			{Kind: Assignment, Key: "flow.role_auto", Args: []any{"QA", "codex", "qa-fallback"}},
    30		}
    31		if got := Build(cfg); !reflect.DeepEqual(got, want) {
    32			t.Fatalf("assignments = %+v, want %+v", got, want)
    33		}
    34		if !reflect.DeepEqual(cfg, before) {
    35			t.Fatal("summary mutated configuration")
    36		}
    37		cfg.KanbanAgents["small"] = "claude"
    38		cfg.Models.Kanban["claude"]["small_model"] = "edited-model"
    39		if got := Build(cfg)[2].Args; !reflect.DeepEqual(got, []any{"claude", "edited-model"}) {
    40			t.Fatalf("summary missed current configuration: %v", got)
    41		}
    42	}
