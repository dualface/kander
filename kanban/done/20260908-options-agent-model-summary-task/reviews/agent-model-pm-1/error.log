   548	// NewSessionForTest builds a session that skips environment probing; it is for tests only.
   549	// The candidate agents are simply every value the schema allows, and no agent executable is invoked.
   550	func NewSessionForTest(existing *config.Config) (*Session, error) {
   551		session := &Session{existing: existing}
   552		labels := agentLabels()
   553		for _, name := range config.AgentNames(existing) {
   554			session.exec = append(session.exec, Choice{Value: name, Label: labels[name]})
   555		}
   556		for _, name := range config.ReviewAgents {
   557			session.review = append(session.review, Choice{Value: name, Label: labels[name]})
   558		}
   559		cfg := config.DefaultConfig()
   560		cfg.Agents = config.CloneAgents(existing.Agents)
   561		cfg.Models = copyModels(existing.Models)
   562		cfg.KanbanAgent = existing.KanbanAgent
   563		cfg.KanbanAgents = cloneStrings(existing.KanbanAgents)
   564		cfg.Reviewers = cloneStrings(existing.Reviewers)
   565		cfg.ReviewStages = cloneStrings(existing.ReviewStages)
   566		cfg.Rules = existing.Rules.Clone()
   567		cfg.Launcher = existing.Launcher
   568		cfg.TUI = existing.TUI
   569		cfg.Language = existing.Language
   570		cfg.AgentLanguage = existing.AgentLanguage
   571		session.Config = cfg
   572		return session, nil
   573	}
   574	
   575	func cloneStrings(src map[string]string) map[string]string {
   576		out := make(map[string]string, len(src))
   577		for k, v := range src {
   578			out[k] = v
   579		}
   580		return out
   581	}

