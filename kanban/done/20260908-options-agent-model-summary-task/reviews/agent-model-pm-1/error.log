    79				for _, msg := range []tea.Msg{tea.KeyMsg{Type: tea.KeyDown}, tea.KeyMsg{Type: tea.KeyPgDown}} {
    80					old := panel.report.view.YOffset
    81					panel.Update(msg)
    82					if panel.report.view.YOffset <= old {
    83						t.Fatal("keyboard must scroll report")
    84					}
    85				}
    86				old := panel.report.view.YOffset
    87				panel.Update(tea.KeyMsg{Type: tea.KeyPgUp})
    88				if panel.report.view.YOffset >= old {
    89					t.Fatal("PgUp must scroll upward")
    90				}
    91				old = panel.report.view.YOffset
    92				panel.Update(tea.MouseMsg{Button: tea.MouseButtonWheelDown})
    93				if panel.report.view.YOffset <= old {
    94					t.Fatal("wheel must scroll report")
    95				}
    96				// Inspect every wrapped line, including text below the first viewport.
    97				panel.report.view.Height = panel.report.view.TotalLineCount()
    98				panel.report.view.GotoTop()
    99				text := ansi.Strip(panel.report.view.View())
   100				for _, line := range strings.Split(text, "\n") {
   101					if !utf8.ValidString(line) || ansi.StringWidth(line) > 60 {
   102						t.Fatalf("broken wrapped line: %q", line)
   103					}
   104				}
   105				if !strings.Contains(text, i18n.Text(lang, "flow.execution")) || !strings.Contains(text, i18n.Text(lang, "flow.review")) {
   106					t.Fatal("missing localized execution or review section")
   107				}
   108			})
   109		}
   110	}
   111	
   112	func TestFlowShowsUnsavedModelsAndCLIDefault(t *testing.T) {
   113		_, panel := openPanel(t)
   114		panel.session.Config.Models.Kanban["codex"]["large_model"] = "unsaved-large"
