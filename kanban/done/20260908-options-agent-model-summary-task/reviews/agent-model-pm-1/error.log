   240	// Update is the input entry point of the panel: the report first, then the current Huh form.
   241	func (p *optionsPanel) Update(msg tea.Msg) tea.Cmd {
   242		if tick, ok := msg.(spinner.TickMsg); ok {
   243			if p.form != nil || p.loadErr != "" {
   244				return nil
   245			}
   246			var cmd tea.Cmd
   247			p.spinner, cmd = p.spinner.Update(tick)
   248			return cmd
   249		}
   250		if p.report != nil {
   251			return p.updateReport(msg)
   252		}
   253		if event, ok := msg.(tea.KeyMsg); ok && p.form != nil && !p.acceptsText() {
   254			switch mapKey(event) {
   255			case "q", "Q", "o", "O":
   256				// Consistent with the rest of the board: q closes, and pressing o again closes too.
   257				return p.requestClose()
   258			}
   259		}
   260		if p.form == nil {
   261			if key, ok := msg.(tea.KeyMsg); ok {
   262				switch mapKey(key) {
   263				case "esc", "q", "Q":
   264					p.close()
   265				}
   266			}
   267			return nil
   268		}
   269		return p.updateForm(msg)
   270	}
