   379			return tea.Batch(cmd, p.rebuildSection())
   380		}
   381		switch p.form.State {
   382		case huh.StateCompleted:
   383			if p.confirming {
   384				return p.finishCloseConfirm()
   385			}
   386			return tea.Batch(cmd, p.finishSection())
   387		case huh.StateAborted:
   388			if p.confirming {
   389				p.confirming = false
   390				return p.openRoot()
   391			}
   392			return p.abortSection()
   393		}
   394		return cmd
   395	}
   396	
   397	func (p *optionsPanel) finishCloseConfirm() tea.Cmd {
   398		p.confirming = false
   399		switch p.closeChoice {
   400		case closeSave:
   401			p.save()
   402			return nil
   403		case closeDiscard:
   404			p.close()
   405			return nil
   406		}
   407		return p.openRoot()
   408	}
   409	
   410	// finishSection runs the side effects and returns to the root menu once a section form is confirmed.
   411	// Ordinary values were already written back in apply; interface / task execution / review / rules reach disk on submit,
   412	// so there is no need to return to the root menu and pick "save and apply".
   413	func (p *optionsPanel) finishSection() tea.Cmd {
   414		if p.current == sectionDoctor {
   415			return p.finishHerdrInstall()
   416		}
   417		if p.current == "" {
   418			return p.dispatch(p.section)
   419		}
   420		if p.bind != nil {
   421			p.bind.commitSideEffects(p)
   422		}
   423		if p.savesOnSubmit() {
   424			if err := p.persistNow(); err != nil {
   425				p.showReport(t("tui.save_failed"), nil, err.Error())
   426				return nil
   427			}
   428		}
   429		p.current = ""
   430		return p.openRoot()
   431	}
   432	
   433	func (p *optionsPanel) savesOnSubmit() bool {
   434		return p.current == sectionInterface || p.current == sectionExecution || p.current == sectionReview || p.current == sectionRules
   435	}
   436	
   437	// persistNow writes the current session to the config file, UI preferences included.
   438	func (p *optionsPanel) persistNow() error {
   439		p.persistUI()
   440		if p.session == nil {
   441			return nil
   442		}
   443		p.session.Config.WelcomeComplete = true
   444		if _, err := p.session.Save(); err != nil {
   445			return err
   446		}
   447		p.dirty = false
   448		return nil
   449	}
   450	
   451	// abortSection handles Esc: a section returns to the root menu, the root menu closes the panel.
   452	// Changed values are kept (apply wrote them back long ago); only side effects that need confirmation are skipped.
   453	func (p *optionsPanel) abortSection() tea.Cmd {
   454		if p.current == sectionDoctor {
   455			p.installHerdr = false
   456			return p.finishHerdrInstall()
   457		}
   458		if p.current == "" {
   459			p.close()
   460			return nil
   461		}
   462		p.current = ""
   463		return p.openRoot()
   464	}
   465	
   466	func (p *optionsPanel) dispatch(section string) tea.Cmd {
   467		switch section {
   468		case sectionSave:
   469			p.save()
   470			return nil
   471		case sectionClose:
   472			p.close()
   473			return nil
   474		case sectionFlow:
   475			p.openFlow()
   476			return nil
   477		case sectionDoctor:
   478			p.status = t("tui.running_environment_check")
   479			p.app.pendingWork = func() any {
   480				return terminalToolsResult{tools: menu.CheckTerminalTools()}
   481			}
   482			p.form = nil
   483			return nil
   484		case "":
   485			return p.openRoot()
   486		}
   487		return p.openSection(section)
   488	}
   489	
   490	func (p *optionsPanel) save() {
   491		p.persistUI()
   492		if p.session == nil {
   493			p.status = t("tui.environment_not_ready_interface_preferences_saved")
   494			return
   495		}
   496		finishLines, err := p.session.Finish()
   497		finishLines = spaceSaveReport(finishLines)
   498		if err != nil {
   499			p.showReport(t("tui.save_failed"), finishLines, err.Error())
   500			return
   501		}
   502		path, err := p.session.Save()
   503		if err != nil {
   504			p.showReport(t("tui.save_failed"), finishLines, err.Error())
   505			return
   506		}
   507		p.dirty = false
   508		p.app.Context = tuiPageContext()
   509		p.showReport(
   510			t("tui.configuration_saved"),
   511			finishLines,
   512			t("tui.configuration_saved_2")+path,
   513		)
   514		p.form = nil
   515	}
   516	
   517	func (p *optionsPanel) persistUI() {
   518		prefs := uiPrefs{
   519			Columns:        p.app.Columns,
   520			MinColumnWidth: p.app.MinColumnWidth,
   521			Theme:          p.app.Theme,
   522			Refresh:        p.app.RefreshSecs,
   523			Single:         p.app.Model.Single,
   524		}
   525		written, err := savePrefs(prefs)
   526		// When the write fails, only the edited value in the session is updated and the baseline is not advanced.
   527		p.session.SyncTUI(written, err == nil)
   528		if err != nil {
   529			p.app.PrefsError = err.Error()
   530			return
   531		}
   532		p.app.PrefsError = ""
   533	}
     1	package tui
     2	
     3	import (
     4		"strings"
     5	
     6		tea "github.com/charmbracelet/bubbletea"
     7		"github.com/charmbracelet/huh"
     8		"github.com/charmbracelet/lipgloss"
     9		"github.com/charmbracelet/x/ansi"
    10	
    11		"github.com/dualface/kander/internal/version"
    12	)
    13	
    14	// innerWidth is the number of writable columns inside the popup border; rendering and measuring must use the same value.
    15	func (p *optionsPanel) innerWidth() int {
    16		_, screenWidth := p.app.size()
    17		boxWidth := screenWidth - 8
    18		if boxWidth > popupMaxWidth {
    19			boxWidth = popupMaxWidth
    20		}
    21		if boxWidth < popupMinWidth {
    22			boxWidth = popupMinWidth
    23		}
    24		if boxWidth > screenWidth {
    25			boxWidth = screenWidth
    26		}
    27		inner := boxWidth - 4
    28		if inner < 1 {
    29			inner = 1
    30		}
    31		return inner
    32	}
    33	
    34	// startForm installs a new form: Init first draws the fields into the viewport, then the natural height is measured.
    35	// Measuring too early finds an empty viewport, dropping the trailing blanks yields 1, and the following WithHeight(1) cuts the whole page away.
    36	func (p *optionsPanel) startForm(form *huh.Form) tea.Cmd {
    37		p.form = form
    38		cmd := form.Init()
    39		p.measureForm()
    40		return cmd
    41	}
    42	
    43	// measureForm records the natural height of the form. Huh's WithHeight pads the form up to the given height,
    44	// so it has to be measured once before the height is set, for the popup to hug its content afterwards.
    45	// NewGroup inflates the viewport with Charm's default style before the theme is applied, so View() carries trailing blanks;
    46	// they are dropped while measuring, otherwise a field-heavy page such as review would keep a large empty tail.
    47	func (p *optionsPanel) measureForm() {
    48		if p.form == nil {
    49			return
    50		}
    51		p.formWidth = p.innerWidth()
    52		p.syncFormTheme(themePalette(p.app.Theme))
    53		p.form.WithWidth(p.formWidth)
    54		p.formNatural = contentHeight(p.form.View())
    55	}
    56	
    57	func contentHeight(view string) int {
    58		n := len(trimTrailingBlank(strings.Split(view, "\n")))
    59		if n < 1 {
    60			return 1
    61		}
    62		return n
    63	}
    64	
    65	func optionsHeader(left string, width int) string {
    66		right := clipText(version.String(), width)
    67		rightWidth := displayWidth(right)
    68		if rightWidth >= width {
    69			return padLine(right, width)
    70		}
    71		left = clipText(left, width-rightWidth-1)
    72		gap := width - displayWidth(left) - rightWidth
    73		return left + strings.Repeat(" ", gap) + right
    74	}
    75	
    76	// view renders the popup and records its geometry for mouse hit testing.
    77	// The body is rendered against the available space first, then the border is tightened to the body's actual height to avoid large blank areas.
    78	func (p *optionsPanel) view() (popupBox, string) {
    79		palette := themePalette(p.app.Theme)
    80		screenHeight, screenWidth := p.app.size()
    81	
    82		inner := p.innerWidth()
    83		boxWidth := inner + 4
    84		// The title line, the separator and the top and bottom borders.
    85		chrome := 4
    86		// When the content does not fit, the options popup may reach the top and bottom edges of the terminal, so the rule modules do not
    87		// start scrolling merely because of the popup's outer margin.
    88		maxBody := screenHeight - chrome
    89		if maxBody < 3 {
    90			maxBody = 3
    91		}
    92	
    93		title, body := p.content(palette, inner, maxBody)
    94		lines := trimTrailingBlank(strings.Split(body, "\n"))
    95		if len(lines) > maxBody {
    96			lines = lines[:maxBody]
    97		}
    98		bodyHeight := len(lines)
    99		if bodyHeight < 1 {
   100			bodyHeight = 1
   101		}
   102	
   103		box := centerOptionsPopup(screenWidth, screenHeight, boxWidth, bodyHeight+chrome)
   104		p.box = box
   105		// The body starts after the top border, the title line and the separator; on the left it gives up one column each to the border and the padding.
   106		p.bodyX, p.bodyY = box.X+2, box.Y+3
   107		p.bodyWidth, p.bodyHeight = inner, bodyHeight
   108		p.bodyLines = lines
   109	
   110		rule := styleFor("popup-edge", palette).Render(strings.Repeat("─", inner))
   111		content := strings.Join([]string{
   112			styleFor("popup-title", palette).Render(optionsHeader(title, inner)),
   113			rule,
   114			padBlock(strings.Join(lines, "\n"), inner, bodyHeight, palette),
   115		}, "\n")
   116		return box, withDefaultColors(popupFrame(palette, boxWidth-2).Render(content), palette.ink(palette.Base))
   117	}
   118	
   119	// centerOptionsPopup keeps the ordinary popup margins while the content fits; only a height shortage consumes them.
   120	func centerOptionsPopup(screenWidth, screenHeight, wantWidth, wantHeight int) popupBox {
   121		box := centerPopup(screenWidth, screenHeight, wantWidth, wantHeight)
   122		height := wantHeight
   123		if height > screenHeight {
   124			height = screenHeight
   125		}
   126		if height > box.Height {
   127			box.Height = height
   128			box.Y = (screenHeight - height) / 2
   129		}
   130		return box
   131	}
   132	
   133	func trimTrailingBlank(lines []string) []string {
   134		for len(lines) > 1 && strings.TrimSpace(ansi.Strip(lines[len(lines)-1])) == "" {
   135			lines = lines[:len(lines)-1]
   136		}
   137		return lines
   138	}
   139	
   140	func (p *optionsPanel) content(palette palette, width, height int) (string, string) {
   141		switch {
   142		case p.report != nil:
   143			count := p.report.build(palette, width)
   144			// One blank line is always kept between the report body and the action hint at the bottom.
   145			body := height - 2
   146			if count < body {
   147				body = count
   148			}
   149			if body < 1 {
   150				body = 1
   151			}
   152			p.report.view.Width, p.report.view.Height = width, body
   153			hint := styleFor("popup-dim", palette).Render(t("tui.scroll_esc_back"))
   154			return p.report.title, p.report.view.View() + "\n\n" + hint
   155		case p.loadErr != "":
   156			return t("tui.options_2"), styleFor("popup-warn", palette).Render(p.loadErr)
   157		case p.form == nil:
   158			line := p.spinner.View() + " " + t("tui.detecting_environment")
   159			if p.status != "" {
   160				line = p.spinner.View() + " " + p.status
   161			}
   162			return t("tui.options_2"), styleFor("popup-dim", palette).Render(line)
   163		}
   164		if p.formWidth != width || p.formNatural == 0 {
   165			p.measureForm()
   166		}
   167		p.syncFormTheme(palette)
   168		formHeight, footerGap := fitOptionsForm(p.formNatural, height)
   169		p.form.WithWidth(width)
   170		// Keep Huh's natural height while the content fits. Even when given the same height, WithHeight switches the
   171		// Group to a viewport layout, making a page that could be shown in full take part in scrolling.
   172		if formHeight < p.formNatural {
   173			p.form.WithHeight(formHeight)
   174		}
   175		title := t("tui.kander_options")
   176		switch {
   177		case p.confirming:
   178			title = t("tui.close_options")
   179		case p.current != "":
   180			title = sectionTitle(p.current)
   181		}
   182		// The unsaved marker stays in the title, so it remains visible inside a section too.
   183		if p.dirty {
   184			title += t("tui.unsaved")
   185		}
   186		hint := styleFor("popup-dim", palette).Render(p.hintLine())
   187		// An unconstrained Huh Group may carry the trailing blanks of an initialized viewport. Trim them before adding the hint,
   188		// otherwise those blanks become interior whitespace and the popup cannot hug its actual content.
   189		formView := strings.Join(trimTrailingBlank(strings.Split(p.form.View(), "\n")), "\n")
   190		return title, formView + footerGap + hint
   191	}
   192	
   193	// fitOptionsForm owns the vertical layout of every section: the blank line before the hint is preserved first,
   194	// a shortage drops that blank line next, and only if it still does not fit is the Huh viewport shortened and scrolled.
   195	func fitOptionsForm(natural, available int) (height int, footerGap string) {
   196		footerHeight := 2
   197		footerGap = "\n\n"
   198		if natural+footerHeight > available {
   199			footerHeight = 1
   200			footerGap = "\n"
   201		}
   202		height = natural
   203		if height > available-footerHeight {
   204			height = available - footerHeight
   205		}
   206		if height < 1 {
   207			height = 1
   208		}
   209		return height, footerGap
   210	}
   211	
   212	// hintLine is the key hint at the bottom of the popup, giving one accurate line for the current page.
   213	func (p *optionsPanel) hintLine() string {
   214		switch {
   215		case p.current == sectionDoctor:
   216			return t("tui.choose_enter_confirm_esc_skip_installation")
   217		case p.confirming:
   218			return t("tui.move_enter_confirm_esc_keep_editing")
   219		case p.current == "":
   220			return t("tui.move_enter_open_esc_close")
   221		case p.current == sectionExecution || p.current == sectionReview:
   222			return t("tui.field_change_type_model_ids_enter_save_esc_back")
   223		}
   224		return t("tui.field_change_enter_save_esc_back")
   225	}
   226	
   227	func sectionTitle(section string) string {
   228		switch section {
   229		case sectionDoctor:
   230			return t("menu.install_herdr")
   231		case sectionInterface:
   232			return t("tui.interface")
   233		case sectionExecution:
   234			return t("tui.execution_and_models")
   235		case sectionReview:
   236			return t("tui.review_and_models")
   237		case sectionRules:
   238			return t("rules.modules")
   239		}
   240		return t("tui.options_2")
   241	}
   242	
   243	// padBlock pads the content into a rectangle of fixed width and height, so the popup border does not jitter.
   244	func padBlock(text string, width, height int, p palette) string {
   245		lines := strings.Split(text, "\n")
   246		if len(lines) > height {
   247			lines = lines[:height]
   248		}
   249		for i, line := range lines {
   250			lines[i] = padLineFill(line, width, p)
   251		}
   252		for len(lines) < height {
   253			lines = append(lines, p.fillLine(width))
   254		}
   255		return strings.Join(lines, "\n")
   256	}
   257	
   258	// Focus markers: the prefix of a selected item is set by this package in huhTheme, while the left border of a focused field is drawn by Huh.
   259	const (
   260		focusMarker = "▸"
   261		focusBorder = "┃"
   262	)
   263	
   264	// focusRange finds the line range currently holding focus in the rendered output.
   265	// With a selected-item marker it is exact to that line, otherwise it falls back to the whole left border segment of the focused field.
   266	func focusRange(lines []string) (lo, hi int, ok bool) {
   267		lo, hi = -1, -1
   268		for i, line := range lines {
   269			text := ansi.Strip(line)
   270			if strings.Contains(text, focusMarker) {
   271				return i, i, true
   272			}
   273			if strings.Contains(text, focusBorder) {
   274				if lo < 0 {
   275					lo = i
   276				}
   277				hi = i
   278			}
   279		}
   280		return lo, hi, lo >= 0
   281	}
   282	
   283	// keyCmd wraps one key press as a command handed back to Bubble Tea, which delivers it into Update asynchronously.
   284	// The commands returned by the form must not be called in place: the cursor blink chain of a text input contains a tea.Tick,
   285	// and running it synchronously really does sleep for over half a second, which feels like a hitch on every key press.
   286	func keyCmd(key tea.KeyType) tea.Cmd {
   287		return func() tea.Msg { return tea.KeyMsg{Type: key} }
   288	}
   289	
   290	// repeatCmd hands the same command to Bubble Tea n times.
   291	func repeatCmd(n int, cmd tea.Cmd) tea.Cmd {
   292		if n <= 0 {
   293			return nil
   294		}
   295		cmds := make([]tea.Cmd, 0, n)
   296		for i := 0; i < n; i++ {
   297			cmds = append(cmds, cmd)
   298		}
   299		return tea.Batch(cmds...)
   300	}
   301	
   302	// bodyLines returns the rendered lines of the current form body, used to convert mouse coordinates into field positions.
   303	func (p *optionsPanel) currentBodyLines() []string {
   304		if p.form == nil {
   305			return p.bodyLines
   306		}
   307		return trimTrailingBlank(strings.Split(p.form.View(), "\n"))
   308	}
   309	
   310	// HandleMouse gives the popup click-to-focus, double-click confirmation and wheel scrolling.
   311	// Every focus move is turned into a command handed back to Bubble Tea rather than driving the form synchronously here.
   312	func (p *optionsPanel) HandleMouse(x, y, bstate int) tea.Cmd {
   313		if p.report != nil {
   314			delta := mouseWheelDelta(bstate)
   315			if delta > 0 {
   316				p.report.view.ScrollDown(delta * mouseScrollStep)
   317			} else if delta < 0 {
   318				p.report.view.ScrollUp(-delta * mouseScrollStep)
   319			}
   320			return nil
   321		}
   322		if p.form == nil {
   323			return nil
   324		}
   325		if delta := mouseWheelDelta(bstate); delta != 0 {
   326			if delta > 0 {
   327				return keyCmd(tea.KeyDown)
   328			}
   329			return keyCmd(tea.KeyUp)
   330		}
   331		if !mouseLeftClicked(bstate) {
   332			return nil
   333		}
   334		if x < p.bodyX || x >= p.bodyX+p.bodyWidth || y < p.bodyY || y >= p.bodyY+p.bodyHeight {
   335			return nil
   336		}
   337		target := y - p.bodyY
   338		lines := p.currentBodyLines()
   339		if target < 0 || target >= len(lines) {
   340			return nil
   341		}
   342		move, already := p.focusMove(lines, target)
   343		if already || mouseLeftDoubleClicked(bstate) {
   344			// Clicking an already focused line, or double-clicking, counts as confirmation.
   345			return tea.Batch(move, keyCmd(tea.KeyEnter))
   346		}
   347		return move
   348	}
   349	
   350	// focusMove computes the commands needed to move focus to the target line and reports whether the target already has focus.
   351	// Single-choice pages (the root menu, the close confirmation) move by candidate line; settings pages convert using the actual rendered height
   352	// of each field, independently of whether blank lines sit between them.
   353	func (p *optionsPanel) focusMove(lines []string, target int) (tea.Cmd, bool) {
   354		for i, line := range lines {
   355			if strings.Contains(ansi.Strip(line), focusMarker) {
   356				delta := target - i
   357				switch {
   358				case delta == 0:
   359					return nil, true
   360				case delta > 0:
   361					return repeatCmd(delta, keyCmd(tea.KeyDown)), false
   362				default:
   363					return repeatCmd(-delta, keyCmd(tea.KeyUp)), false
   364				}
   365			}
   366		}
   367		if p.bind == nil || len(p.bind.formFields) == 0 {
   368			return nil, false
   369		}
   370		row, focusable := 0, 0
   371		wanted, current := -1, -1
   372		for _, field := range p.bind.formFields {
   373			view := field.View()
   374			height := lipgloss.Height(view)
   375			if !field.Skip() {
   376				if target >= row && target < row+height {
   377					wanted = focusable
   378				}
   379				if strings.Contains(ansi.Strip(view), focusBorder) {
   380					current = focusable
   381				}
   382				focusable++
   383			}
   384			row += height
   385		}
   386		if wanted < 0 || current < 0 {
   387			return nil, false
   388		}
   389		delta := wanted - current
   390		switch {
   391		case delta == 0:
   392			return nil, true
   393		case delta > 0:
   394			return repeatCmd(delta, huh.NextField), false
   395		default:
   396			return repeatCmd(-delta, huh.PrevField), false
   397		}
   398	}
     1	package menu
     2	
     3	import (
     4		"errors"
     5		"strconv"
     6	
     7		"github.com/dualface/kander/internal/config"
     8		"github.com/dualface/kander/internal/install"
     9		"strings"
    10	)
    11	
    12	// Choice is one selectable value in the options panel.
    13	type Choice struct {
    14		Value string
    15		Label string
    16	}
    17	
    18	// ModelField is one editable field of "model and reasoning effort".
    19	type ModelField struct {
    20		// Label is the full label used by the line-based menu, e.g. "kanban Codex model".
    21		Label string
    22		// Short is the short label used when nested under an agent option, e.g. "Codex model".
    23		Short string
    24		// Agent is the object this field belongs to (an agent on the execution side, a role on the review side),
    25		// and together with field it forms the deduplication key.
    26		Agent       string
    27		Prompt      string
    28		entry       map[string]string
    29		field       string
    30		get         func() string
    31		set         func(string)
    32		Placeholder string
    33	}
    34	
    35	// Key uniquely identifies one config item. When two task scales or two review roles pick the same agent,
    36	// they point at the very same config entry, which must appear only once in the UI.
    37	func (f ModelField) Key() string { return f.Agent + "." + f.field }
    38	
    39	// Value returns the current value of the field; an empty string means the CLI default is used.
    40	func (f ModelField) Value() string {
    41		if f.get != nil {
    42			return f.get()
    43		}
    44		return f.entry[f.field]
    45	}
    46	
    47	// Set writes the field.
    48	func (f ModelField) Set(value string) {
    49		if f.set != nil {
    50			f.set(value)
    51			return
    52		}
    53		f.entry[f.field] = value
    54	}
    55	
    56	// Session carries the editable config of the options panel plus the one-shot environment probe results.
    57	type Session struct {
    58		// Config is the config being edited; it does not reach disk before saving.
    59		Config *config.Config
    60		// Warnings are environment warnings raised while constructing the session; the caller decides how to display them.
    61		Warnings []ReportLine
    62	
    63		existing *config.Config
    64		agents   map[string]agentState
    65		exec     []Choice
    66		review   []Choice
    67	}
    68	
    69	// NewSession probes agents and launchers, and prepares the editable config from existing.
    70	// configValid means a schema-validated config already exists on disk.
    71	func NewSession(existing *config.Config, configValid bool) (*Session, error) {
    72		session := &Session{existing: existing}
    73		var err error
    74		session.Warnings = CaptureReport(func() {
    75			err = session.prepare(configValid)
    76		})
    77		// A session is returned even on error, so the caller can still display the environment warnings collected so far.
    78		return session, err
    79	}
    80	
    81	func (s *Session) prepare(configValid bool) error {
    82		s.agents = findAgents(s.existing)
    83		labels := agentLabels()
    84		for name, state := range s.agents {
    85			if state.Path != "" && !agentUsable(state) {
    86				warning(config.Text(
    87					"menu.version_failed_unavailable_as_a_new_choice", labels[name], state.Path,
    88				))
    89			}
    90		}
    91		firstExecution := ""
    92		for _, name := range config.AgentNames(s.existing) {
    93			state := s.agents[name]
    94			if labels[name] == "" {
    95				labels[name] = name
    96			}
    97			label := labels[name] + config.Text("menu.not_currently_installed")
    98			if agentUsable(state) {
    99				if firstExecution == "" {
   100					firstExecution = name
   101				}
   102				label = labels[name] + " (" + state.Version + ")"
   103			}
   104			// Unavailable agents remain selectable so their executable can be configured.
   105			s.exec = append(s.exec, Choice{Value: name, Label: label})
   106		}
   107		if firstExecution == "" && !s.existing.WelcomeComplete {
   108			return errors.New(config.Text("menu.no_usable_agent_found_version_must_succeed_install_codex"))
   109		}
   110		for _, name := range config.ReviewAgents {
   111			if reviewerUsable(s.agents[name]) {
   112				s.review = append(s.review, Choice{Value: name, Label: labels[name] + " (" + reviewerState(s.agents[name]).Version + ")"})
   113			}
   114		}
   115		if len(s.review) == 0 && !s.existing.WelcomeComplete {
   116			return errors.New(config.Text(
   117				"menu.no_usable_reviewer_found_install_codex_claude_grok_or",
   118			))
   119		}
   120	
   121		cfg := config.DefaultConfig()
   122		cfg.Agents = config.CloneAgents(s.existing.Agents)
   123		cfg.Models = copyModels(s.existing.Models)
   124		cfg.KanbanAgent = s.existing.KanbanAgent
   125		cfg.AgentLanguage = s.existing.AgentLanguage
   126		cfg.KanbanAgents = map[string]string{}
   127		for k, v := range s.existing.KanbanAgents {
   128			cfg.KanbanAgents[k] = v
   129		}
   130		if !s.existing.WelcomeComplete {
   131			if !agentUsable(s.agents[cfg.KanbanAgent]) {
   132				cfg.KanbanAgent = firstExecution
   133			}
   134			for _, scale := range config.TaskScales {
   135				if !agentUsable(s.agents[cfg.KanbanAgents[scale]]) {
   136					cfg.KanbanAgents[scale] = cfg.KanbanAgent
   137				}
   138			}
   139		}
   140		cfg.Reviewers = map[string]string{}
   141		for _, role := range config.ReviewRoles {
   142			previous := s.existing.Reviewers[role]
   143			cfg.Reviewers[role] = previous
   144			if !s.existing.WelcomeComplete && !reviewerUsable(s.agents[previous]) {
   145				cfg.Reviewers[role] = s.review[0].Value
   146			}
   147		}
   148		cfg.Launcher = s.existing.Launcher
   149		s.normalizeLauncher(cfg)
   150		cfg.TUI = s.existing.TUI
   151		cfg.Rules = s.existing.Rules.Clone()
   152		cfg.ReviewStages = map[string]string{}
   153		for k, v := range s.existing.ReviewStages {
   154			cfg.ReviewStages[k] = v
   155		}
   156		if configValid {
   157			if stored := config.ConfiguredLanguage(); stored != "" {
   158				cfg.Language = stored
   159			} else {
   160				cfg.Language = config.ResolveLanguage()
   161			}
   162		} else {
   163			cfg.Language = config.ResolveLanguage()
   164		}
   165		config.BindConfigLanguage(cfg)
   166		s.Config = cfg
   167		return nil
   168	}
   169	
   170	func (s *Session) normalizeLauncher(cfg *config.Config) {
   171		if s.existing.WelcomeComplete {
   172			return
   173		}
   174		switch {
   175		case isWindowsOS() && (cfg.Launcher == "tmux" || cfg.Launcher == "tmux-session"):
   176			cfg.Launcher = "console"
   177			warning(config.Text(
   178				"menu.windows_does_not_support_tmux_using_console",
   179			))
   180		case (cfg.Launcher == "tmux" || cfg.Launcher == "tmux-session") && lookPath("tmux") == "":
   181			cfg.Launcher = "foreground"
   182			warning(config.Text(
   183				"menu.tmux_is_not_installed_using_foreground_the_launcher_menu",
   184			))
   185		// On POSIX auto holds as long as tmux exists, so a missing herdr must not
   186		// rewrite it; on Windows auto can only land on herdr, so a missing herdr does.
   187		case (cfg.Launcher == "herdr" || (cfg.Launcher == "auto" && isWindowsOS())) && lookPath("herdr") == "":
   188			switch {
   189			case isWindowsOS():
   190				cfg.Launcher = "console"
   191			case lookPath("tmux") != "":
   192				cfg.Launcher = "tmux"
   193			default:
   194				cfg.Launcher = "foreground"
   195			}
   196			warning(config.Text(
   197				"menu.herdr_is_not_installed_using", cfg.Launcher,
   198			))
   199		}
   200	}
