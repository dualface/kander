   122		}
   123		for _, want := range []string{"unsaved-large", "unsaved-pm", config.Text("flow.cli_default")} {
   124			if !strings.Contains(text, want) {
   125				t.Fatalf("missing %q: %s", want, text)
   126			}
   127		}
   128	}

