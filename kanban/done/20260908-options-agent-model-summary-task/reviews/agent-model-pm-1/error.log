   134	
   135	// applyWork consumes the result of a background task; the Bubble Tea shell calls it on a workMsg.
   136	func (a *App) applyWork(payload any) tea.Cmd {
   137		if result, ok := payload.(focusResult); ok {
   138			a.focusRunning = false
   139			a.showFocusNotice(result.message)
   140			return nil
   141		}
   142		panel := a.Options
   143		if panel == nil {
   144			return nil
   145		}
   146		switch result := payload.(type) {
   147		case sessionResult:
   148			if result.err != nil {
   149				panel.loadErr = result.err.Error()
   150				return nil
   151			}
   152			a.Session = result.session
   153			panel.session = result.session
   154			if panel.initial != "" {
   155				section := panel.initial
   156				panel.initial = ""
   157				return panel.dispatch(section)
   158			}
   159			return panel.openRoot()
   160		case terminalToolsResult:
   161			return panel.beginDoctor(result.tools)
   162		case doctorResult:
   163			panel.status = ""
   164			if panel.session != nil && result.after != nil {
   165				if err := panel.session.ApplyDoctorConfig(result.before, result.after, panel.dirty); err != nil {
   166					result.lines = append(result.lines, menu.ReportLine{Level: menu.LevelWarning, Text: err.Error()})
   167				}
   168			}
   169			panel.showReport(t("tui.environment_check"), append(panel.doctorLines, result.lines...), "")
   170			panel.doctorLines = nil
   171		}
   172		return nil
   173	}
