    17	func TestFlowRootAndReadOnlySession(t *testing.T) {
    18		app, panel := openPanel(t)
    19		root := ansi.Strip(panel.form.View())
    20		if a, b, c := strings.Index(root, config.Text("rules.modules")), strings.Index(root, config.Text("flow.title")), strings.Index(root, config.Text("tui.environment_check")); a < 0 || b <= a || c <= b {
    21			t.Fatalf("wrong root order: %s", root)
    22		}
    23		before := config.Clone(panel.session.Config)
    24		path := os.Getenv(config.EnvConfig)
    25		disk, err := os.ReadFile(path)
    26		if err != nil {
    27			t.Fatal(err)
    28		}
    29		moveRootTo(t, panel, sectionFlow)
    30		drivePanel(panel, keyMsg("enter"))
    31		if panel.report == nil || panel.report.title != config.Text("flow.title") || panel.dirty || app.pendingWork != nil || app.pendingShell != nil {
    32			t.Fatal("flow must open a synchronous, clean, read-only report")
    33		}
    34		drivePanel(panel, keyMsg("esc"))
    35		if panel.report != nil || panel.form == nil || panel.section != sectionFlow || panel.current != "" {
    36			t.Fatal("Escape must restore the root and selected flow entry")
    37		}
    38		if !reflect.DeepEqual(before, panel.session.Config) {
    39			t.Fatal("viewing changed configuration")
    40		}
    41		// Make an unsaved change through the existing section binding, then reopen.
    42		pumpPanel(panel, panel.dispatch(sectionRules))
    43		*panel.bind.rules[config.RuleReview] = false
    44		panel.bind.apply(panel)
    45		drivePanel(panel, keyMsg("esc"))
    46		panel.dispatch(sectionFlow)
    47		if !panel.dirty || !strings.Contains(panel.report.title, config.Text("tui.unsaved")) {
    48			t.Fatal("unsaved state must be retained and visible")
    49		}
    50		for _, line := range panel.report.lines {
    51			if strings.Contains(line.Text, "PM:") || strings.Contains(line.Text, "QA:") {
    52				t.Fatal("flow used saved config instead of the session")
    53			}
    54		}
    55		after, err := os.ReadFile(path)
    56		if err != nil || string(disk) != string(after) {
    57			t.Fatal("read-only flow wrote disk configuration")
    58		}
    59	}
