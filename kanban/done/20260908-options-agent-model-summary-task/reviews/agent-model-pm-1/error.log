    53			{"both stages", true, map[string]string{"PM": "skip", "QA": "auto", "CSA": "required", "Hacker": "skip"}, []string{"flow.stage_one", "flow.role_auto", "flow.stage_two", "flow.role_required"}},
    54			{"second only", true, map[string]string{"PM": "skip", "QA": "skip", "CSA": "auto", "Hacker": "required"}, []string{"flow.stage_two", "flow.role_auto", "flow.role_required"}},
