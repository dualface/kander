     1	// Package flow describes configured execution and review assignments without performing actions.
     2	package flow
     3	
     4	import "github.com/dualface/kander/internal/config"
     5	
     6	// Kind distinguishes section headings, agent/model assignments and short status notes.
     7	type Kind uint8
     8	
     9	const (
    10		Heading Kind = iota
    11		Assignment
    12		Note
    13	)
    14	
    15	// Line carries a catalog key and template arguments independent of terminal layout.
    16	// An assignment's final argument is its model ID; empty means the agent CLI default.
    17	type Line struct {
    18		Kind Kind
    19		Key  string
    20		Args []any
    21	}
    22	
    23	// Build reads the normalized options-session configuration without modifying it.
    24	// Auto roles remain conditional because their applicability depends on the task.
    25	func Build(cfg *config.Config) []Line {
    26		var lines []Line
    27		add := func(kind Kind, key string, args ...any) {
    28			lines = append(lines, Line{Kind: kind, Key: "flow." + key, Args: args})
    29		}
    30		add(Heading, "execution")
    31		for _, scale := range config.TaskScales {
    32			agent := cfg.KanbanAgents[scale]
    33			add(Assignment, scale, agent, config.KanbanModelFor(cfg.Models.Kanban[agent], scale))
    34		}
    35		add(Heading, "review")
    36		if !cfg.Rules[config.RuleReview] {
    37			add(Note, "review_off")
    38			return lines
    39		}
    40		active := false
    41		for index, roles := range [][]string{{"PM", "QA"}, {"CSA", "Hacker"}} {
    42			stageAdded := false
    43			for _, role := range roles {
    44				mode := cfg.ReviewStages[role]
    45				if mode == "skip" {
    46					continue
    47				}
    48				if !stageAdded {
    49					key := "stage_one"
    50					if index == 1 {
    51						key = "stage_two"
    52					}
    53					add(Note, key)
    54					stageAdded, active = true, true
    55				}
    56				agent := cfg.Reviewers[role]
    57				model, _ := config.ReviewModelFor(cfg, agent, role)
    58				add(Assignment, "role_"+mode, role, agent, model)
    59			}
    60		}
    61		if !active {
    62			add(Note, "review_none")
    63		}
    64		return lines
    65	}
