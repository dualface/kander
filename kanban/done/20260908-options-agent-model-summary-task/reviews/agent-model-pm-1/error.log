   201	// build wraps and colors the lines at the given width and returns the actual line count.
   202	func (r *reportView) build(palette palette, width int) int {
   203		var body []string
   204		if r.extra != "" {
   205			for _, text := range wrapText(r.extra, width) {
   206				body = append(body, styleFor("popup-ok", palette).Render(text))
   207			}
   208			if len(r.lines) > 0 {
   209				body = append(body, "")
   210			}
   211		}
   212		for _, line := range r.lines {
   213			style := styleFor(reportTag(line.Level), palette)
   214			for _, raw := range strings.Split(line.Text, "\n") {
   215				for _, text := range wrapText(raw, width) {
   216					body = append(body, style.Render(text))
   217				}
   218			}
   219		}
   220		if len(body) == 0 {
   221			body = append(body, styleFor("popup-dim", palette).Render(t("tui.no_output")))
   222		}
   223		r.view.SetContent(strings.Join(body, "\n"))
   224		r.width = width
   225		return len(body)
   226	}
