   307	// ModelFields builds the editable model fields for the execution agents and reviewers actually in use.
   308	func (s *Session) ModelFields() []ModelField {
   309		return append(s.ExecutionModelFields(), s.ReviewModelFields()...)
   310	}
   311	
   312	// kanbanModelField builds one model field on the execution side.
   313	func (s *Session) kanbanModelField(agent, field, label, short, prompt string) ModelField {
   314		return ModelField{
   315			Label:  label,
   316			Short:  short,
   317			Agent:  agent,
   318			Prompt: prompt,
   319			entry:  s.Config.Models.Kanban[agent],
   320			field:  field,
   321		}
   322	}
   323	
   324	// ExecutionModelFieldsFor returns the model fields of the agent currently selected for one task scale (large/small).
   325	// Model and reasoning effort are stored per scale, so large and small tasks each keep their own
   326	// independently editable values even when they select the same agent.
   327	func (s *Session) ExecutionModelFieldsFor(scale string) []ModelField {
   328		agent := s.Config.KanbanAgents[scale]
   329		if agent == "" {
   330			return nil
   331		}
   332		// When a legacy config only has the shared model key, the scale models are filled in with the same concrete value,
   333		// so the UI never shows a field that looks empty but actually has a value.
   334		if entry := s.Config.Models.Kanban[agent]; entry != nil {
   335			if entry[scale+"_model"] == "" && entry["model"] != "" {
   336				entry[scale+"_model"] = entry["model"]
   337			}
   338		}
   339		label := agentLabels()[agent]
   340		if label == "" {
   341			label = agent
   342		}
   343		if s.Config.Models.Kanban[agent] == nil {
   344			s.Config.Models.Kanban[agent] = map[string]string{}
   345		}
   346		scaleLabel := config.Text("menu.large_task")
   347		if scale == "small" {
   348			scaleLabel = config.Text("menu.small_task")
   349		}
   350		fields := []ModelField{s.kanbanModelField(agent, scale+"_model",
   351			config.Text("menu.kanban_model", label, scaleLabel),
   352			config.Text("menu.model", label, scaleLabel),
   353			config.Text("menu.full_model_id_for_s", scaleLabel))}
   354		if config.AgentFor(s.Config, agent).Dialect == "cursor" && config.AgentFor(s.Config, agent).Args == nil {
   355			return fields
   356		}
   357		return append(fields, s.kanbanModelField(agent, scale+"_effort",
   358			config.Text("menu.kanban_reasoning_effort", label, scaleLabel),
   359			config.Text("menu.effort", label, scaleLabel),
   360			config.Text("menu.reasoning_effort_for_s", scaleLabel)))
   361	}
   362	
   363	// ExecutionModelFields is the flattened, order-preserving deduplication of the per-scale fields, for the line-based menu.
   364	func (s *Session) ExecutionModelFields() []ModelField {
   365		var out []ModelField
   366		seen := map[string]struct{}{}
   367		for _, scale := range config.TaskScales {
   368			for _, field := range s.ExecutionModelFieldsFor(scale) {
   369				if _, ok := seen[field.Key()]; ok {
   370					continue
   371				}
   372				seen[field.Key()] = struct{}{}
   373				out = append(out, field)
   374			}
   375		}
   376		return out
   377	}
   378	
   379	// ReviewModelFieldsFor returns the model fields of one review role.
   380	// Every role stores its own concrete values, so what the UI shows is what is used, with no hidden inheritance layer;
   381	// while a role has no value yet, it is filled in from the default of its selected reviewer.
   382	func (s *Session) ReviewModelFieldsFor(role string) []ModelField {
   383		reviewer := s.Config.Reviewers[role]
   384		if reviewer == "" {
   385			return nil
   386		}
   387		entry := s.seedReviewRole(role, reviewer)
   388		fields := []ModelField{{
   389			Label:  config.Text("menu.review_model", role),
   390			Short:  config.Text("menu.model_2", role),
   391			Agent:  role,
   392			Prompt: config.Text("menu.which_model_should_use", role),
   393			entry:  entry,
   394			field:  "model",
   395		}}
   396		if reviewer == "cursor" {
   397			return fields
   398		}
   399		return append(fields, ModelField{
   400			Label:  config.Text("menu.review_reasoning_effort", role),
   401			Short:  config.Text("menu.effort_2", role),
   402			Agent:  role,
   403			Prompt: config.Text("menu.reasoning_effort_for", role),
   404			entry:  entry,
   405			field:  "effort",
   406		})
   407	}
   408	
   409	// seedReviewRole makes sure the role owns its values: whichever item is missing is filled in from that reviewer's default.
   410	func (s *Session) seedReviewRole(role, reviewer string) map[string]string {
   411		entry := s.Config.Models.ReviewRoles[role]
   412		if entry == nil {
   413			entry = map[string]string{}
   414			s.Config.Models.ReviewRoles[role] = entry
   415		}
   416		agentEntry := s.Config.Models.Review[reviewer]
   417		if entry["model"] == "" {
   418			entry["model"] = agentEntry["model"]
   419		}
   420		if _, ok := agentEntry["effort"]; ok && entry["effort"] == "" {
   421			entry["effort"] = agentEntry["effort"]
   422		}
   423		return entry
   424	}
   425	
   426	// ResetReviewRoleModel resets the model and reasoning effort of one role to the defaults of its new reviewer.
   427	// Call it when a role changes reviewer: the old values were configured for the old reviewer and would otherwise be misattributed.
   428	func (s *Session) ResetReviewRoleModel(role string) {
   429		s.Config.Models.ReviewRoles[role] = map[string]string{}
   430		s.seedReviewRole(role, s.Config.Reviewers[role])
   431	}
   432	
   433	// ReviewModelFields is the flattened, order-preserving deduplication of the per-role fields, for the line-based menu.
   434	func (s *Session) ReviewModelFields() []ModelField {
   435		var out []ModelField
   436		seen := map[string]struct{}{}
   437		for _, role := range config.ReviewRoles {
   438			for _, field := range s.ReviewModelFieldsFor(role) {
   439				if _, ok := seen[field.Key()]; ok {
   440					continue
   441				}
   442				seen[field.Key()] = struct{}{}
   443				out = append(out, field)
   444			}
   445		}
   446		return out
   447	}
   448	
   449	// Finish wraps up before saving: it reports how the rules were installed and marks initialization complete.
   450	func (s *Session) Finish() ([]ReportLine, error) {
   451		var err error
   452		lines := CaptureReport(func() {
   453			err = s.finish()
   454		})
   455		return lines, err
   456	}
   457	
   458	func (s *Session) finish() error {
   459		if err := config.ValidateRules(s.Config.Rules); err != nil {
   460			return err
   461		}
   462		labels := agentLabels()
   463		paths, err := currentPaths()
   464		if err != nil {
   465			return err
   466		}
   467		entry := rulesEntry(paths)
   468		seen := map[string]struct{}{}
   469		for _, selected := range config.ExecutionAgentsInUse(s.Config) {
   470			target := install.AgentRulesTarget(selected, paths)
   471			if _, ok := seen[target]; ok && target != "" {
   472				continue
   473			}
   474			seen[target] = struct{}{}
   475			outcome, ensureErr := install.EnsureRulesIntegration(selected, paths)
   476			if ensureErr != nil {
   477				warning(config.Text("menu.is_not_connected_to_kander_rules", labels[selected], ensureErr.Error()))
   478				hint(config.Text(
   479					"menu.follow_the_readme_integration_section_and_point_the_rules", entry,
   480				))
   481				continue
   482			}
   483			if outcome.Status == install.IntegrationPresent {
   484				success(config.Text("menu.is_connected_to_kander_rules", labels[selected], outcome.Target))
   485			} else {
   486				success(config.Text("menu.added_kander_rules_reference", labels[selected], outcome.Target))
   487			}
   488		}
   489		note(config.Text(
   490			"menu.note_kanban_start_uses_the_agent_s_no_confirmation",
   491		))
   492		note(RulesSessionNotice())
   493		s.Config.WelcomeComplete = true
   494		return nil
   495	}
   496	
   497	// Save writes the current config to disk and returns the config file path.
   498	func (s *Session) Save() (string, error) {
   499		path, err := config.SaveIfUnchanged(s.Config, s.existing)
   500		if err == nil {
   501			s.existing = config.Clone(s.Config)
   502		}
   503		return path, err
   504	}
   505	
   506	// Summary returns the "current configuration" overview shown in the menu title and at the top of the panel.
   507	func (s *Session) Summary() []string {
   508		cfg := s.Config
   509		lines := []string{config.Text("menu.current_configuration")}
   510		lines = append(lines, config.Text("rules.modules")+": "+config.FormatRulesSummary(cfg.Rules))
   511		for _, agent := range config.ExecutionAgentsInUse(cfg) {
   512			entry := cfg.Models.Kanban[agent]
   513			lines = append(lines, "  kanban "+agent+": "+config.FormatKanbanModelSummary(agent, entry))
   514		}
   515		seen := map[string]struct{}{}
   516		for _, role := range config.ReviewRoles {
   517			reviewer := cfg.Reviewers[role]
   518			if _, ok := seen[reviewer]; ok {
   519				continue
   520			}
   521			seen[reviewer] = struct{}{}
   522			entry := cfg.Models.Review[reviewer]
   523			lines = append(lines, "  review "+reviewer+": "+config.FormatReviewModelSummary(entry))
   524		}
   525		return lines
   526	}
