import KanderFormal.Gen.Go
import KanderFormal.Gen.Vectors

/-
The Go emitter for the differential test (`zz_generated_test.go`). It lists the
vector alphabet as Go values, encodes Go values in the canonical JSON of
`Json.lean`, and hands everything to `internal/statemachine/vectortest`.
-/
namespace KanderFormal.Gen

open KanderFormal.Registry

def namesVar (e : String) : String := e ++ "Names"

/-- Go expression encoding the value `x` of type `t`. -/
def goEncodeBase (x : String) : EBase → String
  | .bool => "vectortest.Bool(" ++ x ++ ")"
  | .enum e => "vectortest.Str(" ++ namesVar e ++ "[" ++ x ++ "])"
  | .nat => "vectortest.Uint(" ++ x ++ ")"

/-- The name of the generated encoder of arrays with elements of type `t`. -/
def arrEncoder : ETy → String
  | .base .bool => "encodeBoolArray"
  | .base .nat => "encodeUintArray"
  | .base (.enum e) => "encode" ++ goEnum e ++ "Array"
  | .set e => "encode" ++ goSet e ++ "Array"
  | _ => "encodeArray"

def goEncode (m : Machine) (x : String) : ETy → String
  | .base b => goEncodeBase x b
  | .map k v =>
    let ctors := (m.ctorsOf k).getD []
    "vectortest.Object(" ++ ", ".intercalate (ctors.flatMap fun c =>
      [jsonStr c, goEncodeBase (x ++ "[" ++ goCtor k c ++ "]") v]) ++ ")"
  | .set e => "encode" ++ goSet e ++ "(" ++ x ++ ")"
  | .arr t => arrEncoder t ++ "(" ++ x ++ ")"

/-- The element types of the arrays of a machine, without duplicates. -/
def arrElems (m : Machine) : List ETy :=
  let ts := (m.fields.map (·.ty.erase) ++ m.queries.map (·.ty)).filterMap fun
    | .arr t => some t
    | _ => none
  ts.foldl (fun acc t => if acc.contains t then acc else acc ++ [t]) []

def goEventLit (m : Machine) (e : Event) : String :=
  match m.findEvent e.name with
  | some ev =>
    capitalize ev.name ++ "{" ++ ", ".intercalate ((ev.args.zip e.args).map fun (d, v) =>
      capitalize d.name ++ ": " ++ goValLit m d.ty.erase v) ++ "}"
  | none => "nil"

def goParamsLit (m : Machine) (ps : List (String × Nat)) : String :=
  let p := paramsOf ps
  "{" ++ ", ".intercalate (m.params.map fun x => capitalize x ++ ": " ++ toString (p x)) ++ "}"

def testFile (en : Entry) : String :=
  let m := en.machine
  let events := vectorAlphabet en
  let anyArgs := m.events.any fun ev => !ev.args.isEmpty
  let lines :=
    ["// Code generated by kander-formal; DO NOT EDIT.", "",
      "package " ++ m.name, "",
      "import (", "\t\"testing\"", "",
      "\t\"github.com/dualface/kander/internal/statemachine/vectortest\"", ")", ""] ++
    m.enums.flatMap (fun d =>
      ["var " ++ namesVar d.name ++ " = [" ++ goCount d.name ++ "]string{" ++
        ", ".intercalate (d.ctors.map jsonStr) ++ "}", ""]) ++
    (setEnums m).flatMap (fun e =>
      ["func encode" ++ goSet e ++ "(v " ++ goSet e ++ ") string {", "\tvar xs []string",
        "\tfor i := " ++ goEnum e ++ "(0); i < " ++ goCount e ++ "; i++ {", "\t\tif v.Has(i) {",
        "\t\t\txs = append(xs, vectortest.Str(" ++ namesVar e ++ "[i]))", "\t\t}", "\t}",
        "\treturn vectortest.Array(xs...)", "}", ""]) ++
    (arrElems m).flatMap (fun t =>
      ["func " ++ arrEncoder t ++ "(v " ++ goType (.arr t) ++ ") string {", "\txs := make([]string, len(v))",
        "\tfor i, x := range v {", "\t\txs[i] = " ++ goEncode m "x" t, "\t}",
        "\treturn vectortest.Array(xs...)", "}", ""]) ++
    ["var vectorParams = []Params{"] ++ en.vectors.paramSets.map (fun ps => "\t" ++ goParamsLit m ps ++ ",") ++
    ["}", "", "var vectorEvents = []Event{"] ++ events.map (fun e => "\t" ++ goEventLit m e ++ ",") ++
    ["}", "", "func encodeParams(p Params) string {", "\treturn vectortest.Object("] ++
    m.params.map (fun x => "\t\t" ++ jsonStr x ++ ", vectortest.Uint(uint64(p." ++ capitalize x ++ ")),") ++
    ["\t)", "}", "", "func encodeState(s State) string {", "\treturn vectortest.Object("] ++
    m.fields.map (fun d => "\t\t" ++ jsonStr d.name ++ ", " ++ goEncode m ("s." ++ capitalize d.name) d.ty.erase ++ ",") ++
    ["\t)", "}", "", "func encodeEvent(e Event) string {",
      if anyArgs then "\tswitch ev := e.(type) {" else "\tswitch e.(type) {"] ++
    m.events.flatMap (fun ev =>
      ["\tcase " ++ capitalize ev.name ++ ":",
        "\t\treturn vectortest.Event(" ++ ", ".intercalate (jsonStr ev.name :: ev.args.flatMap fun a =>
          [jsonStr a.name, goEncode m ("ev." ++ capitalize a.name) a.ty.erase]) ++ ")"]) ++
    ["\t}", "\treturn \"null\"", "}", ""] ++
    m.queries.flatMap (fun q =>
      let n := capitalize q.name
      if mayFail q.body then
        ["func encodeQuery" ++ n ++ "(s State, p Params) string {", "\tv, ok := " ++ n ++ "(s, p)",
          "\tif !ok {", "\t\treturn \"null\"", "\t}", "\treturn " ++ goEncode m "v" q.ty, "}", ""]
      else
        ["func encodeQuery" ++ n ++ "(s State, p Params) string {",
          "\treturn " ++ goEncode m (n ++ "(s, p)") q.ty, "}", ""]) ++
    ["func encodeQueries(s State, p Params) string {", "\treturn vectortest.Object("] ++
    m.queries.map (fun q => "\t\t" ++ jsonStr q.name ++ ", encodeQuery" ++ capitalize q.name ++ "(s, p),") ++
    ["\t)", "}", "",
      "func TestVectors(t *testing.T) {",
      "\tvar m vectortest.Machine[Params, State, Event]",
      "\tm.Name = " ++ jsonStr m.name,
      "\tm.Params = vectorParams",
      "\tm.Events = vectorEvents",
      "\tm.Initial = Initial",
      "\tm.Step = Step",
      "\tm.EncodeParams = encodeParams",
      "\tm.EncodeState = encodeState",
      "\tm.EncodeEvent = encodeEvent",
      "\tm.EncodeQueries = encodeQueries",
      "\tvectortest.Replay(t, \"testdata/vectors.jsonl\", m)",
      "}"]
  "\n".intercalate lines ++ "\n"

end KanderFormal.Gen
